@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Reports.Wip.DetailsModel
@{ ViewData["Title"] = "Detalle WIP"; }
<div class="container py-4"><a asp-page="Index">← Reporte WIP</a><h1 class="h2 mt-2">@Model.Issue.ProductSku: @Model.Issue.SourceLocation → @Model.Issue.WipArea</h1><p>Salida original @Model.Issue.OccurredAt.ToString("dd/MM/yyyy HH:mm") · @Model.Issue.Responsible · folio @Model.Issue.MovementId</p><div class="row g-3 mb-4"><div class="col"><div class="card card-body"><span>Enviado</span><strong>@Model.Issue.Issued.ToString("0.####") @Model.Issue.Unit</strong></div></div><div class="col"><div class="card card-body"><span>Devuelto a bodega</span><strong>@Model.Issue.WarehouseReturned.ToString("0.####")</strong></div></div><div class="col"><div class="card card-body"><span>Devuelto a proveedor</span><strong>@Model.Issue.SupplierReturned.ToString("0.####")</strong></div></div><div class="col"><div class="card card-body border-warning"><span>Consumo asumido</span><strong>@Model.Issue.AssumedConsumed.ToString("0.####")</strong></div></div></div><h2 class="h4">Devoluciones y compensaciones</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Cantidad</th><th>Responsable</th><th>Referencia</th><th>Estado</th></tr></thead><tbody>@if(Model.Dispositions.Count==0){<tr><td colspan="6" class="text-center text-muted">Sin devoluciones.</td></tr>}@foreach(var row in Model.Dispositions){<tr class="@(row.IsReversal||row.WasReversed?"table-secondary":null)"><td>@row.OccurredAt.ToString("dd/MM/yyyy HH:mm")</td><td>@(row.Type=="WarehouseReturn"?"A bodega":"A proveedor")</td><td>@row.Quantity.ToString("0.####") @Model.Issue.Unit</td><td>@row.Responsible</td><td>@row.Reference</td><td>@(row.IsReversal?"Compensación":row.WasReversed?"Corregida":"Vigente")</td></tr>}</tbody></table></div></div>
