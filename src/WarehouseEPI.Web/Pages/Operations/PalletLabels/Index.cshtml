@page "/Operations/PalletLabels"
@model WarehouseEPI.Web.Pages.Operations.PalletLabels.IndexModel
@using WarehouseEPI.Infrastructure.Labels
@{ ViewData["Title"] = "Placas de pallet"; }
@if (Model.Preview is not null) { <style>@Html.Raw($"@@page {{ size: {Model.Preview.Size.WidthInches.ToString(System.Globalization.CultureInfo.InvariantCulture)}in {Model.Preview.Size.HeightInches.ToString(System.Globalization.CultureInfo.InvariantCulture)}in; margin: 0; }}")</style> }
<div class="label-workspace pallet-label-workspace">
    <header class="label-page-header no-label-print"><div><span class="label-eyebrow">Entrada confirmada</span><h1 class="h2 mb-1">Placas de pallet</h1><p class="text-body-secondary mb-0">Busca una Entrada para generar su placa documental. No cambia inventario.</p></div></header>
    <form method="get" class="label-template-picker no-label-print"><label for="pallet-folio" class="form-label fw-bold">Folio de Entrada o placa</label><div class="input-group input-group-lg"><input id="pallet-folio" name="folio" class="form-control" value="@Model.Entry?.Identifier" autocomplete="off" placeholder="PLT-UUID o UUID de Entrada" autofocus/><button class="btn btn-outline-primary" type="submit">Buscar</button></div><div class="form-text">Acepta el UUID de la Entrada o el folio visible PLT.</div></form>
    @if(Model.SearchError is not null){<div class="alert alert-warning no-label-print mt-3" role="alert">@Model.SearchError</div>}
    <div asp-validation-summary="ModelOnly" class="alert alert-danger no-label-print mt-3" role="alert"></div>
    @if(Model.Entry is not null){
        <section class="operation-card no-label-print mt-3"><div class="receipt-meta"><div><span>Placa</span><strong>@Model.Entry.Identifier</strong></div><div><span>Producto</span><strong>@Model.Entry.Sku</strong></div><div><span>Cantidad</span><strong>@Model.Entry.Quantity.ToString("0.####") @Model.Entry.UnitCode</strong></div><div><span>Destino</span><strong>@(Model.Entry.Destination ?? "—")</strong></div></div>@if(Model.Entry.Description is not null){<p class="text-body-secondary mb-0 mt-2">@Model.Entry.Description</p>}</section>
        <form method="post" class="label-create-grid no-label-print mt-3"><input asp-for="Input.MovementId" type="hidden"/><section class="label-form-card"><div class="label-section-heading"><span class="label-step-number">1</span><div><h2 class="h5 mb-1">Datos de impresión</h2><p class="text-body-secondary mb-0">El peso es opcional y no se almacena.</p></div></div><div class="row g-3"><div class="col-sm-7"><label asp-for="Input.Weight" class="form-label">Peso</label><input asp-for="Input.Weight" class="form-control form-control-lg" maxlength="40" autocomplete="off" placeholder="Ej. 1,250 LB"/><span asp-validation-for="Input.Weight" class="text-danger"></span></div><div class="col-sm-5"><label asp-for="Input.Copies" class="form-label">Copias idénticas</label><input asp-for="Input.Copies" class="form-control form-control-lg" type="number" min="1" max="100" required/><span asp-validation-for="Input.Copies" class="text-danger"></span></div></div></section><section class="label-form-card label-submit-card"><div class="label-section-heading"><span class="label-step-number">2</span><div><h2 class="h5 mb-1">Previsualizar</h2><p class="text-body-secondary mb-0">Received se deriva de la Entrada; Counted y Removed se completan a mano.</p></div></div><button type="submit" class="btn btn-primary btn-lg">Generar placa</button></section></form>
    }
    @if(Model.Preview is not null){<section class="label-preview-section"><header class="label-preview-toolbar no-label-print"><div><span class="label-eyebrow">@Model.Preview.TemplateCode · v@Model.Preview.TemplateVersion · @Model.Preview.Copies copia(s)</span><h2 class="h4 mb-1">Lista para imprimir</h2><p class="text-body-secondary mb-0">Selecciona Carta horizontal, escala 100 %, sin encabezados/pies y una sola copia.</p></div><button type="button" class="btn btn-primary btn-lg" data-label-print>Imprimir placas</button></header><div class="label-print-pages" data-label-print-pages>@for(var copy=1;copy<=Model.Preview.Copies;copy++){<article class="label-dynamic" data-label-copy="@copy" aria-label="Placa @copy de @Model.Preview.Copies" style="--label-width:@(Model.Preview.Size.WidthInches.ToString(System.Globalization.CultureInfo.InvariantCulture))in;--label-height:@(Model.Preview.Size.HeightInches.ToString(System.Globalization.CultureInfo.InvariantCulture))in">@foreach(var item in Model.Preview.Elements){var e=item.Definition;var left=e.X*100m/Model.Preview.Size.WidthMils;var top=e.Y*100m/Model.Preview.Size.HeightMils;var width=e.Width*100m/Model.Preview.Size.WidthMils;var height=e.Height*100m/Model.Preview.Size.HeightMils;<div class="label-element label-element-@e.Type.ToString().ToLowerInvariant() @(e.BlankLine&&string.IsNullOrEmpty(item.Text)?"is-blank-line":null)" style="left:@(left.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(top.ToString(System.Globalization.CultureInfo.InvariantCulture))%;width:@(width.ToString(System.Globalization.CultureInfo.InvariantCulture))%;height:@(height.ToString(System.Globalization.CultureInfo.InvariantCulture))%;transform:rotate(@(e.Rotation)deg);z-index:@e.ZIndex;font-family:'@e.FontFamily';font-size:@(e.FontSize)pt;font-weight:@(e.Bold?700:400);color:@e.Color;background-color:@(e.Type==LabelElementType.Rectangle?e.BackgroundColor:"transparent");border-width:@(e.Type==LabelElementType.Rectangle?e.BorderWidth:0)px;text-align:@e.Align">@if(item.Barcode is not null){@Html.Raw(item.Barcode.Markup)}else if(item.ImageUrl is not null){<img src="@item.ImageUrl" alt="Extra Packaging, LLC"/>}else if(e.Type==LabelElementType.Line){<span class="label-line"></span>}else{@item.Text}</div>}</article>}</div></section>}
</div>
@section Styles { <link rel="stylesheet" href="~/css/label-4x6.css" asp-append-version="true"/> }
@section Scripts { <script src="~/js/label-4x6.js" asp-append-version="true"></script> }
