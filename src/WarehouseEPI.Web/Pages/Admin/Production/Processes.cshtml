@page
@model WarehouseEPI.Web.Pages.Admin.Production.ProcessesModel
@{ ViewData["Title"] = "Procesos"; }
<div class="container-fluid py-3">
    <header class="d-flex flex-wrap justify-content-between gap-3 mb-4">
        <div><span class="eyebrow">Producción</span><h1 class="h2 mb-1">Procesos</h1><p class="text-body-secondary mb-0">Configura dónde puede realizarse cada proceso.</p></div>
        <a asp-page="ProcessEdit" class="btn btn-primary btn-lg">Nuevo proceso</a>
    </header>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <form method="get" class="d-flex gap-2 mb-3">
        <label for="process-search" class="visually-hidden">Buscar procesos</label>
        <input id="process-search" name="search" value="@Model.Search" class="form-control form-control-lg" type="search" placeholder="Código o nombre" />
        <button class="btn btn-outline-primary btn-lg">Buscar</button>
    </form>
    @if (Model.Items.Count == 0) { <div class="alert alert-info">No hay procesos con esa búsqueda. Crea uno para comenzar.</div> }
    else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Proceso</th><th>Estado</th><th>Áreas y racks WIP</th><th>WIP predeterminado</th><th></th></tr></thead><tbody>
        @foreach (var item in Model.Items) { <tr><td><strong>@item.Code</strong><small class="d-block text-body-secondary">@item.Name</small></td><td>@(item.IsActive ? "Activo" : "Inactivo")</td><td>@(string.IsNullOrEmpty(item.Targets) ? "Sin asociaciones" : item.Targets)</td><td>@item.DefaultWip @if(!item.DefaultWipAvailable){<span class="badge text-bg-warning">Requiere atención</span>}</td><td><a asp-page="ProcessEdit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a></td></tr> }
    </tbody></table></div>
    <nav class="d-flex justify-content-between align-items-center" aria-label="Páginas de procesos"><a asp-page="Processes" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber - 1)" class="btn btn-outline-secondary @(Model.HasPrevious ? null : "disabled")" aria-disabled="@(!Model.HasPrevious)">Anterior</a><span>Página @Model.PageNumber</span><a asp-page="Processes" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber + 1)" class="btn btn-outline-secondary @(Model.HasNext ? null : "disabled")" aria-disabled="@(!Model.HasNext)">Siguiente</a></nav> }
</div>
