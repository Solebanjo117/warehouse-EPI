@page "/Operations/CycleCounts"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.IndexModel
@{
    ViewData["Title"] = OpTexts["Conteos cíclicos"].Value;
}

<div class="inventory-analytics cycle-count-workspace">
    <header class="inventory-page-header analytics-header">
        <div><span class="eyebrow">@OpTexts["Operación LAN"]</span><h1 class="h2 mb-1">@OpTexts["Conteos cíclicos"]</h1><p class="text-muted mb-0">@OpTexts["Organiza conteos ciegos por ubicación y revisa las diferencias sin detener el almacén."]</p></div>
        <div class="d-flex gap-2 flex-wrap"><a asp-page="Calendar" class="btn btn-outline-primary">@OpTexts["Calendario"]</a><a asp-page="Create" class="btn btn-primary cycle-primary-action">@OpTexts["Nueva campaña"]</a></div>
    </header>

    @if (Model.Attention is not null)
    {
        <div class="alert alert-warning" role="status">
            @OpTexts["Mostrando campañas con ubicaciones que requieren atención:"] <strong>@(Model.Attention == "stale" ? OpTexts["conteo obsoleto"].Value : Model.Attention == "review" ? OpTexts["en revisión (variante)"].Value : OpTexts["reconteo solicitado (variante)"].Value)</strong>.
            <a asp-page="Index" class="alert-link ms-1">@OpTexts["Quitar filtro"]</a>
        </div>
    }

    <nav class="cycle-status-filters" aria-label="@OpTexts["Filtrar campañas por estado"]">
        <a asp-page="Index" asp-route-search="@Model.Search" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" class="@(Model.Status is null ? "active" : null)" aria-current="@(Model.Status is null ? "page" : null)">@OpTexts["Todas"]</a>
        @foreach (var status in Enum.GetValues<CycleCountCampaignStatus>())
        {
            <a asp-page="Index" asp-route-status="@status" asp-route-search="@Model.Search" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" class="@(Model.Status == status ? "active" : null)" aria-current="@(Model.Status == status ? "page" : null)">@OpTexts[CycleCountPresentation.CampaignStatusLabel(status)]</a>
        }
    </nav>

    <form method="get" class="analytics-filter-card analytics-filter-form">
        @if (Model.Attention is not null) { <input type="hidden" name="attention" value="@Model.Attention" /> }
        <div><label class="form-label" for="cycle-search">@OpTexts["Folio o título"]</label><input id="cycle-search" name="search" value="@Model.Search" class="form-control" placeholder="@OpTexts["Ej. CC-000021 o Fila A"]" /></div>
        <div><label class="form-label" for="cycle-status">@OpTexts["Estado"]</label><select id="cycle-status" name="status" class="form-select"><option value="">@OpTexts["Todos"]</option>@foreach (var status in Enum.GetValues<CycleCountCampaignStatus>()) { <option value="@status" selected="@(Model.Status == status)">@OpTexts[CycleCountPresentation.CampaignStatusLabel(status)]</option> }</select></div>
        <div><label class="form-label" for="cycle-from">@OpTexts["Desde"]</label><input id="cycle-from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" type="date" /></div>
        <div><label class="form-label" for="cycle-to">@OpTexts["Hasta"]</label><input id="cycle-to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" type="date" /></div>
        <div class="analytics-filter-actions"><button class="btn btn-outline-primary">@OpTexts["Aplicar filtros"]</button></div>
    </form>

    @if (Model.Campaigns.Count == 0)
    {
        <div class="cycle-empty"><strong>@OpTexts["No hay campañas con estos filtros."]</strong><span>@OpTexts["Cambia los filtros o crea una campaña para preparar el siguiente conteo."]</span><a asp-page="Create" class="btn btn-primary mt-2">@OpTexts["Nueva campaña"]</a></div>
    }
    else
    {
        <div class="table-responsive analytics-table cycle-campaign-table d-none d-lg-block">
            <table class="table align-middle mb-0">
                <thead><tr><th>@OpTexts["Campaña"]</th><th>@OpTexts["Estado"]</th><th>@OpTexts["Progreso"]</th><th>@OpTexts["Revisión"]</th><th>@OpTexts["Creada"]</th><th><span class="visually-hidden">@OpTexts["Acción"]</span></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Campaigns)
                {
                    var progress = item.LocationCount == 0 ? 0 : (int)Math.Round(item.CompletedLocationCount * 100d / item.LocationCount);
                    <tr>
                        <td><strong>@item.Folio</strong><small class="d-block text-body-secondary">@(item.Title ?? OpTexts["Sin título"].Value)</small></td>
                        <td><span class="badge @CycleCountPresentation.CampaignStatusClass(item.Status)">@OpTexts[CycleCountPresentation.CampaignStatusLabel(item.Status)]</span></td>
                        <td><div class="cycle-inline-progress"><div class="progress" role="progressbar" aria-label="@OpTexts["Progreso de {0}", item.Folio]" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@progress%"></div></div><small>@item.CompletedLocationCount de @item.LocationCount</small></div></td>
                        <td>@if (item.DifferenceLocationCount > 0) { <span class="cycle-review-count">@item.DifferenceLocationCount por revisar</span> } else { <span class="text-body-secondary">@OpTexts["Sin diferencias"]</span> }</td>
                        <td><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time></td>
                        <td class="text-end"><a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">@OpTexts["Abrir campaña"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="cycle-campaign-cards d-lg-none">
            @foreach (var item in Model.Campaigns)
            {
                var progress = item.LocationCount == 0 ? 0 : (int)Math.Round(item.CompletedLocationCount * 100d / item.LocationCount);
                <article class="cycle-campaign-card">
                    <header><div><span class="eyebrow">@item.Folio</span><h2 class="h5 mb-0">@(item.Title ?? OpTexts["Sin título"].Value)</h2></div><span class="badge @CycleCountPresentation.CampaignStatusClass(item.Status)">@OpTexts[CycleCountPresentation.CampaignStatusLabel(item.Status)]</span></header>
                    <div class="progress" role="progressbar" aria-label="@OpTexts["Progreso de {0}", item.Folio]" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@progress%"></div></div>
                    <dl><div><dt>@OpTexts["Completadas"]</dt><dd>@item.CompletedLocationCount / @item.LocationCount</dd></div><div><dt>@OpTexts["En revisión"]</dt><dd>@item.DifferenceLocationCount</dd></div><div><dt>@OpTexts["Creada"]</dt><dd><time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToString("dd/MM/yyyy")</time></dd></div></dl>
                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100">@OpTexts["Abrir campaña"]</a>
                </article>
            }
        </div>
    }
</div>
