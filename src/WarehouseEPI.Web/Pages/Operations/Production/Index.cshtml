@page
@model WarehouseEPI.Web.Pages.Operations.Production.IndexModel
@{ViewData["Title"]="Producción";}
<div class="container-fluid py-3 production-page" data-supply-queue data-signature="@Model.Snapshot.Signature" data-checked-at="@Model.Snapshot.CheckedAt.ToString("O")" data-snapshot-url="@Url.Page(null,"Snapshot",new{Model.Search,Model.Status,Model.ActiveStageId,Model.From,Model.To,Model.AlertsOnly,Model.View})"><header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="eyebrow">Operación</span><h1 class="h2 mb-1">Producción</h1><p class="text-muted mb-0">Escanea o busca una orden, lote de producción o lote terminado.</p></div><a asp-page="Trace" class="btn btn-outline-primary align-self-start">Consultar procedencia</a></header>
<button class="btn btn-outline-primary" type="button" data-queue-refresh>Actualizar</button><p data-supply-live role="status" aria-live="polite"></p><nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Órdenes por estado">@foreach(var tab in new[]{("active","Activas"),("drafts","Borradores"),("closed","Cerradas"),("cancelled","Canceladas")}){<a class="btn btn-outline-primary" asp-route-View="@tab.Item1" aria-current="@(Model.View==tab.Item1?"page":null)">@tab.Item2</a>}</nav><form method="get" class="row g-2 mb-4"><input type="hidden" asp-for="View"/><div class="col-12 col-lg-4"><label for="production-search" class="form-label">Folio, lote, referencia o SKU</label><input id="production-search" name="Search" value="@Model.Search" class="form-control form-control-lg" type="search" autocomplete="off" autocapitalize="characters" autofocus/></div><div class="col-6 col-lg-2"><label asp-for="Status" class="form-label">Estado</label><select asp-for="Status" class="form-select form-select-lg"><option value="">Todos</option>@foreach(var s in Enum.GetValues<WarehouseEPI.Core.Entities.ProductionWorkOrderStatus>()){<option value="@s">@WarehouseEPI.Infrastructure.Production.ProductionStateLabels.Label(s)</option>}</select></div><div class="col-6 col-lg-2"><label asp-for="ActiveStageId" class="form-label">Proceso con pendientes</label><select asp-for="ActiveStageId" class="form-select form-select-lg"><option value="">Todos</option>@foreach(var s in Model.Stages.Where(x=>x.IsActive)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-6 col-lg-2"><label asp-for="From" class="form-label">Desde</label><input asp-for="From" class="form-control" type="date"/></div><div class="col-6 col-lg-2"><label asp-for="To" class="form-label">Hasta</label><input asp-for="To" class="form-control" type="date"/></div><div class="col-8 col-lg-3 d-flex align-items-center"><div class="form-check"><input asp-for="AlertsOnly" class="form-check-input"/><label asp-for="AlertsOnly" class="form-check-label">Solo con alertas</label></div></div><div class="col-4 col-lg-2"><button class="btn btn-primary btn-lg w-100">Buscar</button></div></form>
@if(Model.Result.Items.Count==0){<div class="alert alert-info">No hay órdenes con esos filtros. Revisa el folio o solicita que ADMIN libere la orden.</div>}else{<div class="row g-3">@foreach(var x in Model.Result.Items){var pct=x.Target>0?Math.Min(100,x.Received*100/x.Target):0;<div class="col-12 col-lg-6"><article class="card h-100"><div class="card-body d-flex justify-content-between gap-3"><div class="flex-grow-1"><span class="badge text-bg-secondary">@WarehouseEPI.Infrastructure.Production.ProductionStateLabels.Label(x.Status)</span><span class="badge text-bg-secondary ms-1">@(x.Priority==WarehouseEPI.Core.Entities.ProductionSupplyPriority.Urgent?"Urgente":"Normal")</span>@if(x.AlertCount>0){<span class="badge text-bg-warning">@x.AlertCount alertas</span>}<p class="small mt-2 mb-0">Fecha requerida @(x.DueDate?.ToString("dd/MM/yyyy")??"Sin fecha")</p><p class="small">@x.Attention</p><h2 class="h5 mt-2 mb-1">@x.Number</h2><strong>@x.Sku</strong> <span>@x.Description</span>@if(x.UsesBatchTraceability){<small class="d-block text-body-secondary">Seguimiento por lote · @(x.ActiveProcess??"Sin iniciar")</small>}<div class="progress mt-3" role="progressbar" aria-label="Recibido en bodega"><div class="progress-bar" style="width:@pct%"></div></div><p class="mb-0 mt-1">Recibido: <strong>@x.Received.ToString("0.####") de @x.Target.ToString("0.####") @x.Unit</strong></p></div><div><a asp-page="Work" asp-route-id="@x.Id" class="btn btn-primary">@x.NextAction</a></div></div></article></div>}</div><nav class="d-flex justify-content-between align-items-center mt-4" aria-label="Paginación"><a class="btn btn-outline-primary @(Model.Result.Page<=1?"disabled":null)" asp-route-View="@Model.View" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-ActiveStageId="@Model.ActiveStageId" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-AlertsOnly="@Model.AlertsOnly" asp-route-PageNumber="@(Model.Result.Page-1)">Anterior</a><span>Página @Model.Result.Page de @Model.Result.TotalPages · @Model.Result.TotalCount órdenes</span><a class="btn btn-outline-primary @(Model.Result.Page>=Model.Result.TotalPages?"disabled":null)" asp-route-View="@Model.View" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-ActiveStageId="@Model.ActiveStageId" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-AlertsOnly="@Model.AlertsOnly" asp-route-PageNumber="@(Model.Result.Page+1)">Siguiente</a></nav>}</div>

@section Scripts { <script src="~/js/production-supply-queue.js" asp-append-version="true"></script> }

@section Styles { <link rel="stylesheet" href="~/css/production-workspace.css" asp-append-version="true"/> }
