@model WarehouseEPI.Web.Pages.Operations.Production.IndexModel
@using WarehouseEPI.Core.Entities
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> T
@{ string Area(ProductionDailyArea area)=>T[area switch {ProductionDailyArea.Cutting=>"Corte",ProductionDailyArea.Sewing=>"Costura",_=>"Ready to Pack"}]; }
<section class="production-entry mb-4" aria-labelledby="daily-entry-heading"><div class="production-entry__body">
<h2 id="daily-entry-heading" class="h4">@T["Registrar producción"]</h2><p class="production-entry__intro">@T["Selecciona dónde trabajaste, escribe las piezas de cada producto y revisa la captura. El NIP se pide al confirmar."]</p>
<p class="small text-body-secondary">@T["Estas cantidades se agregan a lo ya registrado. Para modificar un total, usa Tabla y balance."]</p>
<div class="production-entry__sticky" role="status" aria-label="@T["Contexto de captura"]">
    <span><small>@T["Fecha efectiva"]</small><strong>@Model.Group.Date.ToString("dd/MM/yyyy")</strong></span>
    <span><small>@T["Semana"]</small><strong>@(Model.CaptureWeek is null ? T["Sin semana"] : $"{Model.CaptureWeek.WeekStart:dd/MM}–{Model.CaptureWeek.WeekEnd:dd/MM}")</strong></span>
    <span><small>@T["Área"]</small><strong>@Area(Model.Group.Area)</strong></span>
    <span><small>@T["Turno"]</small><strong>@(Model.Shifts.FirstOrDefault(x=>x.Id==Model.Group.ShiftId)?.Name ?? T["Sin turno"])</strong></span>
    <span><small>@T["Estado"]</small><strong>@(Model.CaptureWeek is null ? T["Sin semana"] : WarehouseEPI.Web.Production.ProductionDailyText.WeekStatus(T,Model.CaptureWeek.Status))</strong></span>
</div>
@if(Model.Receipt is not null){<section class="alert alert-success production-entry__receipt" role="status" aria-labelledby="capture-receipt-heading"><h3 id="capture-receipt-heading" class="h5">@T["Tanda registrada"]</h3><p class="mb-1">@Model.Receipt.Items.First().Date.ToString("dd/MM/yyyy") · @Area(Model.Receipt.Items.First().Area) · @Model.Shifts.FirstOrDefault(x=>x.Id==Model.Receipt.Items.First().ShiftId)?.Name</p><p class="mb-1">@T["Responsable"]: @Model.Receipt.Responsible · @T["Registro"]: <code>@Model.Receipt.Id</code></p><ul class="mb-2">@foreach(var item in Model.Receipt.Items){<li><strong>@item.Sku</strong> · @item.Quantity.ToString("0.####",CultureInfo.InvariantCulture) @item.Unit</li>}</ul><a asp-page="Index" asp-route-Tab="history" asp-route-WeekId="@Model.CaptureWeek?.Id" asp-route-Day="@Model.Receipt.Items.First().Date.ToString("yyyy-MM-dd")" asp-route-Area="@Model.Receipt.Items.First().Area" asp-route-ShiftId="@Model.Receipt.Items.First().ShiftId" asp-fragment="@($"capture-{Model.Receipt.Items.First().CaptureId}")" class="btn btn-outline-success" data-capture-context-link>@T["Ver registro"]</a></section>}
<h3 class="production-entry__step">1. @T["Fecha, área y turno"]</h3>
@if(!Model.ConfigurationReady){<p class="alert alert-warning">@T["Completa la configuración de áreas y turnos activos antes de capturar."] @if(User.IsInRole("ADMIN")){<a asp-page="/Admin/Production/Schedule" asp-fragment="daily-configuration">@T["Configurar áreas y turnos"]</a>}else{<span>@T["Contacta al administrador para habilitar la captura."]</span>}</p>}
<form method="get" class="row g-3 production-entry__context" data-context-form>
<input name="Tab" type="hidden" value="capture"/><input name="WeekId" type="hidden" value="@Model.WeekId"/>
<input name="Sku" value="@Model.Sku" type="hidden"/><input name="Reference" value="@Model.Reference" type="hidden"/>
<div class="col-12 col-md-4"><label for="group-date" class="form-label">@T["Fecha efectiva"]</label><input id="group-date" name="Day" value="@Model.Group.Date.ToString("yyyy-MM-dd")" type="date" class="form-control form-control-lg" data-refresh-context/></div>
<div class="col-6 col-md-4"><label for="group-area" class="form-label">@T["Área"]</label><select id="group-area" name="Area" class="form-select form-select-lg" data-refresh-context>@foreach(var area in Enum.GetValues<ProductionDailyArea>()){<option value="@area" selected="@(area==Model.Group.Area)">@Area(area)</option>}</select></div>
<div class="col-6 col-md-4"><label for="group-shift" class="form-label">@T["Turno"]</label><select id="group-shift" name="ShiftId" class="form-select form-select-lg" data-refresh-context>@foreach(var shift in Model.Shifts){<option value="@shift.Id" selected="@(shift.Id==Model.Group.ShiftId)">@shift.Name</option>}</select></div>
</form>
@if(Model.CaptureWeek is not null){<p class="production-entry__week">@T["Semana"]: @Model.CaptureWeek.WeekStart.ToString("dd/MM/yyyy")–@Model.CaptureWeek.WeekEnd.ToString("dd/MM/yyyy") · <strong>@WarehouseEPI.Web.Production.ProductionDailyText.WeekStatus(T,Model.CaptureWeek.Status)</strong></p>}
@if(Model.CaptureContextMessage is not null){<div class="alert alert-warning" role="status">@T[Model.CaptureContextMessage]
@if(User.IsInRole("ADMIN")){<a class="d-block mt-2" asp-page="/Admin/Production/Schedule" asp-route-WeekId="@Model.CaptureWeek?.Id" data-capture-context-link>@T["Programa semanal"]</a>}
</div>}
<form id="capture-group" method="post" autocomplete="off" data-capture-group data-unsaved-message="@T["Hay cantidades sin confirmar. ¿Quieres descartarlas?"]" data-quick-mode-label="@T["Captura rápida"]" data-list-mode-label="@T["Lista de pendientes"]">
<input name="Sku" value="@Model.Sku" type="hidden"/><input name="Reference" value="@Model.Reference" type="hidden"/>
<input asp-for="WeekId" type="hidden"/><input asp-for="Group.OperationId" type="hidden"/><input asp-for="Group.Fingerprint" type="hidden"/><input asp-for="Group.Date" type="hidden"/><input asp-for="Group.Area" type="hidden"/><input asp-for="Group.ShiftId" type="hidden"/><input asp-for="Group.Mode" type="hidden"/>
<fieldset disabled="@(!Model.ConfigurationReady || Model.CaptureContextMessage is not null)">
<button type="submit" asp-page-handler="GroupMode" hidden data-group-mode-submit></button>
<h3 class="production-entry__step">2. @T["Escribe las piezas a agregar"]</h3>
<div class="production-entry__modes d-flex flex-wrap gap-2 mb-3" role="group" aria-label="@T["Forma de captura"]"><button type="button" class="btn btn-outline-primary" data-capture-mode="list" aria-pressed="true">@T["Lista de pendientes"]</button><button type="button" class="btn btn-outline-primary" data-capture-mode="quick" aria-pressed="false">@T["Captura rápida"]</button></div>
<p data-quick-guidance hidden class="small text-body-secondary">@T["Busca o escanea un SKU para agregarlo a la tanda."]</p>
<div class="row g-2 mb-3 production-entry__add">
<div class="col-md-9 production-entry__picker" data-daily-product-field data-url="@Url.Page("Index", "DailyProducts")" data-resolve-url="@Url.Page("/Operations/Lookup", "ResolveProduct")"
     data-planned="@T["Programados esta semana"]" data-pending="@T["Pendientes anteriores"]" data-other="@T["Otros productos activos"]"
     data-more="@T["Cargar más"]" data-empty="@T["No hay coincidencias. Busca otro SKU o descripción."]" data-error="@T["No se pudieron consultar los productos. Vuelve a buscar."]">
<label for="group-add-product" class="form-label">@T["Buscar o agregar producto"]</label>
<input asp-for="Group.AddProductId" type="hidden" data-product-id/>
<input id="group-add-product" type="search" class="form-control form-control-lg" data-product-input autocomplete="off" autocapitalize="characters" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="group-product-results"/>
<div id="group-product-results" class="list-group production-entry__results" role="listbox" data-product-results></div>
<p class="small text-body-secondary mt-2 mb-0">@T["Primero los productos de la semana. Escribe dos caracteres para buscar también en el catálogo."]</p>
</div>
<div class="col-md-3 d-grid align-items-center"><button asp-page-handler="GroupAdd" class="btn btn-outline-primary" data-daily-product-add>@T["Agregar producto"]</button></div>
</div>
<p class="production-entry__guidance">@T["El pendiente es una referencia. Puedes registrar extras o piezas cuya etapa anterior aún no se ha capturado."]</p>
@if(Model.Group.Rows.Count>0){
<p class="production-entry__count" role="status" data-list-count>@Area(Model.Group.Area) · @T["Productos mostrados: {0}",Model.Group.Rows.Count]</p>
<p class="small text-body-secondary">@T["Vacío o cero no se incluye. Hasta 100 productos por tanda; usa el buscador para acotar."]</p>
<div class="production-entry__rows"><table class="table align-middle production-entry__table" role="table"><thead><tr role="row"><th>@T["Producto"]</th><th>@T["Registrado en este día y turno"]</th><th>@T["Piezas a agregar"]</th><th>@T["Total resultante · vista previa"]</th><th>@T["Referencia"]</th></tr></thead><tbody role="rowgroup">
@for(var i=0;i<Model.Group.Rows.Count;i++){
var row=Model.Group.Rows[i];var available=Model.Available.FirstOrDefault(x=>x.ProductId==row.ProductId);var registered=Model.RegisteredInShift.GetValueOrDefault(row.ProductId);var meta=Model.CaptureProducts.GetValueOrDefault(row.ProductId);
<tr role="row" data-product-row="@row.ProductId" data-unit="@meta?.Unit" data-focus-product="@(Model.FocusProductId==row.ProductId ? "true" : null)"><td role="cell" class="production-entry__product"><input asp-for="Group.Rows[i].ProductId" type="hidden"/><input asp-for="Group.Rows[i].Sku" type="hidden"/><strong>@(available?.Sku??row.Sku)</strong></td><td role="cell" class="production-entry__registered" data-label="@T["Registrado en este día y turno"]" data-registered="@registered.ToString("0.####",CultureInfo.InvariantCulture)">@registered.ToString("0.####",CultureInfo.InvariantCulture) <small>@meta?.Unit</small></td>
<td role="cell" class="production-entry__quantity" data-label="@T["Piezas a agregar"]"><label asp-for="Group.Rows[i].Quantity" class="visually-hidden">@T["Piezas a agregar"] @row.Sku</label><input asp-for="Group.Rows[i].Quantity" class="form-control form-control-lg" inputmode="decimal" data-group-quantity/><span asp-validation-for="Group.Rows[i].Quantity" class="text-danger"></span></td>
<td role="cell" data-label="@T["Total resultante · vista previa"]"><strong data-result-total>@registered.ToString("0.####",CultureInfo.InvariantCulture)</strong> <small>@meta?.Unit</small><small class="d-block text-body-secondary">@T["Vista previa; se valida al confirmar"]</small></td><td role="cell" data-label="@T["Referencia"]"><small>@T["Pendiente registrado"]: @((available?.Available??0).ToString("0.####",CultureInfo.InvariantCulture))</small>@if(available?.ToReconcile>0){<small class="d-block text-warning-emphasis">@T["Por conciliar"]: @available.ToReconcile.ToString("0.####",CultureInfo.InvariantCulture)</small>}<details class="production-entry__notes"><summary>@T["Notas"]</summary><label asp-for="Group.Rows[i].Notes" class="visually-hidden">@T["Notas"] @row.Sku</label><input asp-for="Group.Rows[i].Notes" class="form-control" maxlength="500"/></details></td></tr>}
</tbody></table></div>
}
<div class="production-entry__actions" data-capture-actions data-count-label="@T["Productos con cantidad"]"><span data-capture-count>@T["Productos con cantidad"]: 0</span><span data-capture-units></span><button asp-page-handler="GroupPreview" class="btn btn-primary btn-lg" data-group-preview disabled="@(Model.Group.Rows.Count == 0)">@T["Revisar captura"]</button></div>
@if(Model.CaptureEmptyMessage is not null){<div class="alert alert-info" role="status"><strong>@Area(Model.Group.Area)</strong><p class="mt-2">@T[Model.CaptureEmptyMessage]</p>
@foreach(var availableArea in Model.OtherAvailableAreas){<a class="btn btn-outline-primary me-2 mb-2" asp-page="Index" asp-route-Tab="capture" asp-route-Day="@Model.Group.Date.ToString("yyyy-MM-dd")" asp-route-Area="@availableArea.Key" asp-route-ShiftId="@Model.Group.ShiftId" data-capture-context-link>@Area(availableArea.Key) · @T["Productos disponibles: {0}",availableArea.Value]</a>}
<a class="btn btn-outline-secondary" asp-page="Index" asp-route-Tab="balance" asp-route-WeekId="@Model.CaptureWeek?.Id" data-capture-context-link>@T["Balance"]</a>
</div>}
@if(Model.GroupPreview is not null){<section class="production-entry__review mt-4" aria-labelledby="group-review-heading" tabindex="-1" data-group-review><h3 id="group-review-heading" class="production-entry__step">3. @T["Revisar tanda"]</h3><p>@Model.Group.Date.ToString("dd/MM/yyyy") · @Area(Model.Group.Area) · @Model.Shifts.FirstOrDefault(x=>x.Id==Model.Group.ShiftId)?.Name</p>
@foreach(var preview in Model.GroupPreview.Products){var selectedRow=Model.Group.Rows.FirstOrDefault(x=>x.Sku==preview.Product);var registered=selectedRow is null ? 0 : Model.RegisteredInShift.GetValueOrDefault(selectedRow.ProductId);<div class="production-entry__review-product"><div class="d-flex justify-content-between align-items-baseline gap-3"><strong>@preview.Product</strong><span class="production-entry__total">@preview.Requested.ToString("0.####",CultureInfo.InvariantCulture) <small>@T["Piezas a agregar"]</small></span></div><dl class="production-entry__figures"><div><dt>@T["Registrado en este día y turno"]</dt><dd>@registered.ToString("0.####",CultureInfo.InvariantCulture)</dd></div><div><dt>@T["Piezas a agregar"]</dt><dd>@preview.Requested.ToString("0.####",CultureInfo.InvariantCulture)</dd></div><div><dt>@T["Total resultante · vista previa"]</dt><dd>@((registered + preview.Requested).ToString("0.####",CultureInfo.InvariantCulture))</dd></div><div><dt>@T["Pendiente registrado"]</dt><dd>@preview.Available.ToString("0.####",CultureInfo.InvariantCulture)</dd></div><div><dt>@T["Extras"]</dt><dd>@preview.Extra.ToString("0.####",CultureInfo.InvariantCulture)</dd></div><div><dt>@T["Por conciliar"]</dt><dd>@preview.ToReconcile.ToString("0.####",CultureInfo.InvariantCulture)</dd></div></dl><details><summary>@T["Ver reparto por órdenes"]</summary><ul>@foreach(var allocation in preview.Allocations){<li>@allocation.OrderNumber · @allocation.Quantity.ToString("0.####",CultureInfo.InvariantCulture)</li>}</ul></details></div>}
@foreach(var error in Model.GroupPreview.Errors){<p class="text-danger">@WarehouseEPI.Web.Production.ProductionDailyText.Message(T,error)</p>}
@if(Model.GroupPreview.CanConfirm){<label asp-for="Group.Pin" class="form-label">@T["NIP responsable"]</label><input asp-for="Group.Pin" type="password" inputmode="numeric" maxlength="8" class="form-control form-control-lg mb-2 production-entry__pin" autocomplete="off"/><button asp-page-handler="GroupConfirm" class="btn btn-success btn-lg" data-group-confirm>@T["Confirmar tanda con NIP"]</button>}
</section>}
</fieldset></form></div></section>
