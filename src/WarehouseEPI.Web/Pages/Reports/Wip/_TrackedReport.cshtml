@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Reports.Wip.IndexModel
<section class="mb-4" aria-labelledby="wip-current-title">
    <h2 class="h4" id="wip-current-title">@CatTexts["Entregas y pendiente documental"]</h2>
    <p>@CatTexts["El pendiente documental no representa existencias físicas ni material disponible en almacén."]</p>
    <div class="table-responsive"><table class="table align-middle report-cards">
        <thead><tr><th scope="col">@CatTexts["Fecha / folio"]</th><th scope="col">WIP</th><th scope="col">@CatTexts["Producto"]</th><th scope="col">@CatTexts["Cantidad documentada"]</th><th scope="col">@CatTexts["Uso registrado"]</th><th scope="col">@CatTexts["Merma"]</th><th scope="col">@CatTexts["A bodega"]</th><th scope="col">@CatTexts["A proveedor"]</th><th scope="col">@CatTexts["Pendiente documental"]</th></tr></thead>
        <tbody>
        @if(Model.TrackedReport.Inventory.Count == 0){<tr class="report-empty-row"><td colspan="9">@CatTexts["No hay entregas documentales con los filtros seleccionados."]</td></tr>}
        @foreach(var row in Model.TrackedReport.Inventory)
        {
            <tr>
                <td data-label="@CatTexts["Fecha / folio"]">@row.UpdatedAt.ToString("dd/MM/yyyy HH:mm")<div><a asp-page="Document" asp-route-id="@row.DocumentId">@row.DocumentId.ToString()[..8]</a></div>@if(row.IsOpening){<span class="badge text-bg-secondary">@CatTexts["Apertura del corte"]</span>}</td>
                <td data-label="WIP">@row.WipArea</td><td data-label="@CatTexts["Producto"]"><strong>@row.ProductSku</strong><div>@row.Unit · @row.Responsible</div></td>
                <td data-label="@CatTexts["Cantidad documentada"]">@row.Delivered.ToString("0.####")</td><td data-label="@CatTexts["Uso registrado"]">@row.Used.ToString("0.####")</td><td data-label="@CatTexts["Merma"]">@row.Scrapped.ToString("0.####")</td><td data-label="@CatTexts["A bodega"]">@row.WarehouseReturned.ToString("0.####")</td><td data-label="@CatTexts["A proveedor"]">@row.SupplierReturned.ToString("0.####")</td><td data-label="@CatTexts["Pendiente documental"]"><strong>@row.Quantity.ToString("0.####")</strong></td>
            </tr>
        }
        </tbody>
    </table></div>
</section>
