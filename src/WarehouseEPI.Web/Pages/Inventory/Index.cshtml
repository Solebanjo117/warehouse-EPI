@page "/Inventory"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@using WarehouseEPI.Infrastructure.Inventory
@model WarehouseEPI.Web.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = CatTexts["Existencias"].Value;
    var hasResult = Model.Product is not null || Model.Location is not null;
    var filter = Model.Filter switch
    {
        InventoryPositionFilter.WithBalance => "balance",
        InventoryPositionFilter.Negative => "negative",
        InventoryPositionFilter.AssignedZero => "assigned-zero",
        InventoryPositionFilter.UnassignedBalance => "unassigned-balance",
        _ => "all"
    };
    var isAdmin = User.IsInRole("ADMIN");
}

@section Styles {
    <link rel="stylesheet" href="~/css/inventory-index.css" asp-append-version="true" />
}

<div class="inventory-workspace" data-inventory-workspace data-lookup-url="@Url.Page("/Operations/Lookup")">
    <header class="inventory-page-header">
        <div>
            <span class="eyebrow">@CatTexts["Consulta de almacén"]</span>
            <h1 class="h2 mb-1">@CatTexts["Existencias"]</h1>
            <p class="mb-0">@CatTexts["Consulta saldos por producto o ubicación"]</p>
        </div>
    </header>

    <form method="get" class="inventory-search-card" data-inventory-search-form novalidate>
        <label for="inventory-code" class="form-label fw-semibold">@CatTexts["Producto o ubicación"]</label>
        <div class="input-group input-group-lg entry-capture-input">
            <input id="inventory-code" name="code" class="form-control" type="search" autocomplete="off" autocapitalize="characters" placeholder="@CatTexts["Escanea o escribe SKU, barras o ubicación"]" aria-describedby="inventory-search-feedback" autofocus required data-inventory-search-input />
            <button type="button" class="btn btn-outline-secondary" data-inventory-camera aria-label="@CatTexts["Escanear con cámara"]" title="@CatTexts["Escanear con cámara"]"><svg aria-hidden="true" viewBox="0 0 16 16" width="1.2em" height="1.2em" fill="currentColor"><path d="M1 4.5A1.5 1.5 0 0 1 2.5 3h1.586l.707-.707A1 1 0 0 1 5.5 2h5a1 1 0 0 1 .707.293L11.914 3H13.5A1.5 1.5 0 0 1 15 4.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 11.5zm7 1a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5m0 1a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3" /></svg></button>
            <button class="btn btn-primary" type="submit">@CatTexts["Consultar"]</button>
        </div>
        <div id="inventory-search-feedback" class="inventory-search-feedback d-none" role="status" aria-live="polite" data-inventory-feedback></div>
        <div class="inventory-search-results" data-inventory-search-results></div>
    </form>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-warning mt-3" role="alert">@Model.ErrorMessage</div>
    }

    @if (hasResult)
    {
        <section class="inventory-identity operation-card">
            <div>
                @if (Model.Product is not null)
                {
                    <span class="inventory-eyebrow">@CatTexts["Producto"]</span><h2 class="h3 mb-1">@if (isAdmin) { <a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@Model.Product.Id">@Model.Product.Sku</a> } else { @Model.Product.Sku }</h2><p class="mb-0 text-muted">@(Model.Product.Description ?? CatTexts["Sin descripción"].Value)</p>
                    @if (!Model.Product.IsActive) { <span class="inv-chip is-muted mt-2">@CatTexts["Producto inactivo"]</span> }
                }
                else if (Model.Location is not null)
                {
                    <span class="inventory-eyebrow">@CatTexts["Ubicación"]</span><h2 class="h3 mb-1"><a asp-page="/Locations/Details" asp-route-id="@Model.Location.Id">@Model.Location.Code</a></h2><p class="mb-0 text-muted">@(Model.Location.Description ?? CatTexts["Ubicación operativa"].Value)</p>
                    @if (!Model.Location.IsActive) { <span class="inv-chip is-muted mt-2">@CatTexts["Ubicación inactiva"]</span> }
                    else if (Model.Location.IsBlocked) { <span class="inv-chip is-warning mt-2">@CatTexts["Ubicación bloqueada"]</span> }
                }
            </div>
            @if (Model.Product is not null) { <div class="inventory-total"><span>@CatTexts["Total global"]</span><strong>@Model.ProductTotal.ToString("0.####") @Model.Product.UnitCode</strong></div> }
            <div class="inventory-identity-actions">
                @if (Model.Product is not null)
                {
                    <a asp-page="/Reports/Kardex/Index" asp-route-sku="@Model.Product.Sku" asp-route-locationId="@Model.HighlightLocationId" class="btn btn-outline-info">@CatTexts["Kardex"]</a>
                    @if (isAdmin)
                    {
                        <a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@Model.Product.Id" class="btn btn-outline-primary">@CatTexts["Ficha"]</a>
                        <a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@Model.Product.Sku" class="btn btn-outline-secondary">@CatTexts["Movimientos"]</a>
                        <a asp-page="/Locations/Index" asp-route-search="@Model.Product.Sku" asp-route-status="all" asp-route-viewMode="map" class="btn btn-outline-secondary">@CatTexts["Croquis"]</a>
                    }
                }
                else if (isAdmin && Model.Location is not null)
                {
                    <a asp-page="/Locations/Details" asp-route-id="@Model.Location.Id" class="btn btn-outline-primary">@CatTexts["Ficha"]</a>
                    <a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@Model.Location.Code" class="btn btn-outline-secondary">@CatTexts["Movimientos"]</a>
                    <a asp-page="/Locations/Index" asp-route-status="all" asp-route-viewMode="map" asp-route-highlightLocationId="@Model.Location.Id" class="btn btn-outline-secondary">@CatTexts["Croquis"]</a>
                }
                <a asp-page="Index" class="inventory-identity-reset">@CatTexts["Consultar otro código"]</a>
            </div>
        </section>

        <nav class="inventory-filter-cards inventory-filter-chips" aria-label="@CatTexts["Resumen y filtros de existencias"]">
            @foreach (var item in new[]
            {
                (Code: "all", Label: Model.Product is not null ? CatTexts["Todas las ubicaciones"].Value : CatTexts["Todos los productos"].Value, Count: Model.Results.Summary.Positions),
                (Code: "balance", Label: CatTexts["Con saldo"].Value, Count: Model.Results.Summary.WithBalance),
                (Code: "negative", Label: CatTexts["Negativos"].Value, Count: Model.Results.Summary.Negative),
                (Code: "assigned-zero", Label: CatTexts["Asignados en cero"].Value, Count: Model.Results.Summary.AssignedZero),
                (Code: "unassigned-balance", Label: CatTexts["Saldo sin asignación"].Value, Count: Model.Results.Summary.UnassignedBalances)
            })
            {
                <a class="@(filter == item.Code ? "active" : null)" aria-current="@(filter == item.Code ? "page" : null)" asp-route-productId="@Model.Product?.Id" asp-route-locationId="@Model.Location?.Id" asp-route-filter="@item.Code" asp-route-highlightLocationId="@Model.HighlightLocationId" asp-route-highlightProductId="@Model.HighlightProductId"><strong>@item.Count</strong><span>@item.Label</span></a>
            }
        </nav>

        <section class="inventory-positions" aria-live="polite">
            <div class="inventory-position-head" aria-hidden="true"><span>@CatTexts["Producto"]</span><span>@CatTexts["Ubicación"]</span><span>@CatTexts["Estado"]</span><span class="text-end">@CatTexts["Cantidad"]</span></div>
            @if (Model.Results.Items.Count == 0)
            {
                <div class="inventory-empty"><strong>@CatTexts["Ninguna posición coincide con este filtro."]</strong><span>@CatTexts["Vuelve al filtro completo o escanea otro código."]</span></div>
            }
            @foreach (var position in Model.Results.Items)
            {
                var highlighted = position.LocationId == Model.HighlightLocationId || position.ProductId == Model.HighlightProductId;
                <article class="inventory-position @(highlighted ? "is-highlighted" : null) @(position.IsNegative ? "is-negative" : null)" tabindex="@(highlighted ? "-1" : null)" data-inventory-highlighted="@(highlighted ? "true" : null)">
                    @if (highlighted) { <span class="visually-hidden">@CatTexts["Resultado destacado desde Alertas."]</span> }
                    <div class="inventory-position-product"><span class="inventory-card-label">@CatTexts["Producto"]</span>@if (isAdmin) { <a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@position.ProductId" class="fw-bold">@position.ProductSku</a> } else { <strong>@position.ProductSku</strong> }<small>@(position.ProductDescription ?? CatTexts["Sin descripción"].Value)</small>@if (!position.ProductIsActive) { <span class="inv-chip is-muted">@CatTexts["Producto inactivo"]</span> }</div>
                    <div class="inventory-position-location"><span class="inventory-card-label">@CatTexts["Ubicación"]</span><a asp-page="/Locations/Details" asp-route-id="@position.LocationId" class="fw-bold">@position.LocationCode</a><small>@(position.LocationDescription ?? CatTexts["Ubicación operativa"].Value)</small>@if (!position.LocationIsActive) { <span class="inv-chip is-muted">@CatTexts["Ubicación inactiva"]</span> } else if (position.LocationIsBlocked) { <span class="inv-chip is-warning">@CatTexts["Ubicación bloqueada"]</span> }</div>
                    <div class="inventory-position-state"><span class="inventory-card-label">@CatTexts["Estado"]</span>@if (position.HasActiveAssignment && position.Quantity == 0) { <span class="inv-chip is-muted">@CatTexts["Asignado · saldo cero"]</span> } else if (position.HasActiveAssignment) { <span class="inv-state-normal">@CatTexts["Asignado · con saldo"]</span> } else { <span class="inv-chip is-warning">@CatTexts["Saldo sin asignación"]</span> } @if (position.IsNegative) { <span class="inv-chip is-danger">@CatTexts["Saldo negativo"]</span> }</div>
                    <div class="inventory-position-quantity @(position.IsNegative ? "is-negative" : null)"><span class="inventory-card-label">@CatTexts["Cantidad"]</span><strong>@position.Quantity.ToString("0.####") @position.UnitCode</strong></div>
                </article>
            }
        </section>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4" aria-label="@CatTexts["Paginación de existencias"]"><ul class="pagination justify-content-center"><li class="page-item @(Model.Results.PageNumber <= 1 ? "disabled" : null)"><a class="page-link" asp-route-productId="@Model.Product?.Id" asp-route-locationId="@Model.Location?.Id" asp-route-filter="@filter" asp-route-pageNumber="@(Model.Results.PageNumber - 1)" asp-route-highlightLocationId="@Model.HighlightLocationId" asp-route-highlightProductId="@Model.HighlightProductId">@CatTexts["Anterior"]</a></li><li class="page-item disabled"><span class="page-link">@CatTexts["{0} de {1}", Model.Results.PageNumber, Model.TotalPages]</span></li><li class="page-item @(Model.Results.PageNumber >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-route-productId="@Model.Product?.Id" asp-route-locationId="@Model.Location?.Id" asp-route-filter="@filter" asp-route-pageNumber="@(Model.Results.PageNumber + 1)" asp-route-highlightLocationId="@Model.HighlightLocationId" asp-route-highlightProductId="@Model.HighlightProductId">@CatTexts["Siguiente"]</a></li></ul></nav>
        }
    }

    <div class="modal fade" id="inventory-camera-scanner" tabindex="-1" aria-labelledby="inventory-camera-scanner-title" aria-hidden="true" data-inventory-camera-modal><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="inventory-camera-scanner-title">@CatTexts["Escanear código"]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@CatTexts["Cerrar"]"></button></div><div class="modal-body"><div class="camera-preview" data-inventory-camera-preview><video class="w-100" autoplay muted playsinline data-inventory-camera-video></video></div><p class="mb-0 mt-3" role="status" aria-live="polite" data-inventory-camera-status>@CatTexts["Preparando cámara…"]</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary btn-lg d-none" data-camera-switch>@CatTexts["Cambiar cámara"]</button><label class="btn btn-outline-primary btn-lg mb-0" for="inventory-camera-photo">@CatTexts["Tomar foto"]</label><input id="inventory-camera-photo" class="visually-hidden" type="file" accept="image/*" capture="environment" data-inventory-camera-photo /><button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">@CatTexts["Cancelar"]</button></div></div></div></div>
</div>

@section Scripts {
    <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script>
    <script src="~/js/operations.js" asp-append-version="true"></script>
}
