@page "{id:guid}"
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Operations.ReceiptModel
@{
    ViewData["Title"] = "Operación confirmada";
    var typeName = Model.Receipt.Purpose switch
    {
        InventoryMovementPurpose.ProductionIssue => "Surtimiento WIP",
        InventoryMovementPurpose.WipWarehouseReturn => "Devolución WIP a bodega",
        InventoryMovementPurpose.WipConsumption => "Consumo WIP",
        InventoryMovementPurpose.WipSupplierReturn => "Devolución WIP a proveedor",
        InventoryMovementPurpose.DocumentReceipt => "Recepción documental",
        _ => Model.Receipt.Type switch
    {
        InventoryMovementType.Entry => "Entrada",
        InventoryMovementType.Exit => "Salida",
        InventoryMovementType.Transfer => "Transferencia",
        InventoryMovementType.Adjustment => "Ajuste",
        _ => "Movimiento"
    }};
    var newPage = Model.Receipt.Purpose switch
    {
        InventoryMovementPurpose.ProductionIssue => "/Operations/Exit",
        InventoryMovementPurpose.WipWarehouseReturn => "/Operations/WipProcess",
        InventoryMovementPurpose.WipConsumption => "/Operations/WipProcess",
        InventoryMovementPurpose.WipSupplierReturn => "/Operations/WipProcess",
        InventoryMovementPurpose.DocumentReceipt => "/Operations/Receiving/Index",
        _ => Model.Receipt.Type switch
    {
        InventoryMovementType.Entry => "/Operations/Entry",
        InventoryMovementType.Exit => "/Operations/Exit",
        InventoryMovementType.Transfer => "/Operations/Transfer",
        InventoryMovementType.Adjustment => "/Operations/Adjustment",
        _ => "/Index"
    }};
    var newMode = Model.Receipt.Purpose == InventoryMovementPurpose.ProductionIssue ? "wip" : null;
    var canGeneratePalletPlate = Model.Receipt.Type == InventoryMovementType.Entry &&
        (Model.Receipt.Correction is null || Model.Receipt.Correction.ReplacementMovementId == Model.Receipt.MovementId);
}

<div class="receipt-shell">
    <div class="receipt-status @(Model.Receipt.HasNegativeBalance ? "receipt-warning" : "receipt-success")">
        <span class="receipt-icon" aria-hidden="true">@(Model.Receipt.HasNegativeBalance ? "!" : "✓")</span>
        <div>
            <h1 class="h3 mb-1">@typeName confirmada</h1>
            <p class="mb-0">
                @if (Model.Receipt.HasNegativeBalance)
                {
                    <text>La operación se guardó, pero existe un saldo negativo.</text>
                }
                else
                {
                    <text>El inventario se actualizó correctamente.</text>
                }
            </p>
        </div>
    </div>

    <section class="operation-card mt-4">
        <div class="receipt-meta">
            <div><span>Responsable</span><strong>@Model.Receipt.ResponsibleName</strong></div>
            <div><span>Fecha</span><strong>@Model.OccurredAtWarehouseTime.ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div><span>Folio</span><strong class="receipt-id">@Model.Receipt.MovementId</strong></div>
            @if (Model.Receipt.Reference is not null)
            {
                <div><span>Referencia</span><strong>@Model.Receipt.Reference</strong></div>
            }
        </div>
    </section>
    @if (Model.Receipt.Purpose == InventoryMovementPurpose.ProductionIssue)
    {
        <section class="operation-card border-warning"><strong>Rack → @Model.Receipt.OperationalAreaCode</strong><p class="mb-0">El surtimiento transfirió existencias al WIP y conservó los lotes del origen.</p></section>
    }
    @if (Model.ReceivingDocument is not null)
    {
        <section class="operation-card border-primary">
            <h2 class="h5">Documento relacionado</h2>
            <p class="mb-2"><strong>@Model.ReceivingDocument.DocumentLabel</strong> · @Model.ReceivingDocument.Status</p>
            @if (Model.ReceivingDocument.ExternalLotReferences.Count > 0) { <p class="small mb-2">Lote/rollo externo: @string.Join(", ", Model.ReceivingDocument.ExternalLotReferences)</p> }
            @if (Model.ReceivingDocument.DifferenceNotes is not null) { <p class="small text-warning">@Model.ReceivingDocument.DifferenceNotes</p> }
            <a class="btn btn-outline-primary" asp-page="/Operations/Receiving/Details" asp-route-id="@Model.ReceivingDocument.DocumentId">Ver recepción</a>
        </section>
    }

    @if (Model.Receipt.Correction is not null)
    {
        <section class="operation-card border-warning">
            <h2 class="h5">Comprobante relacionado con una corrección</h2>
            <p class="mb-2">@Model.Receipt.Correction.Reason</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" asp-page="/Operations/Receipt" asp-route-id="@Model.Receipt.Correction.OriginalMovementId">Original</a>
                <a class="btn btn-outline-secondary" asp-page="/Operations/Receipt" asp-route-id="@Model.Receipt.Correction.ReversalMovementId">Reverso</a>
                @if (Model.Receipt.Correction.ReplacementMovementId is Guid replacement)
                { <a class="btn btn-outline-secondary" asp-page="/Operations/Receipt" asp-route-id="@replacement">Reemplazo</a> }
            </div>
        </section>
    }

    @foreach (var line in Model.Receipt.Lines)
    {
        <section class="operation-card">
            <h2 class="h5 mb-1">@line.ProductSku</h2>
            @if (line.ProductDescription is not null)
            {
                <p class="text-muted">@line.ProductDescription</p>
            }
            <p class="receipt-quantity"><strong>@line.Quantity.ToString("0.####") @line.UnitCode</strong></p>
            @if (line.SourceLocationCode is not null || line.DestinationLocationCode is not null)
            {
                <p class="receipt-route"><strong>@(line.SourceLocationCode ?? "—")</strong><span aria-hidden="true"> → </span><strong>@(line.DestinationLocationCode ?? Model.Receipt.OperationalAreaCode ?? "—")</strong></p>
            }
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Ubicación</th><th>Anterior</th><th>Cambio</th><th>Final</th></tr></thead>
                    <tbody>
                    @foreach (var change in line.Changes)
                    {
                        <tr class="@(change.ResultingQuantity < 0 ? "table-warning" : null)">
                            <td><strong>@change.LocationCode</strong></td>
                            <td>@change.PreviousQuantity.ToString("0.####")</td>
                            <td>@(change.DeltaQuantity > 0 ? "+" : null)@change.DeltaQuantity.ToString("0.####")</td>
                            <td><strong>@change.ResultingQuantity.ToString("0.####")</strong></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.Receipt.Notes is not null)
    {
        <section class="operation-card"><strong>Observaciones / motivo</strong><p class="mb-0 mt-1">@Model.Receipt.Notes</p></section>
    }
    @if (canGeneratePalletPlate)
    {
        <div class="operation-actions"><a class="btn btn-outline-primary btn-lg" asp-page="/Operations/PalletLabels/Index" asp-route-id="@Model.Receipt.MovementId">Generar placa de pallet</a></div>
    }

    <div class="operation-actions">
        <a asp-page="/Index" class="btn btn-outline-secondary btn-lg">Menú</a>
        <a asp-page="@newPage" asp-route-mode="@newMode" class="btn btn-primary btn-lg flex-grow-1">Nueva operación</a>
    </div>
</div>
