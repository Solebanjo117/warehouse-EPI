@page
@model WarehouseEPI.Web.Pages.Operations.ProductionSupply.IndexModel
@using WarehouseEPI.Core.Entities
@{ ViewData["Title"] = "Surtimientos a producción"; }

<div class="supply-queue" data-supply-queue data-snapshot-url="@Url.Page(null, "Snapshot")" data-pending-orders="@Model.PendingOrders">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><span class="eyebrow">Operación</span><h1 class="h2 mb-1">Surtimientos a producción</h1><p class="text-body-secondary mb-0">Prepara lo pendiente y entrégalo al WIP indicado por la orden.</p></div>
        <div class="supply-count"><strong>@Model.PendingOrders</strong><span>órdenes pendientes</span></div>
    </header>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert" tabindex="-1">@error</div> }
    <form method="get" class="card card-body mb-4 supply-filters">
        <div><label asp-for="Search" class="form-label">Orden o producto</label><input asp-for="Search" class="form-control form-control-lg" type="search" autocomplete="off" /></div>
        <div><label asp-for="Condition" class="form-label">Condición</label><select asp-for="Condition" class="form-select form-select-lg"><option value="">Todas</option><option value="shortage">Con faltante</option><option value="partial">Parciales</option><option value="blocked">Pausadas</option></select></div>
        <button class="btn btn-outline-primary" type="submit">Consultar</button>
    </form>
    @if (Model.Rows.Count == 0)
    {
        <div class="card card-body text-center py-5"><h2 class="h4">Sin surtimientos pendientes</h2><p class="text-body-secondary mb-0">Cambia los filtros o espera a que se libere una orden nueva.</p></div>
    }
    else
    {
        <div class="supply-list">
        @foreach (var row in Model.Rows)
        {
            var blocked = row.OrderStatus == ProductionWorkOrderStatus.Paused;
            <article class="card supply-card @(row.Priority == ProductionSupplyPriority.Urgent ? "supply-card-urgent" : null)">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-2"><div><span class="badge text-bg-@(row.Priority == ProductionSupplyPriority.Urgent ? "danger" : "secondary")">@row.Priority</span><h2 class="h4 mt-2 mb-1">@row.WorkOrderNumber · @row.FinishedProduct</h2><p class="mb-0 text-body-secondary">@row.Process · destino @row.Destination · @(row.DueDate?.ToString("dd/MM/yyyy") ?? "sin fecha")</p></div><strong class="supply-material">@row.Material</strong></div>
                    <dl class="supply-quantities"><div><dt>Requerido</dt><dd>@row.Required @row.Unit</dd></div><div><dt>Entregado</dt><dd>@row.Delivered @row.Unit</dd></div><div><dt>Reservado</dt><dd>@row.Reserved @row.Unit</dd></div><div><dt>Pendiente</dt><dd>@row.Pending @row.Unit</dd></div><div class="@(row.Shortage > 0 ? "text-danger" : null)"><dt>Faltante</dt><dd>@row.Shortage @row.Unit</dd></div></dl>
                    @if (blocked) { <div class="alert alert-warning mb-3">Orden pausada. La entrega se habilitará al reanudarla.</div> }
                    @if (row.Problem is not null) { <div class="alert alert-warning mb-3"><strong>Problema reportado:</strong> @row.Problem</div> }
                    @if (row.LastParticipant is not null) { <p class="small text-body-secondary">Preparación registrada por @row.LastParticipant. Otro operador puede continuar.</p> }
                    <div class="supply-actions">
                        @if (!blocked)
                        {
                            <a class="btn btn-primary" asp-page="/Operations/Exit" asp-route-mode="wip" asp-route-productId="@row.ProductId" asp-route-sourceLocationId="@row.SuggestedSourceLocationId" asp-route-destinationLocationId="@row.DestinationLocationId" asp-route-workOrderId="@row.WorkOrderId" asp-route-workOrderStageId="@row.WorkOrderStageId" asp-route-supplyRequestLineId="@row.LineId" asp-route-expectedSupplyVersion="@row.RequestVersion" asp-route-expectedWorkOrderVersion="@row.WorkOrderVersion">Preparar entrega</a>
                        }
                        <details><summary class="btn btn-outline-secondary">Más acciones</summary><div class="supply-action-panel">
                            <form method="post" asp-page-handler="Start"><input type="hidden" name="requestId" value="@row.RequestId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">NIP para iniciar o continuar</label><div class="input-group"><input class="form-control" name="pin" type="password" inputmode="numeric" required/><button class="btn btn-outline-primary">Registrar preparación</button></div></form>
                            @if (row.Shortage > 0) { <form method="post" asp-page-handler="Reserve"><input type="hidden" name="lineId" value="@row.LineId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">Reservar existencia disponible</label><div class="input-group"><input class="form-control" name="quantity" type="number" min="0.0001" max="@row.Shortage" step="0.0001" value="@row.Shortage" required/><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="NIP" required/><button class="btn btn-outline-primary">Reservar</button></div></form> }
                            <form method="post" asp-page-handler="Problem"><input type="hidden" name="requestId" value="@row.RequestId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">Reportar problema</label><input class="form-control mb-2" name="reason" maxlength="500" required/><div class="input-group"><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="NIP" required/><button class="btn btn-outline-warning">Reportar</button></div></form>
                            @if (User.IsInRole("ADMIN")) { <form method="post" asp-page-handler="Priority"><input type="hidden" name="requestId" value="@row.RequestId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><input type="hidden" name="priority" value="@(row.Priority == ProductionSupplyPriority.Urgent ? "Normal" : "Urgent")"/><label class="form-label">Cambiar prioridad</label><input class="form-control mb-2" name="reason" maxlength="500" required/><div class="input-group"><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="NIP ADMIN" required/><button class="btn btn-outline-secondary">Marcar @(row.Priority == ProductionSupplyPriority.Urgent ? "normal" : "urgente")</button></div></form><form method="post" asp-page-handler="Cancel"><input type="hidden" name="lineId" value="@row.LineId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">Cancelar pendiente</label><input class="form-control mb-2" name="reason" maxlength="500" required/><div class="input-group"><input class="form-control" name="quantity" type="number" min="0.0001" max="@row.Pending" step="0.0001" value="@row.Pending" required/><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="NIP ADMIN" required/><button class="btn btn-outline-danger">Cancelar</button></div></form> }
                        </div></details>
                    </div>
                </div>
            </article>
        }
        </div>
    }
    <p class="visually-hidden" role="status" aria-live="polite" data-supply-live></p>
</div>
@section Scripts { <script src="~/js/production-supply-queue.js" asp-append-version="true"></script> }
