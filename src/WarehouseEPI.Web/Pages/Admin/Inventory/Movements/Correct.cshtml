@page "{id:guid}"
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Admin.Inventory.Movements.CorrectModel
@{ ViewData["Title"]="Corregir movimiento"; }
<h1 class="h2">Corregir movimiento</h1><p class="text-muted">El original permanecerá intacto. Se generará un reverso y, opcionalmente, un reemplazo.</p>
<div class="alert alert-warning"><strong>@Model.Movement.Type</strong> · @Model.Movement.Lines.First().Sku · @Model.Movement.Lines.First().Quantity.ToString("0.####") @Model.Movement.Lines.First().Unit</div>
<form method="post" class="card card-body" id="correction-form"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="ReturnUrl" type="hidden" /><input asp-for="Input.OperationId" type="hidden" /><input asp-for="Input.ProductId" type="hidden" /><input asp-for="Input.SourceLocationId" type="hidden" /><input asp-for="Input.DestinationLocationId" type="hidden" /><input asp-for="Input.LocationId" type="hidden" /><input asp-for="Input.ExpectedBalanceVersion" type="hidden" />
<div class="mb-3"><label asp-for="Input.Reason" class="form-label">Motivo obligatorio</label><textarea asp-for="Input.Reason" class="form-control" maxlength="500" required></textarea></div>
@if(Model.CanReplace){<div class="form-check mb-3"><input asp-for="Input.CreateReplacement" class="form-check-input" /><label asp-for="Input.CreateReplacement" class="form-check-label">Crear movimiento corregido después del reverso</label></div><div class="border rounded p-3 mb-3"><p class="text-muted small mb-2">Reemplazo de una línea. Las ubicaciones se conservan; ajuste el tipo, cantidad, referencia u observaciones.</p><div class="row g-2"><div class="col-md-4"><label asp-for="Input.Type" class="form-label">Tipo</label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<InventoryMovementType>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="Input.Quantity" class="form-label">Cantidad</label><input asp-for="Input.Quantity" class="form-control" step="0.0001" /></div><div class="col-md-4"><label asp-for="Input.Reference" class="form-label">Referencia</label><input asp-for="Input.Reference" class="form-control" /></div><div class="col-12"><label asp-for="Input.Notes" class="form-label">Observaciones</label><textarea asp-for="Input.Notes" class="form-control"></textarea></div></div></div>}else{<div class="alert alert-secondary">Los movimientos con varias líneas solo pueden revertirse desde esta primera versión.</div>}
<div class="mb-3"><label asp-for="Input.Pin" class="form-label">NIP de administrador autorizador</label><input asp-for="Input.Pin" type="password" inputmode="numeric" autocomplete="off" class="form-control form-control-lg" required /></div><div class="d-flex gap-2"><a asp-page="Details" asp-route-id="@Model.Movement.Id" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-danger" type="submit">Confirmar corrección</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
