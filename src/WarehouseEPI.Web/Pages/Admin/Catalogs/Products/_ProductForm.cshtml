@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.IProductFormPage
<form method="post" class="card shadow-sm"><div class="card-body p-3 p-md-4"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="Input.Id" type="hidden"/>
<div class="row g-3"><div class="col-12 col-md-5"><label asp-for="Input.Sku" class="form-label">SKU</label><input asp-for="Input.Sku" class="form-control form-control-lg text-uppercase" autofocus/><span asp-validation-for="Input.Sku" class="text-danger"></span></div><div class="col-12 col-md-7"><label asp-for="Input.ExternalReference" class="form-label">Referencia externa</label><input asp-for="Input.ExternalReference" class="form-control form-control-lg"/><span asp-validation-for="Input.ExternalReference" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Input.Description" class="form-label">Descripción <span class="text-muted fw-normal">(opcional)</span></label><textarea asp-for="Input.Description" class="form-control" rows="4"></textarea></div>
<div class="col-12 col-md-4"><label asp-for="Input.BaseUnitId" class="form-label">Unidad base</label><select asp-for="Input.BaseUnitId" asp-items="Model.Units" class="form-select"><option value="">Seleccione</option></select><span asp-validation-for="Input.BaseUnitId" class="text-danger"></span></div><div class="col-12 col-md-4"><label asp-for="Input.ProductTypeId" class="form-label">Tipo</label><select asp-for="Input.ProductTypeId" asp-items="Model.Types" class="form-select"><option value="">Sin tipo</option></select></div><div class="col-12 col-md-4"><label asp-for="Input.ProductClassId" class="form-label">Clase</label><select asp-for="Input.ProductClassId" asp-items="Model.Classes" class="form-select"><option value="">Sin clase</option></select></div>
<div class="col-12 col-md-4"><label asp-for="Input.MinimumStock" class="form-label">Stock mínimo</label><input asp-for="Input.MinimumStock" class="form-control" type="number" min="0" step="0.0001"/><span asp-validation-for="Input.MinimumStock" class="text-danger"></span></div><div class="col-12 col-md-8 d-flex flex-wrap align-items-end gap-3 pb-2"><div class="form-check form-switch"><input asp-for="Input.TracksLots" class="form-check-input"/><label asp-for="Input.TracksLots" class="form-check-label">Controla lotes</label></div><div class="form-check form-switch"><input asp-for="Input.TracksExpiration" class="form-check-input"/><label asp-for="Input.TracksExpiration" class="form-check-label">Controla caducidad</label></div><div class="form-check form-switch"><input asp-for="Input.AllowsNegativeStock" class="form-check-input"/><label asp-for="Input.AllowsNegativeStock" class="form-check-label">Permite inventario negativo</label></div><div class="form-check form-switch"><input asp-for="Input.IsActive" class="form-check-input"/><label asp-for="Input.IsActive" class="form-check-label">Activo</label></div></div></div>
<div class="mt-4 d-flex gap-2"><button class="btn btn-primary btn-lg">Guardar</button><a asp-page="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a></div></div></form>
