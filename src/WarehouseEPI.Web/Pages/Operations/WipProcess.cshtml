@page "/Operations/Wip"
@model WarehouseEPI.Web.Pages.Operations.WipProcessModel
@{ ViewData["Title"] = "Procesar WIP"; }

<div class="operation-shell py-3" data-wip-process data-lookup-url="@Url.Page("/Operations/Lookup")" data-source-balance="@(Model.SourceBalance?.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
    <a asp-page="/Index" class="small text-decoration-none">← Menú operativo</a>
    <h1 class="h2 mt-2 mb-1">Procesar WIP</h1>
    <p class="text-muted">Registra el destino real del material contra las existencias acumuladas de WIP.</p>
    <form method="post" class="operation-card" id="wip-process-form" data-wip-process-form>
        <input asp-for="Input.OperationId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" tabindex="-1"></div>
        @if (Model.SharingConflicts.Count != 0)
        {
            <div class="alert alert-warning"><strong>La ubicación destino ya contiene otros productos.</strong>
                @foreach (var conflict in Model.SharingConflicts)
                {
                    <div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="Input.ApprovedSharedLocationIds" value="@conflict.LocationId" id="approve-@conflict.LocationId" required /><label class="form-check-label" for="approve-@conflict.LocationId">Compartir @conflict.LocationCode con @string.Join(", ", conflict.ExistingProductSkus)</label></div>
                }
                <p class="small mb-0 mt-2">Revisa la operación e introduce nuevamente tu NIP.</p>
            </div>
        }
        <fieldset class="mb-4"><legend class="h5">Acción</legend><div class="row g-2">
            <div class="col-12 col-lg-4"><input asp-for="Input.Action" id="wip-consumption" class="btn-check" type="radio" value="Consumption" /><label class="btn btn-outline-primary w-100 p-3 text-start" for="wip-consumption"><strong>Consumo</strong><small class="d-block">Salida de material utilizado.</small></label></div>
            <div class="col-12 col-lg-4"><input asp-for="Input.Action" id="wip-return" class="btn-check" type="radio" value="WarehouseReturn" /><label class="btn btn-outline-primary w-100 p-3 text-start" for="wip-return"><strong>Regreso a bodega</strong><small class="d-block">Transferencia a otra ubicación.</small></label></div>
            <div class="col-12 col-lg-4"><input asp-for="Input.Action" id="wip-supplier" class="btn-check" type="radio" value="SupplierReturn" /><label class="btn btn-outline-primary w-100 p-3 text-start" for="wip-supplier"><strong>Devolución a proveedor</strong><small class="d-block">Salida con referencia obligatoria.</small></label></div>
        </div></fieldset>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Input.WipCode" class="form-label">WIP origen</label><div class="input-group input-group-lg"><input asp-for="Input.WipCode" class="form-control text-uppercase" list="wip-options" autocomplete="off" placeholder="WIP-2" autofocus data-wip-lookup="wip" /><button type="button" class="btn btn-outline-secondary" data-wip-camera="Input_WipCode" aria-label="Escanear WIP con cámara">📷</button></div><datalist id="wip-options">@foreach (var item in Model.WipLocations) { <option value="@item.Code">@item.Description</option> }</datalist><span asp-validation-for="Input.WipCode" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.ProductCode" class="form-label">SKU o código de barras</label><div class="lookup-field"><div class="input-group input-group-lg"><input asp-for="Input.ProductCode" class="form-control" type="search" autocomplete="off" placeholder="Escanea o busca por SKU, descripción o referencia" aria-describedby="wip-product-feedback" data-wip-lookup="product" data-wip-product-search /><button type="button" class="btn btn-outline-secondary" data-wip-camera="Input_ProductCode" aria-label="Escanear producto con cámara">📷</button></div><div class="lookup-results list-group" data-wip-product-results aria-live="polite"></div></div><p id="wip-product-feedback" class="form-text mb-0" role="status" aria-live="polite" data-wip-product-feedback></p><span asp-validation-for="Input.ProductCode" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.Quantity" class="form-label">Cantidad</label><input asp-for="Input.Quantity" class="form-control form-control-lg" inputmode="decimal" min="0.0001" step="0.0001" required /><span asp-validation-for="Input.Quantity" class="text-danger"></span>@if (Model.SourceBalance is not null) { <div class="form-text">Saldo actual: @Model.SourceBalance.Quantity.ToString("0.####")</div> }</div>
            <div class="col-md-6" data-wip-destination><label asp-for="Input.DestinationCode" class="form-label">Ubicación destino</label><div class="input-group input-group-lg"><input asp-for="Input.DestinationCode" class="form-control text-uppercase" autocomplete="off" placeholder="Escanea o escribe la ubicación" data-wip-lookup="destination" /><button type="button" class="btn btn-outline-secondary" data-wip-camera="Input_DestinationCode" aria-label="Escanear destino con cámara">📷</button></div><span asp-validation-for="Input.DestinationCode" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.Reference" class="form-label">Referencia <span data-reference-required class="text-muted">(opcional)</span></label><input asp-for="Input.Reference" class="form-control form-control-lg" maxlength="120" /><span asp-validation-for="Input.Reference" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.Notes" class="form-label">Observaciones <span class="text-muted">(opcional)</span></label><textarea asp-for="Input.Notes" class="form-control" rows="2" maxlength="500"></textarea></div>
            <div class="col-12"><div class="alert alert-warning mb-0">Se permite saldo negativo, pero debe revisarse antes de confirmar. Las salidas consumen lotes FEFO y los regresos conservan los lotes de origen.</div></div>
            <div class="col-md-6"><label asp-for="Input.Pin" class="form-label fw-semibold">NIP del responsable</label><input asp-for="Input.Pin" value="" class="form-control form-control-lg" type="password" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" autocomplete="off" required /></div>
            <div class="col-12 d-flex gap-2"><a asp-page="/Index" class="btn btn-outline-secondary btn-lg">Cancelar</a><button type="button" class="btn btn-primary btn-lg flex-grow-1" data-wip-review>Revisar y confirmar</button></div>
        </div>
    </form>
    <div class="modal fade" id="wip-camera-scanner" tabindex="-1" aria-labelledby="wip-camera-scanner-title" aria-hidden="true" data-camera-scanner><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="wip-camera-scanner-title">Escanear código</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><div class="camera-preview" data-camera-preview><video class="w-100" autoplay muted playsinline data-camera-video></video></div><p class="mb-0 mt-3" role="status" aria-live="polite" data-camera-status>Preparando cámara…</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary btn-lg d-none" data-camera-switch>Cambiar cámara</button><label class="btn btn-outline-primary btn-lg mb-0" for="wip-camera-photo">Tomar foto</label><input id="wip-camera-photo" class="visually-hidden" type="file" accept="image/*" capture="environment" data-camera-photo /><button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">Cancelar</button></div></div></div></div>
    <div class="modal fade" id="confirm-wip-process" tabindex="-1" aria-labelledby="confirm-wip-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="confirm-wip-title">Confirmar operación WIP</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><dl class="confirmation-summary mb-0"><dt>Acción</dt><dd data-wip-review-action></dd><dt>WIP / producto</dt><dd data-wip-review-position></dd><dt>Cantidad</dt><dd data-wip-review-quantity></dd><div data-wip-review-target-row><dt>Destino</dt><dd data-wip-review-target></dd></div></dl><p class="text-warning mt-3 mb-0" data-wip-negative-review></p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">Volver</button><button type="submit" form="wip-process-form" class="btn btn-primary btn-lg" data-wip-confirm>Confirmar operación</button></div></div></div></div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script>
    <script src="~/js/wip-process.js" asp-append-version="true" defer></script>
}
