@page
@model WarehouseEPI.Web.Pages.Admin.Production.ScheduleModel
@using WarehouseEPI.Core.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@using global::System.Globalization
@using WarehouseEPI.Web.Production
@{
    ViewData["Title"] = ProdTexts["Programa semanal"];
}
<div class="container-fluid py-3 production-daily" data-production-daily data-product-url="@Url.Page("/Operations/Lookup", "Products")" data-product-resolve-url="@Url.Page("/Operations/Lookup", "ResolveProduct")">
    <header class="production-daily__header mb-4"><div><span class="eyebrow">@ProdTexts["Producción"]</span><h1 class="h2 mb-1">@ProdTexts["Programa semanal"]</h1><p class="text-body-secondary mb-0">@ProdTexts["Configura productos, cantidades y pedidos de cada día."]</p></div>
    <div class="d-flex flex-wrap gap-2">
        @if(Model.Week?.Status==ProductionScheduleWeekStatus.Draft){<a class="btn btn-primary" asp-route-WeekId="@Model.WeekId" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-View="review">Revisar semana</a>}
        @if(Model.Week?.Status==ProductionScheduleWeekStatus.Open){<a asp-page="/Operations/Production/Index" asp-route-WeekId="@Model.WeekId" class="btn btn-primary">@ProdTexts["Capturar"]</a>}
        <details class="dropdown"><summary class="btn btn-outline-secondary">Más</summary><div class="d-grid gap-1 mt-2">
            <a class="btn btn-outline-secondary" asp-route-WeekId="@Model.WeekId" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-ActionPanel="new">Nueva semana</a>
            @if(Model.Week?.Status==ProductionScheduleWeekStatus.Draft){<a class="btn btn-outline-secondary" asp-route-WeekId="@Model.WeekId" asp-route-View="program" asp-fragment="week-workspace-source">Copiar productos</a>}
            else if(Model.Week is not null){<a class="btn btn-outline-secondary" asp-route-WeekId="@Model.WeekId" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-ActionPanel="copy">Copiar productos</a>}
            <a asp-page="ScheduleImport" class="btn btn-outline-secondary">Importar Excel</a>
            @if(Model.Week is not null){<a asp-page="/Operations/Production/Index" asp-page-handler="Export" asp-route-WeekId="@Model.Week.Id" class="btn btn-outline-secondary">Exportar Excel</a>}
            <a class="btn btn-outline-secondary" asp-route-WeekId="@Model.WeekId" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-ActionPanel="config">Áreas y turnos</a>
            @if(Model.Week?.Status==ProductionScheduleWeekStatus.Open){<a class="btn btn-outline-secondary" asp-route-WeekId="@Model.WeekId" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-ActionPanel="close">Cerrar semana</a>}
            @if(Model.Week?.Status==ProductionScheduleWeekStatus.Closed){<a class="btn btn-outline-secondary" asp-route-WeekId="@Model.WeekId" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-ActionPanel="reopen">Reabrir semana</a>}
        </div></details>
    </div></header>
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-12">
            <section class="card mb-4"><div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-end">
                <form method="get" class="d-flex flex-wrap gap-2 align-items-end"><div><label asp-for="WeekId" class="form-label">@ProdTexts["Semana"]</label><select asp-for="WeekId" class="form-select form-select-lg production-daily__week" disabled="@(Model.Weeks.Count == 0)"><option value="">@ProdTexts[Model.Weeks.Count == 0 ? "Todavía no hay semanas programadas" : "Selecciona una semana"]</option>@foreach(var item in Model.Weeks){<option value="@item.Id">@item.WeekStart.ToString("dd/MM")–@item.WeekEnd.ToString("dd/MM") · @ProductionDailyText.WeekStatus(ProdTexts, item.Status)</option>}</select></div><button class="btn btn-outline-primary btn-lg" disabled="@(Model.Weeks.Count == 0)">@ProdTexts["Abrir"]</button></form>
                @if(Model.ActionPanel=="new" || Model.Weeks.Count==0){<form method="post" asp-page-handler="CreateWeek" class="d-flex flex-wrap gap-2 align-items-end"><input asp-for="NewWeek.OperationId" type="hidden"/><div><label asp-for="NewWeek.WeekStart" class="form-label">@ProdTexts["Nueva semana (lunes)"]</label><input asp-for="NewWeek.WeekStart" type="date" class="form-control form-control-lg"/><span asp-validation-for="NewWeek.WeekStart" class="text-danger"></span></div><button class="btn btn-primary btn-lg">@ProdTexts["Crear borrador"]</button></form>}
            </div></section>

            @if (Model.Week is not null)
            {
                <section class="card mb-4"><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-3"><div><span class="badge text-bg-secondary">@ProductionDailyText.WeekStatus(ProdTexts, Model.Week.Status)</span><h2 class="h4 mt-2">@Model.Week.WeekStart.ToString("dd/MM/yyyy") – @Model.Week.WeekEnd.ToString("dd/MM/yyyy")</h2></div><div class="d-flex flex-wrap gap-2">
                    @if(Model.Week.Status==ProductionScheduleWeekStatus.Open && Model.ActionPanel=="close"){<form method="post" asp-page-handler="Close"><input name="weekId" value="@Model.Week.Id" type="hidden"/><input name="version" value="@Model.Week.Version" type="hidden"/><button class="btn btn-outline-secondary">@ProdTexts["Cerrar semana"]</button></form>}
                    @if(Model.Week.Status==ProductionScheduleWeekStatus.Closed && Model.ActionPanel=="reopen"){<form method="post" asp-page-handler="Reopen"><input name="weekId" value="@Model.Week.Id" type="hidden"/><input name="version" value="@Model.Week.Version" type="hidden"/><button class="btn btn-outline-warning">@ProdTexts["Reabrir con auditoría"]</button></form>}
                </div></div>
                <nav class="nav nav-pills gap-2 mt-3" aria-label="Vistas del programa"><a class="nav-link @(Model.View=="program"?"active":"")" aria-current="@(Model.View=="program"?"page":null)" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-View="program">Programa por día</a><a class="nav-link @(Model.View=="week"?"active":"")" aria-current="@(Model.View=="week"?"page":null)" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-View="week">Productos de la semana</a><a class="nav-link @(Model.View=="summary"?"active":"")" aria-current="@(Model.View=="summary"?"page":null)" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-View="summary">Resumen del plan</a></nav>
                @if(Model.View=="program" && Model.Week.Status==ProductionScheduleWeekStatus.Draft){<partial name="_ScheduleWorkspace" model="Model"/>}
                @if(Model.Week.ExplicitCarryover && (Model.Week.Status!=ProductionScheduleWeekStatus.Draft || Model.View!="program")){<partial name="_InitialCarryover" model="Model"/>}
                @if(Model.View=="program"){
                <nav class="d-flex gap-2 overflow-auto py-3" aria-label="Días de la semana">
                @foreach(var day in ProductionWeekCalendar.Days(Model.Week.WeekStart)){var count=Model.Week.Lines.Count(x=>x.PlannedDate==day&&!x.IsCarryover);var carry=Model.CarryoverPlans.Count(x=>x.PlannedDate==day&&x.Quantity>0);<a class="btn @(Model.SelectedDay==day?"btn-primary":"btn-outline-primary") flex-shrink-0" aria-current="@(Model.SelectedDay==day?"date":null)" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))">@day.ToString("ddd dd/MM",CultureInfo.CurrentUICulture) · @count @if(carry>0){<span> · @carry arrastre(s)</span>}</a>}
                </nav>
                <div class="d-flex justify-content-between align-items-center"><h3 class="h5">@Model.SelectedDay?.ToString("dddd dd/MM",CultureInfo.CurrentUICulture)</h3>@if(Model.Week.Status==ProductionScheduleWeekStatus.Open){<a class="btn btn-outline-primary" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-AddLine="true">Agregar productos</a>}</div>
                }
                @if(Model.View=="program" && Model.Week.Status==ProductionScheduleWeekStatus.Open && (Model.AddLine || Model.Batch.Rows.Count>0) && !Model.EditLineId.HasValue)
                {
                    <section class="mt-4" data-schedule-batch><h3 class="h5">Preparar productos</h3><p class="text-body-secondary">Agrega varios renglones. Permanecen pendientes hasta confirmar todo el grupo.</p>
                    <form method="post" asp-page-handler="StageLine" class="row g-3" data-schedule-editor autocomplete="off">
                        <input asp-for="Batch.OperationId" type="hidden"/><input asp-for="Batch.WeekId" type="hidden"/><input asp-for="Batch.ExpectedWeekVersion" type="hidden"/>
                        <partial name="_ScheduleBatchRows" model="Model"/>
                        <input asp-for="Line.OperationId" type="hidden"/><input asp-for="Line.WeekId" type="hidden"/><input asp-for="Line.ExpectedWeekVersion" type="hidden"/><input asp-for="Line.ProductId" type="hidden" data-product-id/>
                        <div class="col-6 col-lg-2"><label asp-for="Line.PlannedDate" class="form-label">Día</label><input asp-for="Line.PlannedDate" type="date" min="@Model.Week.WeekStart.ToString("yyyy-MM-dd")" max="@Model.Week.WeekEnd.ToString("yyyy-MM-dd")" class="form-control form-control-lg"/></div>
                        <div class="col-12 col-lg-4 position-relative" data-product-field data-product-value="sku" data-product-scan-exact="true"><label asp-for="Line.ProductLabel" class="form-label">SKU</label><input asp-for="Line.ProductLabel" class="form-control form-control-lg" data-product-input type="search" placeholder="@ProdTexts["Escribe y selecciona"]"/><div class="production-daily__suggestions list-group" data-product-results></div><span asp-validation-for="Line.ProductId" class="text-danger"></span><span class="text-danger d-block" data-product-scan-error role="alert"></span></div>
                        <div class="col-6 col-lg-2"><label asp-for="Line.Quantity" class="form-label">Cantidad</label><input asp-for="Line.Quantity" class="form-control form-control-lg" inputmode="decimal"/><span asp-validation-for="Line.Quantity" class="text-danger"></span></div>
                        <details class="col-12"><summary class="py-2">Pedidos y anotaciones</summary><div class="row g-3">
                        <div class="col-6 col-lg-2"><label asp-for="Line.OrderReference1" class="form-label">Pedido 1</label><input asp-for="Line.OrderReference1" class="form-control"/></div><div class="col-6 col-lg-2"><label asp-for="Line.OrderReference2" class="form-label">Pedido 2</label><input asp-for="Line.OrderReference2" class="form-control"/></div><div class="col-6 col-lg-2"><label asp-for="Line.OrderReference3" class="form-label">Pedido 3</label><input asp-for="Line.OrderReference3" class="form-control"/></div>
                        <div class="col-12 col-lg-8"><label asp-for="Line.Notes" class="form-label">Notas</label><input asp-for="Line.Notes" class="form-control"/></div>
                        <div class="col-12 col-lg-4"><label asp-for="Line.OriginalType" class="form-label">Tipo original</label><input asp-for="Line.OriginalType" class="form-control"/></div>
                        <div class="col-12 col-lg-4"><label asp-for="Line.OriginalAnnotation1" class="form-label">Anotación 1 del Excel</label><input asp-for="Line.OriginalAnnotation1" class="form-control"/></div>
                        <div class="col-12 col-lg-4"><label asp-for="Line.OriginalAnnotation2" class="form-label">Anotación 2 del Excel</label><input asp-for="Line.OriginalAnnotation2" class="form-control"/></div></div></details>
                        <input asp-for="Line.OriginalAnnotation1Kind" type="hidden"/><input asp-for="Line.OriginalAnnotation2Kind" type="hidden"/>
                        <input name="SelectedDay" type="hidden" value="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"/>
                        <div class="col-12 d-flex flex-wrap gap-2"><button class="btn btn-outline-primary btn-lg" disabled="@(Model.Batch.Rows.Count>=100)">Agregar al grupo</button><a class="btn btn-outline-secondary btn-lg" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" data-schedule-discard>Descartar grupo</a></div>
                    </form>
                    @if(Model.Batch.Rows.Count>0)
                    {
                        <div class="mt-4" data-schedule-staged><h4 class="h6">Pendientes de confirmar · @Model.Batch.Rows.Count</h4>
                        <form id="remove-staged-line" method="post" asp-page-handler="RemoveStagedLine" data-schedule-batch-action><input asp-for="Batch.OperationId" type="hidden"/><input asp-for="Batch.WeekId" type="hidden"/><input asp-for="Batch.ExpectedWeekVersion" type="hidden"/><input name="SelectedDay" type="hidden" value="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"/><partial name="_ScheduleBatchRows" model="Model"/></form>
                        <div class="production-schedule-pending-list" aria-label="Renglones pendientes de confirmar">
                        @for(var i=0;i<Model.Batch.Rows.Count;i++)
                        {
                            var row=Model.Batch.Rows[i];
                            var product=Model.StagedProducts.GetValueOrDefault(row.ProductId);
                            <div class="rounded border border-warning-subtle bg-warning-subtle p-3 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <div><span class="badge text-bg-warning me-2">Pendiente de confirmar</span><strong>@(product?.Sku??"SKU no disponible")</strong><span class="ms-2">@row.PlannedDate.ToString("ddd dd/MM",CultureInfo.CurrentUICulture) · @row.Quantity.ToString("0.####") @product?.Unit</span>@if(new[]{row.OrderReference1,row.OrderReference2,row.OrderReference3}.Any(x=>!string.IsNullOrWhiteSpace(x))){<span class="ms-2">· Cliente</span>}</div>
                                <div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" type="submit" form="remove-staged-line" asp-page-handler="EditStagedLine" name="index" value="@i">Editar</button><button class="btn btn-outline-danger" type="submit" form="remove-staged-line" name="index" value="@i">Quitar</button></div>
                            </div>
                        }
                        </div>
                        <form method="post" asp-page-handler="SaveBatch" class="border rounded p-3 mt-3" data-schedule-batch-action autocomplete="off">
                            <input asp-for="Batch.OperationId" type="hidden"/><input asp-for="Batch.WeekId" type="hidden"/><input asp-for="Batch.ExpectedWeekVersion" type="hidden"/><input name="SelectedDay" type="hidden" value="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"/><partial name="_ScheduleBatchRows" model="Model"/>
                            @if(Model.Week.Status==ProductionScheduleWeekStatus.Open){<div class="mb-3"><label asp-for="Batch.Pin" class="form-label">NIP ADMIN para confirmar el grupo</label><input asp-for="Batch.Pin" type="password" inputmode="numeric" class="form-control form-control-lg" autocomplete="off" value=""/></div>}
                            <p class="alert alert-warning d-none" role="alert" data-schedule-unadded>Primero agrega al grupo el renglón que estás editando.</p>
                            <button class="btn btn-primary btn-lg">Confirmar @Model.Batch.Rows.Count @(Model.Batch.Rows.Count==1?"renglón":"renglones")</button>
                        </form></div>
                    }
                    </section>
                }
                @if(Model.View=="program" && Model.Week.Status!=ProductionScheduleWeekStatus.Closed && (Model.EditLineId.HasValue || Model.Request.Method=="POST" && Model.Request.Query["handler"]=="SaveLine"))
                {
                    <hr/><form method="post" asp-page-handler="SaveLine" class="row g-3" data-schedule-editor><input asp-for="Line.OperationId" type="hidden"/><input asp-for="Line.WeekId" type="hidden"/><input asp-for="Line.LineId" type="hidden"/><input asp-for="Line.ExpectedWeekVersion" type="hidden"/><input asp-for="Line.ExpectedLineVersion" type="hidden"/><input asp-for="Line.ProductId" type="hidden" data-product-id/>
                        <div class="col-6 col-lg-2"><label asp-for="Line.PlannedDate" class="form-label">@ProdTexts["Día"]</label><input asp-for="Line.PlannedDate" type="date" min="@Model.Week.WeekStart.ToString("yyyy-MM-dd")" max="@Model.Week.WeekEnd.ToString("yyyy-MM-dd")" class="form-control form-control-lg"/></div>
                        <div class="col-12 col-lg-4 position-relative" data-product-field data-product-value="sku" data-product-scan-exact="true"><label asp-for="Line.ProductLabel" class="form-label">SKU</label><input asp-for="Line.ProductLabel" class="form-control form-control-lg" data-product-input type="search" placeholder="@ProdTexts["Escribe y selecciona"]"/><div class="production-daily__suggestions list-group" data-product-results></div><span asp-validation-for="Line.ProductId" class="text-danger"></span><span class="text-danger d-block" data-product-scan-error role="alert"></span></div>
                        <div class="col-6 col-lg-2"><label asp-for="Line.Quantity" class="form-label">@ProdTexts["Cantidad"]</label><input asp-for="Line.Quantity" class="form-control form-control-lg" inputmode="decimal"/></div>
                        <details class="col-12"><summary class="py-2">@ProdTexts["Más detalles"]</summary><div class="row g-3">
                        <div class="col-6 col-lg-2"><label asp-for="Line.OrderReference1" class="form-label">@ProdTexts["Orden 1"]</label><input asp-for="Line.OrderReference1" class="form-control"/></div><div class="col-6 col-lg-2"><label asp-for="Line.OrderReference2" class="form-label">@ProdTexts["Orden 2"]</label><input asp-for="Line.OrderReference2" class="form-control"/></div><div class="col-6 col-lg-2"><label asp-for="Line.OrderReference3" class="form-label">@ProdTexts["Orden 3"]</label><input asp-for="Line.OrderReference3" class="form-control"/></div>
                        <div class="col-12 col-lg-8"><label asp-for="Line.Notes" class="form-label">@ProdTexts["Notas"]</label><input asp-for="Line.Notes" class="form-control"/></div>
                        <div class="col-12 col-lg-4"><label asp-for="Line.OriginalType" class="form-label">Tipo original</label><input asp-for="Line.OriginalType" class="form-control"/></div>
                        <div class="col-12 col-lg-4"><label asp-for="Line.OriginalAnnotation1" class="form-label">Anotación 1 del Excel</label><input asp-for="Line.OriginalAnnotation1" class="form-control"/></div>
                        <div class="col-12 col-lg-4"><label asp-for="Line.OriginalAnnotation2" class="form-label">Anotación 2 del Excel</label><input asp-for="Line.OriginalAnnotation2" class="form-control"/></div></div></details>
                        <input asp-for="Line.OriginalAnnotation1Kind" type="hidden"/><input asp-for="Line.OriginalAnnotation2Kind" type="hidden"/>
@if(Model.Week.Status==ProductionScheduleWeekStatus.Open && !Model.EditLineId.HasValue){<div class="col-md-4"><label asp-for="Line.Pin" class="form-label">@ProdTexts["NIP ADMIN de la sesión"]</label><input asp-for="Line.Pin" type="password" inputmode="numeric" class="form-control form-control-lg"/></div>}
<div class="col-12 col-lg-3 d-flex gap-2 align-items-end"><button class="btn btn-primary">Guardar renglón</button><a class="btn btn-outline-secondary" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))">Cancelar</a></div>
                    </form>
                }
                </div></section>
                @if(Model.View=="program"){
                <section class="card mb-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0 production-schedule-table"><thead><tr><th>#</th><th>SKU</th><th class="text-end">Cantidad</th><th>Destino</th><th>Tipo original</th><th>Pedidos y anotaciones</th><th></th></tr></thead><tbody>
                @foreach(var line in Model.DayLines)
                {
                    <tr><td>@line.Sequence</td><td><strong>@line.Sku</strong></td><td class="text-end">@line.Quantity.ToString("0.####") @line.Unit</td><td>@(line.IsCarryover?"Apertura importada":new[]{line.OrderReference1,line.OrderReference2,line.OrderReference3}.Any(x=>!string.IsNullOrWhiteSpace(x))?"Cliente":"Inventario")</td><td>@(string.IsNullOrWhiteSpace(line.OriginalType)?"Sin especificar en origen":line.OriginalType)</td><td><details><summary>Ver detalles</summary><dl><dt>Pedido 1</dt><dd>@line.OrderReference1</dd><dt>Pedido 2</dt><dd>@line.OrderReference2</dd><dt>Pedido 3</dt><dd>@line.OrderReference3</dd><dt>Notas</dt><dd>@line.Notes</dd><dt>Anotación 1</dt><dd>@line.OriginalAnnotation1</dd><dt>Anotación 2</dt><dd>@line.OriginalAnnotation2</dd></dl></details></td>
                    <td>
                        @if(Model.Week.Status!=ProductionScheduleWeekStatus.Closed)
                        {
                            <a asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-PageNumber="@Model.PageNumber" asp-route-EditLineId="@line.Id" class="btn btn-outline-primary">Editar</a>
                            if(Model.DeletionEligibility.TryGetValue(line.Id, out var eligibility))
                            {
                                if(eligibility.Allowed && Model.DeleteLineId != line.Id)
                                {
                                    <a class="btn btn-outline-danger" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-PageNumber="@Model.PageNumber" asp-route-DeleteLineId="@line.Id">Eliminar</a>
                                }
                                else if(!eligibility.Allowed && !line.IsCarryover)
                                {
                                    <span class="d-block small text-body-secondary">@eligibility.Reason</span>
                                }
                                if(eligibility.Allowed && Model.DeleteLineId == line.Id)
                                {
                                    <form method="post" asp-page-handler="CancelLine" class="mt-2 border border-danger-subtle rounded p-2" autocomplete="off">
                                        <input name="SelectedDay" type="hidden" value="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"/>
                                        <input name="PageNumber" type="hidden" value="@Model.PageNumber"/>
                                        <input asp-for="DeleteLine.OperationId" type="hidden"/><input asp-for="DeleteLine.WeekId" type="hidden"/><input asp-for="DeleteLine.LineId" type="hidden"/>
                                        <input asp-for="DeleteLine.ExpectedWeekVersion" type="hidden"/><input asp-for="DeleteLine.ExpectedLineVersion" type="hidden"/>
                                        <p class="mb-2">¿Eliminar <strong>@line.Sku</strong> del @line.PlannedDate.ToString("dd/MM") · @line.Quantity.ToString("0.####") @line.Unit?</p>
                                        @if(eligibility.RequiresPin){<label for="delete-line-pin-@line.Id" class="form-label">NIP ADMIN para revertir material</label><input id="delete-line-pin-@line.Id" name="DeleteLine.Pin" type="password" inputmode="numeric" class="form-control mb-2" value="" autocomplete="off"/>}
                                        <div class="d-flex flex-wrap gap-2"><button class="btn btn-danger">Confirmar eliminación</button><a class="btn btn-outline-secondary" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-PageNumber="@Model.PageNumber">Conservar renglón</a></div>
                                    </form>
                                }
                            }
                        }
                    </td></tr>
                }
                </tbody></table></div>@if(Model.DayLines.Count==0){<p class="p-3 mb-0">No hay productos para este día. Agrega uno para empezar.</p>}</section>
                @if(Model.DayPageCount>1){<nav class="d-flex gap-2 mb-3" aria-label="Páginas del día">@for(var pg=1;pg<=Model.DayPageCount;pg++){<a class="btn @(pg==Model.PageNumber?"btn-primary":"btn-outline-primary")" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-PageNumber="@pg">@pg</a>}</nav>}
                @if(!Model.Week.ExplicitCarryover){<section class="card mb-4"><div class="card-body"><h3 class="h5">Arrastre programado · @Model.SelectedDay?.ToString("dd/MM")</h3>@foreach(var row in Model.CarryoverPlans.Where(x=>x.PlannedDate==Model.SelectedDay&&x.Quantity>0)){<p>@Model.CarryoverSkus.GetValueOrDefault(row.ProductId) · @row.Area · @row.Quantity.ToString("0.####")</p>}<a class="btn btn-outline-primary" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-ActionPanel="carry">Agregar o editar arrastre</a></div></section>}
                }
                @if(Model.View=="week"){
                <section class="card my-4"><div class="card-body"><h3 class="h5 mb-1">Productos de la semana</h3><p class="text-body-secondary mb-3">@Model.WeekLineCount @(Model.WeekLineCount==1?"renglón programado":"renglones programados") · @Model.WeekSkuCount @(Model.WeekSkuCount==1?"SKU distinto":"SKU distintos"). Cada renglón conserva su día, cantidad y pedidos; un SKU puede aparecer varias veces.</p>
                <div class="table-responsive"><table class="table table-hover align-middle mb-0 production-schedule-table"><thead><tr><th>Día</th><th>SKU</th><th class="text-end">Cantidad</th><th>Destino</th><th>Pedidos</th><th>Tipo original</th><th>Notas y anotaciones</th><th></th></tr></thead><tbody>
                @foreach(var line in Model.WeekLines){<tr><td>@line.PlannedDate.ToString("ddd dd/MM", CultureInfo.CurrentUICulture)</td><td><strong>@line.Sku</strong></td><td class="text-end">@line.Quantity.ToString("0.####") @line.Unit</td><td>@(new[]{line.OrderReference1,line.OrderReference2,line.OrderReference3}.Any(x=>!string.IsNullOrWhiteSpace(x))?"Cliente":"Inventario")</td><td>@string.Join(" · ",new[]{line.OrderReference1,line.OrderReference2,line.OrderReference3}.Where(x=>!string.IsNullOrWhiteSpace(x)))</td><td>@(string.IsNullOrWhiteSpace(line.OriginalType)?"Sin especificar en origen":line.OriginalType)</td><td>@if(!string.IsNullOrWhiteSpace(line.Notes)||!string.IsNullOrWhiteSpace(line.OriginalAnnotation1)||!string.IsNullOrWhiteSpace(line.OriginalAnnotation2)){<details><summary>Ver detalles</summary><dl><dt>Notas</dt><dd>@line.Notes</dd><dt>Anotación 1</dt><dd>@line.OriginalAnnotation1</dd><dt>Anotación 2</dt><dd>@line.OriginalAnnotation2</dd></dl></details>}</td><td><a class="btn btn-outline-primary" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@line.PlannedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" asp-route-View="program">Ver día</a></td></tr>}
                </tbody></table></div>@if(Model.WeekLineCount==0){<p class="pt-3 mb-0">Todavía no hay productos programados para esta semana.</p>}
                @if(Model.WeekPageCount>1){<nav class="d-flex flex-wrap gap-2 mt-3" aria-label="Páginas de productos de la semana">@for(var pg=1;pg<=Model.WeekPageCount;pg++){<a class="btn @(pg==Model.PageNumber?"btn-primary":"btn-outline-primary")" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-View="week" asp-route-PageNumber="@pg">@pg</a>}</nav>}
                </div></section>
                }
                @if(Model.View is "summary" or "review"){
                <section class="card mb-4"><div class="card-body"><h3 class="h5">@(Model.View=="review"?"Revisión de la semana":"Resumen del plan")</h3>
                @if(Model.View=="review" && Model.PublicationIssues.Count>0){<div role="alert" class="alert alert-warning">@foreach(var issue in Model.PublicationIssues){<p>@issue</p>}</div>}
                <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Día</th><th>Unidad</th><th>Programado nuevo</th><th>Cliente</th><th>Inventario</th><th>Líneas nuevas</th><th>Líneas cliente</th><th>Líneas inventario</th><th>Apertura importada</th><th>Arrastre programado</th></tr></thead><tbody>@foreach(var row in Model.PlanSummary){<tr><td>@row.Day.ToString("ddd dd/MM",CultureInfo.CurrentUICulture)</td><td>@row.Unit</td><td>@row.NewQuantity.ToString("0.####")</td><td>@row.CustomerQuantity.ToString("0.####")</td><td>@row.StockQuantity.ToString("0.####")</td><td>@row.NewLines</td><td>@row.CustomerLines</td><td>@row.StockLines</td><td>@row.ImportedOpening.ToString("0.####")</td><td>@row.PlannedCarryover.ToString("0.####")</td></tr>}@foreach(var group in Model.PlanSummary.GroupBy(x=>x.Unit)){<tr class="table-light fw-bold"><th>Total</th><th>@group.Key</th><td>@group.Sum(x=>x.NewQuantity)</td><td>@group.Sum(x=>x.CustomerQuantity)</td><td>@group.Sum(x=>x.StockQuantity)</td><td>@group.Sum(x=>x.NewLines)</td><td>@group.Sum(x=>x.CustomerLines)</td><td>@group.Sum(x=>x.StockLines)</td><td>@group.Sum(x=>x.ImportedOpening)</td><td>@group.Sum(x=>x.PlannedCarryover)</td></tr>}</tbody></table></div></div></section>
                }
                @if((Model.ActionPanel=="copy" && Model.Week.Status!=ProductionScheduleWeekStatus.Draft) || Model.ActionPanel=="carry" || Model.CarryProduct.HasValue || Model.CarryPlanId.HasValue){<partial name="_ScheduleWorkflow" model="Model"/>}
                @if(Model.View=="review" && Model.Week.Status==ProductionScheduleWeekStatus.Draft)
                {
                    <section class="card border-primary"><div class="card-body"><h2 class="h5">@ProdTexts["Abrir semana para capturar"]</h2><p>@ProdTexts["Líneas"]: @Model.Week.Lines.Count · @ProdTexts["Piezas"]: @Model.Week.Lines.Sum(x=>x.Quantity).ToString("0.####",CultureInfo.InvariantCulture)</p><p class="small">@(Model.Week.ExplicitCarryover ? "Solo se incorporará el arrastre seleccionado en la preparación." : ProdTexts["Los pendientes de órdenes anteriores también estarán disponibles para capturar."].Value)</p><p class="text-body-secondary">@ProdTexts["Si los procesos o turnos de Producción diaria no están listos, no se creará ninguna orden."]</p><form method="post" asp-page-handler="Publish" class="row g-2 align-items-end"><input asp-for="Publish.OperationId" type="hidden"/><input asp-for="Publish.WeekId" type="hidden"/><input asp-for="Publish.ExpectedVersion" type="hidden"/><div class="col-12 col-md-4"><label asp-for="Publish.Pin" class="form-label">@ProdTexts["NIP ADMIN de la sesión"]</label><input asp-for="Publish.Pin" class="form-control form-control-lg" type="password" inputmode="numeric"/></div><div class="col-12 col-md-4"><button class="btn btn-success btn-lg w-100">@ProdTexts["Abrir semana para capturar"]</button></div></form></div></section>
                }
            }
        </div>
        @if(Model.ActionPanel=="config" || !Model.ConfigurationReady){<aside class="col-12" id="daily-configuration"><details class="card" open><summary class="card-header py-3">@ProdTexts["Configuración diaria"]</summary><div class="card-body"><h2 class="h5">@ProdTexts["Configuración diaria"]</h2><p class="small text-body-secondary">@ProdTexts["Reutiliza procesos y turnos existentes; no crea catálogos duplicados."]</p>@if (!Model.ConfigurationReady) { <p class="alert alert-warning" role="status">@ProdTexts["Las coincidencias únicas se proponen aquí. Revisa y guarda la configuración para habilitar la captura."]</p> }<form method="post" asp-page-handler="Configure" class="d-grid gap-3"><input asp-for="Configuration.OperationId" type="hidden"/><input asp-for="Configuration.ExpectedVersion" type="hidden"/>
            <div><label asp-for="Configuration.CuttingStageId" class="form-label">@ProdTexts["Corte"]</label><select asp-for="Configuration.CuttingStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.SewingStageId" class="form-label">@ProdTexts["Costura"]</label><select asp-for="Configuration.SewingStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.ReadyToPackStageId" class="form-label">@ProdTexts["Ready to Pack"]</label><select asp-for="Configuration.ReadyToPackStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.Shift1Id" class="form-label">T1</label><select asp-for="Configuration.Shift1Id" class="form-select"><option value="">@ProdTexts[Model.Shifts.Count == 0 ? "No hay turnos activos" : "Selecciona un turno"]</option>@foreach(var shift in Model.Shifts){<option value="@shift.Id">@shift.Name</option>}</select></div><div><label asp-for="Configuration.Shift2Id" class="form-label">T2</label><select asp-for="Configuration.Shift2Id" class="form-select"><option value="">@ProdTexts[Model.Shifts.Count == 0 ? "No hay turnos activos" : "Selecciona un turno"]</option>@foreach(var shift in Model.Shifts){<option value="@shift.Id">@shift.Name</option>}</select></div><button class="btn btn-outline-primary">@ProdTexts["Guardar configuración"]</button>
        </form>
        <a asp-page="/Admin/Production/Routes" class="btn btn-outline-secondary w-100 mt-3">@ProdTexts["Agregar turno"]</a>
        </div></details></aside>}
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/production-daily.js" asp-append-version="true"></script><script src="~/js/production-schedule.js" asp-append-version="true"></script><script src="~/js/production-week-paste.js" asp-append-version="true"></script><script src="~/js/production-week-openings.js" asp-append-version="true"></script><script src="~/js/production-week-workspace.js" asp-append-version="true"></script> }
@section Styles { <link rel="stylesheet" href="~/css/production-daily.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/production-week-workspace.css" asp-append-version="true"/> }
