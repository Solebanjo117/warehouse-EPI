@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.CreateModel
@{
    ViewData["Title"] = CatTexts["Crear producto"].Value;
}

<div class="product-editor-workspace" data-product-editor>
    <header class="product-editor-header">
        <div>
            <span class="product-editor-eyebrow">@CatTexts["Catálogo de productos"]</span>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="h2 mb-0">@CatTexts["Crear producto"]</h1>
                <span class="badge text-bg-primary">@CatTexts["Nuevo"]</span>
            </div>
            <p class="text-body-secondary mb-0">@CatTexts["Registra la identificación y configuración base del producto."]</p>
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary">@CatTexts["Volver a productos"]</a>
    </header>

    <partial name="_ProductForm" model="Model" />
</div>

<partial name="/Pages/Operations/CycleCounts/_CameraScanner.cshtml" />

@section Styles {
    <link rel="stylesheet" href="~/css/product-editor.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script>
    <script src="~/js/cycle-count.js" asp-append-version="true" defer></script>
    <script src="~/js/production-wip-defaults.js" asp-append-version="true" defer></script>
    <script src="~/js/product-editor.js" asp-append-version="true" defer></script>
}
