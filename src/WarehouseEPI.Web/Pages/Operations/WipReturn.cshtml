@page
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Operations.WipReturnModel
@{ ViewData["Title"] = "Devolución desde WIP"; }

<div class="operation-shell py-3">
    <a asp-page="/Index" class="small text-decoration-none">← Menú operativo</a>
    <h1 class="h2 mt-2 mb-1">Devolución desde WIP</h1>
    <p class="text-muted">Liga la excepción con el surtimiento original para impedir devoluciones excesivas.</p>

    <form method="get" class="operation-card mb-3">
        <label for="wip-search" class="form-label">Buscar salida WIP</label>
        <div class="input-group input-group-lg"><input id="wip-search" name="search" value="@Model.Search" class="form-control" placeholder="Folio, SKU, referencia, rack o WIP"/><button class="btn btn-outline-primary">Buscar</button></div>
    </form>

    <form method="post" class="operation-card">
        <input asp-for="Input.OperationId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (Model.SharingConflicts.Count != 0)
        {
            <div class="alert alert-warning"><strong>La ubicación destino ya contiene otros productos.</strong>@foreach(var conflict in Model.SharingConflicts){<div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="Input.ApprovedSharedLocationIds" value="@conflict.LocationId" id="approve-@conflict.LocationId" required/><label class="form-check-label" for="approve-@conflict.LocationId">Compartir @conflict.LocationCode con @string.Join(", ", conflict.ExistingProductSkus)</label></div>}</div>
        }
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Input.OriginalMovementLineId" class="form-label">Surtimiento original</label>
                <select asp-for="Input.OriginalMovementLineId" class="form-select form-select-lg" required>
                    <option value="">Selecciona…</option>
                    @foreach (var issue in Model.Issues
                        .Concat(Model.SelectedIssue is null ? [] : [Model.SelectedIssue])
                        .DistinctBy(item => item.MovementLineId))
                    {
                        <option value="@issue.MovementLineId">@issue.OccurredAt.ToString("dd/MM/yyyy") · @issue.ProductSku · @issue.SourceLocation → @issue.WipArea · disponible @issue.Returnable.ToString("0.####") @issue.Unit</option>
                    }
                </select>
                <span asp-validation-for="Input.OriginalMovementLineId" class="text-danger"></span>
            </div>
            <div class="col-md-6"><label asp-for="Input.Type" class="form-label">Destino de la devolución</label><select asp-for="Input.Type" class="form-select form-select-lg"><option value="WarehouseReturn">Regresar a bodega</option><option value="SupplierReturn">Devolver a proveedor</option></select></div>
            <div class="col-md-6"><label asp-for="Input.Quantity" class="form-label">Cantidad</label><input asp-for="Input.Quantity" class="form-control form-control-lg" inputmode="decimal" min="0.0001" step="0.0001" required/><span asp-validation-for="Input.Quantity" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.DestinationCode" class="form-label">Ubicación destino en bodega</label><input asp-for="Input.DestinationCode" class="form-control form-control-lg text-uppercase" placeholder="A-1-8"/><span asp-validation-for="Input.DestinationCode" class="text-danger"></span><div class="form-text">Solo aplica cuando regresa a bodega.</div></div>
            <div class="col-md-6"><label asp-for="Input.Reference" class="form-label">Referencia</label><input asp-for="Input.Reference" class="form-control form-control-lg" maxlength="120"/><span asp-validation-for="Input.Reference" class="text-danger"></span><div class="form-text">Obligatoria para devolución a proveedor.</div></div>
            <div class="col-12"><label asp-for="Input.Notes" class="form-label">Motivo / observaciones</label><textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="500"></textarea></div>
            <div class="col-md-6"><label asp-for="Input.Pin" class="form-label fw-semibold">NIP del responsable</label><input asp-for="Input.Pin" value="" class="form-control form-control-lg" type="password" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" required autocomplete="off"/></div>
            <div class="col-12 d-flex gap-2"><a asp-page="/Index" class="btn btn-outline-secondary btn-lg">Cancelar</a><button class="btn btn-primary btn-lg flex-grow-1">Confirmar devolución</button></div>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
