@page
@model WarehouseEPI.Web.Pages.Admin.Labels.Templates.IndexModel
@using WarehouseEPI.Core.Entities
@{
    ViewData["Title"] = "Diseñar formatos";
    string KindName(LabelTemplateKind kind) => kind == LabelTemplateKind.PalletLicensePlate ? "Placa de pallet" : "Etiqueta de producto";
    string StatusName(LabelTemplateStatus status) => status switch
    {
        LabelTemplateStatus.Draft => "Borrador",
        LabelTemplateStatus.InValidation => "En validación",
        LabelTemplateStatus.Published => "Publicada",
        _ => "Retirada",
    };
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h3 mb-1">Formatos de etiquetas</h1><p class="text-body-secondary mb-0">Cada formato imprime una sola versión. Las demás quedan como historial.</p></div>
        <a class="btn btn-outline-secondary" asp-page="../Assets/Index">Biblioteca de imágenes</a>
    </div>
    @if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <section class="card shadow-sm mb-4">
        <div class="card-header"><strong>Nueva plantilla</strong></div>
        <form method="post" asp-page-handler="Create" class="card-body row g-3 align-items-end">
            <div class="col-sm-4"><label asp-for="Create.Code" class="form-label">Código estable</label><input asp-for="Create.Code" class="form-control text-uppercase" placeholder="LBL-NUEVA" /></div>
            <div class="col-sm-4"><label asp-for="Create.Name" class="form-label">Nombre del formato</label><input asp-for="Create.Name" class="form-control" /></div>
            <div class="col-sm-3"><label asp-for="Create.Size" class="form-label">Tamaño</label><select asp-for="Create.Size" class="form-select">@foreach (var size in Model.Sizes) { <option value="@size.Preset">@size.Name</option> }</select></div>
            <div class="col-sm-1 d-grid"><button class="btn btn-primary" type="submit">Crear</button></div>
        </form>
    </section>

    @if (Model.Groups.Count == 0)
    {
        <div class="card shadow-sm"><div class="card-body text-center text-body-secondary py-5">Aún no hay formatos. Crea el primero con el formulario de arriba; la migración precarga LBL-6X4-ZEBRA.</div></div>
    }

    <div class="label-template-list" data-label-template-list>
        @foreach (var group in Model.Groups)
        {
            <article class="card shadow-sm label-template-card" data-label-template="@group.TemplateId">
                <div class="card-body">
                    <header class="label-template-header">
                        <div>
                            <h2 class="h5 mb-1">@group.Code</h2>
                            <p class="mb-0 small text-body-secondary">@group.Name · @KindName(group.Kind)</p>
                        </div>
                        @if (group.Current is null)
                        {
                            <span class="badge text-bg-warning">Sin versión publicada</span>
                        }
                    </header>

                    @if (group.Current is { } current)
                    {
                        <div class="label-version-row is-current" data-label-version="current">
                            <span class="label-version-role">Imprime hoy</span>
                            <span><strong class="label-version-number">v@(current.Version)</strong> <span class="text-body-secondary small">publicada el @current.UpdatedAt.ToLocalTime().ToString("g")</span></span>
                            <span class="label-version-actions">
                                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@current.VersionId">Ver</a>
                                @if (group.Editable is null)
                                {
                                    <form method="post" asp-page-handler="Duplicate" asp-route-id="@current.VersionId" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">Nueva versión</button></form>
                                }
                            </span>
                        </div>
                    }

                    @if (group.Editable is { } editable)
                    {
                        <div class="label-version-row is-editable" data-label-version="editable">
                            <span class="label-version-role">En edición</span>
                            <span><strong class="label-version-number">v@(editable.Version)</strong> <span class="text-body-secondary small">@StatusName(editable.Status) · @editable.UpdatedAt.ToLocalTime().ToString("g")</span></span>
                            <span class="label-version-actions">
                                <a class="btn btn-sm btn-primary" asp-page="Edit" asp-route-id="@editable.VersionId">Editar</a>
                            </span>
                        </div>
                    }

                    @if (group.History.Count > 0)
                    {
                        <details class="label-template-history">
                            <summary>@group.History.Count @(group.History.Count == 1 ? "versión anterior" : "versiones anteriores")</summary>
                            <table class="table table-sm align-middle mt-2 mb-0">
                                <caption class="visually-hidden">Historial de versiones de @group.Code</caption>
                                <thead><tr><th scope="col">Versión</th><th scope="col">Estado</th><th scope="col">Actualizada</th><th scope="col" class="text-end">Acciones</th></tr></thead>
                                <tbody>
                                @foreach (var version in group.History)
                                {
                                    <tr>
                                        <th scope="row" class="label-version-number fw-bold">v@(version.Version)</th>
                                        <td>@StatusName(version.Status)</td>
                                        <td>@version.UpdatedAt.ToLocalTime().ToString("g")</td>
                                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-page="Edit" asp-route-id="@version.VersionId">Ver</a></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </details>
                    }

                    @if (group.Current is { } retirable)
                    {
                        <details class="label-template-retire">
                            <summary>Retirar la versión que imprime hoy</summary>
                            <p class="small text-body-secondary mt-2 mb-2">Al retirarla, @group.Code deja de imprimir hasta que publiques otra versión.</p>
                            <form method="post" asp-page-handler="Retire" asp-route-id="@retirable.VersionId" class="row g-2">
                                <div class="col-md-7">
                                    <label class="form-label small" for="retire-reason-@group.TemplateId">Motivo</label>
                                    <input id="retire-reason-@group.TemplateId" name="RetireReason" class="form-control" maxlength="500" required />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" for="retire-pin-@group.TemplateId">NIP ADMIN</label>
                                    <input id="retire-pin-@group.TemplateId" name="RetirePin" class="form-control" type="password" autocomplete="off" required />
                                </div>
                                <div class="col-md-2 d-grid align-self-end"><button class="btn btn-danger" type="submit">Retirar</button></div>
                            </form>
                        </details>
                    }
                </div>
            </article>
        }
    </div>
</div>
