@page "{id:guid}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@model WarehouseEPI.Web.Pages.Operations.WipReturnReceiptModel
@{ ViewData["Title"] = OpTexts["Devolución registrada"].Value; }
<div class="receipt-shell"><div class="receipt-status receipt-success"><span class="receipt-icon">✓</span><div><h1 class="h3 mb-1">@OpTexts["Devolución a proveedor registrada"]</h1><p class="mb-0">@OpTexts["El inventario no se descontó nuevamente."]</p></div></div><section class="operation-card mt-4"><dl><dt>@OpTexts["Producto"]</dt><dd>@Model.Receipt.Sku</dd><dt>@OpTexts["Ubicación WIP"]</dt><dd>@Model.Receipt.Wip</dd><dt>@OpTexts["Cantidad"]</dt><dd>@Model.Receipt.Quantity.ToString("0.####") @Model.Receipt.Unit</dd><dt>@OpTexts["Responsable"]</dt><dd>@Model.Receipt.Responsible</dd><dt>@OpTexts["Fecha"]</dt><dd>@Model.Receipt.OccurredAt.ToString("dd/MM/yyyy HH:mm")</dd><dt>@OpTexts["Referencia"]</dt><dd>@Model.Receipt.Reference</dd></dl>@if(Model.Receipt.Notes is not null){<p>@Model.Receipt.Notes</p>}</section><div class="operation-actions"><a asp-page="/Index" class="btn btn-outline-secondary btn-lg">@OpTexts["Menú"]</a><a asp-page="/Operations/WipReturn" class="btn btn-primary btn-lg">@OpTexts["Nueva devolución"]</a></div></div>
