@page "/Admin/Catalogs/Locations/{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.DetailsModel
@{ ViewData["Title"] = $"Ubicación {Model.Location.Code}"; }
@if(Model.Location.OperationalRole==WarehouseEPI.Core.Entities.LocationOperationalRole.Wip){<div class="alert alert-warning"><strong>Rack WIP — no controla saldo.</strong> Se usa como destino informativo de surtimientos a producción y no admite asignaciones.</div>}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"><div><span class="text-body-secondary">Ubicación física</span><h1 class="h2 mb-1">@Model.Location.Code</h1><p class="text-body-secondary mb-0">@if(Model.Location.OperationalRole==WarehouseEPI.Core.Entities.LocationOperationalRole.Wip){<text>Rack WIP completo</text>}else if(Model.Location.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack){<text>Fila @Model.Location.RowCode · Rack @Model.Location.RackNumber · Pallet @Model.Location.PalletNumber</text>}else{<text>Área especial</text>}</p></div><div class="d-flex gap-2"><a asp-page="Index" asp-route-viewMode="map" asp-route-highlightLocationId="@Model.Location.Id" class="btn btn-primary">Ver en croquis</a><a asp-page="Index" asp-route-viewMode="table" class="btn btn-outline-secondary">Ubicaciones</a></div></div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}
<div class="card card-body mb-3"><div class="d-flex flex-wrap gap-2 align-items-center"><strong>Estado:</strong>@if(!Model.Location.IsActive){<span class="badge text-bg-secondary">Inactiva</span>}else if(Model.Location.IsBlocked){<span class="badge text-bg-warning">Bloqueada</span><span>@Model.Location.BlockReason</span>}else{<span class="badge text-bg-success">Disponible</span>}<span class="badge @(Model.IsMapped?"text-bg-primary":"text-bg-secondary")">@(Model.IsMapped?"Colocada en croquis":"Sin colocar en croquis")</span>@if(Model.Location.Description is not null){<span class="ms-md-auto">@Model.Location.Description</span>}</div></div>
<div class="row g-3 mb-4"><section class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="h4">Existencias actuales</h2><p class="text-body-secondary">Cantidades agrupadas por producto y unidad; los lotes internos permanecen transparentes.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Producto</th><th>Relación</th><th class="text-end">Saldo</th></tr></thead><tbody>@foreach(var item in Model.Balances){<tr><td><a asp-page="/Admin/Catalogs/Products/Edit" asp-route-id="@item.ProductId" class="fw-semibold">@item.Sku</a><div class="small text-body-secondary">@item.Description</div></td><td>@(item.IsAssigned?"Asignación activa":"Saldo sin asignación")</td><td class="text-end @(item.Quantity<0?"text-danger":"")">@item.Quantity.ToString("0.####") @item.Unit</td></tr>}@if(Model.Balances.Count==0){<tr><td colspan="3" class="text-center text-body-secondary py-4">Sin saldo actual.</td></tr>}</tbody></table></div><a asp-page="/Inventory/Index" asp-route-locationId="@Model.Location.Id" class="btn btn-outline-primary">Consultar existencias</a></div></div></section>
<section class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h4">Posiciones vecinas</h2>@if(Model.Neighbors.Count==0){<p class="text-body-secondary">Esta ubicación no tiene pallets vecinos.</p>}else{<div class="map-keypad">@foreach(var pallet in new short[]{7,8,9,4,5,6,1,2,3}){var item=Model.Neighbors.FirstOrDefault(value=>value.PalletNumber==pallet);if(item is null){<span class="map-position missing"><strong>@pallet</strong></span>}else{<a asp-page="Details" asp-route-id="@item.Id" class="map-position @(!item.IsActive?"inactive":item.IsBlocked?"blocked":"available")"><strong>@pallet</strong><small>@item.Code</small></a>}}</div>}</div></div></section></div>
<section class="card mb-4"><div class="card-body"><h2 class="h4">Productos asignados</h2><p class="text-body-secondary">La asignación permanece aunque el saldo sea cero y se conserva su historial al desactivarla.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>SKU / Producto</th><th>Asignación</th><th class="text-end">Acciones</th></tr></thead><tbody>@if(Model.Assignments.Count==0){<tr><td colspan="3" class="text-center text-body-secondary py-4">No hay productos asignados.</td></tr>}@foreach(var item in Model.Assignments){<tr class="@(!item.IsActive?"table-secondary":"")"><td><a asp-page="/Admin/Catalogs/Products/Edit" asp-route-id="@item.ProductId" class="fw-bold">@item.Sku</a><div class="small">@item.Description</div>@if(!item.ProductIsActive){<span class="badge text-bg-secondary">Producto inactivo</span>}</td><td>@(item.IsActive?"Asignada":"Histórica")</td><td class="text-end"><form method="post" asp-page-handler="@(item.IsActive?"Deactivate":"Assign")" asp-route-id="@Model.Location.Id"><input type="hidden" name="productId" value="@item.ProductId"/><button class="btn btn-outline-secondary" disabled="@(!item.IsActive&&(!Model.Location.IsActive||Model.Location.IsBlocked||!item.ProductIsActive))">@(item.IsActive?"Desasignar":"Reactivar")</button></form></td></tr>}</tbody></table></div></div></section>
<div class="row g-3"><section class="col-lg-7"><div class="card h-100"><div class="card-body"><h2 class="h4">Asignar otro producto</h2><form method="get" class="row g-2 mb-3"><input type="hidden" name="id" value="@Model.Location.Id"/><div class="col-md-9"><label for="productSearch" class="form-label">Buscar producto</label><input id="productSearch" name="productSearch" value="@Model.ProductSearch" class="form-control form-control-lg" placeholder="SKU, descripción, referencia o código"/></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary btn-lg w-100">Buscar</button></div></form>@if(!string.IsNullOrWhiteSpace(Model.ProductSearch)){<div class="list-group">@foreach(var product in Model.ProductResults){<div class="list-group-item d-flex justify-content-between gap-2"><div><strong>@product.Sku</strong><div class="small">@product.Description</div></div>@if(product.IsAssigned){<span class="badge text-bg-success">Asignado</span>}else{<form method="post" asp-page-handler="Assign" asp-route-id="@Model.Location.Id"><input type="hidden" name="productId" value="@product.Id"/><button class="btn btn-primary" disabled="@(!Model.Location.IsActive||Model.Location.IsBlocked)">Asignar</button></form>}</div>}@if(Model.ProductResults.Count==0){<div class="list-group-item text-body-secondary">Sin resultados.</div>}</div>}</div></div></section>
<section class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h4">Movimientos recientes</h2><div class="list-group list-group-flush">@foreach(var item in Model.RecentMovements){<a asp-page="/Admin/Inventory/Movements/Details" asp-route-id="@item.MovementId" class="list-group-item list-group-item-action"><div class="d-flex justify-content-between"><strong>@item.Type · @item.Sku</strong><span class="@(item.Delta<0?"text-danger":"")">@(item.Delta>0?"+":"")@item.Delta.ToString("0.####")</span></div><small>@item.OccurredAt.ToString("yyyy-MM-dd HH:mm")</small></a>}@if(Model.RecentMovements.Count==0){<p class="text-body-secondary">No hay movimientos relacionados.</p>}</div></div></div></section></div>
