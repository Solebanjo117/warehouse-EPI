@page "/Reports/Wip"
@model WarehouseEPI.Web.Pages.Reports.Wip.IndexModel
@{ ViewData["Title"] = "Reporte WIP"; }

@section Styles {
    <link rel="stylesheet" href="~/css/wip-report-index.css" asp-append-version="true" />
}

<div class="container py-4 wip-report">
    <header class="wip-report-header"><div><span class="eyebrow">Consulta operativa pública</span><h1 class="h2 mb-1">Inventario y actividad WIP</h1><p class="text-muted mb-0">Existencias reales por WIP y cambios efectivos dentro del periodo.</p></div>@if(User.IsInRole("ADMIN")){<div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="csv" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">CSV</a><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="xlsx" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">Excel</a></div>}</header>
    @if(Model.Attention == "aged"){<div class="alert alert-info"><strong>Saldo WIP estancado durante @Model.WipReminderDays días o más.</strong> Se muestran posiciones positivas cuya existencia conserva un lote antiguo. <a asp-page="Index" class="alert-link">Quitar filtro</a></div>}
    <form method="get" class="card card-body mb-4">@if(Model.Attention is not null){<input type="hidden" name="attention" value="@Model.Attention"/>}<div class="row g-2"><div class="col-md-2"><label class="form-label" for="wip-from">Desde</label><input id="wip-from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><label class="form-label" for="wip-to">Hasta</label><input id="wip-to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-3"><label class="form-label" for="wip-search">Buscar</label><input id="wip-search" name="search" value="@Model.Search" class="form-control" type="search" autocomplete="off"/><span class="form-text">Producto, rack, responsable o referencia.</span></div><div class="col-md-3"><label class="form-label" for="wip-area">Rack WIP</label><select id="wip-area" name="wipAreaId" class="form-select"><option value="">Todos</option>@foreach(var area in Model.WipAreas){<option value="@area.Id" selected="@(Model.WipAreaId==area.Id)">@area.Code</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Consultar</button></div></div></form>
    <partial name="_TrackedReport" model="Model" />
    <div class="wip-report-section-head">
        <h2>Resumen semanal</h2>
        <p>Agrupa por semana y producto. <strong>Consumo asumido</strong> es lo enviado menos lo devuelto a bodega y lo devuelto a proveedor: material que salió al rack WIP y no regresó.</p>
    </div>
    <div class="table-responsive mb-4"><table class="table table-striped align-middle report-cards"><thead><tr><th scope="col">Semana</th><th scope="col">Producto</th><th scope="col">WIP</th><th scope="col" class="text-end">Enviado</th><th scope="col" class="text-end">A bodega</th><th scope="col" class="text-end">A proveedor</th><th scope="col" class="text-end">Consumo asumido</th></tr></thead><tbody>@if(Model.Report.Summary.Count==0){<tr class="report-empty-row"><td colspan="7" class="analytics-empty">No hay surtimientos en el periodo.</td></tr>}@foreach(var row in Model.Report.Summary){<tr><td data-label="Semana"><span class="wip-week">@row.WeekStart.ToString("dd/MM/yyyy") al @row.WeekEnd.ToString("dd/MM/yyyy")</span></td><td data-label="Producto"><span class="wip-sku">@row.ProductSku</span> <span class="text-muted">@row.Unit</span></td><td data-label="WIP"><span class="wip-area">@row.WipArea</span></td><td data-label="Enviado" class="text-end wip-amount">@row.Issued.ToString("0.####")</td><td data-label="A bodega" class="text-end wip-amount">@row.WarehouseReturned.ToString("0.####")</td><td data-label="A proveedor" class="text-end wip-amount">@row.SupplierReturned.ToString("0.####")</td><td data-label="Consumo asumido" class="text-end wip-consumed">@row.AssumedConsumed.ToString("0.####")</td></tr>}</tbody></table></div>
    <div class="wip-report-section-head">
        <h2>Detalle de surtimientos</h2>
        <p>Cada línea de surtimiento del período, con su folio para rastrearla hasta el movimiento original.</p>
    </div>
    <div class="table-responsive"><table class="table align-middle report-cards"><thead><tr><th scope="col">Fecha / folio</th><th scope="col">Trayecto</th><th scope="col">Producto</th><th scope="col" class="text-end">Enviado</th><th scope="col" class="text-end">Consumo asumido</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>@if(Model.Report.Items.Count==0){<tr class="report-empty-row"><td colspan="6" class="analytics-empty">No hay surtimientos con los filtros seleccionados. Amplía el período o limpia algún criterio.</td></tr>}@foreach(var row in Model.Report.Items){<tr><td data-label="Fecha / folio"><span class="wip-when">@row.OccurredAt.ToString("dd/MM/yyyy HH:mm")</span><div class="small text-muted"><span class="wip-folio">@row.MovementId.ToString()[..8]</span> <button type="button" class="btn btn-link btn-sm p-0" data-copy-value="@row.MovementId" aria-label="Copiar folio completo @row.MovementId">Copiar</button></div></td><td data-label="Trayecto"><span class="wip-route">@row.SourceLocation<svg class="wip-route-arrow" aria-hidden="true"><use href="#icon-chevron" /></svg><span class="wip-area">@row.WipArea</span></span></td><td data-label="Producto"><span class="wip-sku">@row.ProductSku</span><span class="wip-line-meta">@row.Responsible @row.Reference</span></td><td data-label="Enviado" class="text-end wip-amount">@row.Issued.ToString("0.####") @row.Unit</td><td data-label="Consumo asumido" class="text-end wip-consumed">@row.AssumedConsumed.ToString("0.####") @row.Unit</td><td data-label="" class="text-end"><a asp-page="Details" asp-route-id="@row.MovementLineId" class="btn btn-sm btn-outline-primary">Detalle</a></td></tr>}</tbody></table></div>
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
    @if(Model.TotalPages>1){<nav aria-label="Paginación WIP"><ul class="pagination justify-content-center flex-wrap"><li class="page-item @(Model.Report.PageNumber<=1?"disabled":null)">@if(Model.Report.PageNumber<=1){<span class="page-link">Primera</span>}else{<a class="page-link" asp-route-pageNumber="1" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Primera</a>}</li><li class="page-item @(Model.Report.PageNumber<=1?"disabled":null)">@if(Model.Report.PageNumber<=1){<span class="page-link">Anterior</span>}else{<a class="page-link" asp-route-pageNumber="@(Model.Report.PageNumber-1)" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Anterior</a>}</li>@foreach(var pageNumber in Model.VisiblePages){<li class="page-item @(pageNumber==Model.Report.PageNumber?"active":null)"><a class="page-link" aria-current="@(pageNumber==Model.Report.PageNumber?"page":null)" asp-route-pageNumber="@pageNumber" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@pageNumber</a></li>}<li class="page-item @(Model.Report.PageNumber>=Model.TotalPages?"disabled":null)">@if(Model.Report.PageNumber>=Model.TotalPages){<span class="page-link">Siguiente</span>}else{<a class="page-link" asp-route-pageNumber="@(Model.Report.PageNumber+1)" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Siguiente</a>}</li><li class="page-item @(Model.Report.PageNumber>=Model.TotalPages?"disabled":null)">@if(Model.Report.PageNumber>=Model.TotalPages){<span class="page-link">Última</span>}else{<a class="page-link" asp-route-pageNumber="@Model.TotalPages" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Última</a>}</li></ul></nav>}
</div>
