@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Operations.WipReturnReceiptModel
@{ ViewData["Title"] = "Devolución registrada"; }
<div class="receipt-shell"><div class="receipt-status receipt-success"><span class="receipt-icon">✓</span><div><h1 class="h3 mb-1">Devolución a proveedor registrada</h1><p class="mb-0">El inventario no se descontó nuevamente.</p></div></div><section class="operation-card mt-4"><dl><dt>Producto</dt><dd>@Model.Receipt.Sku</dd><dt>Rack WIP</dt><dd>@Model.Receipt.Wip</dd><dt>Cantidad</dt><dd>@Model.Receipt.Quantity.ToString("0.####") @Model.Receipt.Unit</dd><dt>Responsable</dt><dd>@Model.Receipt.Responsible</dd><dt>Fecha</dt><dd>@Model.Receipt.OccurredAt.ToString("dd/MM/yyyy HH:mm")</dd><dt>Referencia</dt><dd>@Model.Receipt.Reference</dd></dl>@if(Model.Receipt.Notes is not null){<p>@Model.Receipt.Notes</p>}</section><div class="operation-actions"><a asp-page="/Index" class="btn btn-outline-secondary btn-lg">Menú</a><a asp-page="/Operations/WipReturn" class="btn btn-primary btn-lg">Nueva devolución</a></div></div>
