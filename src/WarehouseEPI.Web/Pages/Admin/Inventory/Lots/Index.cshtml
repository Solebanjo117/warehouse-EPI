@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@using WarehouseEPI.Infrastructure.Inventory
@model WarehouseEPI.Web.Pages.Admin.Inventory.Lots.IndexModel
@{
    ViewData["Title"] = CatTexts["Lotes internos"].Value;
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || Model.Balance != LotBalanceFilter.All
        || Model.Date != LotDateFilter.All
        || Model.From is not null
        || Model.To is not null;
    var balanceLabel = Model.Balance switch
    {
        LotBalanceFilter.WithBalance => CatTexts["Con saldo"].Value,
        LotBalanceFilter.Positive => CatTexts["Positivos"].Value,
        LotBalanceFilter.Negative => CatTexts["Negativos"].Value,
        LotBalanceFilter.Exhausted => CatTexts["Agotados"].Value,
        _ => null
    };
    var dateLabel = Model.Date switch
    {
        LotDateFilter.WithDate => CatTexts["Con fecha"].Value,
        LotDateFilter.WithoutDate => CatTexts["Sin fecha"].Value,
        _ => null
    };
    var fromValue = Model.From?.ToString("yyyy-MM-dd");
    var toValue = Model.To?.ToString("yyyy-MM-dd");
    var totalLabel = Model.Results.TotalCount.ToString("N0");
}

@section Styles {
    <link rel="stylesheet" href="~/css/lots-index.css" asp-append-version="true" />
}

<div class="lots-page">
    <header class="lots-header">
        <div>
            <span class="eyebrow">@CatTexts["Consulta de inventario"]</span>
            <h1 class="h2 mb-1">@CatTexts["Lotes internos"]</h1>
            <p>@CatTexts["Consulta lotes, fechas y saldos por producto."]</p>
        </div>
        <p class="lots-tally mb-0">
            <strong>@totalLabel</strong>
            <span>@(Model.Results.TotalCount == 1 ? CatTexts["Lote"].Value : CatTexts["Lotes"].Value)</span>
        </p>
    </header>

    <p class="lots-note">
        <strong>@CatTexts["Los lotes se generan automáticamente."]</strong>
        <span>@CatTexts["No se crean ni se seleccionan manualmente: cada entrada del día alimenta el lote interno que le corresponde."]</span>
    </p>

    <form method="get" class="lots-filters">
        <fieldset>
            <legend class="lots-filter-legend">@CatTexts["Filtros de búsqueda"]</legend>
            <div class="row g-3">
                <div class="col-12 col-xl-4">
                    <label class="form-label" for="lot-search">@CatTexts["Buscar"]</label>
                    <input id="lot-search" name="search" value="@Model.Search" class="form-control form-control-lg" type="search" autocomplete="off" placeholder="@CatTexts["Lote, SKU, descripción, referencia o código"]" autofocus />
                </div>
                <div class="col-6 col-md-3 col-xl-2">
                    <label class="form-label" for="lot-balance">@CatTexts["Saldo"]</label>
                    <select id="lot-balance" name="balance" class="form-select">
                        <option value="All" selected="@(Model.Balance == LotBalanceFilter.All)">@CatTexts["Todos los saldos"]</option>
                        <option value="WithBalance" selected="@(Model.Balance == LotBalanceFilter.WithBalance)">@CatTexts["Con saldo"]</option>
                        <option value="Positive" selected="@(Model.Balance == LotBalanceFilter.Positive)">@CatTexts["Positivos"]</option>
                        <option value="Negative" selected="@(Model.Balance == LotBalanceFilter.Negative)">@CatTexts["Negativos"]</option>
                        <option value="Exhausted" selected="@(Model.Balance == LotBalanceFilter.Exhausted)">@CatTexts["Agotados"]</option>
                    </select>
                </div>
                <div class="col-6 col-md-3 col-xl-2">
                    <label class="form-label" for="lot-date">@CatTexts["Fecha interna"]</label>
                    <select id="lot-date" name="date" class="form-select">
                        <option value="All" selected="@(Model.Date == LotDateFilter.All)">@CatTexts["Toda fecha"]</option>
                        <option value="WithDate" selected="@(Model.Date == LotDateFilter.WithDate)">@CatTexts["Con fecha"]</option>
                        <option value="WithoutDate" selected="@(Model.Date == LotDateFilter.WithoutDate)">@CatTexts["Sin fecha"]</option>
                    </select>
                </div>
                <div class="col-6 col-md-3 col-xl-2">
                    <label class="form-label" for="lot-from">@CatTexts["Desde"]</label>
                    <input id="lot-from" name="from" value="@fromValue" class="form-control" type="date" />
                </div>
                <div class="col-6 col-md-3 col-xl-2">
                    <label class="form-label" for="lot-to">@CatTexts["Hasta"]</label>
                    <input id="lot-to" name="to" value="@toValue" class="form-control" type="date" />
                    <span class="form-text">@CatTexts["El rango se aplica a la fecha interna del lote."]</span>
                </div>
            </div>
            <div class="lots-filter-actions">
                <button type="submit" class="btn btn-primary btn-lg">@CatTexts["Buscar"]</button>
                <a asp-page="Index" class="btn btn-outline-secondary">@CatTexts["Limpiar filtros"]</a>
                @if (hasFilters)
                {
                    <span class="lots-active">
                        <span class="lots-active-label">@CatTexts["Filtros activos"]</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Search))
                        {
                            <span class="lots-chip">Texto: @Model.Search</span>
                        }
                        @if (balanceLabel is not null)
                        {
                            <span class="lots-chip">Saldo: @balanceLabel</span>
                        }
                        @if (dateLabel is not null)
                        {
                            <span class="lots-chip">Fecha: @dateLabel</span>
                        }
                        @if (fromValue is not null)
                        {
                            <span class="lots-chip">Desde @fromValue</span>
                        }
                        @if (toValue is not null)
                        {
                            <span class="lots-chip">Hasta @toValue</span>
                        }
                    </span>
                }
            </div>
        </fieldset>
    </form>

    @if (Model.Results.Items.Count == 0)
    {
        <div class="lots-empty">
            @if (hasFilters)
            {
                <strong>@CatTexts["Ningún lote coincide con estos filtros."]</strong>
                <p>@CatTexts["Ajusta la búsqueda o el rango de fechas, o limpia los filtros para ver todos los lotes."]</p>
                <a asp-page="Index" class="btn btn-primary btn-lg">@CatTexts["Limpiar filtros"]</a>
            }
            else
            {
                <strong>@CatTexts["Todavía no hay lotes internos."]</strong>
                <p>@CatTexts["Los lotes aparecen solos al registrar la primera entrada; no hay nada que crear desde aquí."]</p>
            }
        </div>
    }
    else
    {
        <p class="lots-count mb-0">@CatTexts["Mostrando {0} de {1} lotes.", Model.Results.Items.Count, totalLabel]</p>
        <table class="table lots-table align-middle">
            <caption class="visually-hidden">@CatTexts["Lotes internos con su producto, fecha interna, ubicaciones y saldo."]</caption>
            <thead>
                <tr>
                    <th scope="col">@CatTexts["Lote"]</th>
                    <th scope="col">@CatTexts["Producto"]</th>
                    <th scope="col">@CatTexts["Fecha interna"]</th>
                    <th scope="col" class="text-end">@CatTexts["Ubicaciones"]</th>
                    <th scope="col" class="text-end">@CatTexts["Saldo total"]</th>
                    <th scope="col"><span class="visually-hidden">@CatTexts["Ficha del lote"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td class="lots-cell-lot">
                            <a class="lots-number" asp-page="Details" asp-route-id="@item.Id">@item.Number</a>
                        </td>
                        <td class="lots-cell-product">
                            <a class="lots-sku" asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@item.ProductId">@item.Sku</a>
                            <span class="lots-description">@item.Description</span>
                        </td>
                        <td class="lots-cell-date" data-label="@CatTexts["Fecha interna"]">
                            @if (item.LotDate is DateOnly lotDate)
                            {
                                <time class="lots-date" datetime="@lotDate.ToString("yyyy-MM-dd")">@lotDate.ToString("yyyy-MM-dd")</time>
                            }
                            else
                            {
                                <span class="lots-date lots-muted">@CatTexts["Sin fecha"]</span>
                            }
                        </td>
                        <td class="lots-cell-locations text-end" data-label="@CatTexts["Ubicaciones"]">
                            <span class="lots-locations">@item.Locations</span>
                        </td>
                        <td class="lots-cell-balance text-end">
                            <span class="lots-balance @(item.Quantity < 0 ? "is-negative" : null)">
                                <strong>@item.Quantity.ToString("0.####") @item.Unit</strong>
                                @if (item.Quantity < 0)
                                {
                                    <small>@CatTexts["Saldo negativo"]</small>
                                }
                            </span>
                        </td>
                        <td class="lots-cell-action text-end">
                            <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary" aria-label="Ver ficha del lote @item.Number">@CatTexts["Ver ficha"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="lots-pager" aria-label="@CatTexts["Paginación de lotes"]">
            @if (Model.PageNumber > 1)
            {
                <a class="btn btn-outline-secondary"
                   asp-route-search="@Model.Search"
                   asp-route-balance="@Model.Balance"
                   asp-route-date="@Model.Date"
                   asp-route-from="@fromValue"
                   asp-route-to="@toValue"
                   asp-route-pageNumber="@(Model.PageNumber - 1)">@CatTexts["Anterior"]</a>
            }
            else
            {
                <span class="btn btn-outline-secondary disabled lots-pager-step" aria-disabled="true">@CatTexts["Anterior"]</span>
            }
            <span class="lots-pager-position">@CatTexts["Página {0} de {1}", Model.PageNumber, Model.TotalPages]</span>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="btn btn-outline-secondary"
                   asp-route-search="@Model.Search"
                   asp-route-balance="@Model.Balance"
                   asp-route-date="@Model.Date"
                   asp-route-from="@fromValue"
                   asp-route-to="@toValue"
                   asp-route-pageNumber="@(Model.PageNumber + 1)">@CatTexts["Siguiente"]</a>
            }
            else
            {
                <span class="btn btn-outline-secondary disabled lots-pager-step" aria-disabled="true">@CatTexts["Siguiente"]</span>
            }
        </nav>
    }
</div>
