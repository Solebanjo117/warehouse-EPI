@model WarehouseEPI.Web.Pages.Operations.Production.IndexModel
@using WarehouseEPI.Core.Entities
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> T
@{
    string Area(ProductionDailyArea area) => T[area switch { ProductionDailyArea.Cutting => "Corte", ProductionDailyArea.Sewing => "Costura", _ => "Ready to Pack" }];
    var shift = Model.MatrixShiftName ?? Model.Shifts.FirstOrDefault(x => x.Id == Model.Group.ShiftId)?.Name ?? T["Sin turno"];
    var date = Model.Group.Date.ToString("dd MMM yyyy", CultureInfo.CurrentUICulture);
}
<section class="production-entry mb-4" aria-labelledby="daily-entry-heading" data-capture-entry
         data-cutting-label="@T["Corte"]" data-sewing-label="@T["Costura"]" data-ready-label="@T["Ready to Pack"]"
         data-context-state="@Model.CaptureState" data-date="@Model.Group.Date.ToString("yyyy-MM-dd")"
         data-all-areas="@(Model.Group.AllAreas ? "true" : "false")" data-area="@Model.Group.Area" data-shift="@Model.Group.ShiftId" data-context-label="@date · @shift">
<div class="production-entry__body">
<h2 id="daily-entry-heading" class="visually-hidden">@T["Registrar producción"]</h2>
@if (Model.CaptureOpen) { <p class="production-entry__intro">@T["Escribe las cantidades a sumar; revisa antes de confirmar."]</p> }
<form method="get" class="row g-3 production-entry__context" data-context-form data-matrix-context>
    <input name="Tab" type="hidden" value="capture" />
    <input name="Day" value="@Model.Group.Date.ToString("yyyy-MM-dd")" type="hidden" data-capture-day-value />
    <div class="col-12 col-md-7"><label for="group-week" class="form-label">@T["Semana"]</label>
        <select id="group-week" name="WeekId" class="form-select form-select-lg" data-capture-week>
            <option value="">@T["Selecciona una semana"]</option>
            @foreach (var week in Model.Weeks) { <option value="@week.Id" data-start="@week.WeekStart.ToString("yyyy-MM-dd")" selected="@(week.Id == Model.CaptureWeek?.Id)">@week.WeekStart.ToString("dd/MM/yyyy")–@week.WeekEnd.ToString("dd/MM/yyyy") · @WarehouseEPI.Web.Production.ProductionDailyText.WeekStatus(T, week.Status)</option> }
        </select>
    </div>
    <div class="col-12 col-md-5"><label for="group-shift" class="form-label">@T["Turno"]</label><select id="group-shift" name="ShiftId" class="form-select form-select-lg" data-capture-shift>@foreach (var item in Model.Shifts) { <option value="@item.Id" selected="@(item.Id == Model.Group.ShiftId)">@item.Name</option> }</select></div>
    @if (Model.CaptureWeek is not null)
    {
        <nav class="d-flex gap-2 overflow-auto py-2" aria-label="@T["Días de la semana"]">
        @foreach (var day in WarehouseEPI.Core.Entities.ProductionWeekCalendar.Days(Model.CaptureWeek.WeekStart))
        { <button type="button" class="btn @(day == Model.Group.Date ? "btn-primary" : "btn-outline-primary") flex-shrink-0" data-capture-day="@day.ToString("yyyy-MM-dd")" aria-current="@(day == Model.Group.Date ? "date" : null)">@day.ToString("ddd dd/MM", CultureInfo.CurrentUICulture)</button> }
        </nav>
    }
    <p class="mb-0"><strong>@date · @shift</strong> · @T["Corte"] / @T["Costura"] / @T["Ready to Pack"] · <strong>@(!Model.ConfigurationReady ? T["Configuración incompleta"] : Model.CaptureWeek is null ? T["Sin semana"] : WarehouseEPI.Web.Production.ProductionDailyText.WeekStatus(T, Model.CaptureWeek.Status))</strong></p>
    <noscript><button class="btn btn-primary" type="submit">@T["Aplicar"]</button></noscript>
</form>
@if (Model.MatrixRestored) { <p class="alert alert-info" role="status" data-matrix-restored>@T["Captura pendiente recuperada"]</p> }
@if (!Model.CaptureOpen)
{
    <div class="alert alert-warning mt-3" role="status">
        <p>@T[Model.ConfigurationReady ? Model.CaptureContextMessage! : "Completa la configuración de áreas y turnos activos antes de capturar."]</p>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.CaptureWeek is not null) { <a class="btn btn-outline-secondary" asp-page="Index" asp-route-Tab="balance" asp-route-WeekId="@Model.CaptureWeek.Id" asp-route-Through="@Model.Group.Date.ToString("yyyy-MM-dd")" data-capture-context-link>@T["Ver balance"]</a> }
            <a href="#group-week" class="btn btn-outline-secondary" data-change-capture-date>@T["Cambiar fecha"]</a>
            @if (User.IsInRole("ADMIN")) { <a class="btn btn-outline-primary" asp-page="/Admin/Production/Schedule" asp-route-WeekId="@Model.CaptureWeek?.Id" asp-fragment="@(!Model.ConfigurationReady ? "daily-configuration" : null)" data-capture-context-link>@T[Model.ConfigurationReady ? "Programa semanal" : "Configurar áreas y turnos"]</a> }
            else if (!Model.ConfigurationReady) { <span>@T["Contacta al administrador para habilitar la captura."]</span> }
        </div>
    </div>
}
<div data-draft-warning class="alert alert-warning mt-3" role="status" hidden
     data-storage-error="@T["La recuperación temporal no está disponible. Conserva esta pestaña abierta hasta confirmar."]"
     data-corrupt="@T["El borrador temporal no se puede leer. Puedes descartarlo e iniciar otra captura."]"></div>
<section class="alert alert-info mt-3" data-draft-banner hidden aria-label="@T["Captura pendiente"]">
    <strong>@T["Hay una captura sin confirmar en esta pestaña."]</strong>
    <p data-draft-summary class="mb-2"></p>
    @if (!Model.CaptureOpen) { <p>@T["Las cantidades pendientes se conservan; esta fecha no permite capturar."]</p> }
    <form method="post" asp-page-handler="GroupRestore" data-draft-restore class="d-flex flex-wrap gap-2">
        <div data-draft-fields></div>
        <button type="submit" class="btn btn-primary" data-draft-recover>@T["Recuperar captura"]</button>
        <button type="button" class="btn btn-outline-secondary" data-draft-discard>@T["Descartar"]</button>
    </form>
</section>
@if (Model.Receipt is not null)
{
    <section class="alert alert-success production-entry__receipt" role="status" aria-labelledby="capture-receipt-heading" data-receipt-operation="@Model.Receipt.OperationId">
        <h3 id="capture-receipt-heading" class="h5">@T["Producción registrada"]</h3>
        <p>@T["Responsable"]: @Model.Receipt.Responsible · @T["Registro"]: <code>@Model.Receipt.Id</code></p>
        <ul>@foreach (var item in Model.Receipt.Items) { <li><strong>@item.Sku</strong> · @Area(item.Area) · @item.Quantity.ToString("0.####", CultureInfo.InvariantCulture) @item.Unit</li> }</ul>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Index" asp-route-Tab="capture" asp-route-Day="@Model.Group.Date.ToString("yyyy-MM-dd")" asp-route-ShiftId="@Model.Group.ShiftId" class="btn btn-success" data-capture-context-link>@T["Nueva captura"]</a>
            <a asp-page="Index" asp-route-Tab="history" asp-route-WeekId="@Model.CaptureWeek?.Id" asp-route-Day="@Model.Group.Date.ToString("yyyy-MM-dd")" asp-route-ShiftId="@Model.Group.ShiftId" asp-fragment="@($"capture-{Model.Receipt.Items.First().CaptureId}")" class="btn btn-outline-success" data-capture-context-link>@T["Ver registro"]</a>
        </div>
    </section>
}
<form id="capture-group" method="post" autocomplete="off" data-capture-group
      data-matrix="@(Model.Group.AllAreas ? "true" : "false")" data-server-post="@(Context.Request.Method == "POST" ? "true" : "false")" data-restore-conflict="@(Model.RestoreConflict ? "true" : "false")"
      data-unsaved-message="@T["Hay cantidades sin confirmar. ¿Quieres salir de esta captura?"]"
      data-quantity-error="@T[WarehouseEPI.Web.Pages.Operations.Production.ProductionQuantityBinder.Error]"
      data-inactive-error="@T["El producto ya no está activo. Limpia esta fila para continuar."]"
      data-range-error="@T["La cantidad supera el máximo permitido: 99999999999999.9999."]"
      data-registering="@T["Registrando…"]" data-working="@T["Procesando…"]">
    <input name="Sku" value="@Model.Sku" type="hidden" /><input name="Reference" value="@Model.Reference" type="hidden" />
    <input asp-for="Group.AllAreas" type="hidden" /><input asp-for="Group.FocusArea" type="hidden" /><input asp-for="Group.LegacySource" type="hidden" /><input asp-for="Group.LegacyOperationId" type="hidden" /><input asp-for="WeekId" type="hidden" /><input asp-for="Group.OperationId" type="hidden" /><input asp-for="Group.Fingerprint" type="hidden" /><input asp-for="Group.Date" type="hidden" /><input asp-for="Group.Area" type="hidden" /><input asp-for="Group.ShiftId" type="hidden" /><input asp-for="Group.Mode" type="hidden" />
    @if (Model.CaptureOpen)
    {
        <fieldset disabled="@Model.RestoreConflict">
        <div data-capture-editor>
            <button type="submit" asp-page-handler="GroupMode" hidden data-group-mode-submit></button>
            <div class="production-entry__modes d-flex flex-wrap gap-2 my-3" role="group" aria-label="@T["Forma de captura"]">
                <button type="button" class="btn btn-outline-primary" data-capture-mode="list" aria-pressed="@(Model.Group.Mode == "list" ? "true" : "false")">@T["Lista de pendientes"]</button>
                <button type="button" class="btn btn-outline-primary" data-capture-mode="quick" aria-pressed="@(Model.Group.Mode == "quick" ? "true" : "false")">@T["Captura rápida"]</button>
            </div>
            <p data-quick-guidance hidden class="small text-body-secondary">@T["Busca o escanea un SKU, escribe la cantidad y pulsa Enter para continuar."]</p>
            <p data-scan-destination class="small" hidden>@T["Área de captura"]: <strong data-scan-area></strong></p>
            <div class="row g-2 mb-3 production-entry__add">
                <div class="col-md-9 production-entry__picker" data-daily-product-field data-url="@Url.Page("Index", "DailyProducts", new { allAreas = Model.Group.AllAreas })" data-resolve-url="@Url.Page("/Operations/Lookup", "ResolveProduct")"
                     data-planned="@T["Programados esta semana"]" data-pending="@T["Pendientes anteriores"]" data-other="@T["Otros productos activos"]"
                     data-loading="@T["Buscando productos…"]" data-more="@T["Cargar más"]" data-empty="@T["No hay coincidencias. Busca otro SKU o descripción."]" data-error="@T["No se pudieron consultar los productos. Vuelve a buscar."]">
                    <label for="group-add-product" class="form-label">@T["Buscar o agregar producto"]</label>
                    <input asp-for="Group.AddProductId" type="hidden" data-product-id />
                    <input id="group-add-product" type="search" class="form-control form-control-lg" data-product-input autocomplete="off" autocapitalize="characters" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="group-product-results" />
                    <div id="group-product-results" class="list-group production-entry__results" role="listbox" data-product-results></div>
                </div>
                <div class="col-md-3 d-grid align-items-end"><button asp-page-handler="GroupAdd" class="btn btn-outline-primary" data-daily-product-add>@T["Agregar producto"]</button></div>
            </div>
            <partial name="@(Model.Group.AllAreas ? "_MatrixRows" : "_CaptureRows")" model="Model" />
            <details class="production-entry__help"><summary>@T["Ayuda para capturar"]</summary><p>@T["Estas cantidades se agregan a lo ya registrado. Para modificar un total, usa Tabla y balance."]</p><p>@T["El pendiente es una referencia. Puedes registrar extras o piezas cuya etapa anterior aún no se ha capturado."]</p><p>@T["Primero los productos de la semana. Escribe dos caracteres para buscar también en el catálogo."]</p></details>
            @if (Model.CaptureEmptyMessage is not null)
            {
                <div class="alert alert-info" role="status"><p>@T[Model.CaptureEmptyMessage]</p>
                @foreach (var availableArea in Model.OtherAvailableAreas)
                { <a class="btn btn-outline-secondary me-2 mb-2" asp-page="Index" asp-route-Tab="capture" asp-route-Day="@Model.Group.Date.ToString("yyyy-MM-dd")" asp-route-Area="@availableArea.Key" asp-route-ShiftId="@Model.Group.ShiftId" data-capture-context-link>@Area(availableArea.Key) · @T["Productos disponibles: {0}", availableArea.Value]</a> }
                </div>
            }
            <div class="production-entry__actions" data-capture-actions data-count-label="@T["Productos con cantidad"]">
                <span data-capture-count role="status" aria-live="polite">@T["Productos con cantidad"]: 0</span><span data-capture-units></span>
                <button asp-page-handler="GroupPreview" class="btn btn-primary btn-lg" data-group-preview disabled="@(Model.Group.Rows.Count == 0)">@T["Revisar captura"]</button>
            </div>
        </div>
        <partial name="@(Model.Group.AllAreas ? "_MatrixReview" : "_CaptureReview")" model="Model" />
        </fieldset>
    }
</form>
</div>
</section>
