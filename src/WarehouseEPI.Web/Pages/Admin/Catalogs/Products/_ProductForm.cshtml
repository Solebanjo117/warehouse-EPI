@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.IProductFormPage
@{
    var isEditing = Model.Input.Id != Guid.Empty;
}

<form method="post" class="product-editor-form">
    <div asp-validation-summary="All" class="alert alert-danger product-editor-validation" role="alert"></div>
    <input asp-for="Input.Id" type="hidden" />

    <div class="product-editor-form-grid">
        <section class="card product-editor-card" aria-labelledby="product-information-heading">
            <div class="card-body p-3 p-md-4">
                <div class="product-editor-section-heading">
                    <div>
                        <span class="product-editor-step">Datos principales</span>
                        <h2 id="product-information-heading" class="h4 mb-1">Información del producto</h2>
                        <p class="text-body-secondary mb-0">Los campos marcados con * son obligatorios.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-5">
                        <label asp-for="Input.Sku" class="form-label fw-semibold">SKU <span class="text-danger" aria-hidden="true">*</span></label>
                        <input asp-for="Input.Sku" class="form-control form-control-lg text-uppercase" autocomplete="off" aria-required="true" autofocus />
                        <div class="form-text">Identificador único usado para búsquedas y operación.</div>
                        <span asp-validation-for="Input.Sku" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-7">
                        <label asp-for="Input.ExternalReference" class="form-label fw-semibold">Referencia externa <span class="text-body-secondary fw-normal">(opcional)</span></label>
                        <input asp-for="Input.ExternalReference" class="form-control form-control-lg" autocomplete="off" />
                        <div class="form-text">Número o referencia utilizada por otro sistema.</div>
                        <span asp-validation-for="Input.ExternalReference" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label fw-semibold">Descripción <span class="text-body-secondary fw-normal">(opcional)</span></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="5" placeholder="Describe el producto para reconocerlo con facilidad"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <aside class="card product-editor-card" aria-labelledby="product-settings-heading">
            <div class="card-body p-3 p-md-4">
                <div class="product-editor-section-heading">
                    <div>
                        <span class="product-editor-step">Control de catálogo</span>
                        <h2 id="product-settings-heading" class="h4 mb-1">Configuración</h2>
                        <p class="text-body-secondary mb-0">Clasificación y parámetros de inventario.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Input.BaseUnitId" class="form-label fw-semibold">Unidad base <span class="text-danger" aria-hidden="true">*</span></label>
                        <select asp-for="Input.BaseUnitId" asp-items="Model.Units" class="form-select product-editor-control" aria-required="true">
                            <option value="">Seleccione una unidad</option>
                        </select>
                        <div class="form-text">Las existencias se registrarán directamente en esta unidad.</div>
                        <span asp-validation-for="Input.BaseUnitId" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-12">
                        <label asp-for="Input.ProductTypeId" class="form-label fw-semibold">Tipo <span class="text-body-secondary fw-normal">(opcional)</span></label>
                        <select asp-for="Input.ProductTypeId" asp-items="Model.Types" class="form-select product-editor-control">
                            <option value="">Sin tipo</option>
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-lg-12">
                        <label asp-for="Input.ProductClassId" class="form-label fw-semibold">Clase <span class="text-body-secondary fw-normal">(opcional)</span></label>
                        <select asp-for="Input.ProductClassId" asp-items="Model.Classes" class="form-select product-editor-control">
                            <option value="">Sin clase</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.MinimumStock" class="form-label fw-semibold">Stock mínimo</label>
                        <div class="input-group">
                            <input asp-for="Input.MinimumStock" class="form-control product-editor-control" type="number" min="0" step="0.0001" />
                            <span class="input-group-text">mínimo</span>
                        </div>
                        <div class="form-text">Se usa para identificar existencias por debajo del nivel esperado.</div>
                        <span asp-validation-for="Input.MinimumStock" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <div class="product-editor-status-control">
                            <div>
                                <span class="fw-semibold d-block">Estado del producto</span>
                                <small class="text-body-secondary">Los productos inactivos permanecen en el historial, pero no pueden asignarse.</small>
                            </div>
                            <div class="form-check form-switch mb-0">
                                <input asp-for="Input.IsActive" class="form-check-input" />
                                <label asp-for="Input.IsActive" class="form-check-label">Activo</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>
    </div>

    <div class="product-editor-actions">
        @if (isEditing)
        {
            <a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-outline-secondary btn-lg">Cancelar</a>
        }
        else
        {
            <a asp-page="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
        }
        <button type="submit" class="btn btn-primary btn-lg">@(isEditing ? "Guardar cambios" : "Guardar producto")</button>
    </div>
</form>
