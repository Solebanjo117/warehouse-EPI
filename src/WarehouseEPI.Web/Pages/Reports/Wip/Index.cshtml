@page "/Reports/Wip"
@model WarehouseEPI.Web.Pages.Reports.Wip.IndexModel
@{ ViewData["Title"] = "Reporte WIP"; }
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3"><div><span class="eyebrow">Consulta operativa pública</span><h1 class="h2 mb-1">Inventario y actividad WIP</h1><p class="text-muted mb-0">Existencias reales por WIP y cambios efectivos dentro del periodo.</p></div>@if(User.IsInRole("ADMIN")){<div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="csv" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">CSV</a><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="xlsx" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">Excel</a></div>}</div>
    @if(Model.Attention == "aged"){<div class="alert alert-info"><strong>Saldo WIP estancado durante @Model.WipReminderDays días o más.</strong> Se muestran posiciones positivas cuya existencia conserva un lote antiguo. <a asp-page="Index" class="alert-link">Quitar filtro</a></div>}
    <form method="get" class="card card-body mb-4">@if(Model.Attention is not null){<input type="hidden" name="attention" value="@Model.Attention"/>}<div class="row g-2"><div class="col-md-2"><label class="form-label">Desde</label><input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><label class="form-label">Hasta</label><input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-3"><label class="form-label">Producto, rack, responsable o referencia</label><input name="search" value="@Model.Search" class="form-control"/></div><div class="col-md-3"><label class="form-label">Rack WIP</label><select name="wipAreaId" class="form-select"><option value="">Todos</option>@foreach(var area in Model.WipAreas){<option value="@area.Id" selected="@(Model.WipAreaId==area.Id)">@area.Code</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Consultar</button></div></div></form>
    <partial name="_TrackedReport" model="Model" />
    <h2 class="h4">Resumen semanal</h2><div class="table-responsive mb-4"><table class="table table-striped align-middle report-cards"><thead><tr><th scope="col">Semana</th><th scope="col">Producto</th><th scope="col">WIP</th><th scope="col" class="text-end">Enviado</th><th scope="col" class="text-end">A bodega</th><th scope="col" class="text-end">A proveedor</th><th scope="col" class="text-end">Consumo asumido</th></tr></thead><tbody>@if(Model.Report.Summary.Count==0){<tr class="report-empty-row"><td colspan="7" class="analytics-empty">No hay surtimientos en el periodo.</td></tr>}@foreach(var row in Model.Report.Summary){<tr><td data-label="Semana">@row.WeekStart.ToString("dd/MM/yyyy") – @row.WeekEnd.ToString("dd/MM/yyyy")</td><td data-label="Producto"><strong>@row.ProductSku</strong> <span class="text-muted">@row.Unit</span></td><td data-label="WIP"><span class="badge text-bg-warning">@row.WipArea</span></td><td data-label="Enviado" class="text-end">@row.Issued.ToString("0.####")</td><td data-label="A bodega" class="text-end">@row.WarehouseReturned.ToString("0.####")</td><td data-label="A proveedor" class="text-end">@row.SupplierReturned.ToString("0.####")</td><td data-label="Consumo asumido" class="text-end fw-bold">@row.AssumedConsumed.ToString("0.####")</td></tr>}</tbody></table></div>
    <h2 class="h4">Detalle de surtimientos</h2><div class="table-responsive"><table class="table align-middle report-cards"><thead><tr><th scope="col">Fecha / folio</th><th scope="col">Trayecto</th><th scope="col">Producto</th><th scope="col" class="text-end">Enviado</th><th scope="col" class="text-end">Consumo asumido</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>@if(Model.Report.Items.Count==0){<tr class="report-empty-row"><td colspan="6" class="analytics-empty">No hay surtimientos con los filtros seleccionados. Amplía el período o limpia algún criterio.</td></tr>}@foreach(var row in Model.Report.Items){<tr><td data-label="Fecha / folio">@row.OccurredAt.ToString("dd/MM/yyyy HH:mm")<div class="small text-muted"><span>@row.MovementId.ToString()[..8]…</span> <button type="button" class="btn btn-link btn-sm p-0" data-copy-value="@row.MovementId" aria-label="Copiar folio completo @row.MovementId">Copiar</button></div></td><td data-label="Trayecto">@row.SourceLocation → <span class="badge text-bg-warning">@row.WipArea</span></td><td data-label="Producto"><strong>@row.ProductSku</strong><div class="small">@row.Responsible @row.Reference</div></td><td data-label="Enviado" class="text-end">@row.Issued.ToString("0.####") @row.Unit</td><td data-label="Consumo asumido" class="text-end fw-bold">@row.AssumedConsumed.ToString("0.####") @row.Unit</td><td data-label="" class="text-end"><a asp-page="Details" asp-route-id="@row.MovementLineId" class="btn btn-sm btn-outline-primary">Detalle</a></td></tr>}</tbody></table></div>
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
    @if(Model.TotalPages>1){<nav aria-label="Paginación WIP"><ul class="pagination justify-content-center flex-wrap"><li class="page-item @(Model.Report.PageNumber<=1?"disabled":null)">@if(Model.Report.PageNumber<=1){<span class="page-link">Primera</span>}else{<a class="page-link" asp-route-pageNumber="1" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Primera</a>}</li><li class="page-item @(Model.Report.PageNumber<=1?"disabled":null)">@if(Model.Report.PageNumber<=1){<span class="page-link">Anterior</span>}else{<a class="page-link" asp-route-pageNumber="@(Model.Report.PageNumber-1)" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Anterior</a>}</li>@foreach(var pageNumber in Model.VisiblePages){<li class="page-item @(pageNumber==Model.Report.PageNumber?"active":null)"><a class="page-link" aria-current="@(pageNumber==Model.Report.PageNumber?"page":null)" asp-route-pageNumber="@pageNumber" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@pageNumber</a></li>}<li class="page-item @(Model.Report.PageNumber>=Model.TotalPages?"disabled":null)">@if(Model.Report.PageNumber>=Model.TotalPages){<span class="page-link">Siguiente</span>}else{<a class="page-link" asp-route-pageNumber="@(Model.Report.PageNumber+1)" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Siguiente</a>}</li><li class="page-item @(Model.Report.PageNumber>=Model.TotalPages?"disabled":null)">@if(Model.Report.PageNumber>=Model.TotalPages){<span class="page-link">Última</span>}else{<a class="page-link" asp-route-pageNumber="@Model.TotalPages" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">Última</a>}</li></ul></nav>}
</div>
