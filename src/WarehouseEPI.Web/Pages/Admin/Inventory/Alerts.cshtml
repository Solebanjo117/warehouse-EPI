@page
@using WarehouseEPI.Infrastructure.Reporting
@model WarehouseEPI.Web.Pages.Admin.Inventory.AlertsModel
@{ ViewData["Title"] = "Alertas de inventario"; }

<div class="alerts-workspace">
    <header class="inventory-page-header d-flex flex-wrap justify-content-between gap-3 align-items-start"><div><span class="eyebrow">Prioridad operativa</span><h1 class="h2 mb-1">Alertas de inventario</h1><p class="text-muted mb-0">Condiciones derivadas de saldos, movimientos efectivos, conteos y WIP; consultar no modifica la operación.</p></div><div class="d-flex gap-2"><a asp-page="/Admin/Inventory/Movements/Index" class="btn btn-outline-secondary">Movimientos</a><a asp-route-view="@Model.View" asp-route-search="@Model.Search" asp-route-attention="@Model.Attention" class="btn btn-primary">Actualizar</a></div></header>
    <p class="alerts-updated">Actualizado: <time datetime="@Model.Snapshot.GeneratedAtLocal.ToString("O")">@Model.Snapshot.GeneratedAtLocal.ToString("dd/MM/yyyy HH:mm")</time> · @Model.Snapshot.TotalVisible condición(es)</p>
    <section class="alert-metrics" aria-label="Resumen de alertas"><article class="is-danger"><span aria-hidden="true">!</span><strong>@Model.Snapshot.CriticalCount</strong><small>Críticas</small></article><article class="is-warning"><span aria-hidden="true">↓</span><strong>@Model.Snapshot.WarningCount</strong><small>Advertencias</small></article><article><span aria-hidden="true">i</span><strong>@Model.Snapshot.InformationCount</strong><small>Informativas</small></article></section>
    <nav class="inventory-filter-tabs alert-category-tabs" aria-label="Tipo de alerta">
        <a class="@(Model.View == "negative" ? "active" : null)" asp-route-view="negative">Negativos <span>@Model.Count(OperationalAlertCategory.NegativeInventory)</span></a><a class="@(Model.View == "minimum" ? "active" : null)" asp-route-view="minimum">Mínimos <span>@Model.Count(OperationalAlertCategory.BelowMinimum)</span></a><a class="@(Model.View == "unassigned" ? "active" : null)" asp-route-view="unassigned">Sin asignación <span>@Model.Count(OperationalAlertCategory.UnassignedBalance)</span></a><a class="@(Model.View == "restricted" ? "active" : null)" asp-route-view="restricted">Restringido <span>@Model.Count(OperationalAlertCategory.RestrictedInventory)</span></a><a class="@(Model.View == "stagnant" ? "active" : null)" asp-route-view="stagnant">Estancado <span>@Model.Count(OperationalAlertCategory.StagnantInventory)</span></a><a class="@(Model.View == "cycle" ? "active" : null)" asp-route-view="cycle">Conteos <span>@(Model.Count(OperationalAlertCategory.CycleCountStale) + Model.Count(OperationalAlertCategory.CycleCountPending))</span></a><a class="@(Model.View == "wip" ? "active" : null)" asp-route-view="wip">WIP <span>@Model.Count(OperationalAlertCategory.AgedWip)</span></a>
    </nav>
    @if (Model.View == "cycle") { <nav class="cycle-status-filters mb-3" aria-label="Atención de conteos"><a asp-route-view="cycle" asp-route-attention="review" class="@(Model.Attention != "stale" ? "active" : null)">Revisión / reconteo</a><a asp-route-view="cycle" asp-route-attention="stale" class="@(Model.Attention == "stale" ? "active" : null)">Obsoletos</a></nav> }
    <form method="get" class="alert-search-form"><input type="hidden" name="view" value="@Model.View" /><input type="hidden" name="attention" value="@Model.Attention" /><label class="visually-hidden" for="alert-search">Buscar alertas</label><div class="input-group"><input id="alert-search" name="search" value="@Model.Search" class="form-control" placeholder="Producto, ubicación, campaña o WIP" /><button class="btn btn-outline-primary">Filtrar</button></div></form>
    @if (Model.AlertPage.Items.Count == 0) { <div class="inventory-empty mt-3"><strong>No hay condiciones en esta categoría.</strong><span>Cambia el filtro o actualiza para consultar el estado vigente.</span></div> }
    else { <section class="alert-list mt-3" aria-label="Resultados de alertas">@foreach (var item in Model.AlertPage.Items) { <article class="alert-row @(item.Severity == OperationalAlertSeverity.Critical ? "is-negative" : "is-minimum")"><div><span class="inventory-card-label">Condición</span><strong>@item.PrimaryText</strong><small>@item.SecondaryText</small></div><div><span class="inventory-card-label">Valor</span><strong>@(item.ValueText ?? "Requiere atención")</strong>@if (item.OccurredAt is not null) { <small>@item.OccurredAt.Value.ToString("dd/MM/yyyy HH:mm")</small> }</div><div class="d-flex flex-wrap gap-2 justify-content-end">@if (item.ProductId is Guid productId) { <a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@productId" class="btn btn-outline-secondary btn-sm">Ficha producto</a> }@if (item.LocationId is Guid locationId) { <a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@locationId" class="btn btn-outline-secondary btn-sm">Ficha ubicación</a><a asp-page="/Admin/Catalogs/Locations/Index" asp-route-viewMode="map" asp-route-highlightLocationId="@locationId" class="btn btn-outline-secondary btn-sm">Croquis</a> }@if (item.ProductId is not null || item.LocationId is not null) { <a asp-page="/Admin/Inventory/Movements/Index" asp-route-view="effective" asp-route-period="all" asp-route-sku="@(item.ProductId is not null ? item.PrimaryText : null)" asp-route-locationCode="@(item.LocationId is not null ? item.SecondaryText : null)" class="btn btn-outline-secondary btn-sm">Movimientos</a> }<a href="@item.TargetUrl" class="btn btn-outline-primary">Revisar</a></div></article> }</section> }
    @if (Model.TotalPages > 1) { <nav class="mt-4" aria-label="Paginación de alertas"><ul class="pagination justify-content-center"><li class="page-item @(Model.AlertPage.PageNumber <= 1 ? "disabled" : null)"><a class="page-link" asp-route-view="@Model.View" asp-route-attention="@Model.Attention" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.AlertPage.PageNumber - 1)">Anterior</a></li><li class="page-item disabled"><span class="page-link">@Model.AlertPage.PageNumber de @Model.TotalPages</span></li><li class="page-item @(Model.AlertPage.PageNumber >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-route-view="@Model.View" asp-route-attention="@Model.Attention" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.AlertPage.PageNumber + 1)">Siguiente</a></li></ul></nav> }
</div>
