@page "/Reports/Wip"
@model WarehouseEPI.Web.Pages.Reports.Wip.IndexModel
@{ ViewData["Title"] = "Reporte WIP"; }
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3"><div><span class="eyebrow">Consulta operativa pública</span><h1 class="h2 mb-1">Surtimiento WIP</h1><p class="text-muted mb-0">WIP no controla saldo; el consumo se asume al surtir.</p></div>@if(User.IsInRole("ADMIN")){<div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="csv" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">CSV</a><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="xlsx" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">Excel</a></div>}</div>
    @if(Model.Attention == "aged"){<div class="alert alert-info"><strong>Recordatorios WIP de @Model.WipReminderDays días o más.</strong> Sólo se muestran líneas sin devolución efectiva. WIP no controla saldo y el consumo continúa siendo asumido. <a asp-page="Index" class="alert-link">Quitar filtro</a></div>}
    <form method="get" class="card card-body mb-4">@if(Model.Attention is not null){<input type="hidden" name="attention" value="@Model.Attention"/>}<div class="row g-2"><div class="col-md-2"><label class="form-label">Desde</label><input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><label class="form-label">Hasta</label><input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-3"><label class="form-label">Producto, rack, responsable o referencia</label><input name="search" value="@Model.Search" class="form-control"/></div><div class="col-md-3"><label class="form-label">Rack WIP</label><select name="wipAreaId" class="form-select"><option value="">Todos</option>@foreach(var area in Model.WipAreas){<option value="@area.Id" selected="@(Model.WipAreaId==area.Id)">@area.Code</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Consultar</button></div></div></form>
    <h2 class="h4">Resumen semanal</h2><div class="table-responsive mb-4"><table class="table table-striped align-middle"><thead><tr><th>Semana</th><th>Producto</th><th>WIP</th><th class="text-end">Enviado</th><th class="text-end">A bodega</th><th class="text-end">A proveedor</th><th class="text-end">Consumo asumido</th></tr></thead><tbody>@if(Model.Report.Summary.Count==0){<tr><td colspan="7" class="text-center text-muted py-4">No hay surtimientos en el periodo.</td></tr>}@foreach(var row in Model.Report.Summary){<tr><td>@row.WeekStart.ToString("dd/MM/yyyy") – @row.WeekEnd.ToString("dd/MM/yyyy")</td><td><strong>@row.ProductSku</strong> <span class="text-muted">@row.Unit</span></td><td><span class="badge text-bg-warning">@row.WipArea</span></td><td class="text-end">@row.Issued.ToString("0.####")</td><td class="text-end">@row.WarehouseReturned.ToString("0.####")</td><td class="text-end">@row.SupplierReturned.ToString("0.####")</td><td class="text-end fw-bold">@row.AssumedConsumed.ToString("0.####")</td></tr>}</tbody></table></div>
    <h2 class="h4">Detalle de surtimientos</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Fecha / folio</th><th>Trayecto</th><th>Producto</th><th class="text-end">Enviado</th><th class="text-end">Consumo asumido</th><th></th></tr></thead><tbody>@foreach(var row in Model.Report.Items){<tr><td>@row.OccurredAt.ToString("dd/MM/yyyy HH:mm")<div class="small text-muted">@row.MovementId</div></td><td>@row.SourceLocation → <span class="badge text-bg-warning">@row.WipArea</span></td><td><strong>@row.ProductSku</strong><div class="small">@row.Responsible @row.Reference</div></td><td class="text-end">@row.Issued.ToString("0.####") @row.Unit</td><td class="text-end fw-bold">@row.AssumedConsumed.ToString("0.####") @row.Unit</td><td><a asp-page="Details" asp-route-id="@row.MovementLineId" class="btn btn-sm btn-outline-primary">Detalle</a></td></tr>}</tbody></table></div>
    @if(Model.TotalPages>1){<nav><ul class="pagination">@for(var pageNumber=1;pageNumber<=Model.TotalPages;pageNumber++){<li class="page-item @(pageNumber==Model.Report.PageNumber?"active":null)"><a class="page-link" asp-route-pageNumber="@pageNumber" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@pageNumber</a></li>}</ul></nav>}
</div>
