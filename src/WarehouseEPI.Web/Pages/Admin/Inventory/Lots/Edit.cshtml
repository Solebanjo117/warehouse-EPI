@page "{id:guid}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Inventory.Lots.EditModel
@{ ViewData["Title"] = CatTexts["Fecha de lote"].Value; }
<h1 class="h3 mb-3">@Model.Title</h1>
<form method="post" class="card card-body col-lg-6"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Input.OperationId" type="hidden"/><input asp-for="Input.LotId" type="hidden"/><div class="alert alert-info">@CatTexts["Este cambio solo afecta el orden FEFO de operaciones futuras. No modifica el número AUTO, movimientos históricos ni sus snapshots."]</div><div class="mb-3"><label asp-for="Input.LotDate" class="form-label">@CatTexts["Fecha de lote"]</label><input asp-for="Input.LotDate" class="form-control" type="date"/><div class="form-text">@CatTexts["Deja el campo vacío para limpiar la fecha interna."]</div></div><div class="mb-3"><label asp-for="Input.Reason" class="form-label">@CatTexts["Motivo"]</label><textarea asp-for="Input.Reason" class="form-control" required></textarea></div><div class="mb-3"><label asp-for="Input.Pin" class="form-label">@CatTexts["NIP ADMIN"]</label><input asp-for="Input.Pin" class="form-control" inputmode="numeric" autocomplete="off" required /></div><div><button class="btn btn-primary">@CatTexts["Revisar y guardar"]</button> <a asp-page="Index" class="btn btn-outline-secondary">@CatTexts["Cancelar"]</a></div></form>
