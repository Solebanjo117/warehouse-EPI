@page "/Reports/Wip"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Reports.Wip.IndexModel
@{ ViewData["Title"] = CatTexts["Reporte WIP"].Value; }

@section Styles {
    <link rel="stylesheet" href="~/css/wip-report-index.css" asp-append-version="true" />
}

<div class="container py-4 wip-report">
    <header class="wip-report-header"><div><span class="eyebrow">@CatTexts["Consulta operativa pública"]</span><h1 class="h2 mb-1">@CatTexts["Inventario y actividad WIP"]</h1><p class="text-muted mb-0">@CatTexts["Existencias reales por WIP y cambios efectivos dentro del periodo."]</p></div>@if(User.IsInRole("ADMIN")){<div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="csv" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">CSV</a><a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Wip/Export" asp-route-format="xlsx" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">Excel</a></div>}</header>
    @if(Model.Attention == "aged"){<div class="alert alert-info"><strong>@CatTexts["Saldo WIP estancado durante {0} días o más.", Model.WipReminderDays]</strong> @CatTexts["Se muestran posiciones positivas cuya existencia conserva un lote antiguo."] <a asp-page="Index" class="alert-link">@CatTexts["Quitar filtro"]</a></div>}
    <form method="get" class="card card-body mb-4">@if(Model.Attention is not null){<input type="hidden" name="attention" value="@Model.Attention"/>}<div class="row g-2"><div class="col-md-2"><label class="form-label" for="wip-from">@CatTexts["Desde"]</label><input id="wip-from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-2"><label class="form-label" for="wip-to">@CatTexts["Hasta"]</label><input id="wip-to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-md-3"><label class="form-label" for="wip-search">@CatTexts["Buscar"]</label><input id="wip-search" name="search" value="@Model.Search" class="form-control" type="search" autocomplete="off"/><span class="form-text">@CatTexts["Producto, ubicación, responsable o referencia."]</span></div><div class="col-md-3"><label class="form-label" for="wip-area">@CatTexts["Ubicación WIP"]</label><select id="wip-area" name="wipAreaId" class="form-select"><option value="">@CatTexts["Todas"]</option>@foreach(var area in Model.WipAreas){<option value="@area.Id" selected="@(Model.WipAreaId==area.Id)">@area.Code</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">@CatTexts["Consultar"]</button></div></div></form>
    <p class="text-body-secondary">@CatTexts["Las fechas filtran la entrega original, no el día de captura. Sin fechas se muestra todo el historial."] <a asp-page="Index" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId">@CatTexts["Todo el historial"]</a></p>
    @if(Model.RequiresCutover){<p class="alert alert-warning" role="alert">@CatTexts["Hay existencias WIP anteriores pendientes de conversión. Solicita el corte documental ADMIN."]</p>}
    @if (Model.AssociatedRacks.Count > 0)
{
    <div class="alert alert-info" data-wip-associated-racks>
        <p class="mb-1">@CatTexts["Racks asociados actualmente"]: @string.Join(", ", Model.AssociatedRacks.Select(x => $"{x.RowCode}-{x.RackNumber}"))</p>
        <p class="mb-0">@CatTexts["Reporte compartido del WIP; sin distribución por rack o posición"]</p>
    </div>
}
<partial name="_TrackedReport" model="Model" />
    @if(User.IsInRole("ADMIN")){<a class="btn btn-outline-secondary mb-3" asp-page="/Admin/Inventory/WipCutover">@CatTexts["Corte documental WIP"]</a>}
    @if(Model.TotalPages>1){<nav aria-label="@CatTexts["Paginación WIP"]"><ul class="pagination justify-content-center flex-wrap"><li class="page-item @(Model.TrackedReport.PageNumber<=1?"disabled":null)">@if(Model.TrackedReport.PageNumber<=1){<span class="page-link">@CatTexts["Primera"]</span>}else{<a class="page-link" asp-route-pageNumber="1" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@CatTexts["Primera"]</a>}</li><li class="page-item @(Model.TrackedReport.PageNumber<=1?"disabled":null)">@if(Model.TrackedReport.PageNumber<=1){<span class="page-link">@CatTexts["Anterior"]</span>}else{<a class="page-link" asp-route-pageNumber="@(Model.TrackedReport.PageNumber-1)" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@CatTexts["Anterior"]</a>}</li>@foreach(var pageNumber in Model.VisiblePages){<li class="page-item @(pageNumber==Model.TrackedReport.PageNumber?"active":null)"><a class="page-link" aria-current="@(pageNumber==Model.TrackedReport.PageNumber?"page":null)" asp-route-pageNumber="@pageNumber" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@pageNumber</a></li>}<li class="page-item @(Model.TrackedReport.PageNumber>=Model.TotalPages?"disabled":null)">@if(Model.TrackedReport.PageNumber>=Model.TotalPages){<span class="page-link">@CatTexts["Siguiente"]</span>}else{<a class="page-link" asp-route-pageNumber="@(Model.TrackedReport.PageNumber+1)" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@CatTexts["Siguiente"]</a>}</li><li class="page-item @(Model.TrackedReport.PageNumber>=Model.TotalPages?"disabled":null)">@if(Model.TrackedReport.PageNumber>=Model.TotalPages){<span class="page-link">@CatTexts["Última"]</span>}else{<a class="page-link" asp-route-pageNumber="@Model.TotalPages" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-search="@Model.Search" asp-route-wipAreaId="@Model.WipAreaId" asp-route-attention="@Model.Attention">@CatTexts["Última"]</a>}</li></ul></nav>}
</div>
