@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Inventory.Lots.DetailsModel
@{ ViewData["Title"] = "Ficha de lote"; }
<section class="inventory-shell"><div class="d-flex justify-content-between gap-2 flex-wrap mb-3"><div><p class="text-body-secondary mb-1">Lote interno automático</p><h1 class="h3 mb-0">@Model.Lot.Number</h1></div><div class="d-flex gap-2"><a asp-page="Index" class="btn btn-outline-secondary">Volver</a><a asp-page="Edit" asp-route-id="@Model.Lot.Id" class="btn btn-primary">Cambiar fecha</a></div></div>
<div class="card mb-3"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Producto</dt><dd class="col-sm-9"><a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@Model.Lot.ProductId">@Model.Lot.Sku</a> @Model.Lot.Description</dd><dt class="col-sm-3">Fecha interna</dt><dd class="col-sm-9">@(Model.Lot.LotDate?.ToString("yyyy-MM-dd") ?? "Sin fecha")</dd><dt class="col-sm-3">Creación</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm zzz")</dd><dt class="col-sm-3">Saldo agregado</dt><dd class="col-sm-9 @(Model.Lot.Quantity < 0 ? "text-danger" : "")">@Model.Lot.Quantity @Model.Lot.Unit</dd></dl></div></div>
<h2 class="h5">Distribución actual</h2><div class="table-responsive mb-4"><table class="table"><thead><tr><th>Ubicación</th><th>Descripción</th><th class="text-end">Cantidad</th></tr></thead><tbody>@foreach (var item in Model.Lot.Locations) { <tr><td><a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@item.LocationId">@item.Code</a></td><td>@item.Description</td><td class="text-end">@item.Quantity @item.Unit</td></tr> } @if (!Model.Lot.Locations.Any()) { <tr><td colspan="3" class="text-body-secondary">No hay saldo actual para este lote.</td></tr> }</tbody></table></div>
<h2 class="h5">Movimientos relacionados</h2><div class="table-responsive mb-4"><table class="table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Ubicación</th><th class="text-end">Delta</th><th></th></tr></thead><tbody>@foreach (var item in Model.Lot.Movements) { <tr><td>@item.OccurredAt.ToString("yyyy-MM-dd HH:mm")</td><td>@item.Type</td><td>@item.Location</td><td class="text-end">@item.Delta</td><td><a asp-page="/Admin/Inventory/Movements/Details" asp-route-id="@item.MovementId">Ver movimiento</a></td></tr> }</tbody></table></div>
<h2 class="h5">Auditoría de fecha</h2><div class="table-responsive"><table class="table"><thead><tr><th>Anterior</th><th>Nueva</th><th>Motivo</th><th>Solicitó / autorizó</th></tr></thead><tbody>@foreach (var item in Model.Lot.DateChanges) { <tr><td>@item.Previous</td><td>@item.Current</td><td>@item.Reason</td><td>@item.RequestedBy / @item.AuthorizedBy</td></tr> } @if (!Model.Lot.DateChanges.Any()) { <tr><td colspan="4" class="text-body-secondary">No hay cambios de fecha.</td></tr> }</tbody></table></div></section>
