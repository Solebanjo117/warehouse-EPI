@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.Rack.EditModel
@{
    ViewData["Title"] = CatTexts["Editar rack {0}-{1}", Model.Rack.RowCode, Model.Rack.RackNumber].Value;
    var keypad = new short[] { 7, 8, 9, 4, 5, 6, 1, 2, 3 };
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <a asp-page="../Index" asp-route-viewMode="racks" class="small text-decoration-none">@CatTexts["← Volver a racks"]</a>
        <h1 class="h2 mt-2 mb-1">Editar rack @Model.Rack.RowCode-@Model.Rack.RackNumber</h1>
        <p class="text-body-secondary mb-0">@CatTexts["Configura la existencia y función de cada posición física del rack."]</p>
    </div>
</div>

@if (Model.Message is not null)
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (Model.ReviewErrors.Count > 0)
{
    <div class="alert alert-danger" role="alert"><strong>@CatTexts["No se puede continuar."]</strong><ul class="mb-0 mt-2">@foreach (var error in Model.ReviewErrors) { <li>@error</li> }</ul></div>
}

<form method="post" class="rack-physical-editor" data-rack-editor>
    <input asp-for="Input.OperationId" type="hidden" />
    <input asp-for="Input.RowCode" type="hidden" />
    <input asp-for="Input.RackNumber" type="hidden" />
    <input asp-for="Input.ProcessConfigurationVersion" type="hidden" />
    <div class="rack-editor-workspace">
        <div class="rack-editor-main">
            <section class="card mt-3">
                <div class="card-body">
                    <h2 class="h4">@CatTexts["Procesos del rack"]</h2>
                    @if (Model.Rack.InheritedProcessIds.Count > 0)
                    {
                        <div class="alert alert-info">
                            <strong>@CatTexts["Heredados de Fila {0}", Model.Rack.RowCode]</strong>
                            <p class="mb-2">@CatTexts["Aplican a este rack aunque su función sea almacenamiento. Para retirarlos, edita el proceso que contiene la fila completa."]</p>
                            <ul class="mb-0">
                                @foreach (var process in Model.Processes.Where(x => Model.Rack.InheritedProcessIds.Contains(x.Id)))
                                {
                                    <li><a asp-page="/Admin/Production/ProcessEdit" asp-route-id="@process.Id">@process.Code · @process.Name</a> <span class="badge text-bg-secondary">@CatTexts["Heredado"]</span></li>
                                }
                            </ul>
                        </div>
                    }
                    <h3 class="h5">@CatTexts["Asociaciones directas"]</h3>
                    <p class="form-text">@CatTexts["Estos procesos se comparten entre las posiciones WIP presentes. Las posiciones de almacenamiento no son destinos WIP."]</p>
                    <div class="row">@foreach (var process in Model.Processes.Where(x => !Model.Rack.InheritedProcessIds.Contains(x.Id))) { <div class="col-12 col-md-6"><div class="form-check py-2"><input class="form-check-input" type="checkbox" name="Input.ProcessIds" value="@process.Id" id="rack-process-@process.Id" checked="@(Model.Input.ProcessIds.Contains(process.Id) ? "checked" : null)"/><label class="form-check-label" for="rack-process-@process.Id">@process.Code · @process.Name @if (!process.IsActive) { <span class="text-body-secondary">@CatTexts["(inactivo)"]</span> }</label></div></div> }</div>
                </div>
            </section>
            <section class="card">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                        <div><h2 class="h4 mb-1">@CatTexts["Posiciones físicas"]</h2><p class="text-body-secondary mb-0">@CatTexts["Seleccionada = existe. Sin seleccionar = retirada o no creada."]</p></div>
                        <span class="badge text-bg-light border">@CatTexts["Distribución 7-8-9 / 4-5-6 / 1-2-3"]</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3"><button type="button" class="btn btn-outline-secondary" data-rack-all-storage>@CatTexts["Todas a almacenamiento"]</button><button type="button" class="btn btn-outline-warning" data-rack-all-wip>@CatTexts["Todas a WIP"]</button></div>
                    <p class="alert alert-info py-2" role="status" data-rack-role-summary data-storage-label="@CatTexts["Almacenamiento"]" data-wip-label="WIP" data-mixed-label="@CatTexts["Mixto"]">@CatTexts["Función por posición"]</p>
                    <div class="rack-physical-keypad">
                    @foreach (var pallet in keypad)
                    {
                        var position = Model.Rack.Positions.Single(item => item.PalletNumber == pallet);
                        var blocked = position.IsPhysicallyPresent && (position.HasBalance || position.HasActiveAssignments);
                        <div class="rack-physical-position @(position.IsPhysicallyPresent ? "present" : "absent") @(blocked ? "protected" : "")" data-rack-position>
                            <input class="form-check-input" id="rack-present-@pallet" type="checkbox" name="Input.PresentPallets" value="@pallet" data-rack-present
                                   checked="@(Model.Input.PresentPallets.Contains(pallet) ? "checked" : null)"
                                   disabled="@(blocked ? "disabled" : null)" />
                            @if (blocked) { <input type="hidden" name="Input.PresentPallets" value="@pallet" /> }
                            <label for="rack-present-@pallet"><strong>@pallet</strong> <span>@position.Code</span></label>
                            <small>@if (position.IsPhysicallyPresent) { <text>@CatTexts["Existe"]</text> } else if (position.Exists) { <text>@CatTexts["Retirada"]</text> } else { <text>@CatTexts["No creada"]</text> }</small>
                            <label for="rack-role-@pallet" class="small">@CatTexts["Función"]</label>
                            <select class="form-select" id="rack-role-@pallet" data-rack-role data-pallet="@pallet" aria-label="@CatTexts["Función de {0}", position.Code]">
                                <option value="Storage" selected="@(!Model.Input.WipPallets.Contains(pallet))">@CatTexts["Almacenamiento"]</option>
                                <option value="Wip" selected="@(Model.Input.WipPallets.Contains(pallet))">WIP</option>
                            </select>
                            <input type="checkbox" class="visually-hidden" name="Input.WipPallets" value="@pallet" data-rack-wip tabindex="-1" aria-hidden="true" checked="@(Model.Input.WipPallets.Contains(pallet) ? "checked" : null)" />
                            @if (position.HasBalance) { <span class="badge text-bg-warning">@CatTexts["Con saldo"]</span> }
                            @if (position.HasActiveAssignments) { <span class="badge text-bg-info">@CatTexts["Con asignación"]</span> }
                        </div>
                    }
                    </div>
                    <p class="small text-body-secondary mt-3 mb-0">@CatTexts["Una posición con saldo o asignación activa queda protegida. Retirar no elimina su fila ni su historial."]</p>
                </div>
            </section>

            <section class="card mt-3">
                <div class="card-body">
                    <label asp-for="Input.Reason" class="form-label">@CatTexts["Motivo de la corrección"]</label>
                    <textarea asp-for="Input.Reason" class="form-control" rows="3" maxlength="500" required placeholder="@CatTexts["Ej. El rack físico solo tiene pallets 1 a 6"]"></textarea>
                    <button type="submit" asp-page-handler="Review" class="btn btn-outline-primary mt-3">@CatTexts["Revisar cambios"]</button>
                </div>
            </section>
        </div>

        @if (Model.ReviewSummary is not null)
        {
            <aside class="rack-editor-review" aria-labelledby="rack-review-title">
                <section class="card">
                    <div class="card-body">
                        <h2 id="rack-review-title" class="h4">@CatTexts["Revisión previa"]</h2>
                        <dl class="row mb-3">
                            <dt class="col-sm-4">@CatTexts["Posiciones WIP"]</dt><dd class="col-sm-8">@Model.Input.WipPallets.Count(pallet => Model.Input.PresentPallets.Contains(pallet))</dd>
                            <dt class="col-sm-4">@CatTexts["Posiciones de almacenamiento"]</dt><dd class="col-sm-8">@Model.Input.PresentPallets.Count(pallet => !Model.Input.WipPallets.Contains(pallet))</dd>
                            <dt class="col-sm-4">@CatTexts["Cambios de función"]</dt><dd class="col-sm-8">@(Model.ReviewSummary.RoleChanges is { Count: > 0 } ? string.Join("; ", Model.ReviewSummary.RoleChanges) : CatTexts["Ninguno"].Value)</dd>
                            <dt class="col-sm-4">@CatTexts["Nuevas"]</dt><dd class="col-sm-8">@(Model.ReviewSummary.Added.Count == 0 ? CatTexts["Ninguna"].Value : string.Join(", ", Model.ReviewSummary.Added))</dd>
                            <dt class="col-sm-4">@CatTexts["Restauradas"]</dt><dd class="col-sm-8">@(Model.ReviewSummary.Restored.Count == 0 ? CatTexts["Ninguna"].Value : string.Join(", ", Model.ReviewSummary.Restored))</dd>
                            <dt class="col-sm-4">@CatTexts["Retiradas"]</dt><dd class="col-sm-8">@(Model.ReviewSummary.Retired.Count == 0 ? CatTexts["Ninguna"].Value : string.Join(", ", Model.ReviewSummary.Retired))</dd>
                            <dt class="col-sm-4">@CatTexts["Directos actuales"]</dt><dd class="col-sm-8">@(Model.Rack.ProcessIds.Count == 0 ? CatTexts["Ninguno"].Value : string.Join(", ", Model.Processes.Where(x => Model.Rack.ProcessIds.Contains(x.Id)).Select(x => x.Name)))</dd>
                            <dt class="col-sm-4">@CatTexts["Directos solicitados"]</dt><dd class="col-sm-8">@(Model.ReviewSummary.DirectProcessesRemoved || Model.Input.ProcessIds.Length == 0 ? CatTexts["Ninguno"].Value : string.Join(", ", Model.Processes.Where(x => Model.Input.ProcessIds.Contains(x.Id)).Select(x => x.Name)))</dd>
                            <dt class="col-sm-4">@CatTexts["Heredados de fila"]</dt><dd class="col-sm-8">@(Model.Rack.InheritedProcessIds.Count == 0 ? CatTexts["Ninguno"].Value : string.Join(", ", Model.Processes.Where(x => Model.Rack.InheritedProcessIds.Contains(x.Id)).Select(x => x.Name)))</dd>
                        </dl>
                        @if (Model.IsReviewed)
                        {
                            @if (Model.ReviewSummary.OperationalRoleChanged)
                            {
                                <div class="alert alert-info">@CatTexts["Los saldos, asignaciones y movimientos permanecerán en sus posiciones actuales."]</div>
                            }
                            @if (Model.ReviewSummary.DirectProcessesRemoved && Model.Rack.ProcessIds.Count > 0) { <div class="alert alert-warning">@CatTexts["Al no quedar posiciones WIP, se quitarán las asociaciones directas de procesos. Las heredadas de fila permanecen."]</div> }
                            <div class="alert alert-warning"><strong>@CatTexts["No es eliminación física de datos."]</strong> @CatTexts["Las filas y su auditoría permanecerán consultables."]</div>
                            <label asp-for="Input.Pin" class="form-label">@CatTexts["NIP ADMIN"]</label>
                            <input asp-for="Input.Pin" value="" class="form-control" type="password" inputmode="numeric" autocomplete="off" required autofocus data-rack-pin />
                            <div class="form-text">@CatTexts["Presiona Enter o Guardar configuración para confirmar."]</div>
                            <button type="submit" asp-page-handler="Save" class="btn btn-primary mt-3" data-rack-save>@CatTexts["Guardar configuración"]</button>
                        }
                        else
                        {
                            <p class="text-body-secondary mb-0">@CatTexts["Corrige los errores y vuelve a revisar antes de guardar."]</p>
                        }
                    </div>
                </section>
            </aside>
        }
    </div>
</form>

<section class="card border-danger mt-4" aria-labelledby="delete-rack-title">
    <div class="card-body">
        <h2 id="delete-rack-title" class="h4 text-danger">@CatTexts["Eliminar rack definitivamente"]</h2>
        @if (Model.Rack.Deletion.CanDelete)
        {
            <p>@CatTexts["Este rack nunca ha sido utilizado por inventario, productos u operaciones. La eliminación quitará sus posiciones y su elemento del croquis."]</p>
            <details>
                <summary class="btn btn-outline-danger">@CatTexts["Preparar eliminación definitiva"]</summary>
                <form method="post" asp-page-handler="Delete" class="mt-3" data-rack-delete-form>
                    <input asp-for="DeleteInput.OperationId" type="hidden" />
                    <input asp-for="DeleteInput.RowCode" type="hidden" />
                    <input asp-for="DeleteInput.RackNumber" type="hidden" />
                    <div class="alert alert-danger" role="alert"><strong>@CatTexts["Esta acción no se puede deshacer."]</strong> @CatTexts["Se conservará únicamente la auditoría administrativa de la eliminación."]</div>
                    <label asp-for="DeleteInput.Reason" class="form-label">@CatTexts["Motivo de la eliminación"]</label>
                    <textarea asp-for="DeleteInput.Reason" class="form-control mb-3" rows="3" maxlength="500" required></textarea>
                    <label asp-for="DeleteInput.ConfirmationCode" class="form-label">Escribe @Model.Rack.RowCode-@Model.Rack.RackNumber para confirmar</label>
                    <input asp-for="DeleteInput.ConfirmationCode" class="form-control mb-3" required autocomplete="off" />
                    <label asp-for="DeleteInput.Pin" class="form-label">@CatTexts["NIP ADMIN"]</label>
                    <input asp-for="DeleteInput.Pin" value="" class="form-control" type="password" inputmode="numeric" autocomplete="off" required />
                    <button type="submit" class="btn btn-danger mt-3">@CatTexts["Eliminar rack definitivamente"]</button>
                </form>
            </details>
        }
        else
        {
            <p class="mb-2">@CatTexts["Este rack no puede eliminarse porque conserva registros relacionados:"]</p>
            <ul class="mb-0">@foreach (var blocker in Model.Rack.Deletion.Blockers) { <li>@blocker</li> }</ul>
            <p class="small text-body-secondary mt-3 mb-0">@CatTexts["Puedes retirarlo físicamente desde el editor; así deja de estar disponible sin borrar su historial."]</p>
        }
    </div>
</section>

@if (Model.Rack.Revisions.Count > 0)
{
    <section class="card mt-4"><div class="card-body"><h2 class="h4">@CatTexts["Historial de correcciones"]</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>@CatTexts["Fecha"]</th><th>@CatTexts["Solicitó / autorizó"]</th><th>@CatTexts["Motivo"]</th></tr></thead><tbody>@foreach (var revision in Model.Rack.Revisions) { <tr><td>@revision.RecordedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@revision.RequestedBy / @revision.AuthorizedBy</td><td>@revision.Reason</td></tr> }</tbody></table></div></div></section>
}

@section Scripts {
    <script src="~/js/rack-editor.js" asp-append-version="true" defer></script>
}
