@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.IndexModel
@{ ViewData["Title"]="Productos"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><h1 class="h2 mb-1">Productos</h1><p class="text-muted mb-0">Catálogo operativo y códigos de barras.</p></div><div class="d-flex flex-wrap gap-2"><a asp-page="Import" class="btn btn-outline-primary btn-lg">Importar Excel</a><a asp-page="Create" class="btn btn-primary btn-lg">Crear producto</a></div></div>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-12 col-md-7"><label class="form-label" for="search">Buscar</label><input id="search" name="search" value="@Model.Search" class="form-control form-control-lg" placeholder="SKU, descripción, referencia, código de barras o rack" /></div><div class="col-8 col-md-3"><label class="form-label" for="status">Estado</label><select id="status" name="status" class="form-select form-select-lg"><option value="active" selected="@(Model.Status=="active")">Activos</option><option value="inactive" selected="@(Model.Status=="inactive")">Inactivos</option><option value="all" selected="@(Model.Status=="all")">Todos</option></select></div><div class="col-4 col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary btn-lg w-100">Buscar</button></div></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>SKU / Producto</th><th>Clasificación</th><th>Unidad</th><th>Ubicaciones</th><th>Códigos</th><th>Estado</th><th></th></tr></thead><tbody>
@if(Model.Products.Count==0){<tr><td colspan="7" class="text-center text-muted py-4">No hay productos que coincidan.</td></tr>}else{@foreach(var item in Model.Products){<tr><td><strong>@item.Sku</strong>@if(item.Description is not null){<div>@item.Description</div>}@if(item.ExternalReference is not null){<small class="text-muted">@item.ExternalReference</small>}</td><td>@(item.Type??"—") / @(item.Class??"—")</td><td>@item.Unit</td><td>@foreach(var location in item.Locations){<a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@location.Id" class="badge text-bg-light border text-decoration-none me-1">@location.Code</a>}@if(item.LocationCount>item.Locations.Count){<span class="badge text-bg-secondary">+@(item.LocationCount-item.Locations.Count)</span>}@if(item.LocationCount==0){<span class="text-muted">Sin asignar</span>}</td><td>@item.BarcodeCount</td><td>@(item.IsActive?"Activo":"Inactivo")</td><td class="text-end"><a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a></td></tr>}}
</tbody></table></div>
@if(Model.TotalPages>1){<nav><ul class="pagination justify-content-center"><li class="page-item @(Model.CurrentPage<=1?"disabled":"")"><a class="page-link" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@(Model.CurrentPage-1)">Anterior</a></li><li class="page-item disabled"><span class="page-link">@Model.CurrentPage de @Model.TotalPages</span></li><li class="page-item @(Model.CurrentPage>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@(Model.CurrentPage+1)">Siguiente</a></li></ul></nav>}
