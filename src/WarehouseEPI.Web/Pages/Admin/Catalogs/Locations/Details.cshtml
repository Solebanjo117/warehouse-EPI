@page "/Admin/Catalogs/Locations/{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.DetailsModel
@{ ViewData["Title"] = $"Ubicación {Model.Location.Code}"; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"><div><h1 class="h2 mb-1">@Model.Location.Code</h1><p class="text-muted mb-0">@if(Model.Location.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack){<text>Fila @Model.Location.RowCode, rack @Model.Location.RackNumber, pallet @Model.Location.PalletNumber</text>}else{<text>Área especial</text>}</p></div><a asp-page="Index" class="btn btn-outline-secondary btn-lg">Volver a ubicaciones</a></div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}
@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}

<div class="card card-body mb-4"><div class="d-flex flex-wrap gap-2 align-items-center"><strong>Estado:</strong>@if(!Model.Location.IsActive){<span class="badge text-bg-secondary">Inactiva</span>}else if(Model.Location.IsBlocked){<span class="badge text-bg-warning">Bloqueada</span><span>@Model.Location.BlockReason</span>}else{<span class="badge text-bg-success">Disponible</span>}@if(Model.Location.Description is not null){<span class="ms-md-auto">@Model.Location.Description</span>}</div></div>

<section class="card shadow-sm mb-4"><div class="card-body"><h2 class="h4">Productos asignados</h2><p class="text-muted">Asignación fija; la existencia se incorporará en la fase 5.</p><div class="table-responsive"><table class="table align-middle"><thead><tr><th>SKU / Producto</th><th>Asignación</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if(Model.Assignments.Count==0){<tr><td colspan="3" class="text-center text-muted py-4">No hay productos asignados.</td></tr>}
@foreach(var item in Model.Assignments){<tr class="@(!item.IsActive?"table-secondary":"")"><td><a asp-page="/Admin/Catalogs/Products/Edit" asp-route-id="@item.ProductId" class="fw-bold">@item.Sku</a>@if(item.Description is not null){<div class="small">@item.Description</div>}@if(!item.ProductIsActive){<span class="badge text-bg-secondary">Producto inactivo</span>}</td><td>@(item.IsActive?"Asignado":"Asignación inactiva")</td><td class="text-end">@if(item.IsActive){<form method="post" asp-page-handler="Deactivate" asp-route-id="@Model.Location.Id"><input type="hidden" name="productId" value="@item.ProductId"/><button class="btn btn-outline-secondary">Desasignar</button></form>}else{<form method="post" asp-page-handler="Assign" asp-route-id="@Model.Location.Id"><input type="hidden" name="productId" value="@item.ProductId"/><button class="btn btn-outline-primary" disabled="@(!Model.Location.IsActive||Model.Location.IsBlocked||!item.ProductIsActive)">Reactivar</button></form>}</td></tr>}
</tbody></table></div></div></section>

<section class="card shadow-sm"><div class="card-body"><h2 class="h4">Asignar otro producto</h2><form method="get" class="row g-2 mb-3"><input type="hidden" name="id" value="@Model.Location.Id"/><div class="col-12 col-md-9"><label for="productSearch" class="form-label">Buscar producto</label><input id="productSearch" name="productSearch" value="@Model.ProductSearch" class="form-control form-control-lg" placeholder="SKU, descripción, referencia o código de barras"/></div><div class="col-12 col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary btn-lg w-100">Buscar</button></div></form>
@if(!string.IsNullOrWhiteSpace(Model.ProductSearch)){<div class="list-group">@if(Model.ProductResults.Count==0){<div class="list-group-item text-muted">No se encontraron productos activos.</div>}@foreach(var product in Model.ProductResults){<div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>@product.Sku</strong>@if(product.Description is not null){<div class="small">@product.Description</div>}</div>@if(product.IsAssigned){<span class="badge text-bg-success">Ya asignado</span>}else{<form method="post" asp-page-handler="Assign" asp-route-id="@Model.Location.Id"><input type="hidden" name="productId" value="@product.Id"/><button class="btn btn-primary" disabled="@(!Model.Location.IsActive||Model.Location.IsBlocked)">Asignar aquí</button></form>}</div>}</div>}
</div></section>
