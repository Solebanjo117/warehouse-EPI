@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Locations.Rack.RackPrintPageModel
@{
    ViewData["Title"] = CatTexts["Hoja del rack {0}", Model.RackCode].Value;
}

<div class="rack-sheet-actions no-print">
    <button type="button" class="btn btn-primary btn-lg" data-print-page>@CatTexts["Imprimir hoja"]</button>
    <a asp-page="@(Model.IsAdministrativeView ? "/Admin/Catalogs/Locations/Index" : "/Locations/Index")" asp-route-viewMode="map" class="btn btn-outline-secondary btn-lg">@CatTexts["Volver al croquis"]</a>
</div>

<div class="rack-sheet-desk">
    <main class="rack-sheet">
        <header class="rack-sheet-header">
            <div class="rack-sheet-identity">
                <span class="rack-sheet-brand">Warehouse EPI</span>
                <span class="rack-sheet-eyebrow">@CatTexts["Hoja de verificación de rack"]</span>
            </div>
            <h1 class="rack-sheet-code"><span>Rack</span>@Model.RackCode</h1>
            <p class="rack-sheet-meta">@(Model.Positions.All(x => x.IsWip) ? CatTexts["WIP · Sin control de existencias"] : CatTexts["{0} posiciones · {1} con saldo · {2} productos · generada el", Model.PositionCount, Model.OccupiedCount, Model.ProductCount]) <time datetime="@Model.GeneratedAt.ToString("O")">@Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</time></p>
            <partial name="/Pages/Shared/_RackWipAssociation.cshtml" model="Model.WipAssociation" />
        </header>

        @* El bastidor conserva el formato físico y numera desde el suelo. *@
        <section class="rack-sheet-frame rack-format-grid" data-rack-columns="@Model.Format.Columns" data-rack-levels="@Model.Format.Levels" aria-label="@CatTexts["Posiciones del rack {0}", Model.RackCode]">
            @foreach (var palletNumber in Model.Format.PalletOrder)
            {
                var position = Model.Positions.FirstOrDefault(item => item.PalletNumber == palletNumber);
                if (position is null)
                {
                    <article class="sheet-cell is-missing" aria-label="@CatTexts["Pallet {0}, posición inexistente", palletNumber]">
                        <span class="sheet-pallet">@palletNumber</span>
                        <span class="sheet-cell-note">@CatTexts["Sin posición"]</span>
                    </article>
                }
                else
                {
                    <article class="sheet-cell @(position.HasIssue ? "is-flagged" : "")">
                        <header class="sheet-cell-head">
                            <span class="sheet-pallet">@position.PalletNumber</span>
                            <div class="sheet-cell-id">
                                <h2>@position.Code</h2>
                                <span class="sheet-cell-state">@(!position.IsActive ? CatTexts["Inactiva"] : position.IsBlocked ? CatTexts["Bloqueada: {0}", position.BlockReason ?? string.Empty] : CatTexts["Disponible"])</span>
                            </div>
                            <span class="sheet-check" aria-hidden="true"></span>
                        </header>
                        @if (!string.IsNullOrWhiteSpace(position.Description))
                        {
                            <p class="sheet-cell-description">@position.Description</p>
                        }
                        @if (position.IsWip)
                        {
                            <p class="sheet-cell-note">@CatTexts["WIP · Sin control de existencias"]</p>
                        }
                        else if (position.Products.Count == 0)
                        {
                            <p class="sheet-cell-note">@CatTexts["Sin productos ni saldo."]</p>
                        }
                        else
                        {
                            var printedProducts = position.Products.Take(3).ToArray();
                            var additionalProducts = position.Products.Count - printedProducts.Length;
                            <ul class="sheet-products">
                                @foreach (var product in printedProducts)
                                {
                                    <li>
                                        <span class="sheet-sku">@product.Sku</span>
                                        @if (product.Quantity is decimal quantity)
                                        {
                                            <span class="sheet-qty @(quantity < 0 ? "is-negative" : "")">@quantity.ToString("0.####") @product.Unit</span>
                                        }
                                        else
                                        {
                                            <span class="sheet-qty is-none">@CatTexts["Sin saldo"]</span>
                                        }
                                        <span class="sheet-product-desc">@(string.IsNullOrWhiteSpace(product.Description) ? CatTexts["Sin descripción"].Value : product.Description)</span>
                                        <span class="sheet-product-rel">@CatTexts[product.RelationshipState]</span>
                                    </li>
                                }
                            </ul>
                            @if (additionalProducts > 0)
                            {
                                <p class="sheet-cell-more">@CatTexts["+{0} producto(s) más en esta posición. Imprime la ficha para verlos.", additionalProducts]</p>
                            }
                        }
                    </article>
                }
            }
        </section>

        <footer class="rack-sheet-footer">
            <p class="rack-sheet-sign"><span>@CatTexts["Verificado por"]</span><span class="rack-sheet-blank"></span></p>
            <p class="rack-sheet-sign"><span>@CatTexts["Fecha"]</span><span class="rack-sheet-blank"></span></p>
            <p class="rack-sheet-fineprint">@CatTexts["Rack {0} · Warehouse EPI · El saldo corresponde al momento de generación. Una asignación sin saldo no confirma existencia física.", Model.RackCode]</p>
        </footer>
    </main>
</div>

