@model WarehouseEPI.Web.Pages.Operations.Production.WorkModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@using WarehouseEPI.Core.Entities
@{var o=Model.Order;}
    <header class="mb-3"><a asp-page="Advanced"><span aria-hidden="true">←</span> @ProdTexts["Producción avanzada"]</a><h1 class="h3 mt-2">@o.Number · @o.Sku</h1><p class="mb-1">@o.Description · @ProdTexts[WarehouseEPI.Infrastructure.Production.ProductionStateLabels.Label(o.Status)]</p><p>@ProdTexts["Recibido {0} de {1} {2} · Fecha requerida {3} · Lote {4}", o.WarehouseReceived.ToString("0.####"), o.TargetQuantity.ToString("0.####"), o.Unit, o.DueDate?.ToString("dd/MM/yyyy") ?? ProdTexts["Sin fecha"].Value, Model.Batches.FirstOrDefault(x=>x.Id==Model.BatchId)?.Number ?? ProdTexts["Sin seleccionar"].Value]</p></header>
    @if(o.Status==ProductionWorkOrderStatus.Paused){<p class="alert alert-warning">@ProdTexts["Orden pausada. Solicita reanudar con NIP ADMIN antes de continuar la fabricación."]</p>}
    @if(o.UsesBatchTraceability&&Model.Batches.Count>1&&Model.BatchId is null){<p class="alert alert-info">@ProdTexts["Orden histórica con varios lotes. Selecciona uno para capturar."]</p><div class="d-flex flex-wrap gap-2">@foreach(var batch in Model.Batches){<a class="btn btn-outline-primary" asp-route-id="@o.Id" asp-route-BatchId="@batch.Id">@batch.Number</a>}</div>}
    @if(Model.PlanningView.Blockers.Count>0&&o.Status==ProductionWorkOrderStatus.Draft){<div class="alert alert-warning"><strong>@ProdTexts["Antes de liberar"]</strong><ul>@foreach(var blocker in Model.PlanningView.Blockers){<li>@blocker</li>}</ul></div>}
