@model WarehouseEPI.Web.Pages.Operations.Production.WorkModel
@using WarehouseEPI.Core.Entities
@{
    var view = Model.PlanningView;
    var editable = Model.Order.Status == ProductionWorkOrderStatus.Draft;
    var lookupUrl = Url.Page("Work", "PlanningTargets", new { id = Model.Order.Id });
}
<section class="card mb-4" aria-labelledby="production-planning-heading">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
            <div><span class="eyebrow">P2 · Fotografía de la orden</span><h2 id="production-planning-heading" class="h4 mb-1">Planificación de materiales</h2><p class="text-body-secondary mb-0">Estos destinos pertenecen a esta orden; no reservan ni mueven inventario.</p></div>
            <span class="badge @(view.CanRelease ? "text-bg-success" : "text-bg-warning") align-self-start">@(view.CanRelease ? "Lista para liberar" : "Revisión requerida")</span>
        </div>
        @if (view.IsLegacyWithoutSnapshot) { <div class="alert alert-info">Planificación anterior sin destino WIP fotografiado. La orden conserva su historial y no se reconstruye.</div> }
        @if (view.Blockers.Count > 0) { <div class="alert alert-danger" role="alert"><strong>Bloqueos para liberar</strong><ul class="mb-0 mt-2">@foreach (var item in view.Blockers) { <li>@item</li> }</ul></div> }
        @if (view.Warnings.Count > 0) { <div class="alert alert-warning" role="status"><strong>Advertencias de existencia</strong><ul class="mb-0 mt-2">@foreach (var item in view.Warnings) { <li>@item</li> }</ul></div> }
        @if (view.Rows.Count == 0)
        {
            <p class="mb-0 text-body-secondary">No hay materiales fotografiados. En un borrador ADMIN, usa Revisar planificación para incorporar una receta activa disponible.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var group in view.Rows.GroupBy(x => new { x.Sequence, x.StageId, x.Stage }).OrderBy(x => x.Key.Sequence))
                {
                    <div class="col-12"><h3 class="h6 mb-0">@group.Key.Sequence. @group.Key.Stage</h3></div>
                    @foreach (var row in group)
                    {
                        <div class="col-12 col-xl-6"><article class="border rounded p-3 h-100 @(row.Blockers.Count > 0 ? "border-danger" : "")"><div class="d-flex justify-content-between gap-3"><div><strong>@row.MaterialSku</strong><small class="d-block text-body-secondary">@row.MaterialDescription</small></div><strong>@row.Planned.ToString("0.####") @row.Unit</strong></div><dl class="row small mt-3 mb-0"><dt class="col-5">Destino</dt><dd class="col-7">@(row.IsResolved ? row.Target : "Sin resolver")</dd><dt class="col-5">Origen</dt><dd class="col-7">@row.ResolutionSource</dd><dt class="col-5">Estado</dt><dd class="col-7">@(row.Blockers.Count == 0 ? "Listo" : row.IsResolved ? "Incompatible" : "Requiere destino")</dd><dt class="col-5">Disponible almacén</dt><dd class="col-7">@row.WarehouseAvailable.ToString("0.####") @row.Unit</dd><dt class="col-5">Libre en WIP</dt><dd class="col-7">@row.WipAvailable.ToString("0.####") @row.Unit</dd></dl></article></div>
                    }
                }
            </div>
        }
        @if (editable)
        {
            <details class="mt-3" @(view.Blockers.Count > 0 ? "open" : null)><summary class="btn btn-outline-primary">Revisar o cambiar destinos</summary>
                <form method="post" asp-page-handler="Planning" class="mt-3" data-planning-form data-production-planning data-target-lookup-url="@lookupUrl">
                    <input asp-for="Planning.OperationId" type="hidden" /><input asp-for="Planning.ExpectedVersion" type="hidden" value="@Model.Order.Version" />
                    @for (var index = 0; index < view.Rows.Count; index++)
                    {
                        var row = view.Rows[index];
                        <div class="border rounded p-3 mb-3" data-planning-row data-stage-id="@row.StageId"><input name="Planning.Targets[@index].PlanId" value="@row.PlanId" type="hidden" /><input name="Planning.Targets[@index].TargetKey" value="@row.TargetKey" type="hidden" data-planning-target-key /><label class="form-label fw-semibold" for="planning-target-@index">@(row.IsResolved ? "Cambiar para esta orden" : "Resolver destino") · @row.MaterialSku · @row.Stage</label><div class="lookup-field"><input id="planning-target-@index" type="search" class="form-control form-control-lg" value="@row.Target" placeholder="Buscar área, rack o posición WIP" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="planning-results-@index" data-planning-target-search /><div id="planning-results-@index" class="lookup-results list-group" role="listbox" data-planning-target-results></div></div><div class="form-text" aria-live="polite" data-planning-target-feedback>@(row.IsResolved ? $"Actual: {row.Target}. Selecciona otra opción sólo para esta orden." : "Escribe para elegir un destino permitido para el proceso.")</div></div>
                    }
                    <div class="row g-3"><div class="col-12 col-md-8"><label asp-for="Planning.Reason" class="form-label">Motivo de la revisión</label><input asp-for="Planning.Reason" class="form-control" required maxlength="500" /></div><div class="col-12 col-md-4"><label asp-for="Planning.Pin" class="form-label">NIP ADMIN</label><input asp-for="Planning.Pin" type="password" inputmode="numeric" autocomplete="off" class="form-control" required /></div><div class="col-12"><button type="submit" class="btn btn-primary btn-lg">Guardar fotografía de planificación</button></div></div>
                </form>
            </details>
        }
    </div>
</section>
