@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionOrderReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>Orden</th><th>Producto</th><th class="text-end">Meta</th><th class="text-end">Recibido</th><th>Estado</th><th>Fecha requerida</th><th class="text-end">Alertas</th><th></th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr class="@(row.IsOverdue ? "production-row-alert" : null)"><td data-label="Orden"><strong>@row.Number</strong></td><td data-label="Producto"><span class="font-monospace">@row.Sku</span><small>@row.Description</small></td><td data-label="Meta" class="text-end">@row.Target.ToString("0.####") @row.Unit@if (row.OriginalTarget != row.Target) { <small>Original @row.OriginalTarget.ToString("0.####")</small> }</td><td data-label="Recibido" class="text-end"><strong>@row.Received.ToString("0.####") @row.Unit</strong></td><td data-label="Estado"><span class="badge text-bg-secondary">@row.Status</span>@if (row.IsOverdue) { <span class="badge text-bg-danger">Vencida</span> }</td><td data-label="Fecha requerida">@(row.DueDate?.ToString("dd/MM/yyyy") ?? "Sin fecha")</td><td data-label="Alertas" class="text-end">@row.AlertCount</td><td><a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Production/Details" asp-route-id="@row.Id">Ver orden</a></td></tr> }</tbody>
</table>
