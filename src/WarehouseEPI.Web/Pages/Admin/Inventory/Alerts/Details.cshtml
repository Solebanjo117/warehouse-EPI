@page "{id:guid}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Admin.Inventory.Alerts.DetailsModel
@{
    ViewData["Title"] = CatTexts["Seguimiento de excepción"].Value;
    var item = Model.Exception!.Case;
}

<div class="exception-detail">
    <header class="exception-detail-header">
        <a asp-page="/Admin/Inventory/Alerts" class="small text-decoration-none">@CatTexts["← Centro de excepciones"]</a>
        <div class="exception-detail-title-row">
            <div>
                <div class="exception-detail-badges" aria-label="@CatTexts["Clasificación del caso"]">
                    <span class="badge @SeverityClass(item.Severity)">@SeverityLabel(item.Severity)</span>
                    <span class="badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span>
                </div>
                <h1 class="h2 mb-1">@CategoryLabel(item.Category)</h1>
                <p class="mb-0"><strong>@item.PrimaryText</strong><span class="text-muted"> · @item.SecondaryText</span></p>
            </div>
        </div>
    </header>

    @if (Model.Error is not null)
    {
        <div class="alert alert-danger mt-3" role="alert">@Model.Error</div>
    }

    <section class="exception-detail-summary mt-3" aria-labelledby="exception-summary-title">
        <h2 id="exception-summary-title" class="visually-hidden">@CatTexts["Resumen de la excepción"]</h2>
        <dl class="exception-detail-facts mb-0">
            <div><dt>@PrimaryLabel(item.Category)</dt><dd>@item.PrimaryText</dd></div>
            <div><dt>@SecondaryLabel(item.Category)</dt><dd>@item.SecondaryText</dd></div>
            <div><dt>@CatTexts["Valor actual"]</dt><dd>@(item.ValueText ?? CatTexts["Requiere atención"].Value)</dd></div>
            <div><dt>@CatTexts["Responsable"]</dt><dd>@(item.AssignedUserName ?? CatTexts["Sin responsable"].Value)</dd></div>
        </dl>
        <div class="exception-detail-dates">
            <div>
                <span>@CatTexts["Detectada"]</span>
                <time datetime="@item.FirstDetectedAt.ToString("O")">@Model.FirstDetectedAt.ToString("dd/MM/yyyy HH:mm")</time>
                <small>@Model.FirstDetectedRelative</small>
            </div>
            <div>
                <span>@CatTexts["Última verificación"]</span>
                <time datetime="@item.LastDetectedAt.ToString("O")">@Model.LastDetectedAt.ToString("dd/MM/yyyy HH:mm")</time>
                <small>@Model.LastDetectedRelative</small>
            </div>
        </div>
    </section>

    <div class="exception-detail-guidance mt-3">
        <section class="exception-detail-reason" aria-labelledby="exception-reason-title">
            <span class="exception-detail-section-label">@CatTexts["Motivo"]</span>
            <h2 id="exception-reason-title" class="h5">@CatTexts["Por qué apareció"]</h2>
            <p class="mb-0">@item.ReasonText</p>
        </section>
        <section class="exception-detail-next" aria-labelledby="exception-next-title">
            <span class="exception-detail-section-label">@CatTexts["Acción recomendada"]</span>
            <h2 id="exception-next-title" class="h5">@CatTexts["Siguiente paso"]</h2>
            <p>@ActionDescription(item.Category)</p>
            <a href="@item.TargetUrl" class="btn btn-primary">@ActionLabel(item.Category)</a>
            <small>@CatTexts["La acción abre el flujo existente y conserva sus validaciones y NIP."]</small>
        </section>
    </div>

    @if (item.Status == OperationalExceptionStatus.Resolved)
    {
        <div class="alert alert-success mt-3">
            <strong>@CatTexts["Resuelta automáticamente."]</strong>
            @CatTexts["La condición dejó de estar presente el"]
            <time datetime="@item.ResolvedAt?.ToString("O")">@Model.ResolvedAt?.ToString("dd/MM/yyyy HH:mm")</time>.
        </div>
    }
    else
    {
        <section class="exception-detail-follow-up mt-3" aria-labelledby="exception-follow-up-title">
            <div class="exception-detail-section-heading">
                <div>
                    <span class="exception-detail-section-label">@CatTexts["Triage administrativo"]</span>
                    <h2 id="exception-follow-up-title" class="h4 mb-1">@CatTexts["Actualizar seguimiento"]</h2>
                </div>
                <p class="text-muted mb-0">@CatTexts["El seguimiento no modifica inventario."]</p>
            </div>
            <form method="post" asp-page-handler="Update">
                <input asp-for="Input.OperationId" type="hidden" />
                <input asp-for="Input.Version" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" tabindex="-1"></div>
                <div class="exception-detail-form-grid">
                    <div>
                        <label asp-for="Input.AssignedUserId" class="form-label">@CatTexts["Responsable"]</label>
                        <select asp-for="Input.AssignedUserId" class="form-select">
                            <option value="">@CatTexts["Sin responsable"]</option>
                            @foreach (var user in Model.Assignees)
                            {
                                <option value="@user.Id">@user.FullName · @user.RoleCode</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label asp-for="Input.Status" class="form-label">@CatTexts["Estado"]</label>
                        <select asp-for="Input.Status" class="form-select">
                            <option value="@OperationalExceptionStatus.New">@CatTexts["Nueva"]</option>
                            <option value="@OperationalExceptionStatus.InProgress">@CatTexts["En atención"]</option>
                            <option value="@OperationalExceptionStatus.Waiting">@CatTexts["En espera"]</option>
                        </select>
                    </div>
                    <div class="exception-detail-note">
                        <label asp-for="Input.Notes" class="form-label">@CatTexts["Qué se revisó o qué falta"]</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="500" aria-describedby="exception-note-help"></textarea>
                        <span asp-validation-for="Input.Notes" class="text-danger"></span>
                        <div id="exception-note-help" class="form-text">@CatTexts["Describe el hallazgo o el siguiente paso. Es obligatorio al dejar el caso en espera."]</div>
                    </div>
                </div>
                <button class="btn btn-primary mt-3">@CatTexts["Guardar seguimiento"]</button>
            </form>
        </section>
    }

    <section class="exception-detail-history mt-4" aria-labelledby="exception-history-title">
        <div class="exception-detail-section-heading">
            <div>
                <span class="exception-detail-section-label">@CatTexts["Auditoría"]</span>
                <h2 id="exception-history-title" class="h4 mb-0">@CatTexts["Historial"]</h2>
            </div>
            <span class="text-muted small">@CatTexts["Más reciente primero"]</span>
        </div>
        @if (Model.History.Count == 0)
        {
            <p class="exception-history-empty mb-0">@CatTexts["No hay eventos registrados para esta excepción."]</p>
        }
        else
        {
        <ol class="exception-timeline">
            @foreach (var entry in Model.History)
            {
                var history = entry.Event;
                <li>
                    <div class="exception-timeline-marker" aria-hidden="true"></div>
                    <article>
                        <header>
                            <strong>@EventLabel(history.Type)</strong>
                            <time datetime="@history.RecordedAt.ToString("O")">@entry.RecordedAt.ToString("dd/MM/yyyy HH:mm")</time>
                        </header>
                        @if (history.ActorUserName is not null)
                        {
                            <p class="exception-timeline-actor">@CatTexts["Realizado por {0}", history.ActorUserName]</p>
                        }
                        <dl class="exception-timeline-changes mb-0">
                            @if (history.PreviousStatus is not null && history.CurrentStatus is not null && history.PreviousStatus != history.CurrentStatus)
                            {
                                <div><dt>@CatTexts["Estado"]</dt><dd>@StatusLabel(history.PreviousStatus.Value) <span aria-hidden="true">→</span> @StatusLabel(history.CurrentStatus.Value)</dd></div>
                            }
                            else if (history.CurrentStatus is not null)
                            {
                                <div><dt>@CatTexts["Estado"]</dt><dd>@StatusLabel(history.CurrentStatus.Value)</dd></div>
                            }
                            @if (history.PreviousAssignedUserName != history.CurrentAssignedUserName &&
                                (history.PreviousAssignedUserName is not null || history.CurrentAssignedUserName is not null))
                            {
                                <div><dt>@CatTexts["Responsable"]</dt><dd>@(history.PreviousAssignedUserName ?? CatTexts["Sin responsable"].Value) <span aria-hidden="true">→</span> @(history.CurrentAssignedUserName ?? CatTexts["Sin responsable"].Value)</dd></div>
                            }
                            else if (history.CurrentAssignedUserName is not null)
                            {
                                <div><dt>@CatTexts["Responsable"]</dt><dd>@history.CurrentAssignedUserName</dd></div>
                            }
                        </dl>
                        @if (history.Notes is not null)
                        {
                            <p class="exception-timeline-note mb-0">@history.Notes</p>
                        }
                    </article>
                </li>
            }
        </ol>
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/exception-center.css" asp-append-version="true" />
}

@functions {
    string StatusLabel(OperationalExceptionStatus value) => value switch
    {
        OperationalExceptionStatus.New => CatTexts["Nueva"].Value,
        OperationalExceptionStatus.InProgress => CatTexts["En atención"].Value,
        OperationalExceptionStatus.Waiting => CatTexts["En espera"].Value,
        _ => CatTexts["Resuelta"].Value
    };

    string SeverityLabel(OperationalExceptionSeverity value) => value switch
    {
        OperationalExceptionSeverity.Critical => CatTexts["Crítica"].Value,
        OperationalExceptionSeverity.Warning => CatTexts["Advertencia"].Value,
        _ => CatTexts["Informativa"].Value
    };

    string CategoryLabel(OperationalExceptionCategory value) => value switch
    {
        OperationalExceptionCategory.NegativeInventory => CatTexts["Saldo negativo"].Value,
        OperationalExceptionCategory.BelowMinimum => CatTexts["Inventario bajo mínimo"].Value,
        OperationalExceptionCategory.UnassignedBalance => CatTexts["Existencia sin asignación"].Value,
        OperationalExceptionCategory.RestrictedInventory => CatTexts["Inventario restringido"].Value,
        OperationalExceptionCategory.StagnantInventory => CatTexts["Inventario estancado"].Value,
        OperationalExceptionCategory.CycleCountStale => CatTexts["Conteo obsoleto"].Value,
        OperationalExceptionCategory.CycleCountPending => CatTexts["Conteo pendiente"].Value,
        _ => CatTexts["WIP estancado"].Value
    };

    string ActionLabel(OperationalExceptionCategory value) => value switch
    {
        OperationalExceptionCategory.NegativeInventory => CatTexts["Revisar y ajustar saldo"].Value,
        OperationalExceptionCategory.BelowMinimum => CatTexts["Preparar transferencia"].Value,
        OperationalExceptionCategory.UnassignedBalance => CatTexts["Revisar asignación"].Value,
        OperationalExceptionCategory.RestrictedInventory => CatTexts["Revisar ubicación"].Value,
        OperationalExceptionCategory.StagnantInventory => CatTexts["Registrar salida"].Value,
        OperationalExceptionCategory.CycleCountStale or OperationalExceptionCategory.CycleCountPending => CatTexts["Abrir conteo"].Value,
        _ => CatTexts["Procesar WIP"].Value
    };

    string PrimaryLabel(OperationalExceptionCategory value) =>
        value is OperationalExceptionCategory.CycleCountStale or OperationalExceptionCategory.CycleCountPending
            ? CatTexts["Conteo"].Value
            : CatTexts["Producto"].Value;

    string SecondaryLabel(OperationalExceptionCategory value) =>
        value is OperationalExceptionCategory.BelowMinimum or OperationalExceptionCategory.StagnantInventory
            ? CatTexts["Descripción"].Value
            : CatTexts["Ubicación"].Value;

    string ActionDescription(OperationalExceptionCategory value) => value switch
    {
        OperationalExceptionCategory.NegativeInventory => CatTexts["Comprueba los movimientos y registra un ajuste sólo si el saldo físico lo confirma."].Value,
        OperationalExceptionCategory.BelowMinimum => CatTexts["Revisa la disponibilidad y prepara una transferencia hacia donde se necesita."].Value,
        OperationalExceptionCategory.UnassignedBalance => CatTexts["Confirma si el producto debe quedar asignado a esta ubicación."].Value,
        OperationalExceptionCategory.RestrictedInventory => CatTexts["Revisa el bloqueo o la inactividad antes de decidir cómo mover la existencia."].Value,
        OperationalExceptionCategory.StagnantInventory => CatTexts["Confirma el destino del material antes de registrar una salida."].Value,
        OperationalExceptionCategory.CycleCountStale => CatTexts["Abre la campaña y realiza el reconteo solicitado."].Value,
        OperationalExceptionCategory.CycleCountPending => CatTexts["Abre la campaña para completar la revisión o el reconteo."].Value,
        _ => CatTexts["Decide si corresponde consumo, regreso a bodega o devolución a proveedor."].Value
    };

    string EventLabel(OperationalExceptionEventType value) => value switch
    {
        OperationalExceptionEventType.Detected => CatTexts["Condición detectada"].Value,
        OperationalExceptionEventType.AutoResolved => CatTexts["Condición resuelta automáticamente"].Value,
        _ => CatTexts["Seguimiento actualizado"].Value
    };

    static string SeverityClass(OperationalExceptionSeverity value) => value switch
    {
        OperationalExceptionSeverity.Critical => "text-bg-danger",
        OperationalExceptionSeverity.Warning => "text-bg-warning",
        _ => "text-bg-info"
    };

    static string StatusClass(OperationalExceptionStatus value) => value switch
    {
        OperationalExceptionStatus.New => "text-bg-secondary",
        OperationalExceptionStatus.InProgress => "text-bg-primary",
        OperationalExceptionStatus.Waiting => "text-bg-warning",
        _ => "text-bg-success"
    };
}
