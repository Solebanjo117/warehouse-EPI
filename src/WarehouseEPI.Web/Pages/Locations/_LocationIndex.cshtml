            <td data-label="@CatTexts["Posición física"]">@if(item.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack){<span class="pos-triple"><span><small>@CatTexts["Fila"]</small><strong>@item.RowCode</strong></span><span><small>Rack</small><strong>@item.RackNumber</strong></span><span><small>Pallet</small><strong>@item.PalletNumber</strong></span></span>}else{<span class="pos-area">@CatTexts["Área especial"]</span>}</td>
            <td data-label="@CatTexts["Productos asignados"]">@if(item.ProductCount==0){<span class="text-body-secondary">@CatTexts["Sin asignar"]</span>}else{<span class="sku-list">@foreach(var sku in item.Skus){<span class="sku-chip">@sku</span>}@if(item.ProductCount>item.Skus.Count){<span class="sku-more">@CatTexts["+{0} más", item.ProductCount-item.Skus.Count]</span>}</span>}</td>
            <td data-label="@CatTexts["Estado"]">@if(!item.IsPhysicallyPresent){<span class="state-tag state-retired">@CatTexts["Retirada"]</span>}else if(!item.IsActive){<span class="state-tag state-inactive">@CatTexts["Inactiva"]</span>}else if(item.IsBlocked){<span class="state-tag state-blocked"><svg class="app-icon" aria-hidden="true"><use href="#icon-alert" /></svg>@CatTexts["Bloqueada"]</span><span class="state-reason">@item.BlockReason</span>}else{<span class="state-tag state-available">@CatTexts["Disponible"]</span>}</td>
            <td data-label="@(Model.IsAdministrativeView ? CatTexts["Acciones"].Value : CatTexts["Consulta"].Value)" class="text-end">@if(Model.IsAdministrativeView){<div class="dropdown"><button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">@CatTexts["Acciones"]</button><ul class="dropdown-menu dropdown-menu-end"><li><a asp-page="@detailsPage" asp-route-id="@item.Id" class="dropdown-item">@CatTexts["Ver ficha"]</a></li>@if(item.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack){<li><a asp-page="/Admin/Catalogs/Locations/Rack/Edit" asp-route-rowCode="@item.RowCode" asp-route-rackNumber="@item.RackNumber" class="dropdown-item">@CatTexts["Editar rack"]</a></li>}else{<li><a asp-page="/Admin/Catalogs/Locations/Area" asp-route-locationId="@item.Id" class="dropdown-item">@CatTexts["Editar área"]</a></li>}@if(item.IsPhysicallyPresent){<li><hr class="dropdown-divider"/></li>@if(item.IsActive&&!item.IsBlocked){<li><button type="button" class="dropdown-item text-warning block-location" data-bs-toggle="modal" data-bs-target="#blockModal" data-location-id="@item.Id" data-location-code="@item.Code">@CatTexts["Bloquear"]</button></li>}else if(item.IsBlocked){<li><form method="post" asp-page-handler="Unblock"><input type="hidden" name="id" value="@item.Id"/><button class="dropdown-item text-success">@CatTexts["Desbloquear"]</button></form></li>}<li><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@item.Id"/><button class="dropdown-item">@(item.IsActive?CatTexts["Desactivar"].Value:CatTexts["Activar"].Value)</button></form></li>}</ul></div>}else{<a asp-page="@detailsPage" asp-route-id="@item.Id" class="btn btn-outline-primary">@CatTexts["Ver ficha"]</a>}</td>
        </tr>
    }
    </tbody></table></div>
    @if(Model.TotalPages>1){<nav aria-label="@CatTexts["Paginación"]"><ul class="pagination justify-content-center flex-wrap"><li class="page-item @(Model.CurrentPage<=1?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(1)">@CatTexts["Primera"]</a></li><li class="page-item @(Model.CurrentPage<=1?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.CurrentPage-1)">@CatTexts["Anterior"]</a></li>@foreach(var pageNumber in Model.VisiblePages){<li class="page-item @(pageNumber==Model.CurrentPage?"active":"")"><a class="page-link" asp-all-route-data="@RouteValues(pageNumber)">@pageNumber</a></li>}<li class="page-item @(Model.CurrentPage>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.CurrentPage+1)">@CatTexts["Siguiente"]</a></li><li class="page-item @(Model.CurrentPage>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.TotalPages)">@CatTexts["Última"]</a></li></ul></nav>}
}

@if(Model.IsAdministrativeView){<div class="modal fade" id="blockModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="Block"><div class="modal-header"><h2 class="modal-title fs-5" id="blockModalLabel">@CatTexts["Bloquear ubicación"]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@CatTexts["Cerrar"]"></button></div><div class="modal-body"><input type="hidden" id="blockLocationId" name="id"/><p id="blockLocationText"></p><label for="blockReason" class="form-label">@CatTexts["Motivo"]</label><textarea id="blockReason" name="reason" class="form-control" maxlength="200" rows="3" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@CatTexts["Cancelar"]</button><button class="btn btn-warning">@CatTexts["Bloquear"]</button></div></form></div></div></div>}

</div>

@functions{
    private Dictionary<string,string?> RouteValues(int pageNumber) => new()
    {
        ["search"] = Model.Search, ["status"] = Model.Status, ["kind"] = Model.Kind,
        ["rowCode"] = Model.RowCode, ["viewMode"] = "table", ["pageNumber"] = pageNumber.ToString()
    };
    private static string MapState(WarehouseMapElementView element) => element.Positions.Any(item=>item.HasNegative)?"negative":element.Positions.All(item=>!item.IsActive)?"inactive":element.Positions.Any(item=>item.IsBlocked)?"blocked":element.Positions.Any(item=>item.HasInventory)?"occupied":"available";
    private static string PositionState(WarehouseMapPosition item) => item.HasNegative?"negative":!item.IsActive?"inactive":item.IsBlocked?"blocked":item.HasInventory?"occupied":"available";
    private string StateLabel(string state) => state switch{"negative"=>CatTexts["saldo negativo.lower"].Value,"inactive"=>CatTexts["inactivo.lower"].Value,"blocked"=>CatTexts["bloqueado.lower"].Value,"occupied"=>CatTexts["con inventario"].Value,_=>CatTexts["disponible.lower"].Value};
    private string RackStateLabel(string state) => state switch{"negative"=>CatTexts["Saldo negativo"].Value,"inactive"=>CatTexts["Inactiva"].Value,"blocked"=>CatTexts["Bloqueada"].Value,"occupied"=>CatTexts["Con saldo"].Value,_=>CatTexts["Sin saldo"].Value};
    private static string AdminState(LocationIndexPageModel.LocationRow item) => !item.IsPhysicallyPresent?"retired":!item.IsActive?"inactive":item.IsBlocked?"blocked":"available";
}
