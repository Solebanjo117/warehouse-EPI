@page
@model WarehouseEPI.Web.Pages.Admin.Production.OrdersModel
@{ViewData["Title"]="Órdenes de trabajo";}
<div class="container-fluid py-3 production-page"><header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="eyebrow">Producción</span><h1 class="h2">Órdenes de trabajo</h1><p class="text-muted">Crea una orden por producto y conserva su ruta desde la liberación.</p></div><a asp-page="Routes" class="btn btn-outline-primary">Configurar rutas</a></header><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<section class="card mb-4"><div class="card-body"><h2 class="h5">Nueva orden</h2><form method="post" class="row g-3"><input asp-for="Input.OperationId" type="hidden"/><div class="col-12 col-lg-6"><label asp-for="Input.ProductId" class="form-label">Producto terminado</label><select asp-for="Input.ProductId" class="form-select"><option value="">Selecciona…</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Sku · @p.Description</option>}</select></div><div class="col-6 col-lg-3"><label asp-for="Input.TargetQuantity" class="form-label">Cantidad objetivo</label><input asp-for="Input.TargetQuantity" class="form-control" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="Input.DueDate" class="form-label">Fecha prevista</label><input asp-for="Input.DueDate" class="form-control" type="date"/></div><div class="col-12 col-lg-6"><label asp-for="Input.ExternalReference" class="form-label">Referencia externa (opcional)</label><input asp-for="Input.ExternalReference" class="form-control"/></div><div class="col-12 col-lg-6"><label asp-for="Input.Notes" class="form-label">Observaciones</label><input asp-for="Input.Notes" class="form-control"/></div><div class="col-12 col-lg-4"><label asp-for="Input.Pin" class="form-label">NIP ADMIN</label><input asp-for="Input.Pin" type="password" inputmode="numeric" class="form-control" autocomplete="off"/></div><div class="col-12"><button class="btn btn-primary" type="submit">Crear borrador</button></div></form></div></section>
<section><form method="get" class="d-flex gap-2 mb-3"><label class="visually-hidden" for="order-search">Buscar</label><input id="order-search" name="Search" value="@Model.Search" class="form-control" type="search" placeholder="Folio, referencia o SKU"/><button class="btn btn-outline-primary">Buscar</button></form>@if(Model.Items.Count==0){<div class="alert alert-info">Sin órdenes. Crea un borrador para comenzar.</div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Folio</th><th>Producto</th><th>Meta</th><th>Recibido</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><strong>@x.Number</strong><br/><small>@x.ExternalReference</small></td><td>@x.Sku<br/><small>@x.Description</small></td><td>@x.Target.ToString("0.####") @x.Unit</td><td>@x.Received.ToString("0.####")</td><td>@x.Status</td><td><a asp-page="Details" asp-route-id="@x.Id" class="btn btn-outline-primary">Abrir</a></td></tr>}</tbody></table></div>}</section></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
