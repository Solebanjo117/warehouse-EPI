@page
@model ErrorModel
@{
    ViewData["Title"] = SharedTexts["Error"].Value;
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">@SharedTexts["Ocurrió un error al procesar la solicitud."]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@SharedTexts["Identificador de solicitud:"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@SharedTexts["Modo de desarrollo"]</h3>
<p>
    @SharedTexts["Cambiar al entorno"] <strong>Development</strong> @SharedTexts["muestra información detallada sobre el error ocurrido."]
</p>
<p>
    <strong>@SharedTexts["El entorno Development no debe habilitarse en aplicaciones desplegadas."]</strong>
    @SharedTexts["Puede mostrar información confidencial de las excepciones a los usuarios finales."]
    @SharedTexts["Para depurar localmente, habilita el entorno"] <strong>Development</strong> @SharedTexts["configurando la variable de entorno"] <strong>ASPNETCORE_ENVIRONMENT</strong> @SharedTexts["con el valor"] <strong>Development</strong>
    @SharedTexts["y reiniciando la aplicación."]
</p>
