@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@using System.Globalization
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Operations.OperationPageModel
@{
    var product = Model.SelectedProduct;
    var source = Model.SelectedSource;
    var destination = Model.SelectedDestination;
    var location = Model.SelectedLocation;
    var isEntry = Model.MovementType == InventoryMovementType.Entry;
    var isExit = Model.MovementType == InventoryMovementType.Exit;
    var isTransfer = Model.MovementType == InventoryMovementType.Transfer;
    var isAdjustment = Model.MovementType == InventoryMovementType.Adjustment;
    var isWipIssue = Model.Input.ExitMode == ExitMode.Wip || Model.MovementPurpose == InventoryMovementPurpose.ProductionIssue;
    var stepCount = isExit ? (isWipIssue ? 5 : 4) : isTransfer || isAdjustment ? 4 : 3;
    var lookupUrl = Url.Page("/Operations/Lookup");
    var additionalOpen = !string.IsNullOrWhiteSpace(Model.Input.Reference)
        || !string.IsNullOrWhiteSpace(Model.Input.Notes)
        || ViewData.ModelState.Any(entry =>
            (entry.Key == "Input.Reference" || entry.Key == "Input.Notes") && entry.Value?.Errors.Count > 0);
}

<div class="operation-shell entry-workstation" data-operation="@Model.OperationKey" data-guided-workstation data-lookup-url="@lookupUrl">
    <header class="entry-header"><div><a asp-page="/Index" class="small text-decoration-none">@OpTexts["← Menú operativo"]</a><h1 class="h2 mt-2 mb-1">@OpTexts[Model.PageTitle]</h1><p class="text-muted mb-0">@OpTexts[Model.PageHelp]</p></div><div class="entry-progress" role="status" aria-live="polite"><span data-entry-progress>@OpTexts["0 de {0} listos", stepCount]</span><small>@OpTexts["1 producto por operación"]</small></div></header>
    <form method="post" data-operation-form>
        <input asp-for="Input.OperationId" type="hidden" /><input asp-for="Input.ProductId" type="hidden" data-selected-id="product" /><input asp-for="Input.SourceLocationId" type="hidden" data-selected-id="source" /><input asp-for="Input.DestinationLocationId" type="hidden" data-selected-id="destination" /><input asp-for="Input.LocationId" type="hidden" data-selected-id="location" /><input asp-for="Input.ExpectedBalanceVersion" type="hidden" data-balance-version />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1" data-operation-errors></div>
        @if (Model.PrefillWarning is not null) { <div class="alert alert-warning" role="status">@Model.PrefillWarning</div> }
        <div class="alert alert-info d-none" role="status" aria-live="polite" data-operation-feedback></div>
        @if (Model.NeedsSharingApproval)
        {
            <section class="alert alert-warning operation-warning" aria-labelledby="sharing-title"><h2 id="sharing-title" class="h5">@OpTexts["El pallet ya contiene otros productos"]</h2><p>@OpTexts["Confirma expresamente que deseas compartir la ubicación. No se realizó ningún cambio."]</p>@foreach (var conflict in Model.SharingConflicts) { <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="Input.ApprovedSharedLocationIds" value="@conflict.LocationId" id="approve-@conflict.LocationId" required data-sharing-approval /><label class="form-check-label" for="approve-@conflict.LocationId">@OpTexts["Agregar {0} a {1}, compartiendo con {2}", conflict.ProductSku, conflict.LocationCode, string.Join(", ", conflict.ExistingProductSkus)]</label></div> }<p class="mb-0 small">@OpTexts["Deberás introducir nuevamente tu NIP al confirmar."]</p></section>
        }
        <div class="entry-layout"><main class="entry-capture" aria-label="@OpTexts["Captura de {0}", OpTexts[Model.PageTitle].Value.ToLowerInvariant()]">
            @if (isExit)
            {
                <section class="entry-step" data-entry-step="exit-mode">
                    <header class="entry-step-header"><span class="entry-step-number" aria-hidden="true">1</span><div><h2 class="h5 mb-0">@OpTexts["Tipo de salida"]</h2><span class="entry-step-status" data-entry-step-status>@OpTexts["En captura"]</span></div><button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="exit-mode">@OpTexts["Cambiar"]</button></header>
                    <div class="entry-step-body"><div class="row g-2" data-exit-mode-picker><div class="col-12 col-md-6"><input asp-for="Input.ExitMode" id="exit-mode-general" class="btn-check" type="radio" value="General" autocomplete="off" /><label class="btn btn-outline-primary w-100 text-start p-3" for="exit-mode-general"><strong>@OpTexts["Salida general"]</strong><small class="d-block">@OpTexts["Venta u otra salida de almacén."]</small></label></div><div class="col-12 col-md-6"><input asp-for="Input.ExitMode" id="exit-mode-wip" class="btn-check" type="radio" value="Wip" autocomplete="off" /><label class="btn btn-outline-warning w-100 text-start p-3" for="exit-mode-wip"><strong>@OpTexts["Surtir WIP"]</strong><small class="d-block">@OpTexts["Transfiere existencias del rack al WIP seleccionado."]</small></label></div></div><span asp-validation-for="Input.ExitMode" class="text-danger"></span></div>
                    <div class="entry-step-result" data-entry-step-result><strong data-entry-result-title>@OpTexts["Tipo pendiente"]</strong><span data-entry-result-detail></span></div>
                </section>
            }
            <section class="entry-step" data-entry-step="product"><header class="entry-step-header"><span class="entry-step-number" aria-hidden="true">@(isExit ? 2 : 1)</span><div><h2 class="h5 mb-0">@OpTexts["Producto"]</h2><span class="entry-step-status" data-entry-step-status>@OpTexts["Pendiente"]</span></div><button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="product">@OpTexts["Cambiar"]</button></header><div class="entry-step-body"><div class="lookup-field" data-lookup-field="product"><label for="product-code" class="form-label">@OpTexts["SKU o código de barras"]</label><div class="input-group input-group-lg entry-capture-input"><input id="product-code" class="form-control" type="search" value="@product?.Sku" autocomplete="off" autocapitalize="characters" placeholder="@OpTexts["Escanea o escribe el código"]" autofocus data-lookup-input /><button type="button" class="btn btn-outline-secondary" data-camera-scan aria-label="@OpTexts["Escanear producto con cámara"]"><svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg></button></div><div class="lookup-results list-group" data-lookup-results></div><div class="selected-record @(product is null ? "d-none" : null)" data-selected-record data-unit="@product?.UnitCode" data-allows-decimals="@(product?.AllowsDecimals == true ? "true" : "false")"><strong data-selected-title>@product?.Sku</strong><span data-selected-detail>@product?.Description</span><small data-selected-meta>@product?.UnitCode</small></div><span asp-validation-for="Input.ProductId" class="text-danger"></span></div></div><div class="entry-step-result" data-entry-step-result><strong data-entry-result-title>@OpTexts["Producto pendiente"]</strong><span data-entry-result-detail></span></div></section>
            @if (isEntry)
            {
                <section class="entry-step" data-entry-step="destination">
                    <header class="entry-step-header">
                        <span class="entry-step-number" aria-hidden="true">2</span>
                        <div>
                            <h2 class="h5 mb-0">@OpTexts["Ubicación destino"]</h2>
                            <span class="entry-step-status" data-entry-step-status>@OpTexts["Pendiente"]</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="destination">@OpTexts["Cambiar"]</button>
                    </header>
                    <div class="entry-step-body">
                        <div class="relationship-panel d-none" data-relationship-for="destination" aria-live="polite"></div>
                        <div class="lookup-field" data-lookup-field="destination">
                            <label for="destination-code" class="form-label">@OpTexts["Código de ubicación"]</label>
                            <div class="input-group input-group-lg entry-capture-input">
                                <input id="destination-code" class="form-control" type="search" value="@destination?.Code"
                                       autocomplete="off" autocapitalize="characters" placeholder="@OpTexts["Escanea o escribe la ubicación"]"
                                       data-lookup-input />
                                <button type="button" class="btn btn-outline-secondary" data-camera-scan
                                        aria-label="@OpTexts["Escanear ubicación destino con cámara"]"><svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg></button>
                            </div>
                            <div class="lookup-results list-group" data-lookup-results></div>
                            <div class="selected-record @(destination is null ? "d-none" : null)" data-selected-record>
                                <strong data-selected-title>@destination?.Code</strong>
                                <span data-selected-detail>@destination?.Description</span>
                            </div>
                            <span asp-validation-for="Input.DestinationLocationId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="entry-step-result" data-entry-step-result>
                        <strong data-entry-result-title>@OpTexts["Destino pendiente"]</strong>
                        <span data-entry-result-detail></span>
                    </div>
                </section>
            }
            @if (isExit || isTransfer) { <section class="entry-step" data-entry-step="source"><header class="entry-step-header"><span class="entry-step-number" aria-hidden="true">@(isExit ? 3 : 2)</span><div><h2 class="h5 mb-0">@OpTexts["Ubicación origen"]</h2><span class="entry-step-status" data-entry-step-status>@OpTexts["Pendiente"]</span></div><button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="source">@OpTexts["Cambiar"]</button></header><div class="entry-step-body"><div class="relationship-panel d-none" data-relationship-for="source" aria-live="polite"></div><div class="lookup-field" data-lookup-field="source"><label for="source-code" class="form-label">@OpTexts["Código de ubicación"]</label><div class="input-group input-group-lg entry-capture-input"><input id="source-code" class="form-control" type="search" value="@source?.Code" autocomplete="off" autocapitalize="characters" placeholder="@OpTexts["Escanea o escribe la ubicación"]" data-lookup-input /><button type="button" class="btn btn-outline-secondary" data-camera-scan aria-label="@OpTexts["Escanear ubicación origen con cámara"]"><svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg></button></div><div class="lookup-results list-group" data-lookup-results></div><div class="selected-record @(source is null ? "d-none" : null)" data-selected-record><strong data-selected-title>@source?.Code</strong><span data-selected-detail>@source?.Description</span></div><span asp-validation-for="Input.SourceLocationId" class="text-danger"></span></div></div><div class="entry-step-result" data-entry-step-result><strong data-entry-result-title>@OpTexts["Origen pendiente"]</strong><span data-entry-result-detail></span></div></section> }
            @if (isTransfer || isExit) { <section class="entry-step @(isExit && !isWipIssue ? "d-none" : null)" data-entry-step="destination" data-wip-destination-step><header class="entry-step-header"><span class="entry-step-number" aria-hidden="true">@(isExit ? 4 : 3)</span><div><h2 class="h5 mb-0">@(isExit ? OpTexts["Ubicación WIP destino"].Value : OpTexts["Ubicación destino"].Value)</h2><span class="entry-step-status" data-entry-step-status>@OpTexts["Pendiente"]</span></div><button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="destination">@OpTexts["Cambiar"]</button></header><div class="entry-step-body"><div class="relationship-panel d-none" data-relationship-for="destination" aria-live="polite"></div><div class="lookup-field" data-lookup-field="destination"><label for="destination-code" class="form-label">@(isExit ? OpTexts["Código de ubicación WIP"].Value : OpTexts["Código de ubicación"].Value)</label><div class="input-group input-group-lg entry-capture-input"><input id="destination-code" class="form-control" type="search" value="@destination?.Code" autocomplete="off" autocapitalize="characters" placeholder="@(isExit ? OpTexts["Escanea o escribe el pallet WIP"].Value : OpTexts["Escanea o escribe la ubicación"].Value)" data-lookup-input /><button type="button" class="btn btn-outline-secondary" data-camera-scan aria-label="@OpTexts["Escanear ubicación destino con cámara"]"><svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg></button></div><div class="lookup-results list-group" data-lookup-results></div><div class="selected-record @(destination is null ? "d-none" : null)" data-selected-record><strong data-selected-title>@destination?.Code</strong><span data-selected-detail>@destination?.Description</span></div><span asp-validation-for="Input.DestinationLocationId" class="text-danger"></span>@if(isExit){<div class="form-text">@OpTexts["El material quedará como existencia real en el WIP seleccionado."]</div>}</div></div><div class="entry-step-result" data-entry-step-result><strong data-entry-result-title>@OpTexts["Destino pendiente"]</strong><span data-entry-result-detail></span></div></section> }
            @if (isAdjustment) { <section class="entry-step" data-entry-step="location"><header class="entry-step-header"><span class="entry-step-number" aria-hidden="true">2</span><div><h2 class="h5 mb-0">@OpTexts["Ubicación"]</h2><span class="entry-step-status" data-entry-step-status>@OpTexts["Pendiente"]</span></div><button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="location">@OpTexts["Cambiar"]</button></header><div class="entry-step-body"><div class="relationship-panel d-none" data-relationship-for="location" aria-live="polite"></div><div class="lookup-field" data-lookup-field="location"><label for="location-code" class="form-label">@OpTexts["Código de ubicación"]</label><div class="input-group input-group-lg entry-capture-input"><input id="location-code" class="form-control" type="search" value="@location?.Code" autocomplete="off" autocapitalize="characters" placeholder="@OpTexts["Escanea o escribe la ubicación"]" data-lookup-input /><button type="button" class="btn btn-outline-secondary" data-camera-scan aria-label="@OpTexts["Escanear ubicación con cámara"]"><svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg></button></div><div class="lookup-results list-group" data-lookup-results></div><div class="selected-record @(location is null ? "d-none" : null)" data-selected-record><strong data-selected-title>@location?.Code</strong><span data-selected-detail>@location?.Description</span></div><span asp-validation-for="Input.LocationId" class="text-danger"></span></div></div><div class="entry-step-result" data-entry-step-result><strong data-entry-result-title>@OpTexts["Ubicación pendiente"]</strong><span data-entry-result-detail></span></div></section> }
            <section class="entry-step" data-entry-step="quantity"><header class="entry-step-header"><span class="entry-step-number" aria-hidden="true">@(isExit ? (isWipIssue ? 5 : 4) : isTransfer || isAdjustment ? 4 : 3)</span><div><h2 class="h5 mb-0">@(isAdjustment ? OpTexts["Conteo final"].Value : OpTexts["Cantidad"].Value)</h2><span class="entry-step-status" data-entry-step-status>@OpTexts["Pendiente"]</span></div><button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="quantity">@OpTexts["Cambiar"]</button></header><div class="entry-step-body"><label asp-for="Input.Quantity" class="form-label">@(isAdjustment ? OpTexts["Cantidad física"].Value : OpTexts["Cantidad a mover"].Value)</label><div class="input-group input-group-lg entry-capture-input"><input asp-for="Input.Quantity" class="form-control" inputmode="decimal" required min="@(isAdjustment ? null : "0.0001")" data-quantity /><span class="input-group-text" data-unit-label>@(product?.UnitCode ?? OpTexts["Unidad"].Value)</span></div><span asp-validation-for="Input.Quantity" class="text-danger"></span><div class="balance-preview mt-3" data-balance-preview data-source="@((Model.SourceBalance?.Quantity ?? 0m).ToString(CultureInfo.InvariantCulture))" data-destination="@((Model.DestinationBalance?.Quantity ?? 0m).ToString(CultureInfo.InvariantCulture))" data-location="@((Model.LocationBalance?.Quantity ?? 0m).ToString(CultureInfo.InvariantCulture))"><span class="text-muted">@OpTexts["Saldo y resultado"]</span><strong data-balance-text>@OpTexts["Selecciona producto y ubicación"]</strong><span class="text-danger d-none" data-negative-warning>@OpTexts["Advertencia: el saldo resultante será negativo."]</span></div></div><div class="entry-step-result" data-entry-step-result><strong data-entry-result-title>@OpTexts["Sin capturar"]</strong><span data-entry-result-detail></span></div></section>
            @if (isAdjustment) { <section class="entry-step" data-entry-step="notes"><header class="entry-step-header"><span class="entry-step-number" aria-hidden="true">4</span><div><h2 class="h5 mb-0">@OpTexts["Motivo"]</h2><span class="entry-step-status" data-entry-step-status>@OpTexts["Pendiente"]</span></div><button type="button" class="btn btn-sm btn-link entry-step-edit d-none" data-edit-step="notes">@OpTexts["Cambiar"]</button></header><div class="entry-step-body"><label asp-for="Input.Notes" class="form-label">@OpTexts["Motivo del ajuste"]</label><textarea asp-for="Input.Notes" class="form-control" rows="3" maxlength="500" required data-operation-notes></textarea><span asp-validation-for="Input.Notes" class="text-danger"></span></div><div class="entry-step-result" data-entry-step-result><strong data-entry-result-title>@OpTexts["Motivo pendiente"]</strong><span data-entry-result-detail></span></div></section> }
            <details class="entry-additional operation-card" @(additionalOpen ? "open" : null) data-entry-additional><summary><span><strong>@OpTexts["Datos adicionales"]</strong><small>@(isAdjustment ? OpTexts["Referencia"] : OpTexts["Referencia y observaciones"])</small></span></summary><div class="row g-3"><div class="col-12 col-md-5"><label asp-for="Input.Reference" class="form-label">@OpTexts["Referencia"] <span class="text-muted">@OpTexts["(opcional)"]</span></label><input asp-for="Input.Reference" class="form-control form-control-lg" maxlength="120" /><span asp-validation-for="Input.Reference" class="text-danger"></span></div>@if (!isAdjustment) { <div class="col-12 col-md-7"><label asp-for="Input.Notes" class="form-label">@OpTexts["Observaciones"] <span class="text-muted">@OpTexts["(opcional)"]</span></label><textarea asp-for="Input.Notes" class="form-control" rows="2" maxlength="500"></textarea><span asp-validation-for="Input.Notes" class="text-danger"></span></div> }</div></details>
        </main><aside class="entry-summary" aria-labelledby="entry-summary-title"><div class="entry-summary-card"><div class="entry-summary-heading"><div><span class="entry-summary-eyebrow">@OpTexts["Resumen de {0}", OpTexts[Model.PageTitle].Value.ToLowerInvariant()]</span><h2 class="h5 mb-0" id="entry-summary-title" data-entry-summary-state>@OpTexts["Faltan {0} pasos", stepCount]</h2></div><span class="entry-ready-mark" aria-hidden="true">✓</span></div><dl class="entry-summary-list"><div><dt>@OpTexts["Producto"]</dt><dd data-entry-summary-product>@OpTexts["Sin seleccionar"]</dd></div><div><dt>@OpTexts["Ubicación"]</dt><dd data-entry-summary-location>@OpTexts["Sin seleccionar"]</dd></div><div><dt>@OpTexts["Cantidad"]</dt><dd data-entry-summary-quantity>@OpTexts["Sin capturar"]</dd></div><div><dt>@OpTexts["Saldo"]</dt><dd data-entry-summary-balance>@OpTexts["Selecciona producto y ubicación"]</dd></div></dl><div class="entry-summary-actions"><a asp-page="/Index" class="btn btn-outline-secondary btn-lg">@OpTexts["Cancelar"]</a><button type="button" class="btn btn-primary btn-lg" data-review-button disabled>@OpTexts["Revisar y confirmar"]</button></div></div></aside></div>
        <div class="modal fade" id="confirm-operation" tabindex="-1" aria-labelledby="confirm-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5" id="confirm-title">@OpTexts["Confirmar {0}", OpTexts[Model.PageTitle].Value.ToLowerInvariant()]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@OpTexts["Cerrar"]"></button></div><div class="modal-body"><div class="confirmation-summary mb-3" data-confirmation-summary></div><label asp-for="Input.Pin" class="form-label fw-semibold">@OpTexts["NIP del responsable"]</label><input asp-for="Input.Pin" value="" class="form-control form-control-lg pin-input" type="password" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" autocomplete="off" data-pin-input /><span asp-validation-for="Input.Pin" class="text-danger"></span></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">@OpTexts["Volver"]</button><button type="submit" class="btn btn-primary btn-lg" data-submit-button>@OpTexts["Confirmar operación"]</button></div></div></div></div>
        <div class="modal fade" id="camera-barcode-scanner" tabindex="-1" aria-hidden="true" data-camera-scanner><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5">@OpTexts["Escanear código de barras"]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@OpTexts["Cerrar"]"></button></div><div class="modal-body"><div class="camera-preview" data-camera-preview><video class="w-100" autoplay muted playsinline data-camera-video></video></div><p class="mb-0 mt-3" role="status" aria-live="polite" data-camera-status>@OpTexts["Preparando cámara…"]</p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary btn-lg d-none" data-camera-switch>@OpTexts["Cambiar cámara"]</button><label class="btn btn-outline-primary btn-lg mb-0" for="camera-barcode-photo">@OpTexts["Tomar foto"]</label><input id="camera-barcode-photo" class="visually-hidden" type="file" accept="image/*" capture="environment" data-camera-photo /><button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">@OpTexts["Cancelar"]</button></div></div></div></div>
    </form>
</div>
