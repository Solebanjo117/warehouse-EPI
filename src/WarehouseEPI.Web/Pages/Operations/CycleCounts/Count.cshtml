@page
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.CountModel
@{
    ViewData["Title"] = "Conteo ciego";
    var attempt = Model.Attempt;
    var unexpectedRows = Math.Max(3, Model.Input.UnexpectedEntries.Count);
}
<div class="inventory-analytics" data-cycle-count-capture data-cycle-campaign="@Model.CampaignId" data-cycle-location="@Model.LocationId">
    <header class="inventory-page-header">
        <div>
            <a asp-page="Details" asp-route-id="@Model.CampaignId" class="small text-decoration-none">← Campaña</a>
            <h1 class="h2 mt-2">Conteo ciego</h1>
            <p class="text-muted mb-0">Escanea producto, captura cantidad y continúa. El sistema no muestra existencias esperadas.</p>
        </div>
    </header>

    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    @if (attempt is null)
    {
        <div class="alert alert-warning" role="alert">
            Vuelve a abrir la ubicación desde la campaña para iniciar la captura.
            <a asp-page="Details" asp-route-id="@Model.CampaignId" class="alert-link">Ir a la campaña</a>
        </div>
        return;
    }

    <form method="post" class="analytics-filter-card">
        <input asp-for="Input.PreparationToken" type="hidden" value="@Model.PreparationToken" />
        <input asp-for="Input.OperationId" type="hidden" value="@(Model.Input.OperationId == Guid.Empty ? Guid.NewGuid() : Model.Input.OperationId)" />
        <input type="hidden" name="id" value="@Model.CampaignId" />
        <input type="hidden" name="locationId" value="@Model.LocationId" />

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th scope="col">Producto</th><th scope="col">Unidad</th><th scope="col">Conteo físico</th></tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < attempt.Entries.Count; index++)
                    {
                        var entry = attempt.Entries[index];
                        var missing = Model.MissingQuantityProductIds.Contains(entry.ProductId);
                        <tr data-cycle-product="@entry.Sku">
                            <td>
                                <strong>@entry.Sku</strong>
                                <small class="d-block text-body-secondary">@(entry.Description ?? "Sin descripción")</small>
                                <input name="Input.Entries[@index].ProductId" type="hidden" value="@entry.ProductId" />
                            </td>
                            <td>@entry.UnitCode</td>
                            <td>
                                <label class="visually-hidden" for="quantity-@index">Conteo físico de @entry.Sku</label>
                                <input id="quantity-@index" name="Input.Entries[@index].Quantity" value="@Model.CapturedQuantity(entry.ProductId)"
                                       class="form-control @(missing ? "is-invalid" : null)" data-cycle-quantity
                                       inputmode="@(entry.AllowsDecimals ? "decimal" : "numeric")" required autocomplete="off"
                                       placeholder="Cantidad física" aria-describedby="@(missing ? $"quantity-error-{index}" : null)" />
                                @if (missing)
                                {
                                    <div id="quantity-error-@index" class="invalid-feedback">Captura la cantidad física, incluso si es cero.</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <fieldset class="border rounded p-3 mb-3" data-cycle-unexpected>
            <legend class="h6 px-2">Productos inesperados</legend>
            <p class="small text-body-secondary">Escanea o escribe un SKU/código de barras y su cantidad.</p>
            @for (var index = 0; index < unexpectedRows; index++)
            {
                var unexpected = Model.UnexpectedEntry(index);
                <div class="row g-2 mb-2" data-cycle-unexpected-row>
                    <div class="col-sm-7">
                        <label class="visually-hidden" for="unexpected-code-@index">SKU o código inesperado @(index + 1)</label>
                        <input id="unexpected-code-@index" name="Input.UnexpectedEntries[@index].Code" value="@unexpected.Code" class="form-control" autocomplete="off" autocapitalize="characters" placeholder="SKU o código de barras inesperado" />
                    </div>
                    <div class="col-sm-3">
                        <label class="visually-hidden" for="unexpected-quantity-@index">Cantidad inesperada @(index + 1)</label>
                        <input id="unexpected-quantity-@index" name="Input.UnexpectedEntries[@index].Quantity" value="@unexpected.Quantity" class="form-control" inputmode="decimal" placeholder="Cantidad" />
                    </div>
                </div>
            }
        </fieldset>

        <div class="form-check mb-3">
            <input asp-for="Input.IsLocationEmpty" class="form-check-input" />
            <label asp-for="Input.IsLocationEmpty" class="form-check-label">La ubicación está vacía: registrar cero para todas las líneas.</label>
        </div>

        <div class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label asp-for="Input.Pin" class="form-label">NIP responsable</label>
                <input asp-for="Input.Pin" value="" class="form-control" type="password" inputmode="numeric" maxlength="8" autocomplete="off" />
            </div>
            <div class="col-sm-8">
                <button class="btn btn-primary">Enviar conteo para revisión</button>
            </div>
        </div>
    </form>

    <button type="button" class="cycle-scan-fab" data-cycle-scan-product aria-label="Escanear producto">📷 <span>Escanear producto</span></button>
    <input class="visually-hidden" data-cycle-scan-photo type="file" accept="image/*" capture="environment" />
</div>
@section Scripts { <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script><script src="~/js/cycle-count.js" asp-append-version="true"></script> }
