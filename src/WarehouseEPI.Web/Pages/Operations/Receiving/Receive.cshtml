@page "/Operations/Receiving/{id:guid}/Receive"
@model WarehouseEPI.Web.Pages.Operations.Receiving.ReceiveModel
@{ViewData["Title"]="Registrar recepción";}
<div class="container-fluid py-3 receiving-shell" data-receiving-builder data-lookup-url="@Url.Page("/Operations/Lookup")"><header class="mb-4"><a asp-page="Details" asp-route-id="@Model.Document.Id" class="small text-decoration-none">← @Model.Document.Number</a><h1 class="h2 mt-2 mb-1">Registrar recepción</h1><p class="text-muted">Un NIP confirmará todas las líneas como una sola Entrada.</p></header><form method="post" data-receiving-form><input asp-for="Input.OperationId" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div>
@if(Model.Conflicts.Count>0){<section class="alert alert-warning"><h2 class="h5">Ubicaciones compartidas</h2>@foreach(var conflict in Model.Conflicts){<div class="form-check"><input class="form-check-input" type="checkbox" name="Input.ApprovedSharedLocationIds" value="@conflict.LocationId" id="approve-@conflict.LocationId" required/><label class="form-check-label" for="approve-@conflict.LocationId">Agregar @conflict.ProductSku a @conflict.LocationCode, compartiendo con @string.Join(", ",conflict.ExistingProductSkus)</label></div>}<p class="small mb-0">Vuelve a introducir tu NIP.</p></section>}
<section class="operation-card"><div class="d-flex justify-content-between"><div><h2 class="h5 mb-1">Líneas recibidas</h2><p class="small text-muted">Deja en cero los productos no recibidos; puedes agregar inesperados.</p></div><button type="button" class="btn btn-outline-primary" data-add-receiving-line>Agregar inesperado</button></div><div class="mt-3" data-receiving-lines>@for(var i=0;i<Model.Input.Lines.Count;i++){<div class="receiving-receipt-line" data-receiving-line><input asp-for="Input.Lines[i].ProductId" type="hidden" data-product-id/><input asp-for="Input.Lines[i].ProductLabel" type="hidden"/><div><label class="form-label">Producto</label><input class="form-control" value="@Model.Input.Lines[i].ProductLabel" data-product-lookup autocomplete="off" placeholder="SKU o código"/><div class="list-group lookup-results" data-product-results></div></div><div><label asp-for="Input.Lines[i].Quantity" class="form-label">Cantidad</label><input asp-for="Input.Lines[i].Quantity" class="form-control" type="number" min="0" step="0.0001" inputmode="decimal"/></div><div><input asp-for="Input.Lines[i].DestinationLocationId" type="hidden" data-location-id/><label class="form-label">Destino</label><input class="form-control" data-location-lookup autocomplete="off" placeholder="Escanea ubicación"/><div class="list-group lookup-results" data-location-results></div></div><div><label asp-for="Input.Lines[i].ExternalLotReference" class="form-label">Lote/rollo externo</label><input asp-for="Input.Lines[i].ExternalLotReference" class="form-control" maxlength="120"/></div><button type="button" class="btn btn-outline-danger align-self-end" data-remove-receiving-line>Quitar</button></div>}</div></section>
<section class="operation-card mt-3 border-warning"><div class="form-check"><input asp-for="Input.DifferenceAcknowledged" class="form-check-input"/><label asp-for="Input.DifferenceAcknowledged" class="form-check-label">Revisé y acepto cualquier sobrante o producto inesperado</label></div><label asp-for="Input.DifferenceNotes" class="form-label mt-2">Nota de diferencias</label><textarea asp-for="Input.DifferenceNotes" class="form-control" maxlength="500" rows="2"></textarea></section>
<aside class="operation-card mt-3"><label asp-for="Input.Pin" class="form-label">NIP del responsable</label><input asp-for="Input.Pin" value="" class="form-control pin-input" type="password" inputmode="numeric" maxlength="8" required/><div class="d-flex gap-2 mt-3"><a asp-page="Details" asp-route-id="@Model.Document.Id" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary flex-grow-1">Confirmar recepción</button></div></aside></form></div>
<template data-receiving-line-template><div class="receiving-receipt-line" data-receiving-line><input name="Input.Lines[__index__].ProductId" type="hidden" data-product-id/><div><label class="form-label">Producto inesperado</label><input class="form-control" data-product-lookup autocomplete="off" placeholder="SKU o código"/><div class="list-group lookup-results" data-product-results></div></div><div><label class="form-label">Cantidad</label><input name="Input.Lines[__index__].Quantity" class="form-control" type="number" min="0.0001" step="0.0001"/></div><div><input name="Input.Lines[__index__].DestinationLocationId" type="hidden" data-location-id/><label class="form-label">Destino</label><input class="form-control" data-location-lookup autocomplete="off" placeholder="Escanea ubicación"/><div class="list-group lookup-results" data-location-results></div></div><div><label class="form-label">Lote/rollo externo</label><input name="Input.Lines[__index__].ExternalLotReference" class="form-control" maxlength="120"/></div><button type="button" class="btn btn-outline-danger align-self-end" data-remove-receiving-line>Quitar</button></div></template>
@section Scripts{<script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script><script src="~/js/receiving.js" asp-append-version="true"></script>}
