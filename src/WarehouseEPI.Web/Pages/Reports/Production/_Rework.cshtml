@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionReworkReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>@CatTexts["Orden / proceso"]</th><th class="text-end">@CatTexts["Inicial"]</th><th class="text-end">@CatTexts["Recuperado"]</th><th class="text-end">@CatTexts["Descartado"]</th><th class="text-end">@CatTexts["Pendiente"]</th><th class="text-end">@CatTexts["Intentos"]</th><th>@CatTexts["Antigüedad"]</th><th>@CatTexts["Estado"]</th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr class="@(row.IsLate ? "production-row-alert" : null)"><td data-label="@CatTexts["Orden / proceso"]"><a asp-page="/Admin/Production/Details" asp-route-id="@row.OrderId"><strong>@row.OrderNumber</strong></a><small>@row.Stage</small></td><td data-label="@CatTexts["Inicial"]" class="text-end">@row.Initial.ToString("0.####") @row.Unit</td><td data-label="@CatTexts["Recuperado"]" class="text-end">@row.Recovered.ToString("0.####")</td><td data-label="@CatTexts["Descartado"]" class="text-end">@row.Discarded.ToString("0.####")</td><td data-label="@CatTexts["Pendiente"]" class="text-end"><strong>@row.Pending.ToString("0.####")</strong></td><td data-label="@CatTexts["Intentos"]" class="text-end">@row.Attempts</td><td data-label="@CatTexts["Antigüedad"]">@row.AgeHours h<small>Desde @row.OriginAt.ToString("dd/MM/yyyy HH:mm")</small></td><td data-label="@CatTexts["Estado"]">@if (row.IsLate) { <span class="badge text-bg-warning">@CatTexts["Requiere atención"]</span> } else if (row.AlertHours is null) { <span class="badge text-bg-secondary">@CatTexts["Sin umbral"]</span> } else { <span class="badge text-bg-success">@CatTexts["Dentro del umbral"]</span> }</td></tr> }</tbody>
</table>
