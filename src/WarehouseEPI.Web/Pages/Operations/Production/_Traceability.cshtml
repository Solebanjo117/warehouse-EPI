@model WarehouseEPI.Web.Pages.Operations.Production.WorkModel
@{ var o=Model.Order; var active=o.Status is WarehouseEPI.Core.Entities.ProductionWorkOrderStatus.Released or WarehouseEPI.Core.Entities.ProductionWorkOrderStatus.InProgress; var selected=Model.Batches.FirstOrDefault(x=>x.Id==Model.BatchId); }
@if(!o.UsesBatchTraceability){<div class="alert alert-warning" role="status"><strong>Seguimiento anterior sin trazabilidad por lote.</strong> Conserva el flujo con el que fue creada.</div>}
else
{
<section class="production-trace mb-4" aria-labelledby="trace-title">
 <div class="d-flex flex-wrap justify-content-between gap-3 mb-3"><div><h2 id="trace-title" class="h4 mb-1">Transformación por lotes</h2><p class="text-body-secondary mb-0">Receta v@o.RecipeVersion · cantidades separadas por unidad.</p></div><form method="get" class="d-flex gap-2" data-batch-filter-form><input type="hidden" name="id" value="@o.Id"/><label class="visually-hidden" for="batch-filter">Lote</label><select id="batch-filter" name="BatchId" class="form-select" data-batch-filter><option value="">Vista acumulada</option>@foreach(var b in Model.Batches){<option value="@b.Id" selected="@(Model.BatchId==b.Id)">@b.Number</option>}</select></form></div>
 <div class="production-flow">
  <article class="production-flow-column"><h3 class="h6">Materiales</h3>@foreach(var m in Model.MaterialPlan){<div class="production-flow-card @(m.Pending>0?"is-warning":"is-ready")"><strong>@m.Sku</strong><small>@m.Description</small><dl><dt>Previsto</dt><dd>@m.Planned.ToString("0.####") @m.Unit</dd><dt>Surtido</dt><dd>@m.Issued.ToString("0.####")</dd><dt>Consumido</dt><dd>@m.Consumed.ToString("0.####")</dd><dt>Devuelto</dt><dd>@m.Returned.ToString("0.####")</dd></dl><span class="badge @(m.Pending>0?"text-bg-warning":"text-bg-success")">@(m.Pending>0?$"Faltan {m.Pending:0.####}":"Surtido completo")</span><a asp-page="/Operations/Exit" asp-route-mode="wip" asp-route-workOrderId="@o.Id" asp-route-workOrderStageId="@m.StageId" class="btn btn-sm btn-outline-primary mt-2">Surtir a @m.Stage</a>@if(User.Identity?.IsAuthenticated==true){<details class="mt-2"><summary class="btn btn-sm btn-outline-warning">Ajustar previsto</summary><form method="post" asp-page-handler="AdjustPlan" class="mt-2"><input asp-for="PlanAdjustment.OperationId" type="hidden" value="@Guid.NewGuid()"/><input asp-for="PlanAdjustment.PlanId" type="hidden" value="@m.Id"/><input asp-for="PlanAdjustment.ExpectedVersion" type="hidden" value="@o.Version"/><label class="form-label">Nueva cantidad</label><input asp-for="PlanAdjustment.Quantity" value="@m.Planned" class="form-control mb-2" inputmode="decimal"/><label class="form-label">Motivo</label><input asp-for="PlanAdjustment.Reason" class="form-control mb-2" required/><label class="form-label">NIP ADMIN</label><input asp-for="PlanAdjustment.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control mb-2" required/><button class="btn btn-warning" type="submit">Guardar ajuste</button></form></details>}</div>}</article>
  <span class="production-flow-arrow" aria-hidden="true">→</span>
  <article class="production-flow-column production-flow-processes"><h3 class="h6">Procesos</h3>@foreach(var s in o.Stages){<div class="production-flow-card"><strong>@s.Sequence. @s.Name</strong><small>@s.Code</small><dl><dt>Bueno</dt><dd>@s.Good.ToString("0.####") @o.Unit</dd><dt>Retrabajo</dt><dd>@s.Rework.ToString("0.####")</dd><dt>Merma</dt><dd>@s.Scrap.ToString("0.####")</dd><dt>Por recibir</dt><dd>@s.PendingReceipt.ToString("0.####")</dd></dl></div>}</article>
  <span class="production-flow-arrow" aria-hidden="true">→</span>
  <article class="production-flow-column"><h3 class="h6">Producto terminado</h3>@if(selected is null){<div class="production-flow-card"><strong>@o.Sku</strong><small>Selecciona un lote.</small></div>}else{<div class="production-flow-card is-ready"><strong>@selected.Number</strong><small>@selected.Assigned.ToString("0.####") @o.Unit asignados</small><dl><dt>Bueno final</dt><dd>@selected.Good.ToString("0.####")</dd><dt>Recibido en bodega</dt><dd>@selected.WarehouseReceived.ToString("0.####")</dd><dt>Merma</dt><dd>@selected.Scrap.ToString("0.####")</dd><dt>Proceso</dt><dd>@selected.CurrentStage</dd></dl><a asp-page="BatchLabel" asp-route-id="@selected.Id" class="btn btn-outline-primary btn-sm">Imprimir etiqueta</a></div>}</article>
  <span class="production-flow-arrow" aria-hidden="true">→</span>
  <article class="production-flow-column"><h3 class="h6">Bodega</h3><div class="production-flow-card"><strong>@o.WarehouseReceived.ToString("0.####") de @o.TargetQuantity.ToString("0.####") @o.Unit</strong><div class="progress mt-2" role="progressbar" aria-label="Recibido en bodega"><div class="progress-bar" style="width:@(o.TargetQuantity>0?Math.Min(100,o.WarehouseReceived*100/o.TargetQuantity):0)%"></div></div>@if(o.WarehouseReceived>o.TargetQuantity){<span class="badge text-bg-warning mt-2">Excedente @(o.WarehouseReceived-o.TargetQuantity)</span>}</div></article>
 </div>
</section>
@if(selected is not null){<details class="card mb-4"><summary class="card-header fw-semibold">Procedencia del lote @selected.Number</summary><div class="card-body">@if(Model.TraceLinks.Count==0){<p class="text-body-secondary mb-0">Todavía no hay materiales consumidos vinculados a este lote.</p>}else{<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Material</th><th>Lote</th><th>Consumo</th><th>Proceso</th><th>Responsable</th></tr></thead><tbody>@foreach(var x in Model.TraceLinks){<tr><td>@x.MaterialSku</td><td>@x.MaterialLot</td><td>@x.Quantity.ToString("0.####") @x.Unit</td><td>@x.Stage</td><td>@x.Responsible<small class="d-block text-body-secondary">@x.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td></tr>}</tbody></table></div>}</div></details>}
@if(selected is not null&&Model.BatchResults.Count>0){<details class="card mb-4"><summary class="card-header fw-semibold">Resultados parciales de @selected.Number</summary><div class="card-body table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Fecha</th><th>Proceso</th><th>Resultado</th><th>Responsable</th><th>Corrección</th></tr></thead><tbody>@foreach(var r in Model.BatchResults){<tr><td>@r.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@r.Stage<small class="d-block text-body-secondary">@r.Shift</small></td><td>@r.Input.ToString("0.####") procesadas<small class="d-block">Buena @r.Good.ToString("0.####") · Retrabajo @r.Rework.ToString("0.####") · Merma @r.Scrap.ToString("0.####")</small></td><td>@r.Responsible</td><td>@if(!r.CanReverse){<span class="badge text-bg-secondary">Revertido</span>}else if(User.Identity?.IsAuthenticated==true){<details><summary class="btn btn-sm btn-outline-danger">Revertir</summary><form method="post" asp-page-handler="ReverseResult" class="mt-2"><input asp-for="ResultReverse.OperationId" type="hidden" value="@Guid.NewGuid()"/><input asp-for="ResultReverse.ResultId" type="hidden" value="@r.Id"/><input asp-for="ResultReverse.ExpectedVersion" type="hidden" value="@o.Version"/><label class="form-label">Motivo</label><input asp-for="ResultReverse.Reason" class="form-control mb-2" required/><label class="form-label">NIP ADMIN</label><input asp-for="ResultReverse.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control mb-2" required/><button class="btn btn-danger btn-sm" type="submit">Confirmar reverso</button></form></details>}</td></tr>}</tbody></table></div></details>}
@if(active)
{
<section class="card mb-4"><div class="card-body"><h2 class="h5">Lotes de producción</h2><div class="d-flex flex-wrap gap-2 mb-3">@foreach(var b in Model.Batches){<a asp-route-id="@o.Id" asp-route-BatchId="@b.Id" class="btn @(b.Id==Model.BatchId?"btn-primary":"btn-outline-primary")">@b.Number · @b.Assigned.ToString("0.####")</a>}</div><details><summary class="btn btn-outline-primary">Crear lote</summary><form method="post" asp-page-handler="Batch" class="row g-3 mt-2"><input asp-for="Batch.OperationId" type="hidden"/><input asp-for="Batch.ExpectedVersion" type="hidden"/><div class="col-6"><label asp-for="Batch.Quantity" class="form-label">Cantidad asignada</label><input asp-for="Batch.Quantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6"><label asp-for="Batch.Pin" class="form-label">NIP</label><input asp-for="Batch.Pin" type="password" value="" class="form-control form-control-lg" inputmode="numeric" autocomplete="off"/></div><div class="col-12"><button class="btn btn-primary" type="submit">Crear e identificar lote</button></div></form></details></div></section>
@if(selected is not null)
{
<div class="accordion mb-4" id="trace-actions">
 <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#batch-result-panel">Registrar resultado y consumo</button></h2><div id="batch-result-panel" class="accordion-collapse collapse show"><div class="accordion-body"><form method="post" asp-page-handler="BatchResult" class="row g-3" data-batch-result-form><input asp-for="BatchResult.OperationId" type="hidden"/><input asp-for="BatchResult.ExpectedVersion" type="hidden"/><input asp-for="BatchResult.BatchId" type="hidden" value="@selected.Id"/><div class="col-6"><label asp-for="BatchResult.StageId" class="form-label">Proceso</label><select asp-for="BatchResult.StageId" class="form-select form-select-lg" data-result-stage><option value="">Selecciona…</option>@foreach(var s in o.Stages){<option value="@s.Id">@s.Sequence. @s.Name</option>}</select></div><div class="col-6"><label asp-for="BatchResult.ShiftId" class="form-label">Turno</label><select asp-for="BatchResult.ShiftId" class="form-select form-select-lg"><option value="">Selecciona…</option>@foreach(var s in Model.Shifts.Where(x=>x.IsActive)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-12"><h3 class="h6">Material consumido realmente</h3><p class="small text-body-secondary">La cantidad procesada propone el consumo de receta; confirma los lotes y cantidades reales.</p>@for(var i=0;i<Model.MaterialIssues.Count;i++){var m=Model.MaterialIssues[i];var plan=Model.MaterialPlan.FirstOrDefault(x=>x.StageId==m.StageId&&x.Sku==m.ProductSku);var ratio=plan is null||o.AuthorizedQuantity<=0?0:plan.Planned/o.AuthorizedQuantity;<div class="row g-2 align-items-center mb-2" data-result-material data-stage-id="@m.StageId"><input name="BatchResult.Materials[@i].IssueLinkId" value="@m.IssueLinkId" type="hidden"/><div class="col-auto"><input name="BatchResult.Materials[@i].Selected" value="true" type="checkbox" class="form-check-input" aria-label="Consumir @m.ProductSku"/></div><div class="col"><strong>@m.ProductSku</strong><small class="d-block text-body-secondary">@m.WipCode · @m.Pending.ToString("0.####") @m.Unit</small>@if(!string.IsNullOrWhiteSpace(m.Lots)){<small class="d-block">Lotes: @m.Lots</small>}</div><div class="col-4"><label class="visually-hidden" for="batch-material-@i">Cantidad de @m.ProductSku</label><input id="batch-material-@i" name="BatchResult.Materials[@i].Quantity" class="form-control" inputmode="decimal" max="@m.Pending" data-result-material-quantity data-ratio="@ratio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pending="@m.Pending.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></div></div>}</div><div class="col-6 col-lg-3"><label asp-for="BatchResult.InputQuantity" class="form-label">Procesada</label><input asp-for="BatchResult.InputQuantity" class="form-control form-control-lg" inputmode="decimal" data-result-input/></div><div class="col-6 col-lg-3"><label asp-for="BatchResult.GoodQuantity" class="form-label">Buena</label><input asp-for="BatchResult.GoodQuantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="BatchResult.ReworkQuantity" class="form-label">Retrabajo</label><input asp-for="BatchResult.ReworkQuantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="BatchResult.ScrapQuantity" class="form-label">Merma</label><input asp-for="BatchResult.ScrapQuantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-8"><label asp-for="BatchResult.DifferenceReason" class="form-label">Motivo si difiere de receta</label><input asp-for="BatchResult.DifferenceReason" class="form-control"/></div><div class="col-4"><label asp-for="BatchResult.Pin" class="form-label">NIP</label><input asp-for="BatchResult.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control"/></div><div class="col-12"><button class="btn btn-primary btn-lg" type="submit">Confirmar resultado y consumo</button></div></form></div></div></div>
 <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#batch-handoff-panel">Entregar, recibir o conciliar</button></h2><div id="batch-handoff-panel" class="accordion-collapse collapse"><div class="accordion-body"><form method="post" asp-page-handler="Handoff" class="row g-3"><input asp-for="Handoff.OperationId" type="hidden"/><input asp-for="Handoff.ExpectedVersion" type="hidden" value="@o.Version"/><input asp-for="Handoff.BatchId" type="hidden" value="@selected.Id"/><div class="col-4"><label asp-for="Handoff.Mode" class="form-label">Acción</label><select asp-for="Handoff.Mode" class="form-select"><option value="deliver">Entregar</option><option value="receive">Recibir</option><option value="return">Devolver diferencia</option><option value="lost">Registrar pérdida</option></select></div><div class="col-4"><label asp-for="Handoff.SourceStageId" class="form-label">Origen</label><select asp-for="Handoff.SourceStageId" class="form-select">@foreach(var s in o.Stages.Take(Math.Max(0,o.Stages.Count-1))){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-4"><label asp-for="Handoff.TargetStageId" class="form-label">Destino</label><select asp-for="Handoff.TargetStageId" class="form-select">@foreach(var s in o.Stages.Skip(1)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-12"><label asp-for="Handoff.DeliveryEventId" class="form-label">Entrega pendiente</label><select asp-for="Handoff.DeliveryEventId" class="form-select"><option value="">No aplica al entregar</option>@foreach(var d in Model.PendingDeliveries.Where(x=>x.BatchId==selected.Id)){<option value="@d.Id">@d.BatchNumber · @d.Pending.ToString("0.####") pendientes</option>}</select></div><div class="col-4"><label asp-for="Handoff.Quantity" class="form-label">Cantidad</label><input asp-for="Handoff.Quantity" class="form-control" inputmode="decimal"/></div><div class="col-5"><label asp-for="Handoff.Reason" class="form-label">Motivo de diferencia</label><input asp-for="Handoff.Reason" class="form-control"/></div><div class="col-3"><label asp-for="Handoff.Pin" class="form-label">NIP</label><input asp-for="Handoff.Pin" value="" type="password" inputmode="numeric" class="form-control"/></div><div class="col-12"><button class="btn btn-primary" type="submit">Registrar movimiento</button></div></form></div></div></div>
 <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#batch-warehouse-panel">Recibir en bodega</button></h2><div id="batch-warehouse-panel" class="accordion-collapse collapse"><div class="accordion-body"><form method="post" asp-page-handler="Warehouse" class="row g-3"><input asp-for="Warehouse.OperationId" type="hidden"/><input asp-for="Warehouse.ExpectedVersion" type="hidden" value="@o.Version"/><input asp-for="Warehouse.FinalStageId" type="hidden" value="@o.Stages.Last().Id"/><input asp-for="Warehouse.BatchId" type="hidden" value="@selected.Id"/><div class="col-4"><label asp-for="Warehouse.Quantity" class="form-label">Cantidad</label><input asp-for="Warehouse.Quantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-5"><label asp-for="Warehouse.DestinationLocationId" class="form-label">Ubicación</label><select asp-for="Warehouse.DestinationLocationId" class="form-select form-select-lg"><option value="">Selecciona…</option>@foreach(var x in Model.Destinations){<option value="@x.Id">@x.Code</option>}</select></div><div class="col-3"><label asp-for="Warehouse.Pin" class="form-label">NIP</label><input asp-for="Warehouse.Pin" value="" type="password" inputmode="numeric" class="form-control form-control-lg"/></div><div class="col-12"><button class="btn btn-success btn-lg" type="submit">Registrar recepción y entrada</button></div></form></div></div></div>
</div>
}
}
}
