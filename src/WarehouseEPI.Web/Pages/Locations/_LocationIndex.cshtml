asp-route-sourceLocationId="@position.LocationId">@CatTexts["Transferencia"]</a></li><li><a class="dropdown-item" asp-page="/Operations/Adjustment" asp-route-productId="@product.ProductId" asp-route-locationId="@position.LocationId">@CatTexts["Ajuste"]</a></li>@if(product.Quantity>0){<li><hr class="dropdown-divider" /></li><li><a class="dropdown-item" asp-page="/Operations/PalletLabels/Index" asp-route-location="@position.Code" asp-route-productId="@product.ProductId">@CatTexts["Imprimir placa"]</a></li>}</ul></div>}</div>}@if(position.IsActive&&!position.IsBlocked){<div class="d-flex flex-wrap gap-2 mt-3"><div class="dropdown"><button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">@CatTexts["Nueva operación"]</button><ul class="dropdown-menu"><li><a class="dropdown-item" asp-page="/Operations/Entry" asp-route-destinationLocationId="@position.LocationId">@CatTexts["Entrada"]</a></li><li><a class="dropdown-item" asp-page="/Operations/Exit" asp-route-mode="general" asp-route-sourceLocationId="@position.LocationId">@CatTexts["Salida"]</a></li><li><a class="dropdown-item" asp-page="/Operations/Transfer" asp-route-sourceLocationId="@position.LocationId">@CatTexts["Transferencia"]</a></li><li><a class="dropdown-item" asp-page="/Operations/Adjustment" asp-route-locationId="@position.LocationId">@CatTexts["Ajuste"]</a></li></ul></div><a asp-page="@detailsPage" asp-route-id="@position.LocationId" class="btn btn-outline-secondary">@CatTexts["Ficha"]</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Area" asp-route-locationId="@position.LocationId" class="btn btn-outline-secondary">@CatTexts["Editar área"]</a>}<a asp-page="/Inventory/Index" asp-route-locationId="@position.LocationId" class="btn btn-outline-secondary">@CatTexts["Existencias"]</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">@CatTexts["Movimientos"]</a>}</div>}else{<div class="alert alert-warning py-2 mt-3 mb-0">@CatTexts["No disponible para nuevas operaciones."]</div>}</div>}
            }
            </section>
        }
        </aside>
