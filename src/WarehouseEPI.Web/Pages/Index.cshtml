@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="operations-home py-4">
    <div class="text-center mb-4">
        <span class="eyebrow">Operación de almacén</span>
        <h1 class="display-5 fw-semibold">¿Qué vas a registrar?</h1>
        <p class="lead text-muted">El NIP se solicitará únicamente al confirmar.</p>
    </div>
    <div class="operation-menu">
        <a asp-page="/Operations/Entry" class="operation-menu-card entry"><span aria-hidden="true">＋</span><strong>Entrada</strong><small>Recibir material</small></a>
        <a asp-page="/Operations/Exit" class="operation-menu-card exit"><span aria-hidden="true">−</span><strong>Salida</strong><small>General o surtir WIP</small></a>
        <a asp-page="/Operations/WipReturn" class="operation-menu-card transfer"><span aria-hidden="true">↩</span><strong>Devolución desde WIP</strong><small>A bodega o proveedor</small></a>
        <a asp-page="/Operations/Transfer" class="operation-menu-card transfer"><span aria-hidden="true">⇄</span><strong>Transferencia</strong><small>Mover entre ubicaciones</small></a>
        <a asp-page="/Operations/Adjustment" class="operation-menu-card adjustment"><span aria-hidden="true">✓</span><strong>Ajuste</strong><small>Registrar conteo físico</small></a>
        <a asp-page="/Inventory/Index" class="operation-menu-card inventory"><span aria-hidden="true">⌕</span><strong>Consultar</strong><small>Ver existencias</small></a>
        <a asp-page="/Reports/Wip/Index" class="operation-menu-card inventory"><span aria-hidden="true">▦</span><strong>Reporte WIP</strong><small>Surtido y consumo asumido</small></a>
    </div>
</div>
