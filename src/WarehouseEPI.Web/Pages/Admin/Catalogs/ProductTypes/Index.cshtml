@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.ProductTypes.IndexModel
@{
    ViewData["Title"] = "Tipos de producto";
    var isEditing = Model.Input.Id != 0;
    var totalCount = Model.Items.Count;
    var activeCount = Model.Items.Count(productType => productType.IsActive);
    var inactiveCount = totalCount - activeCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-types-index.css" asp-append-version="true" />
}

<div class="product-types-page">
    <header class="product-types-header">
        <div>
            <span class="eyebrow">Catálogo administrativo</span>
            <h1 class="h2 mb-1">Tipos de producto</h1>
            <p>La clasificación general de cada artículo: producto terminado, materia prima y demás. Es el primer corte del catálogo, por encima de la clase.</p>
        </div>
        @if (totalCount > 0)
        {
            <dl class="product-types-summary">
                <div>
                    <dt>Total</dt>
                    <dd>@totalCount</dd>
                </div>
                <div>
                    <dt>Activos</dt>
                    <dd>@activeCount</dd>
                </div>
                <div>
                    <dt>Inactivos</dt>
                    <dd>@inactiveCount</dd>
                </div>
            </dl>
        }
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger mb-0" role="alert" tabindex="-1">@error</div>
    }

    <section class="product-types-form-section @(isEditing ? "is-editing" : null)" aria-labelledby="product-types-form-title">
        @if (isEditing)
        {
            <span class="product-types-editing-flag">Estás modificando un tipo existente</span>
        }
        <h2 class="product-types-form-title" id="product-types-form-title" tabindex="-1">@(isEditing ? "Editar tipo" : "Agregar tipo")</h2>
        <p class="product-types-form-intro">
            @if (isEditing)
            {
                @:Cambiar el código o el nombre modifica cómo se presenta este tipo en los productos que ya lo usan y en las importaciones que lo nombran. Cancela si prefieres dejarlo como está.
            }
            else
            {
                @:El código identifica el tipo en productos e importaciones. El servidor lo normaliza al guardar y no admite duplicados.
            }
        </p>
        <form method="post" asp-page-handler="Save">
            <input asp-for="Input.Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="Input.Code" class="form-label">Código</label>
                    <input asp-for="Input.Code" class="form-control text-uppercase product-types-code-input" autocomplete="off" autocapitalize="characters" />
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-8">
                    <label asp-for="Input.Name" class="form-label">Nombre</label>
                    <input asp-for="Input.Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
            </div>
            <div class="product-types-form-actions">
                <button type="submit" class="btn btn-primary btn-lg">@(Model.Input.Id == 0 ? "Agregar tipo" : "Guardar cambios")</button>
                @if (isEditing)
                {
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                }
            </div>
        </form>
    </section>

    <section aria-labelledby="product-types-list-title">
        <h2 class="product-types-list-title" id="product-types-list-title">Tipos registrados</h2>
        @if (totalCount == 0)
        {
            <div class="product-types-empty">
                <strong>Todavía no hay tipos registrados.</strong>
                <p>El tipo es la clasificación más general del catálogo y las importaciones lo esperan por código. Crea el primero con el formulario <a href="#product-types-form-title">Agregar tipo</a>.</p>
            </div>
        }
        else
        {
            <table class="table product-types-table align-middle">
                <caption class="product-types-caption">Tipos disponibles para clasificar el catálogo. Desactivar un tipo lo retira de las altas nuevas, pero conserva su historial en los productos que ya lo usan; el servidor impide desactivarlo mientras haya productos activos con él.</caption>
                <thead>
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsActive ? null : "is-inactive")">
                            <td class="product-types-cell-code">
                                <span class="product-types-code">@item.Code</span>
                            </td>
                            <td class="product-types-cell-name">
                                <span class="product-types-name">@item.Name</span>
                            </td>
                            <td class="product-types-cell-state">
                                <span class="product-types-flag @(item.IsActive ? "is-active" : "is-inactive")">@(item.IsActive ? "Activo" : "Inactivo")</span>
                            </td>
                            <td class="product-types-cell-actions text-end">
                                <div class="product-types-row-actions">
                                    <a asp-route-editId="@item.Id" class="btn btn-outline-secondary" aria-label="Editar el tipo @item.Code">Editar</a>
                                    <form method="post" asp-page-handler="Toggle">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")" aria-label="@(item.IsActive ? $"Desactivar el tipo {item.Code}" : $"Activar el tipo {item.Code}")">@(item.IsActive ? "Desactivar" : "Activar")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
