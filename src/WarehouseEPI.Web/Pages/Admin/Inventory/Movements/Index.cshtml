@page
@using WarehouseEPI.Core.Entities
@using WarehouseEPI.Infrastructure.Inventory
@model WarehouseEPI.Web.Pages.Admin.Inventory.Movements.IndexModel
@{
    ViewData["Title"] = "Movimientos";
    var request = ViewContext.HttpContext.Request;
    var returnUrl = $"{request.Path}{request.QueryString}";
    var itemCount = Model.IsAudit ? Model.AuditResults.Items.Count : Model.EffectiveResults.Items.Count;
    var effectiveValues = Model.RouteValues(("view", "effective"), ("state", null), ("pageNumber", null));
    var auditValues = Model.RouteValues(("view", "audit"), ("pageNumber", null));
    var xlsxValues = Model.RouteValues(("format", "xlsx"), ("pageNumber", null));
    var csvValues = Model.RouteValues(("format", "csv"), ("pageNumber", null));
    var todayValues = Model.RouteValues(("period", "today"), ("from", null), ("to", null), ("pageNumber", null));
    var sevenValues = Model.RouteValues(("period", "7"), ("from", null), ("to", null), ("pageNumber", null));
    var thirtyValues = Model.RouteValues(("period", "30"), ("from", null), ("to", null), ("pageNumber", null));
    var allValues = Model.RouteValues(("period", "all"), ("from", null), ("to", null), ("pageNumber", null));
    var clearPeriodValues = Model.RouteValues(("period", "30"), ("from", null), ("to", null), ("pageNumber", null));
    var clearTypeValues = Model.RouteValues(("movementType", null), ("pageNumber", null));
    var clearPurposeValues = Model.RouteValues(("purpose", null), ("pageNumber", null));
    var clearSkuValues = Model.RouteValues(("sku", null), ("pageNumber", null));
    var clearLocationValues = Model.RouteValues(("locationCode", null), ("pageNumber", null));
    var clearResponsibleValues = Model.RouteValues(("responsibleUserId", null), ("pageNumber", null));
    var clearSearchValues = Model.RouteValues(("search", null), ("pageNumber", null));
    var clearStateValues = Model.RouteValues(("state", null), ("pageNumber", null));
    var previousValues = Model.RouteValues(("pageNumber", (Model.PageNumber - 1).ToString()));
    var nextValues = Model.RouteValues(("pageNumber", (Model.PageNumber + 1).ToString()));
}

@section Styles {
    <link rel="stylesheet" href="~/css/movements-index.css" asp-append-version="true" />
}
<div class="inventory-analytics movements-page">
  <header class="inventory-page-header analytics-header"><div><span class="inventory-eyebrow">Consulta ADMIN</span><h1 class="h2 mb-1">Movimientos</h1><p class="text-muted mb-0">Consulta operaciones vigentes o revisa la cadena de auditoría inmutable.</p></div><div class="analytics-exports"><a class="btn btn-outline-success" asp-page-handler="Export" asp-all-route-data="@xlsxValues">Excel (.xlsx)</a><a class="btn btn-outline-secondary" asp-page-handler="Export" asp-all-route-data="@csvValues">CSV</a></div></header>
  <nav class="inventory-filter-tabs analytics-tabs" aria-label="Población de movimientos"><a class="@(Model.IsAudit ? null : "active")" aria-current="@(!Model.IsAudit ? "page" : null)" asp-all-route-data="@effectiveValues" data-movement-tab="effective">Vigentes</a><a class="@(Model.IsAudit ? "active" : null)" aria-current="@(Model.IsAudit ? "page" : null)" asp-all-route-data="@auditValues" data-movement-tab="audit">Auditoría completa</a></nav>
  <dl class="movements-meta">
    <div><dt>Población</dt><dd>@(Model.IsAudit ? "Todas las operaciones confirmadas, incluidos originales corregidos, reversos y reemplazos." : "Operaciones efectivas vigentes; excluye originales corregidos y reversos.")</dd></div>
    <div><dt>Período local</dt><dd class="is-range">@(Model.From?.ToString("dd/MM/yyyy") ?? "inicio") a @(Model.To?.ToString("dd/MM/yyyy") ?? "actualidad")</dd></div>
    <div><dt>Zona horaria</dt><dd>@Model.TimeZoneId</dd></div>
  </dl>
  <form method="get" class="analytics-filter-card"><input type="hidden" name="view" value="@Model.View" /><input type="hidden" name="period" value="@Model.Period" />
    <div class="d-flex flex-wrap gap-2 align-items-center"><span class="text-muted small fw-bold">Período rápido:</span><a asp-all-route-data="@todayValues" class="btn btn-sm" data-movement-period="today">Hoy</a><a asp-all-route-data="@sevenValues" class="btn btn-sm" data-movement-period="7">Últimos 7 días</a><a asp-all-route-data="@thirtyValues" class="btn btn-sm" data-movement-period="30">Últimos 30 días</a><a asp-all-route-data="@allValues" class="btn btn-sm" data-movement-period="all">Todo el historial</a></div>
    <details class="analytics-filter-details mt-3" open="@(Model.HasAdvancedFilters ? "open" : null)"><summary>Filtros avanzados</summary><div class="row g-3 pt-3"><div class="col-sm-6 col-lg-3"><label for="movement-from" class="form-label">Desde</label><input id="movement-from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-to" class="form-label">Hasta</label><input id="movement-to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-type" class="form-label">Tipo</label><select id="movement-type" name="movementType" class="form-select"><option value="">Todos</option>@foreach (var type in Enum.GetValues<InventoryMovementType>()) { <option value="@type" selected="@(Model.MovementType == type)">@TypeLabel(type)</option> }</select></div><div class="col-sm-6 col-lg-3"><label for="movement-purpose" class="form-label">Propósito</label><select id="movement-purpose" name="purpose" class="form-select"><option value="">Todos</option>@foreach (var purpose in Enum.GetValues<InventoryMovementPurpose>()) { <option value="@purpose" selected="@(Model.Purpose == purpose)">@PurposeLabel(purpose)</option> }</select></div><div class="col-sm-6 col-lg-3"><label for="movement-product" class="form-label">Producto</label><input id="movement-product" name="sku" value="@Model.Sku" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-location" class="form-label">Ubicación / área</label><input id="movement-location" name="locationCode" value="@Model.LocationCode" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-user" class="form-label">Responsable</label><select id="movement-user" name="responsibleUserId" class="form-select" asp-items="Model.UserOptions"><option value="">Todos</option></select></div>@if (Model.IsAudit) { <div class="col-sm-6 col-lg-3"><label for="movement-state" class="form-label">Estado de auditoría</label><select id="movement-state" name="state" class="form-select"><option value="All">Todos</option><option value="Current" selected="@(Model.State == InventoryHistoryCorrectionState.Current)">Sin relación con corrección</option><option value="CorrectedOriginal" selected="@(Model.State == InventoryHistoryCorrectionState.CorrectedOriginal)">Original corregido</option><option value="Reversal" selected="@(Model.State == InventoryHistoryCorrectionState.Reversal)">Reverso</option><option value="Replacement" selected="@(Model.State == InventoryHistoryCorrectionState.Replacement)">Reemplazo</option></select></div> }<div class="col-12"><label for="movement-search" class="form-label">Búsqueda libre</label><input id="movement-search" name="search" value="@Model.Search" class="form-control" /></div><div class="col-12 d-flex justify-content-between"><span class="text-muted small">Mostrando <strong>@itemCount</strong> de <strong>@Model.TotalCount</strong> operaciones.</span><div><a asp-page="Index" asp-route-view="@Model.View" class="btn btn-outline-secondary">Limpiar</a><button type="submit" class="btn btn-primary">Aplicar filtros</button></div></div></div></details>
  </form>
  @if (Model.HasAdvancedFilters) { <nav class="analytics-filter-chips" aria-label="Filtros activos">@if (Model.Period == "custom") { <a asp-all-route-data="@clearPeriodValues" data-filter-chip="period" aria-label="Quitar el filtro de período">Período: @(Model.From?.ToString("dd/MM/yyyy") ?? "inicio") a @(Model.To?.ToString("dd/MM/yyyy") ?? "actualidad")<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.MovementType is not null) { <a asp-all-route-data="@clearTypeValues" data-filter-chip="movementType" aria-label="Quitar el filtro de tipo">Tipo: @TypeLabel(Model.MovementType.Value)<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.Purpose is not null) { <a asp-all-route-data="@clearPurposeValues" data-filter-chip="purpose" aria-label="Quitar el filtro de propósito">Propósito: @PurposeLabel(Model.Purpose.Value)<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (!string.IsNullOrWhiteSpace(Model.Sku)) { <a asp-all-route-data="@clearSkuValues" data-filter-chip="sku" aria-label="Quitar el filtro de producto">Producto: @Model.Sku<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (!string.IsNullOrWhiteSpace(Model.LocationCode)) { <a asp-all-route-data="@clearLocationValues" data-filter-chip="locationCode" aria-label="Quitar el filtro de ubicación">Ubicación: @Model.LocationCode<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.ResponsibleUserId is not null) { <a asp-all-route-data="@clearResponsibleValues" data-filter-chip="responsibleUserId" aria-label="Quitar el filtro de responsable">Responsable<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (!string.IsNullOrWhiteSpace(Model.Search)) { <a asp-all-route-data="@clearSearchValues" data-filter-chip="search" aria-label="Quitar la búsqueda libre">Búsqueda: @Model.Search<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.IsAudit && Model.State != InventoryHistoryCorrectionState.All) { <a asp-all-route-data="@clearStateValues" data-filter-chip="state" aria-label="Quitar el filtro de estado">Estado: @Model.State<span class="movement-chip-remove" aria-hidden="true"></span></a> }</nav> }
  @if (Model.IsAudit) { <div class="table-responsive analytics-table-card"><table class="table table-hover align-middle report-cards"><thead><tr><th scope="col">Fecha / folio</th><th scope="col">Tipo / propósito</th><th scope="col">Producto</th><th scope="col">Trayecto</th><th scope="col">Responsable</th><th scope="col">Referencia</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>@if (Model.AuditResults.Items.Count == 0) { <tr class="report-empty-row"><td colspan="8">No hay movimientos de auditoría con los filtros seleccionados.</td></tr> } else { @foreach (var item in Model.AuditResults.Items) { <tr><td data-label="Fecha / folio"><span class="movement-when">@Model.LocalOccurredAt[item.Id].ToString("dd/MM/yyyy HH:mm")</span><br /><a class="movement-folio" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@item.Id.ToString()[..8]</a></td><td data-label="Tipo / propósito"><span class="movement-type @TypeModifier(item.Type)">@TypeLabel(item.Type)</span><span class="movement-purpose">@PurposeLabel(item.Purpose)</span></td><td data-label="Producto">@item.ProductSummary</td><td data-label="Trayecto">@item.Route</td><td data-label="Responsable">@item.ResponsibleName</td><td data-label="Referencia">@if (item.Reference is null) { <span class="movement-muted">Sin referencia</span> } else { @item.Reference }</td><td data-label="Estado">@item.Status</td><td data-label=""><a class="btn btn-outline-primary btn-sm" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">Ver detalle</a></td></tr> } }</tbody></table></div> }
  else { <div class="table-responsive analytics-table-card"><table class="table table-hover align-middle report-cards"><thead><tr><th scope="col">Fecha / folio</th><th scope="col">Tipo</th><th scope="col">Propósito</th><th scope="col">Responsable</th><th scope="col">Detalle de líneas</th><th scope="col">Referencia / notas</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead><tbody>@if (Model.EffectiveResults.Items.Count == 0) { <tr class="report-empty-row"><td colspan="7">No hay movimientos vigentes con los filtros seleccionados.</td></tr> } else { @foreach (var item in Model.EffectiveResults.Items) { <tr><td data-label="Fecha / folio"><span class="movement-when">@Model.LocalOccurredAt[item.Id].ToString("dd/MM/yyyy HH:mm")</span><br /><a class="movement-folio" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@item.Id.ToString()[..8]</a></td><td data-label="Tipo"><span class="movement-type @TypeModifier(item.MovementType)">@TypeLabel(item.MovementType)</span></td><td data-label="Propósito">@PurposeLabel(item.Purpose)</td><td data-label="Responsable">@item.ResponsibleName</td><td data-label="Detalle de líneas"><div class="report-lines-full">@foreach (var line in item.Lines) { <div><span class="movement-line-sku">@line.Sku</span><span class="movement-line-quantity">@line.Quantity.ToString("0.####") @line.UnitCode</span><span class="movement-line-route">@(line.SourceLocationCode ?? "Sin origen")<svg class="movement-route-arrow" aria-hidden="true"><use href="#icon-chevron" /></svg>@(line.DestinationLocationCode ?? item.OperationalAreaCode ?? "Sin destino")</span></div> }</div><span class="report-lines-compact">@item.LineCount línea(s) · <a asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">Ver detalle</a></span></td><td data-label="Referencia / notas">@if (item.Reference is null && item.Notes is null) { <span class="movement-muted">Sin referencia</span> } else { @(item.Reference ?? item.Notes) }</td><td data-label=""><div class="d-flex flex-wrap gap-2">@if (Model.CanGeneratePalletPlate(item)) { <a class="btn btn-outline-success btn-sm" asp-page="/Operations/PalletLabels/Index" asp-route-id="@item.Id">Generar placa</a> }<a class="btn btn-outline-primary btn-sm" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">Ver detalle</a></div></td></tr> } }</tbody></table></div> }
  @if (Model.TotalPages > 1) { <nav aria-label="Paginación de movimientos"><ul class="pagination justify-content-center"><li class="page-item">@if (Model.PageNumber <= 1) { <span class="page-link">Anterior</span> } else { <a class="page-link" asp-all-route-data="@previousValues" data-movement-page-link="previous">Anterior</a> }</li><li class="page-item disabled"><span class="page-link">@Model.PageNumber de @Model.TotalPages</span></li><li class="page-item">@if (Model.PageNumber >= Model.TotalPages) { <span class="page-link">Siguiente</span> } else { <a class="page-link" asp-all-route-data="@nextValues" data-movement-page-link="next">Siguiente</a> }</li></ul></nav> }
</div>

@functions {
    static string TypeLabel(InventoryMovementType type) => type switch
    {
        InventoryMovementType.Entry => "Entrada",
        InventoryMovementType.Exit => "Salida",
        InventoryMovementType.Transfer => "Transferencia",
        InventoryMovementType.Adjustment => "Ajuste",
        _ => "Movimiento"
    };

    static string TypeModifier(InventoryMovementType type) => type switch
    {
        InventoryMovementType.Entry => "is-entry",
        InventoryMovementType.Exit => "is-exit",
        InventoryMovementType.Transfer => "is-transfer",
        InventoryMovementType.Adjustment => "is-adjustment",
        _ => null
    } ?? string.Empty;

    static string PurposeLabel(InventoryMovementPurpose purpose) => purpose switch
    {
        InventoryMovementPurpose.ProductionIssue => "Surtimiento WIP",
        InventoryMovementPurpose.WipWarehouseReturn => "Devolución WIP a bodega",
        InventoryMovementPurpose.WipConsumption => "Consumo WIP",
        InventoryMovementPurpose.WipSupplierReturn => "Devolución WIP a proveedor",
        InventoryMovementPurpose.GeneralExit => "Salida general",
        InventoryMovementPurpose.CycleCountAdjustment => "Ajuste por conteo cíclico",
        InventoryMovementPurpose.DocumentReceipt => "Recepción por documento",
        _ => "Estándar"
    };
}
