@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Units.IndexModel
@{
    ViewData["Title"] = CatTexts["Unidades de medida"].Value;
    var isEditing = Model.Input.Id != 0;
    var totalCount = Model.Items.Count;
    var activeCount = Model.Items.Count(unit => unit.IsActive);
    var inactiveCount = totalCount - activeCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/units-index.css" asp-append-version="true" />
}

<div class="units-page">
    <header class="units-header">
        <div>
            <span class="eyebrow">@CatTexts["Catálogo administrativo"]</span>
            <h1 class="h2 mb-1">@CatTexts["Unidades de medida"]</h1>
            <p>@CatTexts["Las unidades base definen en qué se cuenta cada producto del almacén. Un producto conserva su unidad, así que conviene revisarla antes de darla de alta."]</p>
        </div>
        @if (totalCount > 0)
        {
            <dl class="units-summary">
                <div>
                    <dt>Total</dt>
                    <dd>@totalCount</dd>
                </div>
                <div>
                    <dt>@CatTexts["Activas"]</dt>
                    <dd>@activeCount</dd>
                </div>
                <div>
                    <dt>@CatTexts["Inactivas"]</dt>
                    <dd>@inactiveCount</dd>
                </div>
            </dl>
        }
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger mb-0" role="alert" tabindex="-1">@error</div>
    }

    <section class="units-form-section @(isEditing ? "is-editing" : null)" aria-labelledby="units-form-title">
        @if (isEditing)
        {
            <span class="units-editing-flag">@CatTexts["Estás modificando una unidad existente"]</span>
        }
        <h2 class="units-form-title" id="units-form-title" tabindex="-1">@(isEditing ? CatTexts["Editar unidad"].Value : CatTexts["Agregar unidad"].Value)</h2>
        <p class="units-form-intro">
            @if (isEditing)
            {
                @:Los cambios se aplican a todos los productos que ya usan esta unidad. Cancela si prefieres dejarla como está.
            }
            else
            {
                @:El código se guarda en mayúsculas y no puede repetirse.
            }
        </p>
        <form method="post" asp-page-handler="Save">
            <input asp-for="Input.Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <label asp-for="Input.Code" class="form-label">@CatTexts["Código"]</label>
                    <input asp-for="Input.Code" class="form-control text-uppercase" autocomplete="off" autocapitalize="characters" />
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-5">
                    <label asp-for="Input.Name" class="form-label">@CatTexts["Nombre"]</label>
                    <input asp-for="Input.Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-4">
                    <div class="units-check">
                        <div class="form-check">
                            <input asp-for="Input.AllowsDecimals" class="form-check-input" aria-describedby="units-decimals-help" />
                            <label asp-for="Input.AllowsDecimals" class="form-check-label">@CatTexts["Permite decimales"]</label>
                        </div>
                        <span class="form-text" id="units-decimals-help">@CatTexts["Los productos con esta unidad pueden registrar cantidades fraccionarias."]</span>
                    </div>
                </div>
            </div>
            <div class="units-form-actions">
                <button type="submit" class="btn btn-primary btn-lg">@(Model.Input.Id == 0 ? CatTexts["Agregar"].Value : CatTexts["Guardar cambios"].Value)</button>
                @if (isEditing)
                {
                    <a asp-page="Index" class="btn btn-outline-secondary">@CatTexts["Cancelar"]</a>
                }
            </div>
        </form>
    </section>

    <section aria-labelledby="units-list-title">
        <h2 class="units-list-title" id="units-list-title">@CatTexts["Unidades registradas"]</h2>
        @if (totalCount == 0)
        {
            <div class="units-empty">
                <strong>@CatTexts["Todavía no hay unidades registradas."]</strong>
                <p>@CatTexts["Da de alta la primera con el formulario"] <a href="#units-form-title">@CatTexts["Agregar unidad"]</a>@CatTexts[": los productos no pueden crearse sin una unidad base."]</p>
            </div>
        }
        else
        {
            <table class="table units-table align-middle">
                <caption class="units-caption">@CatTexts["Unidades base disponibles para los productos. «Permite decimales» indica que los productos con esa unidad pueden registrar cantidades fraccionarias. Las unidades reservadas las administra el sistema."]</caption>
                <thead>
                    <tr>
                        <th scope="col">@CatTexts["Código"]</th>
                        <th scope="col">@CatTexts["Nombre"]</th>
                        <th scope="col">@CatTexts["Permite decimales"]</th>
                        <th scope="col">@CatTexts["Estado"]</th>
                        <th scope="col" class="text-end">@CatTexts["Acciones"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var rowClass = item.IsSystem ? "is-reserved" : (item.IsActive ? null : "is-inactive");
                        <tr class="@rowClass">
                            <td class="units-cell-code">
                                <span class="units-code">@item.Code</span>
                            </td>
                            <td class="units-cell-name">
                                <span class="units-name">@item.Name</span>
                            </td>
                            <td class="units-cell-decimals" data-label="@CatTexts["Permite decimales"]">@(item.AllowsDecimals ? CatTexts["Sí"].Value : CatTexts["No"].Value)</td>
                            <td class="units-cell-state">
                                <span class="units-flag @(item.IsActive ? "is-active" : "is-inactive")">@(item.IsActive ? CatTexts["Activa"].Value : CatTexts["Inactiva"].Value)</span>
                            </td>
                            <td class="units-cell-actions text-end">
                                @if (item.IsSystem)
                                {
                                    <span class="units-reserved">@CatTexts["Reservada"]</span>
                                    <span class="units-reserved-note">@CatTexts["La administra el sistema y permanece activa."]</span>
                                }
                                else
                                {
                                    <div class="units-row-actions">
                                        <a asp-route-editId="@item.Id" class="btn btn-outline-secondary" aria-label="Editar la unidad @item.Code">@CatTexts["Editar"]</a>
                                        <form method="post" asp-page-handler="Toggle">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")" aria-label="@(item.IsActive ? $"Desactivar la unidad {item.Code}" : $"Activar la unidad {item.Code}")">@(item.IsActive ? CatTexts["Desactivar"].Value : CatTexts["Activar"].Value)</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
