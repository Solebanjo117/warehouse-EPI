@page "{id:guid}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Inventory.WipDispositions.CorrectModel
@{ ViewData["Title"]=CatTexts["Corregir devolución WIP"].Value; }
<div class="container py-4"><h1 class="h2">@CatTexts["Corregir devolución WIP"]</h1><div class="alert alert-warning">@CatTexts["Esta acción crea una compensación auditable. Si regresó a bodega, revierte también la entrada asociada."]</div><div class="card card-body mb-3"><strong>@Model.Summary.Sku · @Model.Summary.Wip</strong><span>@Model.Summary.Quantity.ToString("0.####") @Model.Summary.Unit · @(Model.Summary.Type=="WarehouseReturn"?CatTexts["A bodega"].Value:CatTexts["A proveedor"].Value)</span></div>@if(Model.Summary.IsCorrected){<div class="alert alert-secondary">@CatTexts["Esta disposición ya fue corregida o es una compensación."]</div>}else{<form method="post" class="card card-body"><input asp-for="Input.OperationId" type="hidden"/><input asp-for="Input.DispositionId" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Input.Reason" class="form-label">@CatTexts["Motivo"]</label><textarea asp-for="Input.Reason" class="form-control" rows="3" maxlength="500"></textarea><span asp-validation-for="Input.Reason" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Pin" class="form-label">@CatTexts["NIP ADMIN"]</label><input asp-for="Input.Pin" value="" type="password" inputmode="numeric" class="form-control form-control-lg" autocomplete="off"/></div><button class="btn btn-danger btn-lg">@CatTexts["Crear compensación"]</button></form>}</div>
