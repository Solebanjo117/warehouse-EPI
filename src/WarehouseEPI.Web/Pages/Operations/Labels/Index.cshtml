@page "/Operations/Labels"
@model WarehouseEPI.Web.Pages.Operations.Labels.IndexModel
@using WarehouseEPI.Infrastructure.Labels
@{ ViewData["Title"] = "Generar etiquetas"; var selected = Model.SelectedProduct; }
@if (Model.Preview is not null) { <style>@Html.Raw($"@@page {{ size: {Model.Preview.Size.WidthInches.ToString(System.Globalization.CultureInfo.InvariantCulture)}in {Model.Preview.Size.HeightInches.ToString(System.Globalization.CultureInfo.InvariantCulture)}in; margin: 0; }}")</style> }
<div class="label-workspace" data-label-workspace data-lookup-url="@Url.Page("/Operations/Lookup")">
<header class="label-page-header no-label-print"><div><span class="label-eyebrow">Motor de plantillas</span><h1 class="h2 mb-1">Generar etiquetas</h1><p class="text-body-secondary mb-0">Selecciona un formato publicado, completa sus datos y revisa antes de imprimir.</p></div></header>
@if(Model.Templates.Count==0){<div class="alert alert-info">No hay plantillas publicadas disponibles.</div>}else{
<form method="get" class="label-template-picker no-label-print" data-template-picker-form><label for="template-picker" class="form-label fw-bold">Formato</label><select id="template-picker" name="Template" class="form-select form-select-lg" data-template-picker>@foreach(var item in Model.Templates){<option value="@item.VersionId" selected="@(item.VersionId==Model.SelectedTemplate?.VersionId)">@item.Name · @item.Code · v@item.Version</option>}</select></form>
<div asp-validation-summary="ModelOnly" class="alert alert-danger no-label-print" role="alert"></div>
<form method="post" class="label-create-grid no-label-print" data-label-form><input asp-for="Input.TemplateVersionId" type="hidden" />
<section class="label-form-card"><div class="label-section-heading"><span class="label-step-number">1</span><div><h2 class="h5 mb-1">Producto</h2><p class="text-body-secondary mb-0">Escanea SKU o código, o busca por descripción.</p></div></div><input asp-for="Input.ProductId" type="hidden" data-label-product-id/><label for="label-product-search" class="form-label">SKU, código o descripción</label><input id="label-product-search" class="form-control form-control-lg" type="search" value="@selected?.Sku" autocomplete="off" placeholder="Escanea o escribe para buscar" autofocus data-label-product-search/><div class="list-group label-product-results" data-label-product-results aria-live="polite"></div><div class="selected-record @(selected is null?"d-none":null) mt-2" data-label-selected-product data-allows-decimals="@(selected?.AllowsDecimals==true?"true":"false")"><strong data-label-selected-sku>@selected?.Sku</strong><span data-label-selected-description>@selected?.Description</span><small data-label-selected-unit>@selected?.UnitCode</small></div><span asp-validation-for="Input.ProductId" class="text-danger"></span></section>
<section class="label-form-card"><div class="label-section-heading"><span class="label-step-number">2</span><div><h2 class="h5 mb-1">Datos del formato</h2><p class="text-body-secondary mb-0">Solo aparecen los campos utilizados por la plantilla.</p></div></div><div class="row g-3">
@if(Model.Uses("input.quantity")){<div class="col-sm-6"><label for="label-quantity" class="form-label">Cantidad</label><div class="input-group input-group-lg"><input id="label-quantity" name="Input.Values[input.quantity]" value="@Model.Input.Values.GetValueOrDefault("input.quantity")" class="form-control" inputmode="decimal" required data-label-quantity/><span class="input-group-text" data-label-unit>@(selected?.UnitCode??"Unidad")</span></div></div>}
@if(Model.Uses("input.manufacturingDate")){<div class="col-sm-6"><label for="label-mfg" class="form-label">Fecha MFG</label><input id="label-mfg" name="Input.Values[input.manufacturingDate]" value="@Model.Input.Values.GetValueOrDefault("input.manufacturingDate")" class="form-control form-control-lg" type="date" required/></div>}
@if(Model.Uses("input.isRepack")){<div class="col-sm-6 d-flex align-items-end"><div class="form-check label-repack-check"><input id="label-repack" name="Input.Values[input.isRepack]" value="true" checked="@(Model.Input.Values.GetValueOrDefault("input.isRepack")=="true")" class="form-check-input" type="checkbox"/><label for="label-repack" class="form-check-label">Producto reempacado (REPACK)</label></div></div>}
@foreach(var field in Model.Design?.Fields ?? new List<LabelFieldDefinition>()){<div class="col-sm-6"><label for="field-@field.Key" class="form-label">@field.Label</label>@if(field.Type==LabelFieldType.Boolean){<select id="field-@field.Key" name="Input.Values[@field.Key]" class="form-select form-select-lg" required="@field.Required"><option value="">Selecciona</option><option value="true" selected="@(Model.Input.Values.GetValueOrDefault(field.Key)=="true")">Sí</option><option value="false" selected="@(Model.Input.Values.GetValueOrDefault(field.Key)=="false")">No</option></select>}else if(field.Type==LabelFieldType.Select){<select id="field-@field.Key" name="Input.Values[@field.Key]" class="form-select form-select-lg" required="@field.Required"><option value="">Selecciona</option>@foreach(var option in field.Options){<option value="@option" selected="@(Model.Input.Values.GetValueOrDefault(field.Key)==option)">@option</option>}</select>}else{<input id="field-@field.Key" name="Input.Values[@field.Key]" value="@Model.Input.Values.GetValueOrDefault(field.Key)" class="form-control form-control-lg" type="@(field.Type==LabelFieldType.Date?"date":field.Type==LabelFieldType.Number?"number":"text")" step="@(field.Type==LabelFieldType.Number?"any":null)" required="@field.Required" maxlength="200"/>}@if(!string.IsNullOrWhiteSpace(field.Help)){<div class="form-text">@field.Help</div>}</div>}
<div class="col-sm-6"><label asp-for="Input.Copies" class="form-label">Copias</label><input asp-for="Input.Copies" class="form-control form-control-lg" type="number" min="1" max="100" required/><span asp-validation-for="Input.Copies" class="text-danger"></span></div></div></section>
<section class="label-form-card label-submit-card"><div class="label-section-heading"><span class="label-step-number">3</span><div><h2 class="h5 mb-1">Previsualizar</h2><p class="text-body-secondary mb-0">La captura no se almacena y no cambia inventario.</p></div></div><button type="submit" class="btn btn-primary btn-lg">Generar vista previa</button></section></form>}
@if(Model.Preview is not null){<section class="label-preview-section"><header class="label-preview-toolbar no-label-print"><div><span class="label-eyebrow">@Model.Preview.TemplateCode · v@Model.Preview.TemplateVersion · @Model.Preview.Copies copia(s)</span><h2 class="h4 mb-1">Lista para imprimir</h2><p class="text-body-secondary mb-0">Usa la impresora correcta, escala 100 %, sin encabezados/pies y una sola copia.</p></div><button type="button" class="btn btn-primary btn-lg" data-label-print>Imprimir etiquetas</button></header><div class="label-print-pages" data-label-print-pages>
@for(var copy=1;copy<=Model.Preview.Copies;copy++){<article class="label-dynamic" data-label-copy="@copy" aria-label="Etiqueta @copy de @Model.Preview.Copies" style="--label-width:@(Model.Preview.Size.WidthInches.ToString(System.Globalization.CultureInfo.InvariantCulture))in;--label-height:@(Model.Preview.Size.HeightInches.ToString(System.Globalization.CultureInfo.InvariantCulture))in">@foreach(var item in Model.Preview.Elements){var e=item.Definition;var left=e.X*100m/Model.Preview.Size.WidthMils;var top=e.Y*100m/Model.Preview.Size.HeightMils;var width=e.Width*100m/Model.Preview.Size.WidthMils;var height=e.Height*100m/Model.Preview.Size.HeightMils;<div class="label-element label-element-@e.Type.ToString().ToLowerInvariant() @(e.BlankLine&&string.IsNullOrEmpty(item.Text)?"is-blank-line":null)" style="left:@(left.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(top.ToString(System.Globalization.CultureInfo.InvariantCulture))%;width:@(width.ToString(System.Globalization.CultureInfo.InvariantCulture))%;height:@(height.ToString(System.Globalization.CultureInfo.InvariantCulture))%;transform:rotate(@(e.Rotation)deg);z-index:@e.ZIndex;font-family:'@e.FontFamily';font-size:@(e.FontSize)pt;font-weight:@(e.Bold?700:400);color:@e.Color;background-color:@(e.Type==LabelElementType.Rectangle?e.BackgroundColor:"transparent");border-width:@(e.Type==LabelElementType.Rectangle?e.BorderWidth:0)px;text-align:@e.Align">@if(item.Barcode is not null){@Html.Raw(item.Barcode.Markup)}else if(item.ImageUrl is not null){<img src="@item.ImageUrl" alt=""/>}else if(e.Type==LabelElementType.Line){<span class="label-line"></span>}else{@item.Text}</div>}</article>}</div></section>}
</div>
@section Styles { <link rel="stylesheet" href="~/css/label-4x6.css" asp-append-version="true"/> }
@section Scripts { <script src="~/js/label-4x6.js" asp-append-version="true"></script> }
