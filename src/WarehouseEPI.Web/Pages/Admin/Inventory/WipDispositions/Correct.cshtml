@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Inventory.WipDispositions.CorrectModel
@{ ViewData["Title"]="Corregir devolución WIP"; }
<div class="container py-4"><h1 class="h2">Corregir devolución WIP</h1><div class="alert alert-warning">Esta acción crea una compensación auditable. Si regresó a bodega, revierte también la entrada asociada.</div><div class="card card-body mb-3"><strong>@Model.Summary.Sku · @Model.Summary.Wip</strong><span>@Model.Summary.Quantity.ToString("0.####") @Model.Summary.Unit · @(Model.Summary.Type=="WarehouseReturn"?"A bodega":"A proveedor")</span></div>@if(Model.Summary.IsCorrected){<div class="alert alert-secondary">Esta disposición ya fue corregida o es una compensación.</div>}else{<form method="post" class="card card-body"><input asp-for="Input.OperationId" type="hidden"/><input asp-for="Input.DispositionId" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Input.Reason" class="form-label">Motivo</label><textarea asp-for="Input.Reason" class="form-control" rows="3" maxlength="500"></textarea><span asp-validation-for="Input.Reason" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Pin" class="form-label">NIP ADMIN</label><input asp-for="Input.Pin" value="" type="password" inputmode="numeric" class="form-control form-control-lg" autocomplete="off"/></div><button class="btn btn-danger btn-lg">Crear compensación</button></form>}</div>
