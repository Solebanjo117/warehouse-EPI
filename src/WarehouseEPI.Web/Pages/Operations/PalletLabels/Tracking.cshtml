@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@model WarehouseEPI.Web.Pages.Operations.PalletLabels.TrackingModel
@{ ViewData["Title"] = OpTexts["Seguimiento de placas"].Value; }
<header class="mb-3"><h1>@OpTexts["Seguimiento de placas"]</h1><p>@OpTexts["Consulta cantidad, ubicación e historial de cada pallet."]</p><a asp-page="Index" class="btn btn-outline-secondary btn-lg">@OpTexts["Identificar pallet e imprimir"]</a></header>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><label asp-for="Search" class="form-label">@OpTexts["Placa, producto o ubicación"]</label><input asp-for="Search" class="form-control form-control-lg" autofocus autocomplete="off" /></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label">@OpTexts["Estado"]</label><select asp-for="Status" class="form-select form-select-lg"><option value="">@OpTexts["Todos"]</option><option value="available">@OpTexts["Disponible"]</option><option value="empty">@OpTexts["Agotada"]</option><option value="negative">@OpTexts["Con diferencia"]</option><option value="void">@OpTexts["Anulada"]</option></select></div>
    <div class="col-md-2 align-self-end"><button class="btn btn-primary btn-lg">@OpTexts["Buscar"]</button></div>
</form>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>@OpTexts["Placa / producto"]</th><th>@OpTexts["Ubicación actual"]</th><th>@OpTexts["Cantidad actual"]</th><th>@OpTexts["Estado"]</th><th>@OpTexts["Acciones"]</th></tr></thead><tbody>
@foreach(var row in Model.Rows){<tr><td><a asp-route-id="@row.Id">@row.Identifier</a><strong class="d-block">@row.Sku</strong></td><td>@row.Location</td><td>@row.Quantity.ToString("0.####")</td><td>@row.Status</td><td><a asp-page="Index" asp-route-id="@row.Id" class="btn btn-outline-primary btn-lg">@OpTexts["Imprimir actual"]</a></td></tr>}
</tbody></table></div>
@if(Model.Rows.Count == 0){<p>@OpTexts["No hay placas que coincidan. Registra una entrada o activa una placa documental."]</p>}
<nav aria-label="@OpTexts["Páginas de placas"]"><a class="btn btn-outline-secondary btn-lg" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-OriginId="@Model.OriginId" asp-route-PageNumber="@Math.Max(1, Model.PageNumber-1)">@OpTexts["Anterior"]</a>@if(Model.Rows.Count == 50){<a class="btn btn-outline-secondary btn-lg" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-OriginId="@Model.OriginId" asp-route-PageNumber="@(Model.PageNumber+1)">@OpTexts["Siguiente"]</a>}</nav>
@if(Model.Orders.Count > 0){<section class="mt-3"><h2 class="h5">@OpTexts["Órdenes relacionadas"]</h2>@foreach(var order in Model.Orders){<a asp-page="/Operations/Production/Work" asp-route-id="@order.Id" class="btn btn-outline-primary btn-lg">@order.Number</a>}</section>}
@if(Model.History.Count > 0){<section class="mt-4"><h2 class="h4">@OpTexts["Historial · últimas 200 operaciones"]</h2><ul class="list-group">@foreach(var item in Model.History){<li class="list-group-item"><strong>@item.Local.ToString("dd/MM/yyyy HH:mm") · @(item.Event.Kind switch { "Entry" => OpTexts["Entrada"].Value, "Exit" => OpTexts["Salida"].Value, "Transfer" => OpTexts["Transferencia"].Value, "Adjustment" => OpTexts["Conteo / ajuste"].Value, "Activation" => OpTexts["Verificación inicial de existencia y lotes"].Value, "Identification" => OpTexts["Identificación de pallet"].Value, "IdentificationVoided" => OpTexts["Anulación de identificación"].Value, "Reversal" => OpTexts["Reverso"].Value, "Assignment" => OpTexts["Asignación a producción"].Value, "AssignmentCancelled" => OpTexts["Asignación cancelada"].Value, _ => item.Event.Kind })</strong><div>@item.Detail.Responsible · @item.Detail.BeforeQuantity.ToString("0.####") → @item.Detail.AfterQuantity.ToString("0.####") · @item.Detail.BeforeLocation → @item.Detail.AfterLocation</div>@foreach(var related in item.Detail.RelatedPlates){<a asp-route-id="@related" class="btn btn-link btn-lg">PLT-@related.ToString("N").ToUpperInvariant()</a>}@if(item.Event.MovementId.HasValue){<a asp-page="/Operations/Receipt" asp-route-id="@item.Event.MovementId" class="btn btn-link btn-lg">@OpTexts["Ver movimiento y placas relacionadas"]</a>}</li>}</ul></section>}
@if(Model.Rows.Count == 1 && !Model.Rows[0].Status.Equals("Anulada", StringComparison.Ordinal) && Model.History.Count == 1 && Model.History[0].Event.Kind == "Identification")
{<details class="card card-body mt-4"><summary class="h5">@OpTexts["Anular identificación (ADMIN)"]</summary><p>@OpTexts["Solo se permite si la placa no tiene movimientos, asignaciones ni eventos posteriores. El inventario total no cambia."]</p><form method="post" asp-page-handler="Void" class="row g-3"><input asp-for="Void.OperationId" type="hidden"/><input asp-for="Void.PlateId" type="hidden"/><input asp-for="Void.ExpectedVersion" type="hidden"/><div class="col-md-8"><label asp-for="Void.Reason" class="form-label">@OpTexts["Motivo"]</label><textarea asp-for="Void.Reason" class="form-control" rows="2" maxlength="500" required></textarea></div><div class="col-md-4"><label asp-for="Void.Pin" class="form-label">@OpTexts["NIP ADMIN"]</label><input asp-for="Void.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control form-control-lg" required/></div><div><button class="btn btn-outline-danger btn-lg">@OpTexts["Anular identificación"]</button></div></form></details>}
<details class="card card-body mt-4"><summary class="h5">@OpTexts["Activar una placa documental existente"]</summary><p>@OpTexts["Verifica físicamente la cantidad y ubicación. La activación identifica inventario existente; no registra una nueva entrada. Los lotes se asignan según disponibilidad actual."]</p>
<form method="post" asp-page-handler="Activate" class="row g-3">
<input asp-for="Activation.OperationId" type="hidden" />
<div class="col-md-6"><label asp-for="Activation.Folio" class="form-label">@OpTexts["Folio de entrada o placa"]</label><input asp-for="Activation.Folio" class="form-control form-control-lg" required autocomplete="off" /></div>
<div class="col-md-6"><label asp-for="Activation.LocationId" class="form-label">@OpTexts["Ubicación verificada"]</label><select asp-for="Activation.LocationId" class="form-select form-select-lg" required data-pallet-location-picker><option value="">@OpTexts["Selecciona ubicación"]</option>@foreach(var location in Model.Locations){<option value="@location.Id">@location.Code</option>}</select></div>
<div class="col-md-6"><label asp-for="Activation.Quantity" class="form-label">@OpTexts["Cantidad verificada"]</label><input asp-for="Activation.Quantity" type="number" step="0.0001" min="0.0001" class="form-control form-control-lg" required /></div>
<div class="col-md-6"><label asp-for="Activation.Pin" class="form-label">@OpTexts["NIP del responsable"]</label><input asp-for="Activation.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control form-control-lg" required /></div>
<div><button class="btn btn-primary btn-lg">@OpTexts["Activar seguimiento"]</button></div>
</form></details>
