@page
@using WarehouseEPI.Infrastructure.Locations
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.IndexModel
@{ ViewData["Title"] = "Ubicaciones"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div><h1 class="h2 mb-1">Ubicaciones</h1><p class="text-muted mb-0">Consulta física y administración del almacén.</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-page="Generate" class="btn btn-outline-primary btn-lg">Preparar racks</a><a asp-page="Area" class="btn btn-primary btn-lg">Crear área</a></div>
</div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}
@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}

<div class="location-summary mb-3">
    <div><strong>@Model.Summary.Available</strong><span>Disponibles</span></div>
    <div><strong>@Model.Summary.Blocked</strong><span>Bloqueadas</span></div>
    <div><strong>@Model.Summary.Inactive</strong><span>Inactivas</span></div>
    <div><strong>@Model.Summary.Racks</strong><span>Posiciones</span></div>
    <div><strong>@Model.Summary.Areas</strong><span>Áreas</span></div>
    @if(Model.ViewMode=="map") { <div><strong>@Model.Map.WithInventory</strong><span>Con saldo</span></div><div><strong>@Model.Map.Negative</strong><span>Negativas</span></div><div><strong>@Model.Map.Unplaced.Count</strong><span>Sin colocar</span></div> }
</div>

<form method="get" class="card card-body mb-3"><input type="hidden" name="viewMode" value="@Model.ViewMode"/><div class="row g-2">
    <div class="col-12 col-lg-4"><label for="search" class="form-label">Buscar ubicación o producto</label><input id="search" name="search" value="@Model.Search" class="form-control form-control-lg" placeholder="Código, SKU, descripción, referencia o barras" /></div>
    <div class="col-6 col-md-4 col-lg-2"><label for="status" class="form-label">Estado</label><select id="status" name="status" class="form-select form-select-lg"><option value="active" selected="@(Model.Status=="active")">Disponibles</option><option value="blocked" selected="@(Model.Status=="blocked")">Bloqueadas</option><option value="inactive" selected="@(Model.Status=="inactive")">Inactivas</option><option value="all" selected="@(Model.Status=="all")">Todas</option></select></div>
    @if(Model.ViewMode == "racks"){<input type="hidden" name="kind" value="rack"/>}else{<div class="col-6 col-md-4 col-lg-2"><label for="kind" class="form-label">Tipo</label><select id="kind" name="kind" class="form-select form-select-lg"><option value="all">Todos</option><option value="rack" selected="@(Model.Kind=="rack")">Rack</option><option value="area" selected="@(Model.Kind=="area")">Área</option></select></div>}
    <div class="col-6 col-md-4 col-lg-2"><label for="rowCode" class="form-label">Fila</label><select id="rowCode" name="rowCode" class="form-select form-select-lg"><option value="">Todas</option>@foreach(var row in Model.Rows){<option value="@row" selected="@(Model.RowCode==row)">@row</option>}</select></div>
    <div class="col-6 col-lg-2 d-flex align-items-end gap-1"><button class="btn btn-outline-primary btn-lg flex-grow-1">Buscar</button><a asp-page="Index" asp-route-viewMode="@Model.ViewMode" class="btn btn-outline-secondary btn-lg" title="Limpiar filtros">×</a></div>
</div></form>

<div class="nav nav-pills mb-3" aria-label="Vista de ubicaciones">
    <a class="nav-link @(Model.ViewMode=="map"?"active":"")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="map">Croquis</a>
    <a class="nav-link @(Model.ViewMode=="racks"?"active":"")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="rack" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="racks">Racks</a>
    <a class="nav-link @(Model.ViewMode=="table"?"active":"")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="table">Tabla administrativa</a>
</div>

@if(Model.ViewMode=="map")
{
    <div class="warehouse-map-toolbar mb-2"><button type="button" class="btn btn-outline-secondary" data-map-zoom="in" aria-label="Acercar">＋</button><button type="button" class="btn btn-outline-secondary" data-map-zoom="out" aria-label="Alejar">−</button><button type="button" class="btn btn-outline-secondary" data-map-fit>Ajustar</button><a asp-page="Map/Edit" class="btn btn-primary ms-auto">Editar croquis</a></div>
    @if(!Model.Map.IsInitialized){<div class="alert alert-info"><strong>Vista previa sin guardar.</strong> Revisa la distribución basada en el plano físico y confírmala desde Editar croquis.</div>}
    <div class="warehouse-map-shell" data-warehouse-map>
        <div class="warehouse-map-viewport" data-map-viewport tabindex="0" aria-label="Croquis interactivo del almacén">
            <svg class="warehouse-map" viewBox="0 0 1600 900" role="img" aria-labelledby="warehouse-map-title">
                <title id="warehouse-map-title">Croquis del almacén Warehouse EPI</title>
                <image href="/images/warehouse-floor-base.svg" x="0" y="0" width="1600" height="900" aria-hidden="true"/>
                <g data-map-layer>
                @foreach(var element in Model.Map.Elements.OrderBy(item=>item.ZIndex))
                {
                    var state = MapState(element); var match = element.Positions.Any(position=>Model.MapMatches.Contains(position.LocationId));
                    <g class="map-element @state @(element.IsWip?"wip":"") @(match?"is-match":"")" transform="translate(@element.X.ToString(global::System.Globalization.CultureInfo.InvariantCulture) @element.Y.ToString(global::System.Globalization.CultureInfo.InvariantCulture)) rotate(@element.Rotation)" tabindex="0" role="button" aria-label="Abrir @element.Label, @StateLabel(state)" data-map-open="@element.Id" data-map-target="@match.ToString().ToLowerInvariant()">
                        <rect width="@element.Width.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" height="@element.Height.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" rx="4"/><text x="6" y="18">@element.Label</text>@if(element.Positions.Any(position=>position.HasNegative)){<circle class="map-alert-dot" cx="@(element.Width-8)" cy="8" r="6"/>}
                    </g>
                }
                </g>
            </svg>
        </div>
        <aside class="warehouse-map-detail" aria-live="polite"><div class="map-detail-placeholder"><h2 class="h5">Selecciona un rack o área</h2><p>Consulta sus posiciones, saldos y asignaciones sin salir del croquis.</p></div>
        @foreach(var element in Model.Map.Elements)
        {
            <section class="map-element-detail" data-map-detail="@element.Id" hidden><div class="d-flex justify-content-between"><div><span class="text-body-secondary">@(element.IsWip?"Rack WIP — no controla saldo":element.Kind=="Rack"?"Rack":"Área")</span><h2 class="h4">@element.Label</h2></div><button type="button" class="btn-close" data-map-close aria-label="Cerrar detalle"></button></div>
            @if(element.Kind=="Rack") { <div class="map-keypad">@foreach(var pallet in new short[]{7,8,9,4,5,6,1,2,3}) { var position=element.Positions.FirstOrDefault(item=>item.PalletNumber==pallet); if(position is null){<span class="map-position missing"><strong>@pallet</strong><small>No disponible</small></span>}else{<button type="button" class="map-position @PositionState(position)" data-map-position="@position.LocationId"><strong>@pallet</strong><small>@position.Code</small><span>@position.ProductCount producto(s)</span></button>} }</div> }
            @foreach(var position in element.Positions){<div class="map-position-detail" data-position-detail="@position.LocationId" hidden><h3 class="h5">@position.Code</h3><p>@(position.Description??"Sin descripción")</p><div class="d-flex gap-2 flex-wrap mb-2"><span class="badge text-bg-light border">@position.AssignmentCount asignación(es)</span>@if(position.HasNegative){<span class="badge text-bg-danger">Saldo negativo</span>}else if(position.HasInventory){<span class="badge text-bg-primary">Con saldo</span>}else{<span class="badge text-bg-secondary">Sin saldo</span>}</div>@foreach(var product in position.Products){<div class="map-product-row"><a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@product.ProductId">@(string.IsNullOrEmpty(product.Sku)?"Producto":product.Sku)</a><span class="@(product.Quantity<0?"text-danger":"")">@product.Quantity.ToString("0.####") @product.Unit</span><small>@(product.IsAssigned?"Asignado":"Sin asignación activa")</small></div>}<div class="d-flex flex-wrap gap-2 mt-3"><a asp-page="Details" asp-route-id="@position.LocationId" class="btn btn-primary">Ficha</a><a asp-page="/Inventory/Index" asp-route-locationId="@position.LocationId" class="btn btn-outline-secondary">Existencias</a><a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">Movimientos</a></div></div>}
            </section>
        }
        </aside>
    </div>
    <div class="visually-hidden"><h2>Lista accesible del croquis</h2><ul>@foreach(var element in Model.Map.Elements){<li><button type="button" data-map-open="@element.Id">@element.Label, @StateLabel(MapState(element))</button></li>}</ul></div>
}
else if(Model.ViewMode=="racks")
{
    <div class="rack-filter-bar mb-3" aria-label="Filtro operativo de racks">
        @foreach(var filter in new[]{("all","Todos"),("occupied","Con saldo"),("empty","Sin saldo"),("issues","Con incidencias")}){<a class="btn @(Model.RackFilter==filter.Item1?"btn-primary":"btn-outline-secondary")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="rack" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="racks" asp-route-rackFilter="@filter.Item1">@filter.Item2</a>}
    </div>
    <div class="rack-legend mb-3" aria-label="Leyenda de estados"><span class="rack-legend-item occupied">Con saldo</span><span class="rack-legend-item empty">Sin saldo</span><span class="rack-legend-item negative">Saldo negativo</span><span class="rack-legend-item blocked">Bloqueada</span><span class="rack-legend-item inactive">Inactiva</span></div>
    @if(Model.LayoutRacks.Count==0){<div class="card card-body text-center text-muted py-5">No hay racks que coincidan.</div>}
    else
    {
        <div class="rack-view-shell" data-rack-view>
            <div class="rack-view-grid">
            @foreach(var rowGroup in Model.LayoutRacks.GroupBy(rack => rack.RowCode))
            {
                var racks = rowGroup.ToArray(); var positions = racks.SelectMany(rack => rack.Positions).OfType<IndexModel.LocationRow>().ToArray();
                <section class="rack-row-section mb-4"><header class="rack-row-header"><div><h2 class="h4 mb-1">Fila @rowGroup.Key</h2><span>@racks.Length rack(s) · @positions.Length posiciones</span></div><div class="rack-row-metrics"><span><strong>@positions.Count(position=>position.HasInventory)</strong> con saldo</span><span><strong>@positions.Count(position=>!position.HasInventory)</strong> sin saldo</span><span><strong>@positions.Count(position=>position.HasIssue)</strong> incidencias</span></div></header><div class="rack-layout-list">
                @foreach(var rack in racks)
                {
                    <article class="rack-card rack-@rack.RackState"><header><div><span>Rack</span><h3 class="h5 mb-0">@rack.RowCode-@rack.RackNumber</h3></div><span class="rack-count">@rack.OccupiedCount/@rack.PositionCount con saldo</span></header><div class="rack-keypad">
                    @foreach(var position in rack.Positions)
                    {
                        @if(position is null){<div class="location-slot missing" aria-label="Posición inexistente"><span>No existe</span></div>}
                        else
                        {
                            var primaryBalance = position.Balances.FirstOrDefault();
                            <a asp-page="Details" asp-route-id="@position.Id" class="location-slot @position.RackState" title="Abrir @position.Code" data-rack-open="@position.Id" aria-controls="rack-detail-@position.Id">
                                <strong>@position.PalletNumber</strong><small>@position.Code</small><span class="rack-slot-state">@RackStateLabel(position.RackState)</span>
                                @if(primaryBalance is not null){<span class="sku-chip">@primaryBalance.Sku</span>@if(position.Balances.Count>1){<span class="sku-more">+@(position.Balances.Count-1) producto(s)</span>}}
                                else if(position.ProductCount>0){<span class="sku-chip">@position.Skus.FirstOrDefault()</span><span class="sku-more">Asignado sin saldo</span>}
                            </a>
                        }
                    }
                    </div></article>
                }
                </div></section>
            }
            </div>
            <aside class="rack-detail-panel" aria-live="polite"><div class="rack-detail-placeholder"><h2 class="h5">Selecciona una posición</h2><p>Consulta saldos, asignaciones y movimientos sin salir de la fila.</p></div>
            @foreach(var position in Model.Locations.Where(location=>location.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack))
            {
                <section id="rack-detail-@position.Id" class="rack-position-detail" data-rack-detail="@position.Id" hidden><div class="d-flex justify-content-between gap-2"><div><span class="text-body-secondary">Ubicación</span><h2 class="h4 mb-1">@position.Code</h2><span class="badge text-bg-light border">@RackStateLabel(position.RackState)</span></div><button type="button" class="btn-close" data-rack-close aria-label="Cerrar detalle"></button></div>
                @if(position.IsBlocked){<p class="alert alert-warning py-2 mt-3 mb-2"><strong>Bloqueada.</strong> @position.BlockReason</p>}else if(!position.IsActive){<p class="alert alert-secondary py-2 mt-3 mb-2"><strong>Inactiva.</strong></p>}
                <h3 class="h6 mt-3">Saldos actuales</h3>@if(position.Balances.Count==0){<p class="text-body-secondary">Sin saldo registrado.</p>}else{<div class="rack-balance-list">@foreach(var balance in position.Balances){<div><div><strong>@balance.Sku</strong><small>@(balance.Description??"Sin descripción") · @(balance.IsAssigned?"Asignado":"Sin asignación activa")</small></div><span class="@(balance.Quantity<0?"text-danger":"")">@balance.Quantity.ToString("0.####") @balance.Unit</span></div>}</div>}
                <div class="d-flex flex-wrap gap-2 mt-3"><a asp-page="Details" asp-route-id="@position.Id" class="btn btn-primary">Ficha</a><a asp-page="/Inventory/Index" asp-route-locationId="@position.Id" class="btn btn-outline-secondary">Existencias</a><a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">Movimientos</a></div></section>
            }
            </aside>
        </div>
    }
}
else
{
    <div class="table-responsive"><table class="table table-striped align-middle inventory-list"><thead><tr><th>Código</th><th>Tipo / posición</th><th>Productos asignados</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
    @if(Model.Locations.Count==0){<tr><td colspan="5" class="text-center text-muted py-4">No hay ubicaciones que coincidan.</td></tr>}
    @foreach(var item in Model.Locations){<tr><td><a asp-page="Details" asp-route-id="@item.Id" class="fw-bold">@item.Code</a>@if(item.Description is not null){<div class="small text-muted">@item.Description</div>}</td><td>@(item.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack?$"Fila {item.RowCode}, rack {item.RackNumber}, pallet {item.PalletNumber}":"Área especial")</td><td>@foreach(var sku in item.Skus){<span class="badge text-bg-light border me-1">@sku</span>}@if(item.ProductCount>item.Skus.Count){<span class="badge text-bg-secondary">+@(item.ProductCount-item.Skus.Count)</span>}@if(item.ProductCount==0){<span class="text-muted">Sin asignar</span>}</td><td>@if(!item.IsActive){<span class="badge text-bg-secondary">Inactiva</span>}else if(item.IsBlocked){<span class="badge text-bg-warning">Bloqueada</span><div class="small">@item.BlockReason</div>}else{<span class="badge text-bg-success">Disponible</span>}</td><td class="text-end"><div class="dropdown"><button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Acciones</button><ul class="dropdown-menu dropdown-menu-end"><li><a asp-page="Details" asp-route-id="@item.Id" class="dropdown-item">Ver productos</a></li>@if(item.Kind==WarehouseEPI.Core.Entities.LocationKind.Area){<li><a asp-page="Area" asp-route-locationId="@item.Id" class="dropdown-item">Editar área</a></li>}<li><hr class="dropdown-divider"/></li>@if(item.IsActive&&!item.IsBlocked){<li><button type="button" class="dropdown-item text-warning block-location" data-bs-toggle="modal" data-bs-target="#blockModal" data-location-id="@item.Id" data-location-code="@item.Code">Bloquear</button></li>}else if(item.IsBlocked){<li><form method="post" asp-page-handler="Unblock"><input type="hidden" name="id" value="@item.Id"/><button class="dropdown-item text-success">Desbloquear</button></form></li>}<li><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@item.Id"/><button class="dropdown-item">@(item.IsActive?"Desactivar":"Activar")</button></form></li></ul></div></td></tr>}
    </tbody></table></div>
    @if(Model.TotalPages>1){<nav aria-label="Paginación"><ul class="pagination justify-content-center flex-wrap"><li class="page-item @(Model.CurrentPage<=1?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(1)">Primera</a></li><li class="page-item @(Model.CurrentPage<=1?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.CurrentPage-1)">Anterior</a></li>@foreach(var pageNumber in Model.VisiblePages){<li class="page-item @(pageNumber==Model.CurrentPage?"active":"")"><a class="page-link" asp-all-route-data="@RouteValues(pageNumber)">@pageNumber</a></li>}<li class="page-item @(Model.CurrentPage>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.CurrentPage+1)">Siguiente</a></li><li class="page-item @(Model.CurrentPage>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.TotalPages)">Última</a></li></ul></nav>}
}

<div class="modal fade" id="blockModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="Block"><div class="modal-header"><h2 class="modal-title fs-5" id="blockModalLabel">Bloquear ubicación</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><input type="hidden" id="blockLocationId" name="id"/><p id="blockLocationText"></p><label for="blockReason" class="form-label">Motivo</label><textarea id="blockReason" name="reason" class="form-control" maxlength="200" rows="3" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-warning">Bloquear</button></div></form></div></div></div>

@functions{
    private Dictionary<string,string?> RouteValues(int pageNumber) => new()
    {
        ["search"] = Model.Search, ["status"] = Model.Status, ["kind"] = Model.Kind,
        ["rowCode"] = Model.RowCode, ["viewMode"] = "table", ["pageNumber"] = pageNumber.ToString()
    };
    private static string MapState(WarehouseMapElementView element) => element.Positions.Any(item=>item.HasNegative)?"negative":element.Positions.All(item=>!item.IsActive)?"inactive":element.Positions.Any(item=>item.IsBlocked)?"blocked":element.Positions.Any(item=>item.HasInventory)?"occupied":"available";
    private static string PositionState(WarehouseMapPosition item) => item.HasNegative?"negative":!item.IsActive?"inactive":item.IsBlocked?"blocked":item.HasInventory?"occupied":"available";
    private static string StateLabel(string state) => state switch{"negative"=>"saldo negativo","inactive"=>"inactivo","blocked"=>"bloqueado","occupied"=>"con inventario",_=>"disponible"};
    private static string RackStateLabel(string state) => state switch{"negative"=>"Saldo negativo","inactive"=>"Inactiva","blocked"=>"Bloqueada","occupied"=>"Con saldo",_=>"Sin saldo"};
}
@section Scripts { <script src="~/js/warehouse-map.js" asp-append-version="true"></script><script src="~/js/rack-view.js" asp-append-version="true"></script> }
