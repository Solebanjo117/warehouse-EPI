@page
@model WarehouseEPI.Web.Pages.Admin.Inventory.AlertsModel
@{ ViewData["Title"]="Alertas de inventario"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2 mb-1">Alertas de inventario</h1><p class="text-muted mb-0">Valores derivados de los saldos actuales.</p></div><a asp-page="/Admin/Inventory/Movements/Index" class="btn btn-outline-secondary">Historial</a></div>
<h2 class="h4">Saldos negativos por ubicación</h2><div class="table-responsive mb-4"><table class="table table-warning"><thead><tr><th>Producto</th><th>Ubicación</th><th>Saldo</th></tr></thead><tbody>@if(Model.NegativeBalances.Count==0){<tr><td colspan="3" class="text-center">No hay saldos negativos.</td></tr>}else{@foreach(var row in Model.NegativeBalances){<tr><td><a asp-page="/Inventory/Index" asp-route-productId="@row.ProductId">@row.ProductSku</a></td><td><a asp-page="/Inventory/Index" asp-route-locationId="@row.LocationId">@row.LocationCode</a></td><td>@row.Quantity.ToString("0.####")</td></tr>}}</tbody></table></div>
<h2 class="h4">Productos por debajo del mínimo</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Producto</th><th>Total</th><th>Mínimo</th></tr></thead><tbody>@if(Model.BelowMinimum.Count==0){<tr><td colspan="3" class="text-center">No hay productos por debajo del mínimo.</td></tr>}else{@foreach(var row in Model.BelowMinimum){<tr><td><a asp-page="/Inventory/Index" asp-route-productId="@row.ProductId">@row.Sku</a></td><td>@row.TotalQuantity.ToString("0.####")</td><td>@row.MinimumStock.ToString("0.####")</td></tr>}}</tbody></table></div>
