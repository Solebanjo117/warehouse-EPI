@page "/Operations/Receiving"
@using WarehouseEPI.Core.Entities
@using WarehouseEPI.Infrastructure.Inventory
@model WarehouseEPI.Web.Pages.Operations.Receiving.IndexModel
@{ ViewData["Title"] = "Recepciones"; var pages = Math.Max(1, (int)Math.Ceiling(Model.Results.TotalCount / (double)IndexModel.PageSize)); }
<div class="container-fluid py-3 receiving-shell">
    <header class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-4"><div><span class="text-uppercase small text-primary fw-semibold">Entrada y trazabilidad</span><h1 class="h2 mb-1">Recepciones contra documento</h1><p class="text-muted mb-0">Lo esperado no cambia inventario; cada recepción confirmada genera una Entrada real.</p></div><a class="btn btn-primary btn-lg" asp-page="New">Preparar documento</a></header>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    <form method="get" class="operation-card mb-3"><div class="row g-3 align-items-end"><div class="col-12 col-lg-7"><label for="receiving-search" class="form-label">Buscar</label><input id="receiving-search" name="search" value="@Model.Search" class="form-control" placeholder="Número, origen, SKU o código" /></div><div class="col-12 col-md-5 col-lg-3"><label for="receiving-status" class="form-label">Estado</label><select id="receiving-status" name="status" class="form-select"><option value="">Abiertos y parciales</option>@foreach(var status in Enum.GetValues<ReceivingDocumentStatus>()){<option value="@status" selected="@(Model.Status == status)">@StatusText(status)</option>}</select></div><div class="col-12 col-md-3 col-lg-2"><button class="btn btn-outline-primary w-100">Filtrar</button></div></div></form>
    @if (Model.Results.Items.Count == 0) { <section class="operation-card text-center py-5"><h2 class="h5">No hay documentos para estos filtros.</h2><p class="text-muted mb-0">Prepara un documento o cambia la búsqueda.</p></section> }
    else { <div class="table-responsive receiving-table"><table class="table align-middle"><thead><tr><th>Documento</th><th>Origen</th><th>Estado</th><th>Avance</th><th>Abierto</th><th></th></tr></thead><tbody>@foreach(var item in Model.Results.Items){<tr><td data-label="Documento"><strong>@ReceivingQueryService.FormatType(item.Type) @item.Number</strong><div class="small text-muted">@item.ProductCount producto(s)</div></td><td data-label="Origen">@item.Origin</td><td data-label="Estado"><span class="badge text-bg-@StatusClass(item.Status)">@StatusText(item.Status)</span></td><td data-label="Avance"><strong>@item.ProgressPercent.ToString("0.#")%</strong></td><td data-label="Abierto">@Model.LocalDates[item.Id].ToString("dd/MM/yyyy HH:mm")</td><td><a class="btn btn-outline-primary" asp-page="Details" asp-route-id="@item.Id">Abrir</a></td></tr>}</tbody></table></div> }
    @if(pages > 1){<nav aria-label="Páginas de recepciones"><ul class="pagination">@for(var p=1;p<=pages;p++){<li class="page-item @(p==Model.PageNumber?"active":null)"><a class="page-link" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@p">@p</a></li>}</ul></nav>}
</div>
@functions { static string StatusText(ReceivingDocumentStatus s)=>s switch{ReceivingDocumentStatus.Open=>"Abierto",ReceivingDocumentStatus.PartiallyReceived=>"Parcial",ReceivingDocumentStatus.Completed=>"Completado",ReceivingDocumentStatus.ClosedWithDifferences=>"Cerrado con diferencias",_=>"Cancelado"}; static string StatusClass(ReceivingDocumentStatus s)=>s switch{ReceivingDocumentStatus.Completed=>"success",ReceivingDocumentStatus.ClosedWithDifferences=>"warning",ReceivingDocumentStatus.Cancelled=>"secondary",ReceivingDocumentStatus.PartiallyReceived=>"info",_=>"primary"}; }
