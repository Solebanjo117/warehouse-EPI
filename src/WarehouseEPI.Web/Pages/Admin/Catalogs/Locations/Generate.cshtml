@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.GenerateModel
@{ ViewData["Title"] = "Preparar racks"; }
<div class="d-print-none"><h1 class="h2">Preparar racks</h1><p class="text-muted">Una línea por bloque: <code>Fila,Rack inicial,Rack final,Pallets</code>. Usa <code>1-9</code> o separa posiciones con punto y coma.</p>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}
<form method="post" asp-page-handler="Prepare" class="card card-body mb-3"><label asp-for="Manifest" class="form-label">Bloques del layout</label><textarea asp-for="Manifest" class="form-control font-monospace" rows="6" placeholder="A,1,10,1-9&#10;B,1,8,1;2;3;4;5;6"></textarea><div class="form-text">La vista previa no escribe en la base de datos.</div><div class="mt-3"><button class="btn btn-primary btn-lg">Preparar vista previa</button> <a asp-page="Index" class="btn btn-outline-secondary btn-lg">Volver</a></div></form></div>
@if(Model.Preview is not null){<section><div class="d-flex flex-wrap justify-content-between gap-2"><div><h2 class="h4">Hoja de validación física</h2><p>@Model.Preview.Rows.Count ubicaciones en @Model.Preview.RackCount racks. Expira @Model.Preview.ExpiresAt.LocalDateTime.ToString("g").</p></div><button type="button" class="btn btn-outline-secondary d-print-none" data-print-validation>Imprimir validación</button></div>
@foreach(var error in Model.Preview.Errors){<div class="alert alert-danger d-print-none">@error</div>}
<form method="post" asp-page-handler="Confirm" asp-route-token="@Model.Preview.Token"><div class="table-responsive"><table class="table table-bordered table-sm align-middle"><thead><tr><th class="d-print-none">Incluir</th><th>Código</th><th>Fila</th><th>Rack</th><th>Pallet</th><th>Nivel</th><th>Validación física</th></tr></thead><tbody>@foreach(var row in Model.Preview.Rows){<tr class="@(row.Exists?"table-warning":"")"><td class="d-print-none"><input class="form-check-input" type="checkbox" name="SelectedCodes" value="@row.Code" checked="@(!row.Exists)" disabled="@row.Exists"/></td><td><strong>@row.Code</strong>@if(row.Exists){<span class="badge text-bg-warning ms-1">Existe</span>}</td><td>@row.RowCode</td><td>@row.RackNumber</td><td>@row.PalletNumber</td><td>@row.Level</td><td class="validation-box">□ Confirmada</td></tr>}</tbody></table></div>
<div class="alert alert-warning d-print-none">Confirma solamente después de revisar físicamente el sentido de numeración y excluir las posiciones inexistentes.</div><button class="btn btn-success btn-lg d-print-none" disabled="@(!Model.Preview.CanConfirm)">Confirmar ubicaciones seleccionadas</button></form></section>}
