@page
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.CountModel
@{
    ViewData["Title"] = "Conteo ciego";
    var attempt = Model.Attempt;
    var unexpectedRows = Math.Max(3, Model.Input.UnexpectedEntries.Count);
    var productCount = attempt?.Entries.Count ?? 0;
}
<div class="operation-shell cycle-count-workspace cycle-count-station" data-cycle-count-capture data-cycle-campaign="@Model.CampaignId" data-cycle-location="@Model.LocationId">
    <header class="entry-header">
        <div>
            <a asp-page="Details" asp-route-id="@Model.CampaignId" class="small text-decoration-none">← Campaña</a>
            <h1 class="h2 mt-2 mb-1">Conteo ciego</h1>
            <p class="text-muted mb-0">Escanea producto, captura cantidad y continúa.</p>
        </div>
        <div class="entry-progress" role="status" aria-live="polite">
            <span data-cycle-progress>0 de @productCount contados</span>
            <small>1 ubicación por captura</small>
        </div>
    </header>

    @if (Model.Error is not null)
    {
        <div class="alert alert-danger" role="alert" tabindex="-1" data-cycle-errors>@Model.Error</div>
    }

    @if (attempt is null)
    {
        <div class="alert alert-warning" role="alert">
            Vuelve a abrir la ubicación desde la campaña para iniciar la captura.
            <a asp-page="Details" asp-route-id="@Model.CampaignId" class="alert-link">Ir a la campaña</a>
        </div>
        return;
    }

    <p class="cycle-blind-note">
        <svg class="app-icon" aria-hidden="true"><use href="#icon-lock" /></svg>
        <span>Existencia esperada oculta. Captura lo que cuentes físicamente, incluso si es cero.</span>
    </p>

    <form method="post">
        <input asp-for="Input.PreparationToken" type="hidden" value="@Model.PreparationToken" />
        <input asp-for="Input.OperationId" type="hidden" value="@(Model.Input.OperationId == Guid.Empty ? Guid.NewGuid() : Model.Input.OperationId)" />
        <input type="hidden" name="id" value="@Model.CampaignId" />
        <input type="hidden" name="locationId" value="@Model.LocationId" />

        <div class="entry-capture">
            @for (var index = 0; index < attempt.Entries.Count; index++)
            {
                var entry = attempt.Entries[index];
                var missing = Model.MissingQuantityProductIds.Contains(entry.ProductId);
                <section class="entry-step cycle-count-step @(missing ? "is-missing" : null)" data-cycle-product="@entry.Sku">
                    <header class="entry-step-header">
                        <span class="entry-step-number" aria-hidden="true">@(index + 1)</span>
                        <div>
                            <h2 class="h5 mb-0">@entry.Sku</h2>
                            <span class="entry-step-status" data-cycle-step-status>Pendiente</span>
                        </div>
                    </header>
                    <div class="entry-step-body">
                        <p class="cycle-count-description">@(entry.Description ?? "Sin descripción")</p>
                        <input name="Input.Entries[@index].ProductId" type="hidden" value="@entry.ProductId" />
                        <label class="form-label" for="quantity-@index">Conteo físico</label>
                        <div class="input-group input-group-lg entry-capture-input">
                            <input id="quantity-@index" name="Input.Entries[@index].Quantity" value="@Model.CapturedQuantity(entry.ProductId)"
                                   class="form-control @(missing ? "is-invalid" : null)" data-cycle-quantity
                                   inputmode="@(entry.AllowsDecimals ? "decimal" : "numeric")" required autocomplete="off"
                                   placeholder="Cantidad física" aria-describedby="@(missing ? $"quantity-error-{index}" : null)" />
                            <span class="input-group-text">@entry.UnitCode</span>
                        </div>
                        @if (missing)
                        {
                            <div id="quantity-error-@index" class="invalid-feedback d-block">Captura la cantidad física, incluso si es cero.</div>
                        }
                    </div>
                </section>
            }
        </div>

        <fieldset class="operation-card" data-cycle-unexpected>
            <legend class="h5">Productos inesperados</legend>
            <p class="text-body-secondary">Escanea o escribe un SKU/código de barras y su cantidad.</p>
            @for (var index = 0; index < unexpectedRows; index++)
            {
                var unexpected = Model.UnexpectedEntry(index);
                <div class="row g-2 mb-2" data-cycle-unexpected-row>
                    <div class="col-sm-7">
                        <label class="visually-hidden" for="unexpected-code-@index">SKU o código inesperado @(index + 1)</label>
                        <input id="unexpected-code-@index" name="Input.UnexpectedEntries[@index].Code" value="@unexpected.Code" class="form-control" autocomplete="off" autocapitalize="characters" placeholder="SKU o código de barras inesperado" />
                    </div>
                    <div class="col-sm-3">
                        <label class="visually-hidden" for="unexpected-quantity-@index">Cantidad inesperada @(index + 1)</label>
                        <input id="unexpected-quantity-@index" name="Input.UnexpectedEntries[@index].Quantity" value="@unexpected.Quantity" class="form-control" inputmode="decimal" placeholder="Cantidad" />
                    </div>
                </div>
            }
        </fieldset>

        <section class="operation-card cycle-empty-location">
            <div class="form-check">
                <input asp-for="Input.IsLocationEmpty" class="form-check-input" data-cycle-empty-location />
                <label asp-for="Input.IsLocationEmpty" class="form-check-label">La ubicación está vacía</label>
            </div>
            <p class="text-body-secondary mb-0">
                Se registrará 0 en @(productCount == 1 ? "la línea" : $"las {productCount} líneas"). Puedes desmarcarlo antes de confirmar.
            </p>
        </section>

        <div class="operation-actions">
            <a asp-page="Details" asp-route-id="@Model.CampaignId" class="btn btn-outline-secondary btn-lg">Cancelar</a>
            <button type="button" class="btn btn-primary btn-lg flex-grow-1" data-cycle-review>Registrar conteo</button>
        </div>

        <div class="modal fade" id="confirm-cycle-count" tabindex="-1" aria-labelledby="confirm-cycle-count-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="confirm-cycle-count-title">Confirmar conteo</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="confirmation-summary mb-3" data-cycle-confirmation></div>
                        <label asp-for="Input.Pin" class="form-label fw-semibold">NIP del responsable</label>
                        <input asp-for="Input.Pin" value="" class="form-control form-control-lg pin-input"
                               type="password" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8"
                               autocomplete="off" data-cycle-pin />
                        <p class="small text-muted mt-2 mb-0">El NIP se usa solo para esta operación y no se conservará.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">Volver</button>
                        <button type="submit" class="btn btn-primary btn-lg" data-cycle-submit>Registrar conteo</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <button type="button" class="cycle-scan-fab" data-cycle-scan-product aria-label="Escanear producto">
        <svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg>
        <span>Escanear producto</span>
    </button>
    <input class="visually-hidden" data-cycle-scan-photo type="file" accept="image/*" capture="environment" />
</div>
@section Scripts { <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script><script src="~/js/cycle-count.js" asp-append-version="true"></script> }
