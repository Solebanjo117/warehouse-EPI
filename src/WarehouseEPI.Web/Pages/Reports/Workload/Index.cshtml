@page "/Reports/Workload"
@using WarehouseEPI.Core.Entities
@using WarehouseEPI.Infrastructure.Reporting
@model WarehouseEPI.Web.Pages.Reports.Workload.IndexModel
@{
    var isPending = Model.View == "pending";
    ViewData["Title"] = Model.IsAdmin
        ? (isPending ? "Pendientes" : "Resumen operativo · Equipo")
        : "Carga de trabajo";
}

<div class="workload-page">
    @if (Model.IsAdmin && !isPending)
    {
        @await Html.PartialAsync("/Pages/Reports/_AdminSummaryNavigation.cshtml", "team")
    }
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <span class="eyebrow">Centro de trabajo</span>
            @if (Model.IsAdmin && isPending)
            {
                <h1 class="h2 mb-1">Pendientes</h1>
                <p class="text-muted mb-0">Abre el trabajo pendiente en su módulo y atiéndelo con los controles operativos habituales.</p>
            }
            else if (Model.IsAdmin)
            {
                <h2 class="h3 mb-1">Equipo</h2>
                <p class="text-muted mb-0">Compara la actividad registrada por período, franja y responsable.</p>
            }
            else
            {
                <nav aria-label="breadcrumb"><ol class="breadcrumb mb-1"><li class="breadcrumb-item"><a asp-page="/Reports/Inventory/Index">Reportes</a></li><li class="breadcrumb-item active" aria-current="page">Carga de trabajo</li></ol></nav>
                <h1 class="h2 mb-1">Carga de trabajo</h1>
                <p class="text-muted mb-0">Consulta lo pendiente y revisa la actividad registrada sin cambiar operaciones desde esta pantalla.</p>
            }
        </div>
    </header>

    @if (!Model.IsAdmin)
    {
        <nav class="nav nav-pills workload-view-tabs mb-4" aria-label="Vistas de carga de trabajo">
            <a asp-page="Index" asp-route-view="pending" class="nav-link @(isPending ? "active" : null)" aria-current="@(isPending ? "page" : null)">Por atender</a>
            <a asp-page="Index" asp-route-view="activity" class="nav-link @(!isPending ? "active" : null)" aria-current="@(!isPending ? "page" : null)">Actividad realizada</a>
        </nav>
    }

    @if (isPending)
    {
        var queue = Model.Queue!;
        <section aria-labelledby="pending-heading">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <div><h2 id="pending-heading" class="h4 mb-1">Por atender</h2><p class="text-muted mb-0">Abre el trabajo en su módulo y confirma ahí con los controles operativos habituales.</p></div>
                <small class="text-muted">Actualizado @queue.GeneratedAtLocal.ToString("dd/MM/yyyy HH:mm")</small>
            </div>

            <form method="get" class="analytics-filter-card mb-4" role="search">
                <input type="hidden" name="view" value="pending" />
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-9"><label for="queue-search" class="form-label">Buscar trabajo pendiente</label><input id="queue-search" name="queueSearch" value="@Model.QueueSearch" class="form-control form-control-lg" type="search" autocomplete="off" placeholder="Orden, referencia, SKU, campaña o ubicación" /></div>
                    <div class="col-8 col-md-2"><button class="btn btn-primary btn-lg w-100">Buscar</button></div>
                    <div class="col-4 col-md-1"><a asp-page="Index" asp-route-view="pending" class="btn btn-outline-secondary btn-lg w-100" aria-label="Limpiar búsqueda">Limpiar</a></div>
                </div>
            </form>

            <div class="row g-3 mb-4" aria-label="Resumen de trabajo pendiente">
                <div class="col-6 col-lg-4"><a href="#pending-production" class="card workload-summary-card h-100 text-decoration-none"><div class="card-body"><span>Producción</span><strong>@queue.Production.TotalCount</strong><small>órdenes abiertas</small></div></a></div>
                <div class="col-6 col-lg-4"><a href="#pending-counts" class="card workload-summary-card h-100 text-decoration-none"><div class="card-body"><span>Conteos</span><strong>@queue.CycleCounts.TotalCount</strong><small>ubicaciones por atender</small></div></a></div>
                @if (queue.Exceptions is not null) { <div class="col-12 col-lg-4"><a href="#pending-exceptions" class="card workload-summary-card workload-summary-card-warning h-100 text-decoration-none"><div class="card-body"><span>Excepciones</span><strong>@queue.Exceptions.TotalCount</strong><small>casos ADMIN abiertos</small></div></a></div> }
            </div>

            <section id="pending-production" class="card workload-section mb-4" aria-labelledby="production-heading">
                <header class="card-header"><div><h3 id="production-heading" class="h5 mb-0">Producción</h3><small>@queue.Production.TotalCount órdenes liberadas, en progreso o pausadas</small></div><a asp-page="/Operations/Production/Index" class="btn btn-outline-primary btn-sm">Ver todas</a></header>
                <div class="card-body">
                    @if (queue.Production.Items.Count == 0) { <p class="workload-empty mb-0">@(queue.Search is null ? "No hay órdenes de producción por atender." : "No hay órdenes que coincidan con la búsqueda.")</p> }
                    else
                    {
                        <div class="workload-item-list">
                            @foreach (var item in queue.Production.Items)
                            {
                                <article class="workload-item"><div class="workload-item-main"><div class="d-flex flex-wrap gap-2 align-items-center mb-1"><span class="badge @ProductionStatusClass(item.Status)">@ProductionStatusLabel(item.Status)</span>@if (item.IsOverdue) { <span class="badge text-bg-danger">Vencida</span> } else if (item.IsDueToday) { <span class="badge text-bg-warning">Vence hoy</span> }</div><h4 class="h6 mb-1">@item.Number · @item.Sku</h4><p class="mb-1">@(item.Description ?? "Sin descripción")</p><small class="text-muted">Recibido @item.ReceivedQuantity.ToString("0.####") de @item.TargetQuantity.ToString("0.####") @item.UnitCode@if (item.DueDate is not null) { <text> · Compromiso @item.DueDate.Value.ToString("dd/MM/yyyy")</text> }@if (!string.IsNullOrWhiteSpace(item.ExternalReference)) { <text> · Ref. @item.ExternalReference</text> }</small></div><a href="@item.TargetUrl" class="btn btn-primary workload-primary-action">@item.ActionLabel</a></article>
                            }
                        </div>
                    }
                </div>
                @if (queue.Production.HasMore) { <footer class="card-footer"><a asp-page="/Operations/Production/Index">Ver las @queue.Production.TotalCount órdenes</a></footer> }
            </section>

            <section id="pending-counts" class="card workload-section mb-4" aria-labelledby="counts-heading">
                <header class="card-header"><div><h3 id="counts-heading" class="h5 mb-0">Conteos cíclicos</h3><small>@queue.CycleCounts.TotalCount ubicaciones requieren una acción</small></div><a asp-page="/Operations/CycleCounts/Index" class="btn btn-outline-primary btn-sm">Ver todos</a></header>
                <div class="card-body">
                    @if (queue.CycleCounts.Items.Count == 0) { <p class="workload-empty mb-0">@(queue.Search is null ? "No hay ubicaciones pendientes de conteo." : "No hay conteos que coincidan con la búsqueda.")</p> }
                    else
                    {
                        <div class="workload-item-list">
                            @foreach (var item in queue.CycleCounts.Items)
                            {
                                <article class="workload-item"><div class="workload-item-main"><div class="d-flex flex-wrap gap-2 align-items-center mb-1"><span class="badge @CountStatusClass(item.Status)">@CountStatusLabel(item.Status)</span><span class="text-muted small">@item.Folio</span></div><h4 class="h6 mb-1">@item.LocationCode</h4><p class="mb-0">@(item.LocationDescription ?? item.CampaignTitle ?? "Ubicación de campaña")</p>@if (!string.IsNullOrWhiteSpace(item.CampaignTitle) && item.CampaignTitle != item.LocationDescription) { <small class="text-muted">@item.CampaignTitle</small> }</div><a href="@item.TargetUrl" class="btn btn-primary workload-primary-action">@item.ActionLabel</a></article>
                            }
                        </div>
                    }
                </div>
                @if (queue.CycleCounts.HasMore) { <footer class="card-footer"><a asp-page="/Operations/CycleCounts/Index">Ver las @queue.CycleCounts.TotalCount ubicaciones pendientes</a></footer> }
            </section>

            @if (queue.Exceptions is not null)
            {
                <section id="pending-exceptions" class="card workload-section mb-4" aria-labelledby="exceptions-heading">
                    <header class="card-header"><div><h3 id="exceptions-heading" class="h5 mb-0">Excepciones</h3><small>@queue.Exceptions.TotalCount casos abiertos para seguimiento ADMIN</small></div><a asp-page="/Admin/Inventory/Alerts" class="btn btn-outline-primary btn-sm">Abrir Centro de excepciones</a></header>
                    <div class="card-body">
                        @if (queue.Exceptions.Items.Count == 0) { <p class="workload-empty mb-0">@(queue.Search is null ? "No hay excepciones abiertas." : "No hay excepciones que coincidan con la búsqueda.")</p> }
                        else
                        {
                            <div class="workload-item-list">
                                @foreach (var item in queue.Exceptions.Items)
                                {
                                    <article class="workload-item"><div class="workload-item-main"><div class="d-flex flex-wrap gap-2 align-items-center mb-1"><span class="badge @SeverityClass(item.Severity)">@SeverityLabel(item.Severity)</span><span class="badge text-bg-light border">@ExceptionStatusLabel(item.Status)</span></div><h4 class="h6 mb-1">@item.PrimaryText</h4><p class="mb-0">@item.SecondaryText</p>@if (!string.IsNullOrWhiteSpace(item.AssignedUserName)) { <small class="text-muted">Responsable: @item.AssignedUserName</small> }</div><a href="@item.TargetUrl" class="btn btn-primary workload-primary-action">@item.ActionLabel</a></article>
                                }
                            </div>
                        }
                    </div>
                    @if (queue.Exceptions.HasMore) { <footer class="card-footer"><a asp-page="/Admin/Inventory/Alerts">Ver los @queue.Exceptions.TotalCount casos</a></footer> }
                </section>
            }
        </section>
    }
    else
    {
        var report = Model.Report!;
        var summary = report.Summary;
        var totalPages = Math.Max(1, (int)Math.Ceiling((double)report.TotalCount / report.PageSize));
        <section aria-labelledby="activity-heading">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"><div><h2 id="activity-heading" class="h4 mb-1">Actividad realizada</h2><p class="text-muted mb-0">Movimientos efectivos registrados. Estos datos describen volumen operativo, no productividad ni horas trabajadas.</p></div>@if (Model.IsAdmin) { <div class="d-flex flex-wrap gap-2"><a asp-page="Index" asp-page-handler="Export" asp-route-format="excel" asp-route-view="activity" asp-route-period="@Model.Period" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-shift="@Model.Shift" asp-route-userId="@Model.UserId" asp-route-movementType="@Model.MovementType" asp-route-search="@Model.Search" class="btn btn-outline-secondary">Excel</a><a asp-page="Index" asp-page-handler="Export" asp-route-format="csv" asp-route-view="activity" asp-route-period="@Model.Period" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-shift="@Model.Shift" asp-route-userId="@Model.UserId" asp-route-movementType="@Model.MovementType" asp-route-search="@Model.Search" class="btn btn-outline-secondary">CSV</a></div> }</div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-lg-3"><div class="card workload-metric h-100"><div class="card-body"><span>Operaciones efectivas</span><strong>@summary.TotalOperations.ToString("N0")</strong><small>@report.PeriodLabel</small></div></div></div>
                <div class="col-6 col-lg-3"><div class="card workload-metric h-100"><div class="card-body"><span>Líneas procesadas</span><strong>@summary.TotalLines.ToString("N0")</strong><small>Detalles registrados</small></div></div></div>
                <div class="col-6 col-lg-3"><div class="card workload-metric h-100"><div class="card-body"><span>Responsables activos</span><strong>@summary.ActiveOperatorsCount</strong><small>Con actividad registrada</small></div></div></div>
                @if (Model.IsAdmin) { <div class="col-6 col-lg-3"><div class="card workload-metric h-100"><div class="card-body"><span>Más operaciones registradas</span><strong class="workload-metric-name">@(summary.TopOperatorName ?? "Sin actividad")</strong><small>@summary.TopOperatorOperations.ToString("N0") operaciones</small></div></div></div> }
            </div>

            <form method="get" class="analytics-filter-card mb-4">
                <input type="hidden" name="view" value="activity" />
                <div class="d-flex flex-wrap gap-2 mb-3" aria-label="Períodos rápidos">@foreach (var quick in new[] { ("today", "Hoy"), ("yesterday", "Ayer"), ("this-week", "Esta semana"), ("this-month", "Este mes"), ("last-month", "Mes pasado"), ("30", "30 días") }) { <a asp-page="Index" asp-route-view="activity" asp-route-period="@quick.Item1" aria-current="@(Model.Period == quick.Item1 ? "page" : null)" asp-route-shift="@Model.Shift" asp-route-userId="@Model.UserId" asp-route-movementType="@Model.MovementType" class="btn btn-sm @(Model.Period == quick.Item1 ? "btn-primary" : "btn-outline-secondary")">@quick.Item2</a> }</div>
                <input type="hidden" name="period" value="custom" />
                <div class="row g-3">
                    <div class="col-6 col-md-3"><label for="from" class="form-label">Desde</label><input id="from" name="from" type="date" class="form-control" value="@Model.From?.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-6 col-md-3"><label for="to" class="form-label">Hasta</label><input id="to" name="to" type="date" class="form-control" value="@Model.To?.ToString("yyyy-MM-dd")" /></div>
                    <div class="col-6 col-md-3"><label for="shift" class="form-label">Franja horaria</label><select id="shift" name="shift" class="form-select"><option value="all" selected="@(string.IsNullOrEmpty(Model.Shift) || Model.Shift == "all")">Día completo</option><option value="morning" selected="@(Model.Shift == "morning")">06:00 a 14:00</option><option value="afternoon" selected="@(Model.Shift == "afternoon")">14:00 a 22:00</option><option value="night" selected="@(Model.Shift == "night")">22:00 a 06:00</option></select></div>
                    <div class="col-6 col-md-3"><label for="movementType" class="form-label">Tipo de movimiento</label><select id="movementType" name="movementType" class="form-select"><option value="">Todos</option><option value="entry" selected="@(Model.MovementType == "entry")">Entrada</option><option value="exit" selected="@(Model.MovementType == "exit")">Salida</option><option value="transfer" selected="@(Model.MovementType == "transfer")">Transferencia</option><option value="adjustment" selected="@(Model.MovementType == "adjustment")">Ajuste</option></select></div>
                    @if (Model.IsAdmin) { <div class="col-12 col-md-6"><label for="userId" class="form-label">Responsable</label><select id="userId" name="userId" class="form-select"><option value="">Todos los responsables</option>@foreach (var user in Model.UserOptions) { <option value="@user.Value" selected="@user.Selected">@user.Text</option> }</select></div><div class="col-12 col-md-4"><label for="search" class="form-label">Buscar responsable</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div> }
                    <div class="col-12 col-md-2 d-flex align-items-end gap-2"><button class="btn btn-primary flex-grow-1">Aplicar</button><a asp-page="Index" asp-route-view="activity" class="btn btn-outline-secondary">Limpiar</a></div>
                </div>
            </form>

            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-4"><section class="card h-100"><div class="card-header"><h3 class="h6 mb-0">Por tipo</h3></div><div class="list-group list-group-flush">@if (report.MovementBreakdown.Count == 0) { <div class="list-group-item text-muted">Sin actividad</div> } else { @foreach (var item in report.MovementBreakdown) { <div class="list-group-item d-flex justify-content-between gap-3"><span>@item.Label</span><strong>@item.Operations op. · @item.Lines lín.</strong></div> } }</div></section></div>
                <div class="col-12 col-lg-4"><section class="card h-100"><div class="card-header"><h3 class="h6 mb-0">Por propósito</h3></div><div class="list-group list-group-flush workload-breakdown-list">@if (report.PurposeBreakdown.Count == 0) { <div class="list-group-item text-muted">Sin actividad</div> } else { @foreach (var item in report.PurposeBreakdown) { <div class="list-group-item d-flex justify-content-between gap-3"><span>@item.Label</span><strong>@item.Operations op.</strong></div> } }</div></section></div>
                <div class="col-12 col-lg-4"><section class="card h-100"><div class="card-header"><h3 class="h6 mb-0">Por franja horaria</h3></div><div class="list-group list-group-flush">@foreach (var item in report.TimeBandBreakdown) { <div class="list-group-item d-flex justify-content-between gap-3"><span>@item.Label</span><strong>@item.Operations op.</strong></div> }</div></section></div>
            </div>

            <section class="card mb-4"><div class="card-header"><h3 class="h6 mb-0">Actividad por día</h3></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Fecha local</th><th class="text-end">Operaciones</th><th class="text-end">Líneas</th></tr></thead><tbody>@if (report.DailyBreakdown.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">No hay actividad en el período.</td></tr> } else { @foreach (var day in report.DailyBreakdown) { <tr><td data-label="Fecha local">@day.Label</td><td data-label="Operaciones" class="text-end">@day.Operations</td><td data-label="Líneas" class="text-end">@day.Lines</td></tr> } }</tbody></table></div></section>

            @if (Model.IsAdmin)
            {
                <section class="card mb-4"><div class="card-header"><h3 class="h6 mb-1">Comparación por responsable</h3><small class="text-muted">Volumen registrado; no representa productividad ni tiempo trabajado.</small></div><div class="table-responsive"><table class="table table-hover align-middle mb-0 report-cards"><thead><tr><th>Responsable</th><th>Rol</th><th class="text-end">Operaciones</th><th class="text-end">Líneas</th><th class="text-end">Entradas</th><th class="text-end">Salidas</th><th class="text-end">Transferencias</th><th class="text-end">Ajustes</th><th>Registro de actividad</th></tr></thead><tbody>@if (report.Operators.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-5">No hay responsables con actividad en los filtros seleccionados.</td></tr> } else { @foreach (var op in report.Operators) { <tr><td data-label="Responsable"><strong>@op.FullName</strong></td><td data-label="Rol">@op.RoleName</td><td data-label="Operaciones" class="text-end">@op.TotalOperations</td><td data-label="Líneas" class="text-end">@op.TotalLines</td><td data-label="Entradas" class="text-end">@op.EntryOperations (@op.EntryLines lín.)</td><td data-label="Salidas" class="text-end">@op.ExitOperations (@op.ExitLines lín.)</td><td data-label="Transferencias" class="text-end">@op.TransferOperations (@op.TransferLines lín.)</td><td data-label="Ajustes" class="text-end">@op.AdjustmentOperations (@op.AdjustmentLines lín.)</td><td data-label="Registro de actividad" class="small">@if (op.FirstActivityLocal is not null) { <span>Primera operación: @op.FirstActivityLocal.Value.ToString("HH:mm")<br />Última operación: @op.LastActivityLocal!.Value.ToString("HH:mm")</span> } else { <span>—</span> }</td></tr> } }</tbody></table></div>
                    @if (totalPages > 1) { <div class="card-footer d-flex justify-content-between align-items-center"><span>Página @Model.PageNumber de @totalPages</span><div class="btn-group"><a asp-page="Index" asp-route-view="activity" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-period="@Model.Period" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-shift="@Model.Shift" asp-route-userId="@Model.UserId" asp-route-movementType="@Model.MovementType" asp-route-search="@Model.Search" class="btn btn-outline-secondary @(Model.PageNumber <= 1 ? "disabled" : null)">Anterior</a><a asp-page="Index" asp-route-view="activity" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-period="@Model.Period" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-shift="@Model.Shift" asp-route-userId="@Model.UserId" asp-route-movementType="@Model.MovementType" asp-route-search="@Model.Search" class="btn btn-outline-secondary @(Model.PageNumber >= totalPages ? "disabled" : null)">Siguiente</a></div></div> }
                </section>
            }
        </section>
    }
</div>

@section Styles { <link rel="stylesheet" href="~/css/workload-report.css" asp-append-version="true" /> }

@functions {
    static string ProductionStatusLabel(ProductionWorkOrderStatus status) => status switch { ProductionWorkOrderStatus.Released => "Liberada", ProductionWorkOrderStatus.InProgress => "En progreso", ProductionWorkOrderStatus.Paused => "Pausada", _ => status.ToString() };
    static string ProductionStatusClass(ProductionWorkOrderStatus status) => status switch { ProductionWorkOrderStatus.InProgress => "text-bg-info", ProductionWorkOrderStatus.Paused => "text-bg-secondary", _ => "text-bg-primary" };
    static string CountStatusLabel(CycleCountLocationStatus status) => status switch { CycleCountLocationStatus.Pending => "Pendiente", CycleCountLocationStatus.Counting => "En conteo", CycleCountLocationStatus.RecountRequested => "Reconteo solicitado", CycleCountLocationStatus.Stale => "Saldo cambió", CycleCountLocationStatus.UnderReview => "Requiere revisión", _ => status.ToString() };
    static string CountStatusClass(CycleCountLocationStatus status) => status switch { CycleCountLocationStatus.Stale => "text-bg-danger", CycleCountLocationStatus.UnderReview => "text-bg-warning", CycleCountLocationStatus.Counting => "text-bg-info", CycleCountLocationStatus.RecountRequested => "text-bg-primary", _ => "text-bg-secondary" };
    static string SeverityLabel(OperationalExceptionSeverity severity) => severity switch { OperationalExceptionSeverity.Critical => "Crítica", OperationalExceptionSeverity.Warning => "Advertencia", _ => "Informativa" };
    static string SeverityClass(OperationalExceptionSeverity severity) => severity switch { OperationalExceptionSeverity.Critical => "text-bg-danger", OperationalExceptionSeverity.Warning => "text-bg-warning", _ => "text-bg-info" };
    static string ExceptionStatusLabel(OperationalExceptionStatus status) => status switch { OperationalExceptionStatus.New => "Nueva", OperationalExceptionStatus.InProgress => "En atención", OperationalExceptionStatus.Waiting => "En espera", _ => "Resuelta" };
}
