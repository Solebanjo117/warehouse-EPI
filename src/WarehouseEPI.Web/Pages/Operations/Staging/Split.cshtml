@page
@model WarehouseEPI.Web.Pages.Operations.Staging.SplitModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@{ ViewData["Title"] = OpTexts["Dividir material"].Value; }
<header class="mb-3">
    <h1>@OpTexts["Dividir material"]</h1>
    <p>@Model.Arrival.Sku · @Model.Arrival.Description · STAGING</p>
    <p>@OpTexts["La división conserva el inventario y sustituye una placa por nuevos folios."]</p>
    <a asp-page="Index" asp-route-arrivalLineId="@Model.ArrivalLineId" class="btn btn-outline-secondary btn-lg">@OpTexts["Ver llegada en staging"]</a>
</header>
@if (!ViewData.ModelState.IsValid)
{ <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1"></div> }
@if (Model.NewPlates.Count > 0)
{
    <section class="card card-body mb-3" role="status">
        <h2 class="h5">@OpTexts["División registrada"]</h2>
        <p>@OpTexts["Retira la etiqueta original. Usa los nuevos folios para mover el material."]</p>
        @foreach (var id in Model.NewPlates)
        { <a asp-page="/Operations/PalletLabels/Tracking" asp-route-id="@id" class="btn btn-link btn-lg text-break">PLT-@id.ToString("N").ToUpperInvariant()</a> }
        <a asp-page="/Operations/PalletLabels/Index" asp-page-handler="StagingArrival" asp-route-arrivalLineId="@Model.ArrivalLineId" asp-fragment="label-preview" class="btn btn-primary btn-lg">@OpTexts["Imprimir placas"]</a>
    </section>
}
else if (Model.Arrival.NeedsIdentification || Model.Plates.Count == 0)
{
    <p class="alert alert-info">@OpTexts[Model.Arrival.NeedsIdentification ? "Requiere identificación" : "Esta llegada ya no tiene material pendiente en STAGING"]</p>
}
else
{
    <form method="get" class="mb-3">
        <input type="hidden" asp-for="ArrivalLineId" id="arrival-selector" />
        <label for="plate-selector" class="form-label">@OpTexts["Placa a dividir"]</label>
        <select asp-for="PlateId" id="plate-selector" class="form-select form-select-lg mb-2" required>
            <option value="">@OpTexts["Selecciona una placa"]</option>
            @foreach (var plate in Model.Plates)
            { <option value="@plate.PlateId">PLT-@plate.PlateId.ToString("N").ToUpperInvariant() · @plate.Quantity.ToString("0.####") @Model.Arrival.Unit</option> }
        </select>
        <button class="btn btn-outline-primary btn-lg">@OpTexts["Seleccionar / recargar"]</button>
    </form>
    @if (Model.Selected is { } selected)
    {
        <form method="post" class="card card-body" data-split-form>
            <input type="hidden" asp-for="ArrivalLineId" /><input type="hidden" asp-for="PlateId" />
            <input type="hidden" asp-for="OperationId" /><input type="hidden" asp-for="ArrivalVersion" /><input type="hidden" asp-for="ExpectedVersion" />
            <partial name="/Pages/Operations/_PalletDistribution.cshtml" model="@(new WarehouseEPI.Web.Pages.Operations.PalletDistributionEditor(Model.Distribution, false, selected.Quantity, Model.Arrival.Unit, Model.AllowsDecimals))" />
            <button type="button" class="btn btn-primary btn-lg mt-3" data-split-review>@OpTexts["Revisar división"]</button>
            <div class="modal fade" id="split-confirm" tabindex="-1" aria-labelledby="split-confirm-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                    <div class="modal-header"><h2 class="modal-title h5" id="split-confirm-title">@OpTexts["Confirmar división"]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@OpTexts["Cerrar"]"></button></div>
                    <div class="modal-body"><p data-split-summary></p><p>@OpTexts["Retira la etiqueta original. Usa los nuevos folios para mover el material."]</p>
                        <label asp-for="Pin" class="form-label">@OpTexts["NIP del responsable"]</label>
                        <input asp-for="Pin" value="" type="password" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" autocomplete="off" class="form-control form-control-lg" data-pin-input />
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">@OpTexts["Volver"]</button><button type="submit" class="btn btn-primary btn-lg">@OpTexts["Confirmar división"]</button></div>
                </div></div>
            </div>
        </form>
    }
}
@section Scripts { <script src="~/js/pallet-distribution.js" asp-append-version="true"></script> }
