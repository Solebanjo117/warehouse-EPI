@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionRecordReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>Fecha</th><th>Orden</th><th>Registro</th><th>Proceso / turno</th><th>Responsable</th><th class="text-end">Cantidades</th><th>Motivo</th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr class="@(!row.IsEffective ? "production-row-reversed" : null)"><td data-label="Fecha">@row.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td data-label="Orden"><a asp-page="/Admin/Production/Details" asp-route-id="@row.OrderId"><strong>@row.OrderNumber</strong></a></td><td data-label="Registro"><span class="badge @(!row.IsEffective ? "text-bg-secondary" : "text-bg-primary")">@row.Type</span>@if (!row.IsEffective) { <small>Revertido o reverso</small> }</td><td data-label="Proceso / turno">@(row.Stage ?? "General")<small>@(row.Shift ?? "Sin turno registrado")</small></td><td data-label="Responsable">@row.Responsible</td><td data-label="Cantidades" class="text-end">@row.Quantity.ToString("0.####")<small>Bueno @row.Good.ToString("0.####") · Retrabajo @row.Rework.ToString("0.####") · Merma @row.Scrap.ToString("0.####")</small></td><td data-label="Motivo">@(row.Reason ?? "—")</td></tr> }</tbody>
</table>
