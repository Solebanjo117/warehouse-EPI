@page
@model IndexModel
@{
    ViewData["Title"] = SharedTexts["Inicio"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
}

<div class="home-page">
    <header class="home-header">
        <span class="eyebrow">@SharedTexts["Operación de almacén"]</span>
        <h1 class="home-title">@SharedTexts["¿Qué necesitas hacer?"]</h1>
        <p>@SharedTexts["Selecciona una operación o abre una consulta del almacén."]</p>
    </header>

    <section aria-labelledby="home-operate-title">
        <h2 class="home-group-title" id="home-operate-title">@SharedTexts["Registrar operación"]</h2>
        <div class="home-actions home-actions-operate">
            <a asp-page="/Operations/Entry" class="home-action home-action-operate is-entry">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-entry" />
                </svg>
                <strong class="home-action-title">@SharedTexts["Entrada"]</strong>
                <span class="home-action-hint">@SharedTexts["Recibir material"]</span>
            </a>
            <a asp-page="/Operations/Exit" class="home-action home-action-operate is-exit">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-exit" />
                </svg>
                <strong class="home-action-title">@SharedTexts["Salida"]</strong>
                <span class="home-action-hint">@SharedTexts["General o surtir WIP"]</span>
            </a>
            <a asp-page="/Operations/WipProcess" class="home-action home-action-operate is-transfer">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-movements" />
                </svg>
                <strong class="home-action-title">@SharedTexts["Procesar WIP"]</strong>
                <span class="home-action-hint">@SharedTexts["Consumo, bodega o proveedor"]</span>
            </a>
            <a asp-page="/Operations/Transfer" class="home-action home-action-operate is-transfer">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-transfer" />
                </svg>
                <strong class="home-action-title">@SharedTexts["Transferencia"]</strong>
                <span class="home-action-hint">@SharedTexts["Mover entre ubicaciones"]</span>
            </a>
            <a asp-page="/Operations/Adjustment" class="home-action home-action-operate is-adjust">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-adjust" />
                </svg>
                <strong class="home-action-title">@SharedTexts["Ajuste"]</strong>
                <span class="home-action-hint">@SharedTexts["Registrar conteo físico"]</span>
            </a>
        </div>
        <div class="home-nip">
            <span class="home-nip-mark">@SharedTexts["NIP"]</span>
            <p>@SharedTexts["El NIP se solicitará únicamente al confirmar."]</p>
        </div>
    </section>

    <section aria-labelledby="home-consult-title">
        <h2 class="home-group-title" id="home-consult-title">@SharedTexts["Consultar y controlar"]</h2>
        <div class="home-actions home-actions-consult">
            <a asp-page="/Operations/CycleCounts/Index" class="home-action home-action-consult">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-product-classes" />
                </svg>
                <span class="home-action-text">
                    <strong class="home-action-title">@SharedTexts["Conteos cíclicos"]</strong>
                    <span class="home-action-hint">@SharedTexts["Conteo ciego por ubicación"]</span>
                </span>
            </a>
            <a asp-page="/Inventory/Index" class="home-action home-action-consult">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-inventory" />
                </svg>
                <span class="home-action-text">
                    <strong class="home-action-title">@SharedTexts["Consultar"]</strong>
                    <span class="home-action-hint">@SharedTexts["Ver existencias"]</span>
                </span>
            </a>
            <a asp-page="/Reports/Wip/Index" class="home-action home-action-consult">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-movements" />
                </svg>
                <span class="home-action-text">
                    <strong class="home-action-title">@SharedTexts["Reporte WIP"]</strong>
                    <span class="home-action-hint">@SharedTexts["Existencias y actividad"]</span>
                </span>
            </a>
            <a asp-page="/Reports/Dashboard/Index" class="home-action home-action-consult">
                <svg class="home-action-icon" aria-hidden="true">
                    <use href="#icon-dashboard" />
                </svg>
                <span class="home-action-text">
                    <strong class="home-action-title">@SharedTexts["Tablero diario"]</strong>
                    <span class="home-action-hint">@SharedTexts["Actividad y alertas del día"]</span>
                </span>
            </a>
        </div>
    </section>
</div>
