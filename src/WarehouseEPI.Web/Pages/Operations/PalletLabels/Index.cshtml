@page "/Operations/PalletLabels"
@model WarehouseEPI.Web.Pages.Operations.PalletLabels.IndexModel
@using WarehouseEPI.Infrastructure.Labels
@{ ViewData["Title"] = "Placas de pallet"; }
@if (Model.Preview is not null) { <style>@Html.Raw($"@@page {{ size: {Model.Preview.Size.WidthInches.ToString(System.Globalization.CultureInfo.InvariantCulture)}in {Model.Preview.Size.HeightInches.ToString(System.Globalization.CultureInfo.InvariantCulture)}in; margin: 0; }}")</style> }
<div class="label-workspace pallet-label-workspace">
    <header class="label-page-header no-label-print"><div><span class="label-eyebrow">Entrada confirmada</span><h1 class="h2 mb-1">Placas de pallet</h1><p class="text-body-secondary mb-0">Busca una Entrada para generar su placa documental. No cambia inventario.</p></div></header>
    <form method="get" class="label-template-picker no-label-print"><label for="pallet-folio" class="form-label fw-bold">Folio de Entrada o placa</label><div class="input-group input-group-lg"><input id="pallet-folio" name="folio" class="form-control" value="@Model.Entry?.Identifier" autocomplete="off" placeholder="PLT-UUID o UUID de Entrada" autofocus/><button class="btn btn-outline-primary" type="submit">Buscar</button></div><div class="form-text">Acepta el UUID de la Entrada o el folio visible PLT.</div></form>
    @if(Model.SearchError is not null){<div class="alert alert-warning no-label-print mt-3" role="alert">@Model.SearchError</div>}
    <div asp-validation-summary="ModelOnly" class="alert alert-danger no-label-print mt-3" role="alert"></div>
    @if(Model.Entry is not null){
        <section class="operation-card no-label-print mt-3"><div class="receipt-meta"><div><span>Placa</span><strong>@Model.Entry.Identifier</strong></div><div><span>Producto</span><strong>@Model.Entry.Sku</strong></div><div><span>Cantidad</span><strong>@Model.Entry.Quantity.ToString("0.####") @Model.Entry.UnitCode</strong></div><div><span>Destino</span><strong>@(Model.Entry.Destination ?? "—")</strong></div><div><span>Fecha de Entrada</span><strong>@(Model.EntryLocalTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</strong></div><div><span>Responsable</span><strong>@Model.Entry.Responsible</strong></div><div><span>Referencia</span><strong>@(string.IsNullOrWhiteSpace(Model.Entry.Reference) ? "—" : Model.Entry.Reference)</strong></div><div><span>Referencia externa</span><strong>@(string.IsNullOrWhiteSpace(Model.Entry.ExternalReference) ? "—" : Model.Entry.ExternalReference)</strong></div></div>@if(Model.Entry.Description is not null){<p class="text-body-secondary mb-0 mt-2">@Model.Entry.Description</p>}</section>
        <form method="post" class="label-create-grid no-label-print mt-3"><input asp-for="Input.MovementId" type="hidden"/><section class="label-form-card"><div class="label-section-heading"><span class="label-step-number">1</span><div><h2 class="h5 mb-1">Datos de impresión</h2><p class="text-body-secondary mb-0">El peso es opcional y no se almacena.</p></div></div><div class="row g-3"><div class="col-sm-7"><label asp-for="Input.Weight" class="form-label">Peso</label><input asp-for="Input.Weight" class="form-control form-control-lg" maxlength="40" autocomplete="off" placeholder="Ej. 1,250 LB"/><span asp-validation-for="Input.Weight" class="text-danger"></span></div><div class="col-sm-5"><label asp-for="Input.Copies" class="form-label">Copias idénticas</label><input asp-for="Input.Copies" class="form-control form-control-lg" type="number" min="1" max="100" required/><span asp-validation-for="Input.Copies" class="text-danger"></span></div></div></section><section class="label-form-card label-submit-card"><div class="label-section-heading"><span class="label-step-number">2</span><div><h2 class="h5 mb-1">Previsualizar</h2><p class="text-body-secondary mb-0">Received se deriva de la Entrada; Counted y Removed se completan a mano.</p></div></div><button type="submit" class="btn btn-primary btn-lg">Generar placa</button></section></form>
    }
    @if(Model.Preview is null){
        <section class="operation-card no-label-print mt-3" aria-labelledby="pallet-recent-title"><div class="label-section-heading"><div><h2 id="pallet-recent-title" class="h5 mb-1">Entradas recientes</h2><p class="text-body-secondary mb-0">Últimas Entradas elegibles para placa. Toca una para cargarla sin teclear el folio.</p></div></div>
        @if(Model.Recent.Count == 0){<p class="text-body-secondary mb-0">Todavía no hay Entradas estándar de una sola línea. Registra una Entrada y aparecerá aquí.</p>}
        else{<ul class="pallet-recent-list">@foreach(var row in Model.Recent){<li><a class="pallet-recent-item @(Model.Entry?.MovementId == row.Candidate.MovementId ? "is-active" : null)" asp-page="/Operations/PalletLabels/Index" asp-route-id="@row.Candidate.MovementId"><span class="pallet-recent-head"><strong class="pallet-recent-sku">@row.Candidate.Sku</strong><span class="pallet-recent-qty">@row.Candidate.Quantity.ToString("0.####") @row.Candidate.UnitCode</span></span>@if(!string.IsNullOrWhiteSpace(row.Candidate.Description)){<span class="pallet-recent-desc">@row.Candidate.Description</span>}<span class="pallet-recent-meta">@row.LocalTime.ToString("dd/MM HH:mm") · @(row.Candidate.Destination ?? "—") · @row.Candidate.Responsible@(string.IsNullOrWhiteSpace(row.Candidate.Reference) ? null : $" · {row.Candidate.Reference}")</span></a></li>}</ul>}
        </section>
    }
    @if(Model.Preview is not null){<section class="label-preview-section"><header class="label-preview-toolbar no-label-print"><div><span class="label-eyebrow">@Model.Preview.TemplateCode · v@Model.Preview.TemplateVersion · @Model.Preview.Copies copia(s)</span><h2 class="h4 mb-1">Lista para imprimir</h2><p class="text-body-secondary mb-0">Selecciona Carta horizontal, escala 100 %, sin encabezados/pies y una sola copia.</p></div><button type="button" class="btn btn-primary btn-lg" data-label-print>Imprimir placas</button></header>@if(Model.PrintWarnings.Count>0){<div class="alert alert-warning no-label-print mt-3 mb-0" role="alert"><strong>Revisa la lectura del código</strong><ul class="mb-0">@foreach(var warning in Model.PrintWarnings){<li>@warning</li>}</ul></div>}<div class="label-print-pages" data-label-print-pages>@for(var copy=1;copy<=Model.Preview.Copies;copy++){<article class="label-dynamic" data-label-copy="@copy" aria-label="Placa @copy de @Model.Preview.Copies" style="--label-width:@(Model.Preview.Size.WidthInches.ToString(System.Globalization.CultureInfo.InvariantCulture))in;--label-height:@(Model.Preview.Size.HeightInches.ToString(System.Globalization.CultureInfo.InvariantCulture))in">@foreach(var item in Model.Preview.Elements){var e=item.Definition;var left=e.X*100m/Model.Preview.Size.WidthMils;var top=e.Y*100m/Model.Preview.Size.HeightMils;var width=e.Width*100m/Model.Preview.Size.WidthMils;var height=e.Height*100m/Model.Preview.Size.HeightMils;<div class="label-element label-element-@e.Type.ToString().ToLowerInvariant() @(e.BlankLine&&string.IsNullOrEmpty(item.Text)?"is-blank-line":null)" style="left:@(left.ToString(System.Globalization.CultureInfo.InvariantCulture))%;top:@(top.ToString(System.Globalization.CultureInfo.InvariantCulture))%;width:@(width.ToString(System.Globalization.CultureInfo.InvariantCulture))%;height:@(height.ToString(System.Globalization.CultureInfo.InvariantCulture))%;transform:rotate(@(e.Rotation)deg);z-index:@e.ZIndex;font-family:'@e.FontFamily';font-size:@(e.FontSize)pt;font-weight:@(e.Bold?700:400);color:@e.Color;background-color:@(e.Type==LabelElementType.Rectangle?e.BackgroundColor:"transparent");border-width:@(e.Type==LabelElementType.Rectangle?e.BorderWidth:0)px;text-align:@e.Align;@(item.Barcode is null?null:$"--barcode-print-width:{item.Barcode.PrintWidthInches.ToString(System.Globalization.CultureInfo.InvariantCulture)}in")">@if(item.Barcode is not null){@Html.Raw(item.Barcode.Markup)<button type="button" class="label-barcode-zoom-trigger no-label-print" data-label-barcode-zoom data-barcode-modules="@item.Barcode.ModuleCount" data-barcode-value="@item.Barcode.Payload" aria-label="Ampliar para escanear código @item.Barcode.Payload">Ampliar</button>}else if(item.ImageUrl is not null){<img src="@item.ImageUrl" alt="Extra Packaging, LLC"/>}else if(e.Type==LabelElementType.Line){<span class="label-line"></span>}else{@item.Text}</div>}</article>}</div><dialog class="label-barcode-dialog" data-label-barcode-dialog aria-labelledby="label-barcode-dialog-title"><div class="label-barcode-dialog-header"><div><h2 id="label-barcode-dialog-title" class="h5 mb-1">Código ampliado para escanear</h2><p class="mb-0 text-body-secondary label-barcode-value" data-label-barcode-value></p></div><button type="button" class="btn-close" data-label-barcode-close aria-label="Cerrar"></button></div><div class="label-barcode-dialog-body"><div class="label-barcode-scan-viewport"><div class="label-barcode-scan-canvas" data-label-barcode-canvas></div></div></div></dialog></section>}
</div>
@section Styles { <link rel="stylesheet" href="~/css/label-4x6.css" asp-append-version="true"/> }
@section Scripts { <script src="~/js/label-4x6.js" asp-append-version="true"></script> }
