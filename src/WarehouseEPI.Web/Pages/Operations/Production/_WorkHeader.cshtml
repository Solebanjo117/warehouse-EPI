@model WarehouseEPI.Web.Pages.Operations.Production.WorkModel
@using WarehouseEPI.Core.Entities
@{var o=Model.Order;}
    <header class="mb-3"><a asp-page="Index">← Órdenes de producción</a><h1 class="h3 mt-2">@o.Number · @o.Sku</h1><p class="mb-1">@o.Description · @WarehouseEPI.Infrastructure.Production.ProductionStateLabels.Label(o.Status)</p><p>Recibido @o.WarehouseReceived.ToString("0.####") de @o.TargetQuantity.ToString("0.####") @o.Unit · Fecha requerida @(o.DueDate?.ToString("dd/MM/yyyy")??"Sin fecha") · Lote @(Model.Batches.FirstOrDefault(x=>x.Id==Model.BatchId)?.Number??"Sin seleccionar")</p></header>
    @if(o.Status==ProductionWorkOrderStatus.Paused){<p class="alert alert-warning">Orden pausada. Solicita reanudar con NIP ADMIN antes de continuar la fabricación.</p>}
    @if(o.UsesBatchTraceability&&Model.Batches.Count>1&&Model.BatchId is null){<p class="alert alert-info">Orden histórica con varios lotes. Selecciona uno para capturar.</p><div class="d-flex flex-wrap gap-2">@foreach(var batch in Model.Batches){<a class="btn btn-outline-primary" asp-route-id="@o.Id" asp-route-BatchId="@batch.Id">@batch.Number</a>}</div>}
    @if(Model.PlanningView.Blockers.Count>0&&o.Status==ProductionWorkOrderStatus.Draft){<div class="alert alert-warning"><strong>Antes de liberar</strong><ul>@foreach(var blocker in Model.PlanningView.Blockers){<li>@blocker</li>}</ul></div>}
