@page
@model WarehouseEPI.Web.Pages.Operations.Production.IndexModel
@{ViewData["Title"]="Producción";}
<div class="container-fluid py-3 production-page"><header class="mb-4"><span class="eyebrow">Operación</span><h1 class="h2 mb-1">Producción</h1><p class="text-muted">Escanea o busca una orden para registrar avance, entrega o recepción.</p></header>
<form method="get" class="row g-2 mb-4"><div class="col-12 col-md-7"><label for="production-search" class="form-label">Folio, referencia o SKU</label><input id="production-search" name="Search" value="@Model.Search" class="form-control form-control-lg" type="search" autocomplete="off" autocapitalize="characters" autofocus/></div><div class="col-8 col-md-3"><label asp-for="Status" class="form-label">Estado</label><select asp-for="Status" class="form-select form-select-lg"><option value="">Activas y cerradas</option>@foreach(var s in Enum.GetValues<WarehouseEPI.Core.Entities.ProductionWorkOrderStatus>()){<option value="@s">@s</option>}</select></div><div class="col-4 col-md-2 d-flex align-items-end"><button class="btn btn-primary btn-lg w-100">Buscar</button></div></form>
@if(Model.Items.Count==0){<div class="alert alert-info">No hay órdenes con esos filtros. Revisa el folio o solicita que ADMIN libere la orden.</div>}else{<div class="row g-3">@foreach(var x in Model.Items){<div class="col-12 col-lg-6"><article class="card h-100"><div class="card-body d-flex justify-content-between gap-3"><div><span class="badge text-bg-secondary">@x.Status</span><h2 class="h5 mt-2 mb-1">@x.Number</h2><strong>@x.Sku</strong> <span>@x.Description</span><p class="mb-0 mt-2">Recibido: <strong>@x.Received.ToString("0.####") de @x.Target.ToString("0.####") @x.Unit</strong></p></div><div><a asp-page="Work" asp-route-id="@x.Id" class="btn btn-primary">Trabajar</a></div></div></article></div>}</div>}</div>
