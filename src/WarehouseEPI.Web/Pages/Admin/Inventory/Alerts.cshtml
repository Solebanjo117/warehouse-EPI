@page
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Admin.Inventory.AlertsModel
@{ ViewData["Title"] = "Centro de excepciones"; }

<div class="alerts-workspace">
    <header class="inventory-page-header d-flex flex-wrap justify-content-between gap-3 align-items-start"><div><span class="eyebrow">Prioridad operativa</span><h1 class="h2 mb-1">Centro de excepciones</h1><p class="text-muted mb-0">Casos derivados de condiciones reales. El seguimiento no modifica inventario.</p></div><div class="d-flex gap-2"><a asp-page="/Admin/Inventory/Movements/Index" class="btn btn-outline-secondary">Movimientos</a><form method="post" asp-page-handler="Refresh"><input type="hidden" name="status" value="@Model.Status"/><input type="hidden" name="category" value="@Model.Category"/><input type="hidden" name="severity" value="@Model.Severity"/><input type="hidden" name="assignedUserId" value="@Model.AssignedUserId"/><input type="hidden" name="search" value="@Model.Search"/><button class="btn btn-primary">Actualizar condiciones</button></form></div></header>
    @if(Model.StatusMessage is not null){<div class="alert alert-success mt-3" role="status">@Model.StatusMessage</div>}@if(Model.ErrorMessage is not null){<div class="alert alert-danger mt-3" role="alert">@Model.ErrorMessage</div>}
    <section class="alert-metrics" aria-label="Resumen de casos abiertos"><article><span aria-hidden="true">N</span><strong>@Model.ExceptionPage.NewCount</strong><small>Nuevas</small></article><article class="is-warning"><span aria-hidden="true">→</span><strong>@Model.ExceptionPage.InProgressCount</strong><small>En atención</small></article><article><span aria-hidden="true">…</span><strong>@Model.ExceptionPage.WaitingCount</strong><small>En espera</small></article><article class="is-danger"><span aria-hidden="true">!</span><strong>@Model.ExceptionPage.CriticalCount</strong><small>Críticas abiertas</small></article></section>
    <form method="get" class="analytics-filter-card mt-3"><div class="row g-2"><div class="col-md-3"><label class="form-label" for="exception-status">Estado</label><select id="exception-status" name="status" class="form-select"><option value="">Todos</option>@foreach(var value in Enum.GetValues<OperationalExceptionStatus>()){<option value="@value" selected="@(Model.Status==value)">@StatusLabel(value)</option>}</select></div><div class="col-md-3"><label class="form-label" for="exception-category">Categoría</label><select id="exception-category" name="category" class="form-select"><option value="">Todas</option>@foreach(var value in Enum.GetValues<OperationalExceptionCategory>()){<option value="@value" selected="@(Model.Category==value)">@CategoryLabel(value)</option>}</select></div><div class="col-md-2"><label class="form-label" for="exception-severity">Prioridad</label><select id="exception-severity" name="severity" class="form-select"><option value="">Todas</option>@foreach(var value in Enum.GetValues<OperationalExceptionSeverity>()){<option value="@value" selected="@(Model.Severity==value)">@SeverityLabel(value)</option>}</select></div><div class="col-md-2"><label class="form-label" for="exception-owner">Responsable</label><select id="exception-owner" name="assignedUserId" class="form-select"><option value="">Todos</option>@foreach(var user in Model.Assignees){<option value="@user.Id" selected="@(Model.AssignedUserId==user.Id)">@user.FullName</option>}</select></div><div class="col-md-2"><label class="form-label" for="exception-search">Buscar</label><input id="exception-search" name="search" value="@Model.Search" class="form-control" placeholder="SKU, ubicación o CC"/></div></div><button class="btn btn-outline-primary mt-3">Filtrar</button></form>
    @if(Model.ExceptionPage.Items.Count==0){<div class="inventory-empty mt-3"><strong>No hay casos para estos filtros.</strong><span>La actualización crea los casos a partir de las condiciones vigentes.</span></div>}
    else{<section class="alert-list mt-3" aria-label="Casos de excepción">@foreach(var item in Model.ExceptionPage.Items){<article class="alert-row @(item.Severity==OperationalExceptionSeverity.Critical ? "is-negative" : "is-minimum")"><div><span class="inventory-card-label">@CategoryLabel(item.Category) · @SeverityLabel(item.Severity)</span><strong>@item.PrimaryText</strong><small>@item.SecondaryText</small></div><div><span class="inventory-card-label">Estado</span><strong>@StatusLabel(item.Status)</strong><small>@(item.AssignedUserName is null ? "Sin responsable" : item.AssignedUserName)</small></div><div><span class="inventory-card-label">Valor</span><strong>@(item.ValueText ?? "Requiere atención")</strong><small>Desde @item.FirstDetectedAt.ToString("dd/MM/yyyy HH:mm")</small></div><div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-page="Alerts/Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Seguimiento</a><a href="@item.TargetUrl" class="btn btn-outline-primary">Actuar</a></div></article>}</section>}
    @if(Model.TotalPages>1){<nav class="mt-4" aria-label="Paginación de excepciones"><ul class="pagination justify-content-center"><li class="page-item @(Model.ExceptionPage.PageNumber<=1?"disabled":null)"><a class="page-link" asp-route-status="@Model.Status" asp-route-category="@Model.Category" asp-route-severity="@Model.Severity" asp-route-assignedUserId="@Model.AssignedUserId" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.ExceptionPage.PageNumber-1)">Anterior</a></li><li class="page-item disabled"><span class="page-link">@Model.ExceptionPage.PageNumber de @Model.TotalPages</span></li><li class="page-item @(Model.ExceptionPage.PageNumber>=Model.TotalPages?"disabled":null)"><a class="page-link" asp-route-status="@Model.Status" asp-route-category="@Model.Category" asp-route-severity="@Model.Severity" asp-route-assignedUserId="@Model.AssignedUserId" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.ExceptionPage.PageNumber+1)">Siguiente</a></li></ul></nav>}
</div>

@functions { static string StatusLabel(OperationalExceptionStatus value) => value switch { OperationalExceptionStatus.New => "Nueva", OperationalExceptionStatus.InProgress => "En atención", OperationalExceptionStatus.Waiting => "En espera", _ => "Resuelta" }; static string SeverityLabel(OperationalExceptionSeverity value) => value switch { OperationalExceptionSeverity.Critical => "Crítica", OperationalExceptionSeverity.Warning => "Advertencia", _ => "Informativa" }; static string CategoryLabel(OperationalExceptionCategory value) => value switch { OperationalExceptionCategory.NegativeInventory => "Saldo negativo", OperationalExceptionCategory.BelowMinimum => "Bajo mínimo", OperationalExceptionCategory.UnassignedBalance => "Sin asignación", OperationalExceptionCategory.RestrictedInventory => "Restringido", OperationalExceptionCategory.StagnantInventory => "Estancado", OperationalExceptionCategory.CycleCountStale => "Conteo obsoleto", OperationalExceptionCategory.CycleCountPending => "Conteo pendiente", _ => "WIP estancado" }; }
