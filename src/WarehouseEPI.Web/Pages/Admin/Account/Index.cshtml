@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Account.IndexModel
@{ ViewData["Title"] = CatTexts["Mi cuenta"].Value; }
<div class="row justify-content-center"><div class="col-12 col-lg-7"><h1 class="h2 mb-4">@CatTexts["Mi cuenta"]</h1>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<form method="post" class="card shadow-sm"><div class="card-body p-4"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Input.FullName" class="form-label">@CatTexts["Nombre completo"]</label><input asp-for="Input.FullName" class="form-control form-control-lg" autocomplete="name" autofocus /><span asp-validation-for="Input.FullName" class="text-danger"></span></div>
<h2 class="h5 mt-4">@CatTexts["Cambiar NIP"]</h2><p class="text-muted small">@CatTexts["Déjalo vacío para conservarlo. Para cambiarlo confirma primero el NIP actual."]</p>
<div class="mb-3"><label asp-for="Input.CurrentPin" class="form-label">@CatTexts["NIP actual"]</label><input asp-for="Input.CurrentPin" class="form-control form-control-lg" inputmode="numeric" autocomplete="current-password" /><span asp-validation-for="Input.CurrentPin" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.NewPin" class="form-label">@CatTexts["Nuevo NIP"]</label><input asp-for="Input.NewPin" class="form-control form-control-lg" inputmode="numeric" autocomplete="new-password" /><span asp-validation-for="Input.NewPin" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Input.ConfirmPin" class="form-label">@CatTexts["Confirmar NIP"]</label><input asp-for="Input.ConfirmPin" class="form-control form-control-lg" inputmode="numeric" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPin" class="text-danger"></span></div></div>
<button class="btn btn-primary btn-lg">@CatTexts["Guardar cambios"]</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
