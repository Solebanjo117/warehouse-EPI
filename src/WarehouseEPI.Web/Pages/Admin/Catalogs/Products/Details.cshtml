@page "{id:guid}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.DetailsModel
@{
    ViewData["Title"] = CatTexts["Ficha de producto"].Value;
    var product = Model.Product;
    var coverage = product.Minimum > 0 ? product.Quantity / product.Minimum * 100 : (decimal?)null;
    var belowMinimum = product.Quantity < product.Minimum;
}
@section Styles {
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
}

<div class="product-sheet">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    <header class="product-sheet-header">
        <div class="product-sheet-identity">
            <div class="product-sheet-context">
                <a asp-page="Index" class="product-sheet-back">@CatTexts["← Volver a productos"]</a>
                <span class="product-sheet-status @(product.IsActive ? "is-active" : "")">@(product.IsActive ? CatTexts["Activo"].Value : CatTexts["Inactivo"].Value)</span>
            </div>
            <p class="product-sheet-eyebrow">@CatTexts["Ficha de producto"]</p>
            <h1>@product.Sku</h1>
            <p class="product-sheet-description">@(product.Description ?? CatTexts["Sin descripción"].Value)</p>
        </div>
        <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-primary product-sheet-edit">@CatTexts["Editar producto"]</a>
    </header>

    <section class="product-sheet-metrics" aria-label="@CatTexts["Resumen de inventario"]">
        <div class="product-sheet-metric product-sheet-metric-primary">
            <span>@CatTexts["Existencia actual"]</span>
            <strong class="@(product.Quantity < 0 ? "text-danger" : "")">@product.Quantity.ToString("0.####") <small>@product.Unit</small>
</strong>
            <a asp-page="/Inventory/Index" asp-route-productId="@product.Id">@CatTexts["Consultar existencias →"]</a>
        </div>
        <div class="product-sheet-metric">
            <span>@CatTexts["Mínimo de inventario"]</span>
            <strong>@product.Minimum.ToString("0.####") <small>@product.Unit</small>
</strong>
            <p class="@(belowMinimum ? "text-danger" : "")">Diferencia: @((product.Quantity - product.Minimum).ToString("0.####")) @product.Unit</p>
        </div>
        <div class="product-sheet-metric">
            <span>@CatTexts["Cobertura del mínimo"]</span>
            <strong>@(coverage is null ? CatTexts["No aplica"].Value : $"{coverage:0.#}%")</strong>
            <p>@(coverage is null ? CatTexts["Sin mínimo configurado"].Value : belowMinimum ? CatTexts["Por debajo del mínimo"].Value : CatTexts["Mínimo cubierto"].Value)</p>
        </div>
        <div class="product-sheet-metric">
            <span>@CatTexts["Ubicaciones con saldo"]</span>
            <strong>@product.LocationsWithBalance</strong>
            <p class="@(product.NegativePositions > 0 ? "text-danger" : "")">@CatTexts["{0} con saldo negativo", product.NegativePositions]</p>
        </div>
    </section>

    @if (product.Quantity < 0 || belowMinimum || product.NegativePositions > 0)
    {
        <div class="product-sheet-attention" role="status">
            <svg class="app-icon" aria-hidden="true">
<use href="#icon-alert" />
</svg>
            <div>
                <strong>@CatTexts["Inventario que requiere atención"]</strong>
                <span>@(product.Quantity < 0 ? CatTexts["La existencia total es negativa."].Value : belowMinimum ? CatTexts["La existencia está por debajo del mínimo."].Value : CatTexts["Hay ubicaciones con saldo negativo."].Value) Revisa la distribución y los movimientos del producto.</span>
            </div>
            <a href="#product-locations">@CatTexts["Revisar ubicaciones →"]</a>
        </div>
    }

    <nav class="product-sheet-nav" aria-label="@CatTexts["Secciones de la ficha"]">
        <a href="#product-summary">@CatTexts["Resumen"]</a>
        <a href="#product-locations">@CatTexts["Ubicaciones"]</a>
        <a href="#product-production-summary">@CatTexts["Producción"]</a>
        <a href="#product-lots">@CatTexts["Lotes"]</a>
        <a href="#product-movements">@CatTexts["Movimientos"]</a>
    </nav>

    <section id="product-summary" class="card product-sheet-panel" aria-labelledby="product-summary-heading">
        <div class="card-body">
            <div class="product-sheet-section-heading">
                <div>
<span class="product-sheet-eyebrow">@CatTexts["Identificación"]</span>
<h2 id="product-summary-heading">@CatTexts["Datos generales"]</h2>
</div>
                <svg class="app-icon" aria-hidden="true">
<use href="#icon-inventory" />
</svg>
            </div>
            <dl class="product-sheet-facts">
                <div>
<dt>@CatTexts["Referencia"]</dt>
<dd>@(product.Reference ?? CatTexts["Sin referencia"].Value)</dd>
</div>
                <div>
<dt>@CatTexts["Unidad de medida"]</dt>
<dd>@product.Unit</dd>
</div>
                <div>
<dt>@CatTexts["Tipo"]</dt>
<dd>@(product.Type ?? CatTexts["Sin tipo"].Value)</dd>
</div>
                <div>
<dt>@CatTexts["Clase"]</dt>
<dd>@(product.Class ?? CatTexts["Sin clase"].Value)</dd>
</div>
            </dl>
        </div>
    </section>
<section id="product-locations" class="card product-sheet-panel" aria-labelledby="product-locations-heading">
<div class="card-body">
<div class="product-sheet-section-heading">
<div>
<span class="product-sheet-eyebrow">@CatTexts["Inventario"]</span>
<h2 id="product-locations-heading">@CatTexts["Distribución por ubicación"]</h2>
</div>
<a asp-page="/Admin/Catalogs/Locations/Index" asp-route-search="@Model.Product.Sku" class="product-sheet-section-link">@CatTexts["Croquis y ubicaciones →"]</a>
</div>
<div class="table-responsive">
<table class="table align-middle mb-0">
<thead>
<tr>
<th>@CatTexts["Ubicación"]</th>
<th>@CatTexts["Relación"]</th>
<th>@CatTexts["Estado"]</th>
<th class="text-end">@CatTexts["Saldo"]</th>
</tr>
</thead>
<tbody>@if(Model.Product.Locations.Count == 0){<tr>
<td colspan="4" class="text-center text-body-secondary">@CatTexts["Sin asignaciones ni saldos."]</td>
</tr>}@foreach(var item in Model.Product.Locations){<tr>
<td>
<a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@item.Id" class="fw-semibold">@item.Code</a>
<div class="small">@item.Description</div>
</td>
<td>@(item.IsAssigned ? CatTexts["Asignación activa"].Value : CatTexts["Saldo sin asignación"].Value)</td>
<td>@if(!item.IsActive){<span class="badge text-bg-secondary">@CatTexts["Inactiva"]</span>} @if(item.IsBlocked){<span class="badge text-bg-warning">@CatTexts["Bloqueada"]</span>}</td>
<td class="text-end @(item.Quantity < 0 ? "text-danger" : "")">@item.Quantity.ToString("0.####") @Model.Product.Unit</td>
</tr>}</tbody>
</table>
</div>
</div>
</section>
<section id="product-production-summary" class="card product-sheet-panel" aria-labelledby="product-production-summary-heading">
<div class="card-body">
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
<div>
<span class="eyebrow">@CatTexts["Producción"]</span>
<h2 id="product-production-summary-heading" class="h4 mb-1">@CatTexts["Receta y materiales"]</h2>
</div>
<a asp-page="Edit" asp-route-id="@Model.Product.Id" asp-fragment="product-production" class="btn btn-outline-primary">@(Model.Production.ActiveRecipe is null ? CatTexts["Configurar receta"].Value : Model.Production.ActiveRecipe.IsComplete ? CatTexts["Editar receta"].Value : CatTexts["Completar receta"].Value)</a>
</div>@if(Model.Production.RouteId is null){<div class="product-editor-empty mt-3">
<strong class="d-block">@CatTexts["La ruta de producción está pendiente."]</strong>
<span>@CatTexts["Puedes definir los materiales antes de crear y ordenar los procesos."]</span>
</div>}else{<div class="production-product-route my-3">
<div>
<small class="text-body-secondary d-block">@CatTexts["Ruta activa"]</small>
<strong>@Model.Production.RouteName</strong>
</div>
<ol class="production-product-stages mb-0" aria-label="@CatTexts["Etapas de la ruta activa"]">@foreach(var stage in Model.Production.Stages){<li>
<span>@stage.Sequence</span>@stage.Name</li>}</ol>
</div>}@if(Model.Production.ActiveRecipe is null){<div class="product-editor-empty mt-3">
<strong class="d-block">@CatTexts["Este producto todavía no tiene lista de materiales."]</strong>
<span>@CatTexts["Define los materiales y sus cantidades; las etapas pueden asignarse después."]</span>
</div>}else{var recipe=Model.Production.ActiveRecipe;<div class="d-flex flex-wrap gap-3 align-items-center my-3">
<span class="badge text-bg-primary">Receta @recipe.Version</span>
<span class="badge @(recipe.IsComplete ? "text-bg-success" : "text-bg-warning")">@(recipe.IsComplete ? CatTexts["Lista para producción"].Value : CatTexts["Lista incompleta"].Value)</span>
<span>@CatTexts["Cantidad base:"] <strong>@recipe.BaseQuantity.ToString("0.####") @Model.Product.Unit</strong>
</span>
</div>
<div class="table-responsive">
<table class="table align-middle mb-0">
<thead>
<tr>
<th>@CatTexts["Etapa"]</th>
<th>Material</th>
<th class="text-end">@CatTexts["Cantidad"]</th>
</tr>
</thead>
<tbody>@foreach(var line in recipe.Lines){<tr>
<td>@(line.Stage ?? CatTexts["Requiere etapa"].Value)</td>
<td>
<strong>@line.Material.Split(" · ")[0]</strong>
<small class="d-block text-body-secondary">@line.Material</small>
</td>
<td class="text-end">@line.Quantity.ToString("0.####") @line.Unit</td>
</tr>}</tbody>
</table>
</div>}</div>
</section>
<div class="product-sheet-wip">
<partial name="_ProductionWipDefaultsSummary" model="Model" />
</div>
<section id="product-lots" class="card product-sheet-panel" aria-labelledby="product-lots-heading">
<div class="card-body">
<div class="product-sheet-section-heading">
<div>
<span class="product-sheet-eyebrow">@CatTexts["Trazabilidad"]</span>
<h2 id="product-lots-heading">@CatTexts["Lotes internos"]</h2>
</div>
<a asp-page="/Admin/Inventory/Lots/Index" asp-route-search="@Model.Product.Sku" class="product-sheet-section-link">@CatTexts["Consultar lotes →"]</a>
</div>@if(Model.Product.Lots.Count == 0){<p class="text-body-secondary">@CatTexts["Sin lotes internos."]</p>}else{<ul class="list-group list-group-flush">@foreach(var item in Model.Product.Lots){<li class="list-group-item d-flex justify-content-between">
<a asp-page="/Admin/Inventory/Lots/Details" asp-route-id="@item.Id">@item.Number</a>
<span>@item.Quantity.ToString("0.####") @Model.Product.Unit</span>
</li>}</ul>}</div>
</section>
<section id="product-movements" class="card product-sheet-panel" aria-labelledby="product-movements-heading">
<div class="card-body">
<div class="product-sheet-section-heading">
<div>
<span class="product-sheet-eyebrow">@CatTexts["Actividad"]</span>
<h2 id="product-movements-heading">@CatTexts["Movimientos recientes"]</h2>
</div>
<a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@Model.Product.Sku" class="product-sheet-section-link">@CatTexts["Consultar movimientos →"]</a>
</div>
<div class="table-responsive">
<table class="table mb-0">
<thead>
<tr>
<th>@CatTexts["Fecha local"]</th>
<th>@CatTexts["Tipo"]</th>
<th>@CatTexts["Trayecto"]</th>
<th>@CatTexts["Responsable"]</th>
<th class="text-end">@CatTexts["Cantidad"]</th>
</tr>
</thead>
<tbody>@if(Model.Product.Movements.Count == 0){<tr>
<td colspan="5" class="text-center text-body-secondary">@CatTexts["Sin movimientos."]</td>
</tr>}@foreach(var item in Model.Product.Movements){<tr>
<td>
<a asp-page="/Admin/Inventory/Movements/Details" asp-route-id="@item.Id">@item.OccurredAt.ToString("yyyy-MM-dd HH:mm")</a>
</td>
<td>@item.Type</td>
<td>@item.Route</td>
<td>@item.Responsible</td>
<td class="text-end">@item.Quantity.ToString("0.####") @Model.Product.Unit</td>
</tr>}</tbody>
</table>
</div>
</div>
</section>
</div>
