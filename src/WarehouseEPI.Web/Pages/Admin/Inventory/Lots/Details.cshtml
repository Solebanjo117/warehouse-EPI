@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Inventory.Lots.DetailsModel
@{ ViewData["Title"] = "Ficha de lote"; }
@section Styles {
    <link rel="stylesheet" href="~/css/lot-details.css" asp-append-version="true" />
}
<div class="lot-detail">
    <header class="lot-detail-header">
        <div>
            <span class="lot-detail-eyebrow">Lote interno automático</span>
            <h1>@Model.Lot.Number</h1>
            <a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@Model.Lot.ProductId" class="lot-detail-product">@Model.Lot.Sku</a>
            <p>@Model.Lot.Description</p>
        </div>
        <div class="lot-detail-actions">
            <a asp-page="Index" class="btn btn-outline-secondary">Volver a lotes</a>
            <a asp-page="Edit" asp-route-id="@Model.Lot.Id" class="btn btn-outline-secondary">Cambiar fecha</a>
        </div>
    </header>
    <dl class="lot-detail-summary">
        <div><dt>Fecha interna</dt><dd>@(Model.Lot.LotDate?.ToString("yyyy-MM-dd") ?? "Sin fecha")</dd></div>
        <div><dt>Creación</dt><dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm zzz")</dd></div>
        <div class="lot-detail-balance"><dt>Saldo agregado</dt><dd class="@(Model.Lot.Quantity < 0 ? "text-danger" : "")">@Model.Lot.Quantity @Model.Lot.Unit</dd></div>
    </dl>
<section class="lot-detail-section" aria-labelledby="lot-distribution-title"><h2 id="lot-distribution-title">Distribución actual</h2><div class="table-responsive mb-4"><table class="table"><thead><tr><th>Ubicación</th><th>Descripción</th><th class="text-end">Cantidad</th></tr></thead><tbody>@foreach (var item in Model.Lot.Locations) { <tr><td><a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@item.LocationId">@item.Code</a></td><td>@item.Description</td><td class="text-end">@item.Quantity @item.Unit</td></tr> } @if (!Model.Lot.Locations.Any()) { <tr><td colspan="3" class="text-body-secondary">No hay saldo actual para este lote.</td></tr> }</tbody></table></div></section>
<section class="lot-detail-section" aria-labelledby="lot-movements-title"><h2 id="lot-movements-title">Movimientos relacionados</h2><div class="table-responsive mb-4"><table class="table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Ubicación</th><th class="text-end">Delta</th><th></th></tr></thead><tbody>@foreach (var item in Model.Lot.Movements) { <tr><td>@item.OccurredAt.ToString("yyyy-MM-dd HH:mm")</td><td>@item.Type</td><td>@item.Location</td><td class="text-end">@item.Delta</td><td><a asp-page="/Admin/Inventory/Movements/Details" asp-route-id="@item.MovementId">Ver movimiento</a></td></tr> }@if (!Model.Lot.Movements.Any()) { <tr><td colspan="5" class="text-body-secondary">No hay movimientos relacionados con este lote.</td></tr> }</tbody></table></div></section>
<section class="lot-detail-section" aria-labelledby="lot-date-audit-title"><h2 id="lot-date-audit-title">Auditoría de fecha</h2><div class="table-responsive"><table class="table"><thead><tr><th>Anterior</th><th>Nueva</th><th>Motivo</th><th>Solicitó / autorizó</th></tr></thead><tbody>@foreach (var item in Model.Lot.DateChanges) { <tr><td>@item.Previous</td><td>@item.Current</td><td>@item.Reason</td><td>@item.RequestedBy / @item.AuthorizedBy</td></tr> } @if (!Model.Lot.DateChanges.Any()) { <tr><td colspan="4" class="text-body-secondary">No hay cambios de fecha.</td></tr> }</tbody></table></div></section>
</div>