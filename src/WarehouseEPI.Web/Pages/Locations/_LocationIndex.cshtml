@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@using WarehouseEPI.Infrastructure.Locations
@model WarehouseEPI.Web.Pages.Locations.LocationIndexPageModel
@{
    ViewData["Title"] = Model.IsAdministrativeView ? CatTexts["Administrar ubicaciones"].Value : CatTexts["Ubicaciones"].Value;
    var detailsPage = Model.IsAdministrativeView
        ? "/Admin/Catalogs/Locations/Details"
        : "/Locations/Details";
    var printPage = Model.IsAdministrativeView
        ? "/Admin/Catalogs/Locations/Rack/Print"
        : "/Locations/Rack/Print";
}

<div class="locations-index-workspace">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div><h1 class="h2 mb-1">@(Model.IsAdministrativeView ? CatTexts["Administrar ubicaciones"].Value : CatTexts["Ubicaciones"].Value)</h1><p class="text-muted mb-0">@(Model.IsAdministrativeView ? CatTexts["Consulta y mantenimiento protegido del almacén."].Value : CatTexts["Consulta física y operativa del almacén."].Value)</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-page="/Locations/Display" class="btn btn-outline-primary btn-lg">Exhibición de filas</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Generate" class="btn btn-outline-primary btn-lg">@CatTexts["Preparar racks"]</a><a asp-page="/Admin/Catalogs/Locations/Area" class="btn btn-primary btn-lg">@CatTexts["Crear área"]</a>}</div>
</div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}
@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}

<div class="location-summary mb-3">
    <div><strong>@Model.Summary.Available</strong><span>@CatTexts["Disponibles"]</span></div>
    <div><strong>@Model.Summary.Blocked</strong><span>@CatTexts["Bloqueadas"]</span></div>
    <div><strong>@Model.Summary.Inactive</strong><span>@CatTexts["Inactivas"]</span></div>
    <div><strong>@Model.Summary.Retired</strong><span>@CatTexts["Retiradas"]</span></div>
    <div><strong>@Model.Summary.Racks</strong><span>@CatTexts["Posiciones"]</span></div>
    <div><strong>@Model.Summary.Areas</strong><span>@CatTexts["Áreas"]</span></div>
    @if(Model.ViewMode=="map") { <div><strong>@Model.Map.WithInventory</strong><span>@CatTexts["Con saldo"]</span></div><div><strong>@Model.Map.Negative</strong><span>@CatTexts["Negativas"]</span></div><div><strong>@Model.Map.Unplaced.Count</strong><span>@CatTexts["Sin colocar"]</span></div> }
</div>

<form method="get" class="card card-body mb-3" data-location-search-form data-location-search-url="@Url.Page("/Operations/Lookup")"><input type="hidden" name="viewMode" value="@Model.ViewMode"/>@if(Model.ViewMode=="map"){<input type="hidden" name="mapMetric" value="@Model.MapMetric"/><input type="hidden" name="period" value="@Model.HeatmapPeriod"/><input type="hidden" name="from" value="@Model.HeatmapFrom?.ToString("yyyy-MM-dd")"/><input type="hidden" name="to" value="@Model.HeatmapTo?.ToString("yyyy-MM-dd")"/>}<div class="row g-2">
    <div class="col-12 col-lg-4"><label for="search" class="form-label">@CatTexts["Buscar ubicación o producto"]</label><div class="lookup-field"><input id="search" name="search" value="@Model.Search" type="search" autocomplete="off" autocapitalize="characters" class="form-control form-control-lg" placeholder="@CatTexts["Código, SKU, descripción, referencia o barras"]" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="location-search-results" aria-describedby="location-search-feedback" data-location-search-input /><div id="location-search-results" class="lookup-results list-group location-search-results" role="listbox" data-location-search-results></div></div><div id="location-search-feedback" class="form-text" role="status" aria-live="polite" data-location-search-feedback>@CatTexts["Escribe para buscar y selecciona un producto o una ubicación."]</div></div>
    <div class="col-6 col-md-4 col-lg-2"><label for="status" class="form-label">@CatTexts["Estado"]</label><select id="status" name="status" class="form-select form-select-lg"><option value="active" selected="@(Model.Status=="active")">@CatTexts["Disponibles"]</option><option value="blocked" selected="@(Model.Status=="blocked")">@CatTexts["Bloqueadas"]</option><option value="inactive" selected="@(Model.Status=="inactive")">@CatTexts["Inactivas"]</option>@if(Model.ViewMode=="table"){<option value="retired" selected="@(Model.Status=="retired")">@CatTexts["Retiradas"]</option>}@if(!Model.IsAdministrativeView){<option value="unavailable" selected="@(Model.Status=="unavailable")">@CatTexts["No disponibles"]</option>}<option value="all" selected="@(Model.Status=="all")">@CatTexts["Todas"]</option></select></div>
    @if(Model.ViewMode == "racks"){<input type="hidden" name="kind" value="rack"/>}else{<div class="col-6 col-md-4 col-lg-2"><label for="kind" class="form-label">@CatTexts["Tipo"]</label><select id="kind" name="kind" class="form-select form-select-lg"><option value="all">@CatTexts["Todos"]</option><option value="rack" selected="@(Model.Kind=="rack")">Rack</option><option value="area" selected="@(Model.Kind=="area")">@CatTexts["Área"]</option></select></div>}
    <div class="col-6 col-md-4 col-lg-2"><label for="rowCode" class="form-label">@CatTexts["Fila"]</label><select id="rowCode" name="rowCode" class="form-select form-select-lg"><option value="">@CatTexts["Todas"]</option>@foreach(var row in Model.Rows){<option value="@row" selected="@(Model.RowCode==row)">@row</option>}</select></div>
    <div class="col-6 col-lg-2 d-flex align-items-end gap-1"><button class="btn btn-outline-primary btn-lg flex-grow-1">@CatTexts["Buscar"]</button><a asp-page="Index" asp-route-viewMode="@Model.ViewMode" class="btn btn-outline-secondary btn-lg" title="@CatTexts["Limpiar filtros"]" aria-label="@CatTexts["Limpiar filtros"]">×</a></div>
</div></form>

<div class="nav nav-pills mb-3" aria-label="@CatTexts["Vista de ubicaciones"]">
    <a class="nav-link @(Model.ViewMode=="map"?"active":"")" aria-current="@(Model.ViewMode=="map" ? "page" : null)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="map">@CatTexts["Croquis"]</a>
    <a class="nav-link @(Model.ViewMode=="racks"?"active":"")" aria-current="@(Model.ViewMode=="racks" ? "page" : null)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="rack" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="racks">Racks</a>
    <a class="nav-link @(Model.ViewMode=="table"?"active":"")" aria-current="@(Model.ViewMode=="table" ? "page" : null)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="table">@(Model.IsAdministrativeView ? CatTexts["Tabla administrativa"].Value : CatTexts["Lista"].Value)</a>
</div>

@if(Model.ViewMode=="map")
{
    <div class="warehouse-map-frame" data-map-frame aria-label="@CatTexts["Consulta del croquis"]">
    <div class="warehouse-map-toolbar mb-2">
        <button type="button" class="btn btn-outline-secondary" data-map-zoom="in" aria-label="@CatTexts["Acercar"]">＋</button><button type="button" class="btn btn-outline-secondary" data-map-zoom="out" aria-label="@CatTexts["Alejar"]">−</button><button type="button" class="btn btn-outline-secondary" data-map-fit>@CatTexts["Ver todo"]</button>
        <button type="button" class="btn btn-outline-secondary" data-map-focus disabled>@CatTexts["Acercar selección"]</button>
        <button type="button" class="btn btn-outline-primary" data-map-expand aria-expanded="false">@CatTexts["Ampliar croquis"]</button>
        <button type="button" class="btn btn-outline-primary" data-location-start>@CatTexts["Mi ubicación"]</button>
        <button type="button" class="btn btn-outline-secondary d-none" data-location-center>@CatTexts["Centrar en mí"]</button>
        <button type="button" class="btn btn-outline-danger d-none" data-location-stop>@CatTexts["Detener ubicación"]</button>
        <a class="btn @(Model.MapMetric=="normal"?"btn-outline-primary":"btn-primary")" asp-route-viewMode="map" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-mapMetric="@(Model.MapMetric=="normal"?"occupancy":"normal")">@(Model.MapMetric=="normal"?CatTexts["Mapa de calor"].Value:CatTexts["Vista normal"].Value)</a>
        @if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Map/Calibration" class="btn btn-outline-primary ms-auto">@CatTexts["Calibrar ubicación"]</a><a asp-page="/Admin/Catalogs/Locations/Map/Edit" class="btn btn-primary">@CatTexts["Editar croquis"]</a>}
    </div>
    @if(Model.MapMetric != "normal" && Model.Heatmap is not null)
    {
        <section class="card card-body mb-3 map-heat-controls" aria-labelledby="map-heat-title">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3"><div><h2 id="map-heat-title" class="h5 mb-1">@CatTexts["Mapa de calor"]</h2><p class="text-body-secondary mb-0"><span data-heatmap-period-label>@Model.Heatmap.PeriodLabel</span> @CatTexts["· Consultado"] <span data-heatmap-generated>@Model.Heatmap.GeneratedAtLocal.ToString("dd/MM/yyyy HH:mm")</span> (<span data-heatmap-timezone>@Model.Heatmap.TimeZoneId</span>)</p></div>@if(Model.IsAdministrativeView){<div class="d-flex gap-2"><a class="btn btn-outline-secondary" data-heatmap-export asp-page-handler="HeatmapExport" asp-route-format="csv" asp-route-mapMetric="@Model.MapMetric" asp-route-period="@Model.HeatmapPeriod" asp-route-from="@Model.HeatmapFrom" asp-route-to="@Model.HeatmapTo" asp-route-rowCode="@Model.RowCode" asp-route-search="@Model.Search">CSV</a><a class="btn btn-outline-success" data-heatmap-export asp-page-handler="HeatmapExport" asp-route-format="xlsx" asp-route-mapMetric="@Model.MapMetric" asp-route-period="@Model.HeatmapPeriod" asp-route-from="@Model.HeatmapFrom" asp-route-to="@Model.HeatmapTo" asp-route-rowCode="@Model.RowCode" asp-route-search="@Model.Search">Excel</a></div>}</div>
            <form method="get" class="row g-2 mt-1 align-items-end" data-heatmap-form><input type="hidden" name="viewMode" value="map" /><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="status" value="@Model.Status" /><input type="hidden" name="kind" value="@Model.Kind" /><input type="hidden" name="rowCode" value="@Model.RowCode" />
                <div class="col-sm-5 col-lg-3"><label for="mapMetric" class="form-label">@CatTexts["Métrica"]</label><select id="mapMetric" name="mapMetric" class="form-select" data-heatmap-submit><option value="occupancy" selected="@(Model.MapMetric=="occupancy")">@CatTexts["Ocupación actual"]</option><option value="activity" selected="@(Model.MapMetric=="activity")">@CatTexts["Actividad"]</option></select></div>
                <div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" ? "" : "d-none")" data-heatmap-activity-control><label for="heatPeriod" class="form-label">@CatTexts["Período"]</label><select id="heatPeriod" name="period" class="form-select" data-heatmap-submit><option value="7" selected="@(Model.HeatmapPeriod=="7")">@CatTexts["7 días"]</option><option value="14" selected="@(Model.HeatmapPeriod=="14")">@CatTexts["14 días"]</option><option value="30" selected="@(Model.HeatmapPeriod=="30")">@CatTexts["30 días"]</option><option value="custom" selected="@(Model.HeatmapPeriod=="custom")">@CatTexts["Personalizado"]</option></select></div><div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" && Model.HeatmapPeriod == "custom" ? "" : "d-none")" data-heatmap-custom-control><label for="heatFrom" class="form-label">@CatTexts["Desde"]</label><input id="heatFrom" name="from" type="date" class="form-control" value="@Model.HeatmapFrom?.ToString("yyyy-MM-dd")" /></div><div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" && Model.HeatmapPeriod == "custom" ? "" : "d-none")" data-heatmap-custom-control><label for="heatTo" class="form-label">@CatTexts["Hasta"]</label><input id="heatTo" name="to" type="date" class="form-control" value="@Model.HeatmapTo?.ToString("yyyy-MM-dd")" /></div><div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" && Model.HeatmapPeriod == "custom" ? "" : "d-none")" data-heatmap-custom-control><button class="btn btn-outline-primary w-100">@CatTexts["Aplicar"]</button></div>
            </form>
            <div class="map-heat-legend mt-3" aria-label="@CatTexts["Escala del mapa de calor"]"><span><i class="heat-swatch heat-0"></i><span data-heatmap-zero-label>@(Model.MapMetric == "activity" ? CatTexts["Sin actividad"].Value : CatTexts["Sin ocupación"].Value)</span></span><span class="@(Model.MapMetric == "occupancy" ? "" : "d-none")" data-heatmap-unavailable-legend><i class="heat-swatch heat-unavailable"></i>@CatTexts["Sin posiciones evaluables"]</span><span><i class="heat-swatch heat-1"></i>@CatTexts["Baja"]</span><span><i class="heat-swatch heat-2"></i>@CatTexts["Moderada"]</span><span><i class="heat-swatch heat-3"></i>@CatTexts["Alta"]</span><span><i class="heat-swatch heat-4"></i>@CatTexts["Crítica"]</span></div>
        </section>
    }
    <div class="alert alert-danger @(Model.HeatmapError is null ? "d-none" : "")" role="alert" data-heatmap-error>@Model.HeatmapError</div>
    @if(!Model.Map.IsInitialized){<div class="alert alert-info"><strong>@CatTexts["Vista previa sin guardar."]</strong> @CatTexts["El croquis aún no tiene una revisión guardada."]</div>}
    <p class="small text-body-secondary mb-2" data-map-hint>@CatTexts["Selecciona un rack o área para consultar sus posiciones y existencias."]</p>
    <div class="small mb-2 d-none" data-location-status role="status" aria-live="polite"></div>
    <div class="warehouse-map-shell" data-warehouse-map data-highlight-location="@Model.HighlightLocationId"
         data-canvas-width="@Model.Map.CanvasWidth.ToString(global::System.Globalization.CultureInfo.InvariantCulture)"
         data-canvas-height="@Model.Map.CanvasHeight.ToString(global::System.Globalization.CultureInfo.InvariantCulture)">
        <div class="warehouse-map-viewport" data-map-viewport tabindex="0" aria-label="@CatTexts["Croquis interactivo del almacén"]">
            <div class="warehouse-map-stage" data-map-stage>
            <svg class="warehouse-map" viewBox="0 0 @Model.Map.CanvasWidth.ToString(global::System.Globalization.CultureInfo.InvariantCulture) @Model.Map.CanvasHeight.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" role="img" aria-labelledby="warehouse-map-title">
                <title id="warehouse-map-title">@CatTexts["Croquis del almacén Warehouse EPI"]</title>
                <partial name="/Pages/Admin/Catalogs/Locations/_WarehouseMapArchitecture.cshtml" model="Model.Map.Architecture" />
                <g data-map-layer>
                @foreach(var element in Model.Map.Elements.OrderBy(item=>item.ZIndex))
                {
                    var state = MapState(element); var match = element.Positions.Any(position=>Model.MapMatches.Contains(position.LocationId));
                    Model.HeatmapByElementId.TryGetValue(element.Id, out var heatItem);
                    var noEvaluablePositions = heatItem is not null && Model.MapMetric == "occupancy" && heatItem.TotalPositions == 0;
                    var heatClass = heatItem is null || element.Kind != "Rack" ? "" : noEvaluablePositions ? "map-heat-unavailable" : $"map-heat-{heatItem.HeatLevel}";
                    var heatLabel = heatItem is null ? "" : Model.MapMetric == "activity" ? heatItem.AccessCount == 0 ? CatTexts[", sin actividad"].Value : $", {heatItem.AccessCount} operaciones" : noEvaluablePositions ? CatTexts[", sin posiciones evaluables"].Value : $", {heatItem.OccupancyPercent:0.##}% ocupado";
                    var heatValue = heatItem is null ? "" : Model.MapMetric == "activity" ? $"{heatItem.AccessCount} mov." : noEvaluablePositions ? CatTexts["N/D"].Value : $"{heatItem.OccupancyPercent:0.##}%";
                    <g class="map-element @state @(element.IsMixed?"mixed":element.IsWip?"wip":"") @(match?"is-match":"") @heatClass" transform="translate(@element.X.ToString(global::System.Globalization.CultureInfo.InvariantCulture) @element.Y.ToString(global::System.Globalization.CultureInfo.InvariantCulture)) rotate(@element.Rotation)" tabindex="0" role="button" aria-label="Abrir @element.Label, @(element.IsMixed ? CatTexts["Mixto"].Value : element.IsWip ? "WIP" : CatTexts["Almacenamiento"].Value), @StateLabel(state)@heatLabel" data-map-base-label="Abrir @element.Label, @(element.IsMixed ? CatTexts["Mixto"].Value : element.IsWip ? "WIP" : CatTexts["Almacenamiento"].Value), @StateLabel(state)" data-map-open="@element.Id" data-map-kind="@element.Kind" data-map-target="@match.ToString().ToLowerInvariant()" data-heat-level="@heatItem?.HeatLevel">
                        <rect width="@element.Width.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" height="@element.Height.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" rx="4"/><text x="6" y="18">@element.Label</text><text class="map-heat-value @(heatItem is null ? "d-none" : "")" data-heatmap-value x="6" y="34">@heatValue</text>@if(element.Positions.Any(position=>position.HasNegative)){<circle class="map-alert-dot" cx="@(element.Width-8)" cy="8" r="6"/>}
                    </g>
                }
                </g>
                <g class="map-user-location d-none" data-location-layer aria-hidden="true">
                    <circle class="map-user-location-accuracy" data-location-accuracy cx="0" cy="0" r="0"></circle>
                    <circle class="map-user-location-dot" data-location-dot cx="0" cy="0" r="10"></circle>
                </g>
            </svg>
            </div>
        </div>
        <aside class="warehouse-map-detail" aria-label="@CatTexts["Detalle de la selección"]" hidden>
        @foreach(var element in Model.Map.Elements)
        {
            <section class="map-element-detail @(element.Kind=="Rack" && element.IsWip?"map-element-detail-wip-rack":"")" data-map-detail="@element.Id" hidden><div class="map-detail-heading d-flex justify-content-between gap-2"><div><span class="text-body-secondary">@(element.Kind=="Rack"?"Rack":element.IsWip?CatTexts["WIP con existencias reales"].Value:CatTexts["Área"].Value)</span><div class="d-flex align-items-center gap-2 flex-wrap"><h2 class="h4 mb-0">@element.Label</h2>@if(element.Kind=="Rack"){<span class="badge @(element.IsWip ? "text-bg-warning" : "text-bg-light border")">@(element.IsMixed ? CatTexts["Mixto"].Value : element.IsWip ? "WIP" : CatTexts["Almacenamiento"].Value)</span>}</div></div><button type="button" class="btn-close" data-map-close aria-label="@CatTexts["Cerrar detalle"]"></button></div>
            @if(element.Kind=="Rack")
            {
                var issues = Model.RecentWipIssues.GetValueOrDefault(element.Id) ?? [];
                var wipPositions = element.Positions
                    .Where(position => position.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip)
                    .OrderBy(position => position.PalletNumber)
                    .ToArray();
                var wipProducts = wipPositions
                    .SelectMany(position => position.Products
                        .Where(product => product.Quantity != 0)
                        .Select(product => new { PositionCode = position.Code, Product = product }))
                    .OrderBy(item => item.PositionCode)
                    .ThenBy(item => item.Product.Sku)
                    .ToArray();
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2"><span class="small text-body-secondary">@CatTexts["Posiciones físicas"]</span><div class="d-flex flex-wrap gap-1"><a asp-page="@printPage" asp-route-rowCode="@element.RowCode" asp-route-rackNumber="@element.RackNumber" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">@CatTexts["Imprimir hoja"]</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Rack/Edit" asp-route-rowCode="@element.RowCode" asp-route-rackNumber="@element.RackNumber" class="btn btn-sm btn-outline-secondary">@CatTexts["Editar rack"]</a>}</div></div>
                <div class="map-keypad">@foreach(var pallet in new short[]{7,8,9,4,5,6,1,2,3}) { var position=element.Positions.FirstOrDefault(item=>item.PalletNumber==pallet); if(position is null){<span class="map-position missing"><strong>@pallet</strong><small>@CatTexts["No existe"]</small></span>}else{<button type="button" class="map-position @PositionState(position) @(position.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip ? "is-wip" : "")" data-map-position="@position.LocationId" data-map-position-match="@Model.MapMatches.Contains(position.LocationId).ToString().ToLowerInvariant()"><strong>@pallet</strong><small>@position.Code</small><span>@(position.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip ? "WIP" : CatTexts["Almacenamiento"].Value)</span><span>@position.ProductCount producto(s)</span></button>} }</div>
                @foreach(var position in element.Positions)
                {
                    <div class="map-position-detail" data-position-detail="@position.LocationId" hidden><h3 class="h5">@position.Code</h3><span class="badge text-bg-light border">@(position.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip ? "WIP" : CatTexts["Almacenamiento"].Value)</span><p>@(position.Description??CatTexts["Sin descripción"].Value)</p><div class="d-flex gap-2 flex-wrap mb-2"><span class="badge text-bg-light border">@CatTexts["{0} asignación(es)", position.AssignmentCount]</span>@if(position.HasNegative){<span class="badge text-bg-danger">@CatTexts["Saldo negativo"]</span>}else if(position.HasInventory){<span class="badge text-bg-primary">@CatTexts["Con saldo"]</span>}else{<span class="badge text-bg-secondary">@CatTexts["Sin saldo"]</span>}</div>@foreach(var product in position.Products){<div class="map-product-row"><a asp-page="/Inventory/Index" asp-route-productId="@product.ProductId">@(string.IsNullOrEmpty(product.Sku)?CatTexts["Producto"].Value:product.Sku)</a><span class="@(product.Quantity<0?"text-danger":"")">@product.Quantity.ToString("0.####") @product.Unit</span><small>@(product.IsAssigned?CatTexts["Asignado"].Value:CatTexts["Sin asignación activa"].Value)</small>@if(position.OperationalRole != WarehouseEPI.Core.Entities.LocationOperationalRole.Wip && position.IsActive && !position.IsBlocked){<div class="dropdown"><button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">@CatTexts["Operar"]</button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-page="/Operations/Entry" asp-route-productId="@product.ProductId" asp-route-destinationLocationId="@position.LocationId">@CatTexts["Entrada"]</a></li><li><a class="dropdown-item" asp-page="/Operations/Exit" asp-route-mode="general" asp-route-productId="@product.ProductId" asp-route-sourceLocationId="@position.LocationId">@CatTexts["Salida"]</a></li><li><a class="dropdown-item" asp-page="/Operations/Transfer" asp-route-productId="@product.ProductId" asp-route-sourceLocationId="@position.LocationId">@CatTexts["Transferencia"]</a></li><li><a class="dropdown-item" asp-page="/Operations/Adjustment" asp-route-productId="@product.ProductId" asp-route-locationId="@position.LocationId">@CatTexts["Ajuste"]</a></li>@if(product.Quantity>0){<li><hr class="dropdown-divider" /></li><li><a class="dropdown-item" asp-page="/Operations/PalletLabels/Index" asp-route-location="@position.Code" asp-route-productId="@product.ProductId">@CatTexts["Imprimir placa"]</a></li>}</ul></div>}</div>}
                    @if(position.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip && position.IsActive && !position.IsBlocked)
                    {
