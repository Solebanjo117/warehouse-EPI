@page
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Admin.Inventory.Movements.IndexModel
@{ ViewData["Title"] = "Historial de movimientos"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1 class="h2 mb-1">Historial de movimientos</h1><p class="text-muted mb-0">Auditoría de inventario confirmada e inmutable.</p></div><a asp-page="/Admin/Inventory/Alerts" class="btn btn-outline-warning">Alertas</a></div>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-4"><label class="form-label">Buscar</label><input name="search" value="@Model.Search" class="form-control" placeholder="Folio, referencia o SKU" /></div><div class="col-md-2"><label class="form-label">Desde</label><input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-2"><label class="form-label">Hasta</label><input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-2"><label class="form-label">Tipo</label><select name="type" class="form-select"><option value="">Todos</option>@foreach(var value in Enum.GetValues<InventoryMovementType>()){<option value="@value" selected="@(Model.Type==value)">@value</option>}</select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Filtrar</button></div></div><div class="mt-3 d-flex gap-2"><a class="btn btn-outline-secondary" asp-page-handler="Export" asp-route-format="csv" asp-route-search="@Model.Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-type="@Model.Type">CSV</a><a class="btn btn-outline-secondary" asp-page-handler="Export" asp-route-format="xlsx" asp-route-search="@Model.Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-type="@Model.Type">Excel</a></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Fecha</th><th>Tipo</th><th>Producto</th><th>Responsable</th><th>Referencia</th><th>Estado</th><th></th></tr></thead><tbody>@if(Model.Results.Items.Count==0){<tr><td colspan="7" class="text-muted text-center py-4">No hay movimientos que coincidan.</td></tr>}else{@foreach(var item in Model.Results.Items){<tr><td>@item.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@item.Type</td><td>@item.ProductSummary</td><td>@item.ResponsibleName</td><td>@(item.Reference??"—")</td><td>@(item.IsCorrected?"Relacionado con corrección":"Vigente")</td><td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-page="Details" asp-route-id="@item.Id">Detalle</a></td></tr>}}</tbody></table></div>
@if(Model.TotalPages>1){<nav><ul class="pagination justify-content-center"><li class="page-item @(Model.PageNumber<=1?"disabled":"")"><a class="page-link" asp-route-search="@Model.Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-type="@Model.Type" asp-route-pageNumber="@(Model.PageNumber-1)">Anterior</a></li><li class="page-item disabled"><span class="page-link">@Model.PageNumber de @Model.TotalPages</span></li><li class="page-item @(Model.PageNumber>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-route-search="@Model.Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-type="@Model.Type" asp-route-pageNumber="@(Model.PageNumber+1)">Siguiente</a></li></ul></nav>}
