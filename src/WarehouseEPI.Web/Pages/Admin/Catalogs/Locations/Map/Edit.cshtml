@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.Map.EditModel
@{ ViewData["Title"]="Editar croquis"; }
<div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h1 class="h2 mb-1">Editar croquis</h1><p class="text-body-secondary mb-0">Mueve la capa operativa; muros, pasillos y códigos de ubicación no cambian.</p></div><a asp-page="/Admin/Catalogs/Locations/Index" asp-route-viewMode="map" class="btn btn-outline-secondary">Cancelar</a></div>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="map-editor" data-map-editor data-initialized="@Model.Map.IsInitialized.ToString().ToLowerInvariant()">
<div class="map-editor-toolbar"><button type="button" class="btn btn-outline-secondary" data-editor-undo disabled>Deshacer</button><button type="button" class="btn btn-outline-secondary" data-editor-redo disabled>Rehacer</button><button type="button" class="btn btn-outline-secondary" data-editor-multi aria-pressed="false">Selección múltiple</button><div class="btn-group"><button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" disabled data-editor-align-menu>Alinear</button><ul class="dropdown-menu"><li><button type="button" class="dropdown-item" data-editor-align="left">Izquierda</button></li><li><button type="button" class="dropdown-item" data-editor-align="center-x">Centro horizontal</button></li><li><button type="button" class="dropdown-item" data-editor-align="right">Derecha</button></li><li><hr class="dropdown-divider"/></li><li><button type="button" class="dropdown-item" data-editor-align="top">Arriba</button></li><li><button type="button" class="dropdown-item" data-editor-align="center-y">Centro vertical</button></li><li><button type="button" class="dropdown-item" data-editor-align="bottom">Abajo</button></li></ul></div><div class="btn-group"><button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" disabled data-editor-distribute-menu>Distribuir</button><ul class="dropdown-menu"><li><button type="button" class="dropdown-item" data-editor-distribute="x">Horizontal</button></li><li><button type="button" class="dropdown-item" data-editor-distribute="y">Vertical</button></li></ul></div><button type="button" class="btn btn-outline-secondary" data-editor-sort-row disabled>Ordenar fila</button><div class="btn-group"><button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" disabled data-editor-size-menu>Igualar tamaño</button><ul class="dropdown-menu"><li><button type="button" class="dropdown-item" data-editor-size="width">Ancho</button></li><li><button type="button" class="dropdown-item" data-editor-size="height">Alto</button></li><li><button type="button" class="dropdown-item" data-editor-size="both">Ambos</button></li></ul></div><button type="button" class="btn btn-outline-secondary" data-editor-rotate disabled>Girar 90°</button><button type="button" class="btn btn-outline-secondary" data-editor-mirror disabled>Invertir horizontal</button><button type="button" class="btn btn-outline-secondary" data-editor-hide disabled>Ocultar</button><span class="editor-selection-count" data-editor-selection-count>Sin selección</span><span class="editor-reference" data-editor-reference hidden></span><span class="ms-auto">Versión @Model.Map.Version</span></div>
<div class="row g-3"><div class="col-xl-9"><div class="warehouse-map-viewport editor-viewport"><svg class="warehouse-map editor-canvas" viewBox="0 0 1600 900" data-editor-svg><g class="map-building"><rect x="35" y="35" width="1530" height="820" rx="12"/><path d="M55 740H1545M260 35V155M55 250H260M1250 35V150M1495 150V315M1260 805H1545"/></g><g data-editor-layer>@foreach(var element in Model.Map.Elements.Concat(Model.Map.Unplaced)){<g class="map-element editor-element @(element.IsVisible?"":"is-hidden")" data-editor-element="@element.Id" data-row-code="@element.RowCode" data-rack-number="@element.RackNumber" data-x="@element.X.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" data-y="@element.Y.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" data-width="@element.Width.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" data-height="@element.Height.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" data-rotation="@element.Rotation" data-z="@element.ZIndex" data-visible="@element.IsVisible.ToString().ToLowerInvariant()" transform="translate(@element.X.ToString(global::System.Globalization.CultureInfo.InvariantCulture) @element.Y.ToString(global::System.Globalization.CultureInfo.InvariantCulture)) rotate(@element.Rotation)"><rect width="@element.Width.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" height="@element.Height.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" rx="4"/><text x="6" y="18">@element.Label</text><rect class="editor-resize-handle" x="@(element.Width-10)" y="@(element.Height-10)" width="12" height="12"/></g>}</g><g class="editor-selection" data-editor-selection></g></svg></div></div>
<aside class="col-xl-3"><div class="card card-body mb-3"><h2 class="h5">Sin colocar / ocultos</h2><div class="map-unplaced-list">@foreach(var item in Model.Map.Unplaced){<button type="button" class="btn btn-outline-secondary text-start" data-editor-place="@item.Id">@item.Label</button>}@if(Model.Map.Unplaced.Count==0){<span class="text-body-secondary">Todos los elementos están colocados.</span>}</div></div><div class="card card-body"><h2 class="h5">Confirmar cambios</h2><form method="post" data-map-save-form><input asp-for="Input.OperationId" type="hidden"/><input asp-for="Input.GeometryJson" type="hidden" data-editor-geometry/><div class="mb-3"><label asp-for="Input.Reason" class="form-label">Motivo (opcional)</label><textarea asp-for="Input.Reason" class="form-control" maxlength="500"></textarea></div><div class="mb-3"><label asp-for="Input.Pin" class="form-label">NIP ADMIN</label><input asp-for="Input.Pin" class="form-control form-control-lg" inputmode="numeric" autocomplete="off" required/></div>@if(Model.Map.IsInitialized){<button asp-page-handler="Save" class="btn btn-primary w-100">Guardar revisión</button>}else{<p class="small text-body-secondary">La propuesta incluye @Model.Map.Elements.Count elementos colocados y @Model.Map.Unplaced.Count pendientes.</p><button asp-page-handler="Initialize" class="btn btn-primary w-100">Confirmar croquis inicial</button>}</form></div></aside></div></div>
@if(Model.Revisions.Count>0){<section class="card mt-4"><div class="card-body"><h2 class="h4">Historial de revisiones</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Versión</th><th>Fecha</th><th>Solicitó / autorizó</th><th>Motivo</th></tr></thead><tbody>@foreach(var item in Model.Revisions){<tr><td>@item.PreviousVersion → @item.NewVersion</td><td>@item.RecordedAt.ToString("yyyy-MM-dd HH:mm")</td><td>@item.RequestedBy / @item.AuthorizedBy</td><td>@(item.Reason??"Sin motivo")</td></tr>}</tbody></table></div></div></section>}
@section Scripts { <script src="~/js/warehouse-map.js" asp-append-version="true"></script> }
