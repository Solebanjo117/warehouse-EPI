@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Admin.Inventory.AlertsModel
@{ ViewData["Title"] = CatTexts["Centro de excepciones"].Value; }

<div class="alerts-workspace">
    <header class="inventory-page-header d-flex flex-wrap justify-content-between gap-3 align-items-start"><div><span class="eyebrow">@CatTexts["Prioridad operativa"]</span><h1 class="h2 mb-1">@CatTexts["Centro de excepciones"]</h1><p class="text-muted mb-0">@CatTexts["Casos derivados de condiciones reales. El seguimiento no modifica inventario."]</p></div><div class="d-flex gap-2"><a asp-page="/Admin/Inventory/Movements/Index" class="btn btn-outline-secondary">@CatTexts["Movimientos"]</a><form method="post" asp-page-handler="Refresh"><input type="hidden" name="status" value="@Model.Status"/><input type="hidden" name="category" value="@Model.Category"/><input type="hidden" name="severity" value="@Model.Severity"/><input type="hidden" name="assignedUserId" value="@Model.AssignedUserId"/><input type="hidden" name="search" value="@Model.Search"/><button class="btn btn-primary">@CatTexts["Actualizar condiciones"]</button></form></div></header>
    @if(Model.StatusMessage is not null){<div class="alert alert-success mt-3" role="status">@Model.StatusMessage</div>}@if(Model.ErrorMessage is not null){<div class="alert alert-danger mt-3" role="alert">@Model.ErrorMessage</div>}
    <section class="alert-metrics" aria-label="@CatTexts["Resumen de casos abiertos"]"><article><span aria-hidden="true">N</span><strong>@Model.ExceptionPage.NewCount</strong><small>@CatTexts["Nuevas"]</small></article><article class="is-warning"><span aria-hidden="true">→</span><strong>@Model.ExceptionPage.InProgressCount</strong><small>@CatTexts["En atención"]</small></article><article><span aria-hidden="true">…</span><strong>@Model.ExceptionPage.WaitingCount</strong><small>@CatTexts["En espera"]</small></article><article class="is-danger"><span aria-hidden="true">!</span><strong>@Model.ExceptionPage.CriticalCount</strong><small>@CatTexts["Críticas abiertas"]</small></article></section>
    <form method="get" class="analytics-filter-card mt-3"><div class="row g-2"><div class="col-md-3"><label class="form-label" for="exception-status">@CatTexts["Estado"]</label><select id="exception-status" name="status" class="form-select"><option value="">@CatTexts["Todos"]</option>@foreach(var value in Enum.GetValues<OperationalExceptionStatus>()){<option value="@value" selected="@(Model.Status==value)">@StatusLabel(value)</option>}</select></div><div class="col-md-3"><label class="form-label" for="exception-category">@CatTexts["Categoría"]</label><select id="exception-category" name="category" class="form-select"><option value="">@CatTexts["Todas"]</option>@foreach(var value in Enum.GetValues<OperationalExceptionCategory>()){<option value="@value" selected="@(Model.Category==value)">@CategoryLabel(value)</option>}</select></div><div class="col-md-2"><label class="form-label" for="exception-severity">@CatTexts["Prioridad"]</label><select id="exception-severity" name="severity" class="form-select"><option value="">@CatTexts["Todas"]</option>@foreach(var value in Enum.GetValues<OperationalExceptionSeverity>()){<option value="@value" selected="@(Model.Severity==value)">@SeverityLabel(value)</option>}</select></div><div class="col-md-2"><label class="form-label" for="exception-owner">@CatTexts["Responsable"]</label><select id="exception-owner" name="assignedUserId" class="form-select"><option value="">@CatTexts["Todos"]</option>@foreach(var user in Model.Assignees){<option value="@user.Id" selected="@(Model.AssignedUserId==user.Id)">@user.FullName</option>}</select></div><div class="col-md-2"><label class="form-label" for="exception-search">@CatTexts["Buscar"]</label><input id="exception-search" name="search" value="@Model.Search" class="form-control" placeholder="@CatTexts["SKU, ubicación o CC"]"/></div></div><button class="btn btn-outline-primary mt-3">@CatTexts["Filtrar"]</button></form>
    @if(Model.ExceptionPage.Items.Count==0){<div class="inventory-empty mt-3"><strong>@CatTexts["No hay casos para estos filtros."]</strong><span>@CatTexts["La actualización crea los casos a partir de las condiciones vigentes."]</span></div>}
    else{<section class="alert-list mt-3" aria-label="@CatTexts["Casos de excepción"]">@foreach(var item in Model.ExceptionPage.Items){<article class="alert-row @(item.Severity==OperationalExceptionSeverity.Critical ? "is-negative" : "is-minimum")"><div><span class="inventory-card-label">@CategoryLabel(item.Category) · @SeverityLabel(item.Severity)</span><strong>@item.PrimaryText</strong><small>@item.SecondaryText</small></div><div><span class="inventory-card-label">@CatTexts["Estado"]</span><strong>@StatusLabel(item.Status)</strong><small>@(item.AssignedUserName is null ? CatTexts["Sin responsable"].Value : item.AssignedUserName)</small></div><div><span class="inventory-card-label">@CatTexts["Valor"]</span><strong>@(item.ValueText ?? CatTexts["Requiere atención"].Value)</strong><small>Desde @item.FirstDetectedAt.ToString("dd/MM/yyyy HH:mm")</small></div><div class="d-flex flex-wrap gap-2 justify-content-end"><a asp-page="Alerts/Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">@CatTexts["Seguimiento"]</a><a href="@item.TargetUrl" class="btn btn-outline-primary">@CatTexts["Actuar"]</a></div></article>}</section>}
    @if(Model.TotalPages>1){<nav class="mt-4" aria-label="@CatTexts["Paginación de excepciones"]"><ul class="pagination justify-content-center"><li class="page-item @(Model.ExceptionPage.PageNumber<=1?"disabled":null)"><a class="page-link" asp-route-status="@Model.Status" asp-route-category="@Model.Category" asp-route-severity="@Model.Severity" asp-route-assignedUserId="@Model.AssignedUserId" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.ExceptionPage.PageNumber-1)">@CatTexts["Anterior"]</a></li><li class="page-item disabled"><span class="page-link">@CatTexts["{0} de {1}", Model.ExceptionPage.PageNumber, Model.TotalPages]</span></li><li class="page-item @(Model.ExceptionPage.PageNumber>=Model.TotalPages?"disabled":null)"><a class="page-link" asp-route-status="@Model.Status" asp-route-category="@Model.Category" asp-route-severity="@Model.Severity" asp-route-assignedUserId="@Model.AssignedUserId" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.ExceptionPage.PageNumber+1)">@CatTexts["Siguiente"]</a></li></ul></nav>}
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/exception-center.css" asp-append-version="true" />
}

@functions { string StatusLabel(OperationalExceptionStatus value) => value switch { OperationalExceptionStatus.New => CatTexts["Nueva"].Value, OperationalExceptionStatus.InProgress => CatTexts["En atención"].Value, OperationalExceptionStatus.Waiting => CatTexts["En espera"].Value, _ => CatTexts["Resuelta"].Value }; string SeverityLabel(OperationalExceptionSeverity value) => value switch { OperationalExceptionSeverity.Critical => CatTexts["Crítica"].Value, OperationalExceptionSeverity.Warning => CatTexts["Advertencia"].Value, _ => CatTexts["Informativa"].Value }; string CategoryLabel(OperationalExceptionCategory value) => value switch { OperationalExceptionCategory.NegativeInventory => CatTexts["Saldo negativo"].Value, OperationalExceptionCategory.BelowMinimum => CatTexts["Bajo mínimo"].Value, OperationalExceptionCategory.UnassignedBalance => CatTexts["Sin asignación"].Value, OperationalExceptionCategory.RestrictedInventory => CatTexts["Restringido"].Value, OperationalExceptionCategory.StagnantInventory => CatTexts["Estancado"].Value, OperationalExceptionCategory.CycleCountStale => CatTexts["Conteo obsoleto"].Value, OperationalExceptionCategory.CycleCountPending => CatTexts["Conteo pendiente"].Value, _ => CatTexts["WIP estancado"].Value }; }
