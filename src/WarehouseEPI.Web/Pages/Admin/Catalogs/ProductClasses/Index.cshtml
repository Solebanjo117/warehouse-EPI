@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.ProductClasses.IndexModel
@{ ViewData["Title"]="Clases de producto"; }
<h1 class="h2">Clases de producto</h1><p class="text-muted">Familias normalizadas usadas por el catálogo.</p>
@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<form method="post" asp-page-handler="Save" class="card card-body mb-4"><input asp-for="Input.Id" type="hidden"/><div class="row g-3 align-items-end"><div class="col-md-3"><label asp-for="Input.Code" class="form-label">Código</label><input asp-for="Input.Code" class="form-control text-uppercase"/><span asp-validation-for="Input.Code" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Name" class="form-label">Nombre</label><input asp-for="Input.Name" class="form-control"/><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-3"><button class="btn btn-primary">@(Model.Input.Id==0?"Agregar":"Guardar")</button> @if(Model.Input.Id!=0){<a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>}</div></div></form>
<div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.Code</strong></td><td>@item.Name</td><td>@(item.IsActive?"Activo":"Inactivo")</td><td class="text-end"><a asp-route-editId="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a> <form method="post" asp-page-handler="Toggle" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-outline-secondary btn-sm">@(item.IsActive?"Desactivar":"Activar")</button></form></td></tr>}</tbody></table></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
