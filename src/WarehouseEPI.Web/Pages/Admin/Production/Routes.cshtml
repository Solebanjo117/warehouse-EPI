@page
@model WarehouseEPI.Web.Pages.Admin.Production.RoutesModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@{ViewData["Title"]=ProdTexts["Rutas de producción"].Value;}
<div class="container-fluid py-3 production-page">
 <a asp-page="/Admin/Production/Schedule" asp-fragment="daily-configuration" class="btn btn-outline-secondary mb-3">@ProdTexts["Configuración diaria"]</a>
 <header class="d-flex flex-wrap justify-content-between gap-3 align-items-start mb-4"><div><span class="eyebrow">@ProdTexts["Configuración administrativa"]</span><h1 class="h2 mb-1">@ProdTexts["Rutas de producción"]</h1><p class="text-muted mb-0">@ProdTexts["Define turnos y el recorrido estable de cada producto."]</p></div><div class="d-flex gap-2"><a asp-page="Processes" class="btn btn-outline-primary">@ProdTexts["Procesos"]</a><a asp-page="/Admin/Catalogs/Products/Index" class="btn btn-outline-primary">@ProdTexts["Productos y recetas"]</a></div></header>
 @if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
 <div class="row g-4"><section class="col-12 col-xl-5"><div class="card"><div class="card-body"><h2 class="h5">@ProdTexts["Agregar turno"]</h2><form method="post" asp-page-handler="Catalog" class="row g-3"><div class="col-12 col-sm-5"><label asp-for="Catalog.Code" class="form-label">@ProdTexts["Código"]</label><input asp-for="Catalog.Code" class="form-control text-uppercase" /></div><div class="col-12 col-sm-7"><label asp-for="Catalog.Name" class="form-label">@ProdTexts["Nombre"]</label><input asp-for="Catalog.Name" class="form-control" /></div><div class="col-12"><label asp-for="Catalog.Pin" class="form-label">@ProdTexts["NIP ADMIN"]</label><input asp-for="Catalog.Pin" type="password" inputmode="numeric" class="form-control" autocomplete="off" /></div><div class="col-12"><button class="btn btn-outline-primary" type="submit">@ProdTexts["Agregar turno"]</button></div></form><h3 class="h6 mt-4">@ProdTexts["Turnos registrados"]</h3>@if(Model.Shifts.Count==0){<p class="text-muted mb-0">@ProdTexts["Todavía no hay turnos."]</p>}else{<ul class="list-unstyled mb-0">@foreach(var s in Model.Shifts){<li>@s.Code · @s.Name</li>}</ul>}</div></div></section>
 <section class="col-12 col-xl-7"><div class="card"><div class="card-body"><h2 class="h5">@ProdTexts["Asignar ruta a producto"]</h2><form method="post" asp-page-handler="Route" class="row g-3"><input asp-for="Route.OperationId" type="hidden"/><div class="col-12"><label asp-for="Route.ProductId" class="form-label">@ProdTexts["Producto"]</label><select asp-for="Route.ProductId" class="form-select"><option value="">@ProdTexts["Selecciona…"]</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Sku · @p.Description</option>}</select></div><div class="col-12"><label asp-for="Route.Name" class="form-label">@ProdTexts["Nombre de ruta"]</label><input asp-for="Route.Name" class="form-control" /></div><fieldset class="col-12"><legend class="form-label">@ProdTexts["Etapas en orden"]</legend><p class="form-text">@ProdTexts["Selecciona en el orden numérico mostrado. Para cambiar el orden, usa los campos de posición."]</p>@foreach(var s in Model.Stages){<div class="input-group mb-2"><div class="input-group-text"><input class="form-check-input mt-0" type="checkbox" name="Route.StageIds" value="@s.Id" aria-label="Incluir @s.Name" /></div><span class="form-control">@s.Code · @s.Name</span></div>}</fieldset><div class="col-12"><label asp-for="Route.Pin" class="form-label">@ProdTexts["NIP ADMIN"]</label><input asp-for="Route.Pin" type="password" inputmode="numeric" class="form-control" autocomplete="off" /></div><div class="col-12"><button class="btn btn-primary" type="submit">@ProdTexts["Crear ruta"]</button></div></form></div></div></section></div>
 <section class="mt-4"><h2 class="h4">@ProdTexts["Rutas activas"]</h2>@if(Model.Routes.Count==0){<div class="alert alert-info">@ProdTexts["Agrega etapas y asigna la primera ruta a un producto."]</div>}else{<div class="table-responsive"><table class="table align-middle"><thead><tr><th>@ProdTexts["Producto"]</th><th>@ProdTexts["Ruta"]</th><th>@ProdTexts["Etapas"]</th></tr></thead><tbody>@foreach(var r in Model.Routes){<tr><td><strong>@r.Product.Sku</strong><br/><small>@r.Product.Description</small></td><td>@r.Name</td><td>@string.Join(" → ",r.Stages.OrderBy(x=>x.Sequence).Select(x=>x.Stage.Name))</td></tr>}</tbody></table></div>}</section>
</div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
