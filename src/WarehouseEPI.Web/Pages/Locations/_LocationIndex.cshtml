@using WarehouseEPI.Infrastructure.Locations
@model WarehouseEPI.Web.Pages.Locations.LocationIndexPageModel
@{
    ViewData["Title"] = Model.IsAdministrativeView ? "Administrar ubicaciones" : "Ubicaciones";
    var detailsPage = Model.IsAdministrativeView
        ? "/Admin/Catalogs/Locations/Details"
        : "/Locations/Details";
    var printPage = Model.IsAdministrativeView
        ? "/Admin/Catalogs/Locations/Rack/Print"
        : "/Locations/Rack/Print";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div><h1 class="h2 mb-1">@(Model.IsAdministrativeView ? "Administrar ubicaciones" : "Ubicaciones")</h1><p class="text-muted mb-0">@(Model.IsAdministrativeView ? "Consulta y mantenimiento protegido del almacén." : "Consulta física y operativa del almacén.")</p></div>
    @if(Model.IsAdministrativeView){<div class="d-flex flex-wrap gap-2"><a asp-page="/Admin/Catalogs/Locations/Generate" class="btn btn-outline-primary btn-lg">Preparar racks</a><a asp-page="/Admin/Catalogs/Locations/Area" class="btn btn-primary btn-lg">Crear área</a></div>}
</div>
@if(Model.Message is not null){<div class="alert alert-success">@Model.Message</div>}
@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}

<div class="location-summary mb-3">
    <div><strong>@Model.Summary.Available</strong><span>Disponibles</span></div>
    <div><strong>@Model.Summary.Blocked</strong><span>Bloqueadas</span></div>
    <div><strong>@Model.Summary.Inactive</strong><span>Inactivas</span></div>
    <div><strong>@Model.Summary.Retired</strong><span>Retiradas</span></div>
    <div><strong>@Model.Summary.Racks</strong><span>Posiciones</span></div>
    <div><strong>@Model.Summary.Areas</strong><span>Áreas</span></div>
    @if(Model.ViewMode=="map") { <div><strong>@Model.Map.WithInventory</strong><span>Con saldo</span></div><div><strong>@Model.Map.Negative</strong><span>Negativas</span></div><div><strong>@Model.Map.Unplaced.Count</strong><span>Sin colocar</span></div> }
</div>

<form method="get" class="card card-body mb-3" data-location-search-form><input type="hidden" name="viewMode" value="@Model.ViewMode"/>@if(Model.ViewMode=="map"){<input type="hidden" name="mapMetric" value="@Model.MapMetric"/><input type="hidden" name="period" value="@Model.HeatmapPeriod"/><input type="hidden" name="from" value="@Model.HeatmapFrom?.ToString("yyyy-MM-dd")"/><input type="hidden" name="to" value="@Model.HeatmapTo?.ToString("yyyy-MM-dd")"/>}<div class="row g-2">
    <div class="col-12 col-lg-4"><label for="search" class="form-label">Buscar ubicación o producto</label><input id="search" name="search" value="@Model.Search" class="form-control form-control-lg" placeholder="Código, SKU, descripción, referencia o barras" data-location-search-input /></div>
    <div class="col-6 col-md-4 col-lg-2"><label for="status" class="form-label">Estado</label><select id="status" name="status" class="form-select form-select-lg"><option value="active" selected="@(Model.Status=="active")">Disponibles</option><option value="blocked" selected="@(Model.Status=="blocked")">Bloqueadas</option><option value="inactive" selected="@(Model.Status=="inactive")">Inactivas</option>@if(Model.ViewMode=="table"){<option value="retired" selected="@(Model.Status=="retired")">Retiradas</option>}@if(!Model.IsAdministrativeView){<option value="unavailable" selected="@(Model.Status=="unavailable")">No disponibles</option>}<option value="all" selected="@(Model.Status=="all")">Todas</option></select></div>
    @if(Model.ViewMode == "racks"){<input type="hidden" name="kind" value="rack"/>}else{<div class="col-6 col-md-4 col-lg-2"><label for="kind" class="form-label">Tipo</label><select id="kind" name="kind" class="form-select form-select-lg"><option value="all">Todos</option><option value="rack" selected="@(Model.Kind=="rack")">Rack</option><option value="area" selected="@(Model.Kind=="area")">Área</option></select></div>}
    <div class="col-6 col-md-4 col-lg-2"><label for="rowCode" class="form-label">Fila</label><select id="rowCode" name="rowCode" class="form-select form-select-lg"><option value="">Todas</option>@foreach(var row in Model.Rows){<option value="@row" selected="@(Model.RowCode==row)">@row</option>}</select></div>
    <div class="col-6 col-lg-2 d-flex align-items-end gap-1"><button class="btn btn-outline-primary btn-lg flex-grow-1">Buscar</button><a asp-page="Index" asp-route-viewMode="@Model.ViewMode" class="btn btn-outline-secondary btn-lg" title="Limpiar filtros">×</a></div>
</div></form>

<div class="nav nav-pills mb-3" aria-label="Vista de ubicaciones">
    <a class="nav-link @(Model.ViewMode=="map"?"active":"")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="map">Croquis</a>
    <a class="nav-link @(Model.ViewMode=="racks"?"active":"")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="rack" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="racks">Racks</a>
    <a class="nav-link @(Model.ViewMode=="table"?"active":"")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="table">@(Model.IsAdministrativeView ? "Tabla administrativa" : "Lista")</a>
</div>

@if(Model.ViewMode=="map")
{
    <div class="warehouse-map-toolbar mb-2">
        <button type="button" class="btn btn-outline-secondary" data-map-zoom="in" aria-label="Acercar">＋</button><button type="button" class="btn btn-outline-secondary" data-map-zoom="out" aria-label="Alejar">−</button><button type="button" class="btn btn-outline-secondary" data-map-fit>Ajustar</button>
        <a class="btn @(Model.MapMetric=="normal"?"btn-outline-primary":"btn-primary")" asp-route-viewMode="map" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-rowCode="@Model.RowCode" asp-route-mapMetric="@(Model.MapMetric=="normal"?"occupancy":"normal")">@(Model.MapMetric=="normal"?"Mapa de calor":"Vista normal")</a>
        @if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Map/Edit" class="btn btn-primary ms-auto">Editar croquis</a>}
    </div>
    @if(Model.MapMetric != "normal" && Model.Heatmap is not null)
    {
        <section class="card card-body mb-3 map-heat-controls" aria-labelledby="map-heat-title">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3"><div><h2 id="map-heat-title" class="h5 mb-1">Mapa de calor</h2><p class="text-body-secondary mb-0"><span data-heatmap-period-label>@Model.Heatmap.PeriodLabel</span> · Consultado <span data-heatmap-generated>@Model.Heatmap.GeneratedAtLocal.ToString("dd/MM/yyyy HH:mm")</span> (<span data-heatmap-timezone>@Model.Heatmap.TimeZoneId</span>)</p></div>@if(Model.IsAdministrativeView){<div class="d-flex gap-2"><a class="btn btn-outline-secondary" data-heatmap-export asp-page-handler="HeatmapExport" asp-route-format="csv" asp-route-mapMetric="@Model.MapMetric" asp-route-period="@Model.HeatmapPeriod" asp-route-from="@Model.HeatmapFrom" asp-route-to="@Model.HeatmapTo">CSV</a><a class="btn btn-outline-success" data-heatmap-export asp-page-handler="HeatmapExport" asp-route-format="xlsx" asp-route-mapMetric="@Model.MapMetric" asp-route-period="@Model.HeatmapPeriod" asp-route-from="@Model.HeatmapFrom" asp-route-to="@Model.HeatmapTo">Excel</a></div>}</div>
            <form method="get" class="row g-2 mt-1 align-items-end" data-heatmap-form><input type="hidden" name="viewMode" value="map" /><input type="hidden" name="search" value="@Model.Search" /><input type="hidden" name="status" value="@Model.Status" /><input type="hidden" name="kind" value="@Model.Kind" /><input type="hidden" name="rowCode" value="@Model.RowCode" />
                <div class="col-sm-5 col-lg-3"><label for="mapMetric" class="form-label">Métrica</label><select id="mapMetric" name="mapMetric" class="form-select" data-heatmap-submit><option value="occupancy" selected="@(Model.MapMetric=="occupancy")">Ocupación actual</option><option value="activity" selected="@(Model.MapMetric=="activity")">Actividad</option></select></div>
                <div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" ? "" : "d-none")" data-heatmap-activity-control><label for="heatPeriod" class="form-label">Período</label><select id="heatPeriod" name="period" class="form-select" data-heatmap-submit><option value="7" selected="@(Model.HeatmapPeriod=="7")">7 días</option><option value="14" selected="@(Model.HeatmapPeriod=="14")">14 días</option><option value="30" selected="@(Model.HeatmapPeriod=="30")">30 días</option><option value="custom" selected="@(Model.HeatmapPeriod=="custom")">Personalizado</option></select></div><div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" && Model.HeatmapPeriod == "custom" ? "" : "d-none")" data-heatmap-custom-control><label for="heatFrom" class="form-label">Desde</label><input id="heatFrom" name="from" type="date" class="form-control" value="@Model.HeatmapFrom?.ToString("yyyy-MM-dd")" /></div><div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" && Model.HeatmapPeriod == "custom" ? "" : "d-none")" data-heatmap-custom-control><label for="heatTo" class="form-label">Hasta</label><input id="heatTo" name="to" type="date" class="form-control" value="@Model.HeatmapTo?.ToString("yyyy-MM-dd")" /></div><div class="col-sm-4 col-lg-2 @(Model.MapMetric == "activity" && Model.HeatmapPeriod == "custom" ? "" : "d-none")" data-heatmap-custom-control><button class="btn btn-outline-primary w-100">Aplicar</button></div>
            </form>
            <div class="map-heat-legend mt-3" aria-label="Escala del mapa de calor"><span><i class="heat-swatch heat-0"></i><span data-heatmap-zero-label>@(Model.MapMetric == "activity" ? "Sin actividad" : "Sin ocupación")</span></span><span class="@(Model.MapMetric == "occupancy" ? "" : "d-none")" data-heatmap-unavailable-legend><i class="heat-swatch heat-unavailable"></i>Sin posiciones evaluables</span><span><i class="heat-swatch heat-1"></i>Baja</span><span><i class="heat-swatch heat-2"></i>Moderada</span><span><i class="heat-swatch heat-3"></i>Alta</span><span><i class="heat-swatch heat-4"></i>Crítica</span></div>
        </section>
    }
    <div class="alert alert-danger @(Model.HeatmapError is null ? "d-none" : "")" role="alert" data-heatmap-error>@Model.HeatmapError</div>
    @if(!Model.Map.IsInitialized){<div class="alert alert-info"><strong>Vista previa sin guardar.</strong> El croquis aún no tiene una revisión guardada.</div>}
    <div class="warehouse-map-shell" data-warehouse-map data-highlight-location="@Model.HighlightLocationId"
         data-canvas-width="@Model.Map.CanvasWidth.ToString(global::System.Globalization.CultureInfo.InvariantCulture)"
         data-canvas-height="@Model.Map.CanvasHeight.ToString(global::System.Globalization.CultureInfo.InvariantCulture)">
        <div class="warehouse-map-viewport" data-map-viewport tabindex="0" aria-label="Croquis interactivo del almacén">
            <svg class="warehouse-map" viewBox="0 0 @Model.Map.CanvasWidth.ToString(global::System.Globalization.CultureInfo.InvariantCulture) @Model.Map.CanvasHeight.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" role="img" aria-labelledby="warehouse-map-title">
                <title id="warehouse-map-title">Croquis del almacén Warehouse EPI</title>
                <partial name="/Pages/Admin/Catalogs/Locations/_WarehouseMapArchitecture.cshtml" model="Model.Map.Architecture" />
                <g data-map-layer>
                @foreach(var element in Model.Map.Elements.OrderBy(item=>item.ZIndex))
                {
                    var state = MapState(element); var match = element.Positions.Any(position=>Model.MapMatches.Contains(position.LocationId));
                    Model.HeatmapByElementId.TryGetValue(element.Id, out var heatItem);
                    var noEvaluablePositions = heatItem is not null && Model.MapMetric == "occupancy" && heatItem.TotalPositions == 0;
                    var heatClass = heatItem is null || element.Kind != "Rack" ? "" : noEvaluablePositions ? "map-heat-unavailable" : $"map-heat-{heatItem.HeatLevel}";
                    var heatLabel = heatItem is null ? "" : Model.MapMetric == "activity" ? heatItem.AccessCount == 0 ? ", sin actividad" : $", {heatItem.AccessCount} operaciones" : noEvaluablePositions ? ", sin posiciones evaluables" : $", {heatItem.OccupancyPercent:0.##}% ocupado";
                    var heatValue = heatItem is null ? "" : Model.MapMetric == "activity" ? $"{heatItem.AccessCount} mov." : noEvaluablePositions ? "N/D" : $"{heatItem.OccupancyPercent:0.##}%";
                    <g class="map-element @state @(element.IsWip?"wip":"") @(match?"is-match":"") @heatClass" transform="translate(@element.X.ToString(global::System.Globalization.CultureInfo.InvariantCulture) @element.Y.ToString(global::System.Globalization.CultureInfo.InvariantCulture)) rotate(@element.Rotation)" tabindex="0" role="button" aria-label="Abrir @element.Label, @StateLabel(state)@heatLabel" data-map-base-label="Abrir @element.Label, @StateLabel(state)" data-map-open="@element.Id" data-map-target="@match.ToString().ToLowerInvariant()" data-heat-level="@heatItem?.HeatLevel">
                        <rect width="@element.Width.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" height="@element.Height.ToString(global::System.Globalization.CultureInfo.InvariantCulture)" rx="4"/><text x="6" y="18">@element.Label</text><text class="map-heat-value @(heatItem is null ? "d-none" : "")" data-heatmap-value x="6" y="34">@heatValue</text>@if(element.Positions.Any(position=>position.HasNegative)){<circle class="map-alert-dot" cx="@(element.Width-8)" cy="8" r="6"/>}
                    </g>
                }
                </g>
            </svg>
        </div>
        <aside class="warehouse-map-detail" aria-live="polite"><div class="map-detail-placeholder"><h2 class="h5">Selecciona un rack o área</h2><p>Consulta sus posiciones, saldos y asignaciones sin salir del croquis.</p></div>
        @foreach(var element in Model.Map.Elements)
        {
            <section class="map-element-detail @(element.Kind=="Rack" && element.IsWip?"map-element-detail-wip-rack":"")" data-map-detail="@element.Id" hidden><div class="d-flex justify-content-between gap-2"><div><span class="text-body-secondary">@(element.Kind=="Rack"?"Rack":element.IsWip?"WIP con existencias reales":"Área")</span><div class="d-flex align-items-center gap-2 flex-wrap"><h2 class="h4 mb-0">@element.Label</h2>@if(element.Kind=="Rack" && element.IsWip){<span class="badge text-bg-warning">WIP</span>}</div></div><button type="button" class="btn-close" data-map-close aria-label="Cerrar detalle"></button></div>
            @if(element.Kind=="Rack")
            {
                var issues = Model.RecentWipIssues.GetValueOrDefault(element.Id) ?? [];
                var wipPositions = element.Positions
                    .Where(position => position.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip)
                    .OrderBy(position => position.PalletNumber)
                    .ToArray();
                var wipProducts = wipPositions
                    .SelectMany(position => position.Products
                        .Where(product => product.Quantity != 0)
                        .Select(product => new { PositionCode = position.Code, Product = product }))
                    .OrderBy(item => item.PositionCode)
                    .ThenBy(item => item.Product.Sku)
                    .ToArray();
                <div class="d-flex justify-content-between align-items-center gap-2 mb-2"><span class="small text-body-secondary">Posiciones físicas</span><div class="d-flex flex-wrap gap-1"><a asp-page="@printPage" asp-route-rowCode="@element.RowCode" asp-route-rackNumber="@element.RackNumber" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">Imprimir hoja</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Rack/Edit" asp-route-rowCode="@element.RowCode" asp-route-rackNumber="@element.RackNumber" class="btn btn-sm btn-outline-secondary">Editar rack</a>}</div></div>
                <div class="map-keypad">@foreach(var pallet in new short[]{7,8,9,4,5,6,1,2,3}) { var position=element.Positions.FirstOrDefault(item=>item.PalletNumber==pallet); if(position is null){<span class="map-position missing"><strong>@pallet</strong><small>No existe</small></span>}else{<button type="button" class="map-position @PositionState(position)" data-map-position="@position.LocationId" data-map-position-match="@Model.MapMatches.Contains(position.LocationId).ToString().ToLowerInvariant()"><strong>@pallet</strong><small>@position.Code</small><span>@position.ProductCount producto(s)</span></button>} }</div>
                @foreach(var position in element.Positions)
                {
                    <div class="map-position-detail" data-position-detail="@position.LocationId" hidden><h3 class="h5">@position.Code</h3><p>@(position.Description??"Sin descripción")</p><div class="d-flex gap-2 flex-wrap mb-2"><span class="badge text-bg-light border">@position.AssignmentCount asignación(es)</span>@if(position.HasNegative){<span class="badge text-bg-danger">Saldo negativo</span>}else if(position.HasInventory){<span class="badge text-bg-primary">Con saldo</span>}else{<span class="badge text-bg-secondary">Sin saldo</span>}</div>@foreach(var product in position.Products){<div class="map-product-row"><a asp-page="/Inventory/Index" asp-route-productId="@product.ProductId">@(string.IsNullOrEmpty(product.Sku)?"Producto":product.Sku)</a><span class="@(product.Quantity<0?"text-danger":"")">@product.Quantity.ToString("0.####") @product.Unit</span><small>@(product.IsAssigned?"Asignado":"Sin asignación activa")</small>@if(!element.IsWip && position.IsActive && !position.IsBlocked){<div class="dropdown"><button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Operar</button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-page="/Operations/Entry" asp-route-productId="@product.ProductId" asp-route-destinationLocationId="@position.LocationId">Entrada</a></li><li><a class="dropdown-item" asp-page="/Operations/Exit" asp-route-mode="general" asp-route-productId="@product.ProductId" asp-route-sourceLocationId="@position.LocationId">Salida</a></li><li><a class="dropdown-item" asp-page="/Operations/Transfer" asp-route-productId="@product.ProductId" asp-route-sourceLocationId="@position.LocationId">Transferencia</a></li><li><a class="dropdown-item" asp-page="/Operations/Adjustment" asp-route-productId="@product.ProductId" asp-route-locationId="@position.LocationId">Ajuste</a></li></ul></div>}</div>}
                    @if(element.IsWip && position.IsActive && !position.IsBlocked)
                    {
                        <div class="map-wip-position-actions d-flex flex-wrap gap-2 mt-3"><a asp-page="/Operations/Exit" asp-route-mode="wip" asp-route-destinationLocationId="@position.LocationId" class="btn btn-primary">Surtir</a><a asp-page="/Operations/WipProcess" asp-route-wipCode="@position.Code" class="btn btn-outline-primary">Procesar</a><a asp-page="/Reports/Wip/Index" asp-route-wipAreaId="@position.LocationId" class="btn btn-outline-secondary">Reporte</a><a asp-page="@detailsPage" asp-route-id="@position.LocationId" class="btn btn-outline-secondary">Ficha</a><a asp-page="/Inventory/Index" asp-route-locationId="@position.LocationId" class="btn btn-outline-secondary">Existencias</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">Movimientos</a>}</div>
                    }
                    else if(position.IsActive && !position.IsBlocked)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-3"><div class="dropdown"><button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Nueva operación</button><ul class="dropdown-menu"><li><a class="dropdown-item" asp-page="/Operations/Entry" asp-route-destinationLocationId="@position.LocationId">Entrada</a></li><li><a class="dropdown-item" asp-page="/Operations/Exit" asp-route-mode="general" asp-route-sourceLocationId="@position.LocationId">Salida</a></li><li><a class="dropdown-item" asp-page="/Operations/Transfer" asp-route-sourceLocationId="@position.LocationId">Transferencia</a></li><li><a class="dropdown-item" asp-page="/Operations/Adjustment" asp-route-locationId="@position.LocationId">Ajuste</a></li></ul></div><a asp-page="@detailsPage" asp-route-id="@position.LocationId" class="btn btn-outline-secondary">Ficha</a><a asp-page="/Inventory/Index" asp-route-locationId="@position.LocationId" class="btn btn-outline-secondary">Existencias</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">Movimientos</a>}</div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 mt-3 mb-0"><strong>No disponible para nuevas operaciones.</strong> Consulta el saldo y el motivo antes de usar otra ubicación.</div>
                    }
                    </div>
                }
                @if(element.IsWip)
                {
                    <details class="map-wip-summary mt-3"><summary><strong>Resumen del rack WIP</strong><small>Existencias combinadas y últimos surtimientos</small></summary><div class="map-wip-summary-body">
                    <h3 class="h6">Existencias actuales</h3>
                    @if(wipProducts.Length == 0)
                    {
                        <p class="text-body-secondary">Este WIP no tiene existencias actualmente.</p>
                    }
                    else
                    {
                        <div class="map-wip-inventory">@foreach(var item in wipProducts){<div class="map-product-row"><a asp-page="/Inventory/Index" asp-route-productId="@item.Product.ProductId">@(string.IsNullOrEmpty(item.Product.Sku)?"Producto":item.Product.Sku)</a><strong class="@(item.Product.Quantity<0?"text-danger":"")">@item.Product.Quantity.ToString("0.####") @item.Product.Unit</strong><small>@item.PositionCode · @(string.IsNullOrWhiteSpace(item.Product.Description)?"Sin descripción":item.Product.Description)</small></div>}</div>
                    }
                    <h3 class="h6 mt-3">Últimos surtimientos</h3>
                    @if(issues.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">Aún no hay surtimientos registrados en este WIP.</p>
                    }
                    else
                    {
                        <div class="map-wip-issues">@foreach(var issue in issues){<a asp-page="/Reports/Wip/Details" asp-route-id="@issue.MovementLineId" class="map-wip-issue"><div class="d-flex justify-content-between gap-2"><strong>@issue.ProductSku</strong><time datetime="@issue.OccurredAt.ToString("O")">@issue.OccurredAt.ToString("dd/MM/yyyy HH:mm")</time></div>@if(!string.IsNullOrWhiteSpace(issue.ProductDescription)){<span class="map-wip-description">@issue.ProductDescription</span>}<span><strong>Enviado:</strong> @issue.Issued.ToString("0.####") @issue.Unit desde @issue.SourceLocation</span><span><strong>Responsable:</strong> @issue.Responsible</span><span><strong>Devuelto:</strong> @((issue.WarehouseReturned + issue.SupplierReturned).ToString("0.####")) @issue.Unit · <strong>Consumo asumido:</strong> @issue.AssumedConsumed.ToString("0.####") @issue.Unit</span></a>}</div>
                    }
                    </div></details>
                }
            }
            else if(element.IsWip)
            {
                var wipAreaId = element.LocationId;
                var wipAreaPosition = element.Positions.FirstOrDefault();
                var issues = Model.RecentWipIssues.GetValueOrDefault(element.Id) ?? [];
                var wipProducts = element.Positions.SelectMany(position => position.Products.Where(product => product.Quantity != 0)).OrderBy(product => product.Sku).ToArray();
                <h3 class="h6 mt-3">Existencias actuales</h3>@if(wipProducts.Length == 0){<p class="text-body-secondary">Este WIP no tiene existencias actualmente.</p>}else{<div class="map-wip-inventory">@foreach(var product in wipProducts){<div class="map-product-row"><a asp-page="/Inventory/Index" asp-route-productId="@product.ProductId">@(string.IsNullOrEmpty(product.Sku)?"Producto":product.Sku)</a><strong class="@(product.Quantity<0?"text-danger":"")">@product.Quantity.ToString("0.####") @product.Unit</strong><small>@(string.IsNullOrWhiteSpace(product.Description)?"Sin descripción":product.Description)</small></div>}</div>}
                <h3 class="h6 mt-3">Últimos surtimientos</h3>@if(issues.Count == 0){<p class="text-body-secondary">Aún no hay surtimientos registrados en este WIP.</p>}else{<div class="map-wip-issues">@foreach(var issue in issues){<a asp-page="/Reports/Wip/Details" asp-route-id="@issue.MovementLineId" class="map-wip-issue"><div class="d-flex justify-content-between gap-2"><strong>@issue.ProductSku</strong><time datetime="@issue.OccurredAt.ToString("O")">@issue.OccurredAt.ToString("dd/MM/yyyy HH:mm")</time></div>@if(!string.IsNullOrWhiteSpace(issue.ProductDescription)){<span class="map-wip-description">@issue.ProductDescription</span>}<span><strong>Enviado:</strong> @issue.Issued.ToString("0.####") @issue.Unit desde @issue.SourceLocation</span><span><strong>Responsable:</strong> @issue.Responsible</span><span><strong>Devuelto:</strong> @((issue.WarehouseReturned + issue.SupplierReturned).ToString("0.####")) @issue.Unit · <strong>Consumo asumido:</strong> @issue.AssumedConsumed.ToString("0.####") @issue.Unit</span></a>}</div>}
                @if(wipAreaId is Guid destinationId){<div class="d-flex flex-wrap gap-2 mt-3">@if(wipAreaPosition is { IsActive: true, IsBlocked: false }){<a asp-page="/Operations/Exit" asp-route-mode="wip" asp-route-destinationLocationId="@destinationId" class="btn btn-primary">Surtir a este WIP</a><a asp-page="/Operations/WipProcess" asp-route-wipCode="@element.Label" class="btn btn-outline-primary">Procesar WIP</a>}else{<span class="alert alert-warning py-2 mb-0">No disponible para nuevas operaciones.</span>}<a asp-page="/Reports/Wip/Index" asp-route-wipAreaId="@destinationId" class="btn btn-outline-secondary">Ver reporte WIP</a><a asp-page="@detailsPage" asp-route-id="@destinationId" class="btn btn-outline-secondary">Ficha</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Area" asp-route-locationId="@destinationId" class="btn btn-outline-secondary">Editar área</a>}</div>}
            }
            else
            {
                @foreach(var position in element.Positions){<div class="map-position-detail" data-position-detail="@position.LocationId" hidden><h3 class="h5">@position.Code</h3><p>@(position.Description??"Sin descripción")</p><div class="d-flex gap-2 flex-wrap mb-2"><span class="badge text-bg-light border">@position.AssignmentCount asignación(es)</span>@if(position.HasNegative){<span class="badge text-bg-danger">Saldo negativo</span>}else if(position.HasInventory){<span class="badge text-bg-primary">Con saldo</span>}else{<span class="badge text-bg-secondary">Sin saldo</span>}</div>@foreach(var product in position.Products){<div class="map-product-row"><a asp-page="/Inventory/Index" asp-route-productId="@product.ProductId">@(string.IsNullOrEmpty(product.Sku)?"Producto":product.Sku)</a><span class="@(product.Quantity<0?"text-danger":"")">@product.Quantity.ToString("0.####") @product.Unit</span><small>@(product.IsAssigned?"Asignado":"Sin asignación activa")</small>@if(position.IsActive&&!position.IsBlocked){<div class="dropdown"><button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Operar</button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-page="/Operations/Entry" asp-route-productId="@product.ProductId" asp-route-destinationLocationId="@position.LocationId">Entrada</a></li><li><a class="dropdown-item" asp-page="/Operations/Exit" asp-route-mode="general" asp-route-productId="@product.ProductId" asp-route-sourceLocationId="@position.LocationId">Salida</a></li><li><a class="dropdown-item" asp-page="/Operations/Transfer" asp-route-productId="@product.ProductId" asp-route-sourceLocationId="@position.LocationId">Transferencia</a></li><li><a class="dropdown-item" asp-page="/Operations/Adjustment" asp-route-productId="@product.ProductId" asp-route-locationId="@position.LocationId">Ajuste</a></li></ul></div>}</div>}@if(position.IsActive&&!position.IsBlocked){<div class="d-flex flex-wrap gap-2 mt-3"><div class="dropdown"><button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">Nueva operación</button><ul class="dropdown-menu"><li><a class="dropdown-item" asp-page="/Operations/Entry" asp-route-destinationLocationId="@position.LocationId">Entrada</a></li><li><a class="dropdown-item" asp-page="/Operations/Exit" asp-route-mode="general" asp-route-sourceLocationId="@position.LocationId">Salida</a></li><li><a class="dropdown-item" asp-page="/Operations/Transfer" asp-route-sourceLocationId="@position.LocationId">Transferencia</a></li><li><a class="dropdown-item" asp-page="/Operations/Adjustment" asp-route-locationId="@position.LocationId">Ajuste</a></li></ul></div><a asp-page="@detailsPage" asp-route-id="@position.LocationId" class="btn btn-outline-secondary">Ficha</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Area" asp-route-locationId="@position.LocationId" class="btn btn-outline-secondary">Editar área</a>}<a asp-page="/Inventory/Index" asp-route-locationId="@position.LocationId" class="btn btn-outline-secondary">Existencias</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">Movimientos</a>}</div>}else{<div class="alert alert-warning py-2 mt-3 mb-0">No disponible para nuevas operaciones.</div>}</div>}
            }
            </section>
        }
        </aside>
    </div>
    @if(Model.MapMetric != "normal" && Model.Heatmap is not null)
    {
        var placedIds = Model.Map.Elements.Select(element => element.Id).ToHashSet();
        var unplacedHeat = Model.Heatmap.AllRacks.Where(item => !placedIds.Contains(item.ElementId)).ToArray();
        @if(unplacedHeat.Length > 0)
        {
            <details class="card card-body mt-3"><summary><strong>Racks sin colocar en el croquis (@unplacedHeat.Length)</strong></summary><div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Rack</th><th class="text-end">Operaciones</th><th class="text-end">Ocupación</th><th class="text-end">Incidencias</th></tr></thead><tbody>@foreach(var rack in unplacedHeat){<tr data-heatmap-rack-row="@rack.ElementId"><td>@rack.Label</td><td class="text-end" data-heatmap-access>@rack.AccessCount</td><td class="text-end" data-heatmap-occupancy>@rack.OccupiedPositions/@rack.TotalPositions (@rack.OccupancyPercent.ToString("0.##")%)</td><td class="text-end" data-heatmap-incidents>@rack.NegativePositions negativas · @rack.BlockedPositions bloqueadas</td></tr>}</tbody></table></div></details>
        }
    }
    <div class="visually-hidden"><h2>Lista accesible del croquis</h2><ul>@foreach(var element in Model.Map.Elements){<li><button type="button" data-map-open="@element.Id">@element.Label, @StateLabel(MapState(element))</button></li>}</ul></div>
}
else if(Model.ViewMode=="racks")
{
    <div class="rack-filter-bar mb-3" role="group" aria-label="Filtrar racks">
        @foreach(var filter in new[]{("all","Todos"),("occupied","Con saldo"),("empty","Sin saldo"),("issues","Con incidencias")}){<a class="rack-filter rack-filter-@filter.Item1 @(Model.RackFilter==filter.Item1?"is-active":"")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-kind="rack" asp-route-rowCode="@Model.RowCode" asp-route-viewMode="racks" asp-route-rackFilter="@filter.Item1" aria-current="@(Model.RackFilter==filter.Item1?"true":null)">@filter.Item2</a>}
    </div>
    @if(Model.LayoutRacks.Count==0)
    {
        <div class="locations-empty"><p class="locations-empty-title">Ningún rack coincide con estos filtros.</p><p>Cambia el estado, quita la fila o limpia la búsqueda para ver el almacén completo.</p><a asp-page="Index" asp-route-viewMode="racks" class="btn btn-outline-primary btn-lg">Ver todos los racks</a></div>
    }
    else
    {
        <div class="rack-view-shell" data-rack-view>
            <div class="rack-view-grid">
            @foreach(var rowGroup in Model.LayoutRacks.GroupBy(rack => rack.RowCode))
            {
                var racks = rowGroup.ToArray(); var positions = racks.SelectMany(rack => rack.Positions).OfType<LocationIndexPageModel.LocationRow>().ToArray();
                var issueCount = positions.Count(position=>position.HasIssue);
                <section class="rack-row-section">
                    <header class="rack-row-header">
                        <div class="rack-row-id"><span>Fila</span><h2 class="rack-row-letter">@rowGroup.Key</h2></div>
                        <div class="rack-row-metrics">
                            <span><strong>@racks.Length</strong> racks</span>
                            <span><strong>@positions.Count(position=>position.HasInventory)</strong> con saldo</span>
                            <span><strong>@positions.Count(position=>!position.HasInventory)</strong> sin saldo</span>
                            <span class="@(issueCount>0?"is-issue":"")"><strong>@issueCount</strong> incidencias</span>
                        </div>
                    </header>
                    <div class="rack-bay-list">
                    @foreach(var rack in racks)
                    {
                        <article class="rack-bay rack-@rack.RackState">
                            <header class="rack-bay-header">
                                <div class="rack-bay-id"><span>Rack</span><h3 class="rack-bay-code">@rack.RowCode-@rack.RackNumber</h3>@if(rack.IsWip){<span class="badge text-bg-warning">Rack WIP</span>}</div>
                                <p class="rack-bay-fill"><strong>@rack.OccupiedCount</strong>/@rack.PositionCount<span>con saldo</span></p>
                                <div class="rack-bay-actions"><a asp-page="@printPage" asp-route-rowCode="@rack.RowCode" asp-route-rackNumber="@rack.RackNumber" class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener">Imprimir</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Catalogs/Locations/Rack/Edit" asp-route-rowCode="@rack.RowCode" asp-route-rackNumber="@rack.RackNumber" class="btn btn-sm btn-outline-secondary">Editar</a>}</div>
                            </header>
                            <div class="rack-bay-frame">
                            @foreach(var position in rack.Positions)
                            {
                                @if(position is null){<div class="bay-slot bay-missing"><span class="bay-pallet" aria-hidden="true">·</span><span class="bay-note">Sin posición</span></div>}
                                else
                                {
                                    var primaryBalance = position.Balances.FirstOrDefault();
                                    <a asp-page="@detailsPage" asp-route-id="@position.Id" class="bay-slot bay-@position.RackState" data-rack-open="@position.Id" aria-controls="rack-detail-@position.Id" aria-label="@position.Code, @RackStateLabel(position.RackState)">
                                        <span class="bay-head"><strong class="bay-pallet">@position.PalletNumber</strong><span class="bay-code">@position.Code</span></span>
                                        @if(position.IsWip){<span class="badge text-bg-warning">WIP</span>}
                                        @if(position.RackState is "negative" or "blocked" or "inactive"){<span class="bay-flag"><svg class="app-icon" aria-hidden="true"><use href="#icon-alert" /></svg>@RackStateLabel(position.RackState)</span>}
                                        @if(primaryBalance is not null){<span class="sku-chip">@primaryBalance.Sku</span>@if(position.Balances.Count>1){<span class="sku-more">+@(position.Balances.Count-1) producto(s)</span>}}
                                        else if(position.ProductCount>0){<span class="sku-chip">@position.Skus.FirstOrDefault()</span><span class="sku-more">Asignado sin saldo</span>}
                                        else{<span class="bay-note">Sin saldo</span>}
                                    </a>
                                }
                            }
                            </div>
                        </article>
                    }
                    </div>
                </section>
            }
            </div>
            <aside class="rack-detail-panel" aria-live="polite"><div class="rack-detail-placeholder"><h2 class="h5">Selecciona una posición</h2><p>Consulta saldos, asignaciones y movimientos sin salir de la fila.</p></div>
            @foreach(var position in Model.Locations.Where(location=>location.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack))
            {
                <section id="rack-detail-@position.Id" class="rack-position-detail" data-rack-detail="@position.Id" hidden><div class="d-flex justify-content-between gap-2"><div><span class="text-body-secondary">Ubicación</span><h2 class="h4 mb-1">@position.Code</h2><span class="badge text-bg-light border">@RackStateLabel(position.RackState)</span>@if(position.IsWip){<span class="badge text-bg-warning ms-1">WIP</span>}</div><button type="button" class="btn-close" data-rack-close aria-label="Cerrar detalle"></button></div>
                @if(position.IsBlocked){<p class="alert alert-warning py-2 mt-3 mb-2"><strong>Bloqueada.</strong> @position.BlockReason</p>}else if(!position.IsActive){<p class="alert alert-secondary py-2 mt-3 mb-2"><strong>Inactiva.</strong> No está disponible para nuevas operaciones.</p>}
                <h3 class="h6 mt-3">Saldos actuales</h3>@if(position.Balances.Count==0){<p class="text-body-secondary">Sin saldo registrado. Registra una entrada para empezar a usar la posición.</p>}else{<div class="rack-balance-list">@foreach(var balance in position.Balances){<div><div><strong>@balance.Sku</strong><small>@(balance.Description??"Sin descripción") · @(balance.IsAssigned?"Asignado":"Sin asignación activa")</small></div><span class="@(balance.Quantity<0?"text-danger":"")">@balance.Quantity.ToString("0.####") @balance.Unit</span></div>}</div>}
                <div class="d-flex flex-wrap gap-2 mt-3"><a asp-page="@detailsPage" asp-route-id="@position.Id" class="btn btn-primary">Ficha</a><a asp-page="/Inventory/Index" asp-route-locationId="@position.Id" class="btn btn-outline-secondary">Existencias</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">Movimientos</a>}</div></section>
            }
            </aside>
        </div>
    }
}
else
{
    <div class="table-responsive"><table class="table align-middle inventory-list location-table"><thead><tr><th scope="col">Ubicación</th><th scope="col">Posición física</th><th scope="col">Productos asignados</th><th scope="col">Estado</th><th scope="col" class="text-end">@(Model.IsAdministrativeView ? "Acciones" : "Consulta")</th></tr></thead><tbody>
    @if(Model.Locations.Count==0){<tr><td colspan="5"><div class="locations-empty"><p class="locations-empty-title">Ninguna ubicación coincide con estos filtros.</p><p>Cambia el estado, quita la fila o limpia la búsqueda para ver el catálogo completo.</p><a asp-page="Index" asp-route-viewMode="table" class="btn btn-outline-primary btn-lg">Ver todas las ubicaciones</a></div></td></tr>}
    @foreach(var item in Model.Locations)
    {
        <tr class="location-row location-row-@AdminState(item)">
            <td data-label="Ubicación"><a asp-page="@detailsPage" asp-route-id="@item.Id" class="location-code">@item.Code</a>@if(item.IsWip){<span class="badge text-bg-warning">WIP</span>}@if(item.Description is not null){<span class="location-desc">@item.Description</span>}</td>
            <td data-label="Posición física">@if(item.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack){<span class="pos-triple"><span><small>Fila</small><strong>@item.RowCode</strong></span><span><small>Rack</small><strong>@item.RackNumber</strong></span><span><small>Pallet</small><strong>@item.PalletNumber</strong></span></span>}else{<span class="pos-area">Área especial</span>}</td>
            <td data-label="Productos asignados">@if(item.ProductCount==0){<span class="text-body-secondary">Sin asignar</span>}else{<span class="sku-list">@foreach(var sku in item.Skus){<span class="sku-chip">@sku</span>}@if(item.ProductCount>item.Skus.Count){<span class="sku-more">+@(item.ProductCount-item.Skus.Count) más</span>}</span>}</td>
            <td data-label="Estado">@if(!item.IsPhysicallyPresent){<span class="state-tag state-retired">Retirada</span>}else if(!item.IsActive){<span class="state-tag state-inactive">Inactiva</span>}else if(item.IsBlocked){<span class="state-tag state-blocked"><svg class="app-icon" aria-hidden="true"><use href="#icon-alert" /></svg>Bloqueada</span><span class="state-reason">@item.BlockReason</span>}else{<span class="state-tag state-available">Disponible</span>}</td>
            <td data-label="@(Model.IsAdministrativeView ? "Acciones" : "Consulta")" class="text-end">@if(Model.IsAdministrativeView){<div class="dropdown"><button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Acciones</button><ul class="dropdown-menu dropdown-menu-end"><li><a asp-page="@detailsPage" asp-route-id="@item.Id" class="dropdown-item">Ver ficha</a></li>@if(item.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack){<li><a asp-page="/Admin/Catalogs/Locations/Rack/Edit" asp-route-rowCode="@item.RowCode" asp-route-rackNumber="@item.RackNumber" class="dropdown-item">Editar rack</a></li>}else{<li><a asp-page="/Admin/Catalogs/Locations/Area" asp-route-locationId="@item.Id" class="dropdown-item">Editar área</a></li>}@if(item.IsPhysicallyPresent){<li><hr class="dropdown-divider"/></li>@if(item.IsActive&&!item.IsBlocked){<li><button type="button" class="dropdown-item text-warning block-location" data-bs-toggle="modal" data-bs-target="#blockModal" data-location-id="@item.Id" data-location-code="@item.Code">Bloquear</button></li>}else if(item.IsBlocked){<li><form method="post" asp-page-handler="Unblock"><input type="hidden" name="id" value="@item.Id"/><button class="dropdown-item text-success">Desbloquear</button></form></li>}<li><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@item.Id"/><button class="dropdown-item">@(item.IsActive?"Desactivar":"Activar")</button></form></li>}</ul></div>}else{<a asp-page="@detailsPage" asp-route-id="@item.Id" class="btn btn-outline-primary">Ver ficha</a>}</td>
        </tr>
    }
    </tbody></table></div>
    @if(Model.TotalPages>1){<nav aria-label="Paginación"><ul class="pagination justify-content-center flex-wrap"><li class="page-item @(Model.CurrentPage<=1?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(1)">Primera</a></li><li class="page-item @(Model.CurrentPage<=1?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.CurrentPage-1)">Anterior</a></li>@foreach(var pageNumber in Model.VisiblePages){<li class="page-item @(pageNumber==Model.CurrentPage?"active":"")"><a class="page-link" asp-all-route-data="@RouteValues(pageNumber)">@pageNumber</a></li>}<li class="page-item @(Model.CurrentPage>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.CurrentPage+1)">Siguiente</a></li><li class="page-item @(Model.CurrentPage>=Model.TotalPages?"disabled":"")"><a class="page-link" asp-all-route-data="@RouteValues(Model.TotalPages)">Última</a></li></ul></nav>}
}

@if(Model.IsAdministrativeView){<div class="modal fade" id="blockModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><form method="post" asp-page-handler="Block"><div class="modal-header"><h2 class="modal-title fs-5" id="blockModalLabel">Bloquear ubicación</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><input type="hidden" id="blockLocationId" name="id"/><p id="blockLocationText"></p><label for="blockReason" class="form-label">Motivo</label><textarea id="blockReason" name="reason" class="form-control" maxlength="200" rows="3" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-warning">Bloquear</button></div></form></div></div></div>}

@functions{
    private Dictionary<string,string?> RouteValues(int pageNumber) => new()
    {
        ["search"] = Model.Search, ["status"] = Model.Status, ["kind"] = Model.Kind,
        ["rowCode"] = Model.RowCode, ["viewMode"] = "table", ["pageNumber"] = pageNumber.ToString()
    };
    private static string MapState(WarehouseMapElementView element) => element.Positions.Any(item=>item.HasNegative)?"negative":element.Positions.All(item=>!item.IsActive)?"inactive":element.Positions.Any(item=>item.IsBlocked)?"blocked":element.Positions.Any(item=>item.HasInventory)?"occupied":"available";
    private static string PositionState(WarehouseMapPosition item) => item.HasNegative?"negative":!item.IsActive?"inactive":item.IsBlocked?"blocked":item.HasInventory?"occupied":"available";
    private static string StateLabel(string state) => state switch{"negative"=>"saldo negativo","inactive"=>"inactivo","blocked"=>"bloqueado","occupied"=>"con inventario",_=>"disponible"};
    private static string RackStateLabel(string state) => state switch{"negative"=>"Saldo negativo","inactive"=>"Inactiva","blocked"=>"Bloqueada","occupied"=>"Con saldo",_=>"Sin saldo"};
    private static string AdminState(LocationIndexPageModel.LocationRow item) => !item.IsPhysicallyPresent?"retired":!item.IsActive?"inactive":item.IsBlocked?"blocked":"available";
}
