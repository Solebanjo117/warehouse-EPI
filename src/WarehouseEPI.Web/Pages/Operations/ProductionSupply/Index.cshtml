@page
@model WarehouseEPI.Web.Pages.Operations.ProductionSupply.IndexModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@using WarehouseEPI.Core.Entities
@{ ViewData["Title"] = ProdTexts["Surtimientos a producción"].Value; }

<div class="supply-queue" data-supply-queue data-snapshot-url="@Url.Page(null, "Snapshot",new{Model.Search,Model.Condition,Model.PageNumber})" data-signature="@Model.QueuePage.Signature" data-checked-at="@Model.QueuePage.CheckedAt.ToString("O")" data-pending-orders="@Model.PendingOrders">
    <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><span class="eyebrow">@ProdTexts["Operación"]</span><h1 class="h2 mb-1">@ProdTexts["Surtimientos a producción"]</h1><p class="text-body-secondary mb-0">@ProdTexts["Prepara lo pendiente y entrégalo al WIP indicado por la orden."]</p></div>
        <div class="supply-count"><strong>@Model.PendingOrders</strong><span>@ProdTexts["órdenes pendientes"]</span></div>
    </header>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger" role="alert" tabindex="-1">@error</div> }
    <form method="get" class="card card-body mb-4 supply-filters">
        <div><label asp-for="Search" class="form-label">@ProdTexts["Orden o producto"]</label><input asp-for="Search" class="form-control form-control-lg" type="search" autocomplete="off" /></div>
        <div><label asp-for="Condition" class="form-label">@ProdTexts["Condición"]</label><select asp-for="Condition" class="form-select form-select-lg"><option value="">@ProdTexts["Todas"]</option><option value="shortage">@ProdTexts["Con faltante"]</option><option value="partial">@ProdTexts["Parciales"]</option><option value="blocked">@ProdTexts["Pausadas"]</option></select></div>
        <button class="btn btn-outline-primary" type="submit">@ProdTexts["Consultar"]</button>
    </form>
    @if (Model.Rows.Count == 0)
    {
        <div class="card card-body text-center py-5"><h2 class="h4">@ProdTexts["Sin surtimientos pendientes"]</h2><p class="text-body-secondary mb-0">@ProdTexts["Cambia los filtros o espera a que se libere una orden nueva."]</p></div>
    }
    else
    {
        <div class="supply-list">
        @foreach (var group in Model.Rows.GroupBy(x=>new{x.WorkOrderId,x.WorkOrderStageId}))
        {
        <section aria-label="@ProdTexts["Orden y proceso"]"><h2 class="h5">@group.First().WorkOrderNumber · @group.First().Process</h2>
        @foreach (var row in group)
        {
            var blocked = row.OrderStatus == ProductionWorkOrderStatus.Paused;
            <article class="card supply-card @(row.Priority == ProductionSupplyPriority.Urgent ? "supply-card-urgent" : null)">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-2"><div><span class="badge text-bg-@(row.Priority == ProductionSupplyPriority.Urgent ? "danger" : "secondary")">@ProdTexts[row.Priority == ProductionSupplyPriority.Urgent ? "Urgente" : "Normal"]</span><h2 class="h4 mt-2 mb-1">@row.WorkOrderNumber · @row.FinishedProduct</h2><p class="mb-0 text-body-secondary">@ProdTexts["{0} · destino {1} · {2}", row.Process, row.Destination, row.DueDate?.ToString("dd/MM/yyyy") ?? ProdTexts["Sin fecha"].Value]</p></div><strong class="supply-material">@row.Material</strong></div>
                    <dl class="supply-quantities"><div><dt>@ProdTexts["Requerido"]</dt><dd>@row.Required @row.Unit</dd></div><div><dt>@ProdTexts["Entregado"]</dt><dd>@row.Delivered @row.Unit</dd></div><div><dt>@ProdTexts["Reservado"]</dt><dd>@row.Reserved @row.Unit</dd></div><div><dt>@ProdTexts["Pendiente"]</dt><dd>@row.Pending @row.Unit</dd></div><div class="@(row.Shortage > 0 ? "text-danger" : null)"><dt>@ProdTexts["Faltante"]</dt><dd>@row.Shortage @row.Unit</dd></div></dl>
                    @if (blocked) { <div class="alert alert-warning mb-3">@ProdTexts["Orden pausada. La entrega se habilitará al reanudarla."]</div> }
                    @if (row.Problem is not null) { <div class="alert alert-warning mb-3"><strong>@ProdTexts["Problema reportado:"]</strong> @row.Problem</div> }
                    @if (row.LastParticipant is not null) { <p class="small text-body-secondary">@ProdTexts["Preparación registrada por {0}. Otro operador puede continuar.", row.LastParticipant]</p> }
                    <div class="supply-actions">
                        @if (!blocked)
                        {
                            <a class="btn btn-primary" asp-page="/Operations/ProductionSupply/Prepare" asp-route-lineId="@row.LineId" asp-route-QueueSearch="@Model.Search" asp-route-QueueCondition="@Model.Condition" asp-route-QueuePage="@Model.PageNumber">@ProdTexts["Preparar entrega"]</a>
                        }
                        <details><summary class="btn btn-outline-secondary">@ProdTexts["Más acciones"]</summary><div class="supply-action-panel">
                            <form method="post" asp-route-Search="@Model.Search" asp-route-Condition="@Model.Condition" asp-route-PageNumber="@Model.PageNumber" asp-page-handler="Start"><input type="hidden" name="requestId" value="@row.RequestId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">@ProdTexts["Marcar participación no bloquea la preparación; otro operador puede continuar. NIP"]</label><div class="input-group"><input class="form-control" name="pin" type="password" inputmode="numeric" required/><button class="btn btn-outline-primary">@ProdTexts["Marcar que estoy preparando"]</button></div></form>
                            @if (row.Shortage > 0) { <form method="post" asp-page-handler="Reserve"><input type="hidden" name="lineId" value="@row.LineId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">@ProdTexts["Reservar existencia disponible"]</label><div class="input-group"><input class="form-control" name="quantity" type="number" min="0.0001" max="@row.Shortage" step="0.0001" value="@row.Shortage" required/><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="@ProdTexts["NIP"]" required/><button class="btn btn-outline-primary">@ProdTexts["Reservar"]</button></div></form> }
                            <form method="post" asp-page-handler="Problem"><input type="hidden" name="requestId" value="@row.RequestId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">@ProdTexts["Reportar problema"]</label><input class="form-control mb-2" name="reason" maxlength="500" required/><div class="input-group"><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="@ProdTexts["NIP"]" required/><button class="btn btn-outline-warning">@ProdTexts["Reportar"]</button></div></form>
                            @{ <form method="post" asp-page-handler="Priority"><input type="hidden" name="requestId" value="@row.RequestId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><input type="hidden" name="priority" value="@(row.Priority == ProductionSupplyPriority.Urgent ? ProdTexts["Normal"].Value : "Urgent")"/><label class="form-label">@ProdTexts["Cambiar prioridad"]</label><input class="form-control mb-2" name="reason" maxlength="500" required/><div class="input-group"><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="@ProdTexts["NIP ADMIN"]" required/><button class="btn btn-outline-secondary">@ProdTexts["Marcar {0}", row.Priority == ProductionSupplyPriority.Urgent ? ProdTexts["Normal"].Value : ProdTexts["Urgente"].Value]</button></div></form><form method="post" asp-page-handler="Cancel"><input type="hidden" name="lineId" value="@row.LineId"/><input type="hidden" name="expectedVersion" value="@row.RequestVersion"/><label class="form-label">@ProdTexts["Cancelar pendiente"]</label><input class="form-control mb-2" name="reason" maxlength="500" required/><div class="input-group"><input class="form-control" name="quantity" type="number" min="0.0001" max="@row.Pending" step="0.0001" value="@row.Pending" required/><input class="form-control" name="pin" type="password" inputmode="numeric" placeholder="@ProdTexts["NIP ADMIN"]" required/><button class="btn btn-outline-danger">@ProdTexts["Cancelar"]</button></div></form> }
                        </div></details>
                    </div>
                </div>
            </article>
        }
        </section>
        }
        </div>
    }
    <nav class="d-flex justify-content-between my-3" aria-label="@ProdTexts["Paginación por órdenes"]"><a class="btn btn-outline-primary @(Model.PageNumber<=1?"disabled":null)" asp-route-Search="@Model.Search" asp-route-Condition="@Model.Condition" asp-route-PageNumber="@(Model.PageNumber-1)">@ProdTexts["Anterior"]</a><span>@ProdTexts["Página {0} de {1} · {2} órdenes", Model.PageNumber, Model.QueuePage.TotalPages, Model.PendingOrders]</span><a class="btn btn-outline-primary @(Model.PageNumber>=Model.QueuePage.TotalPages?"disabled":null)" asp-route-Search="@Model.Search" asp-route-Condition="@Model.Condition" asp-route-PageNumber="@(Model.PageNumber+1)">@ProdTexts["Siguiente"]</a></nav>
    <button class="btn btn-outline-primary" type="button" data-queue-refresh>@ProdTexts["Actualizar"]</button><p role="status" aria-live="polite" data-supply-live></p>
</div>
@section Scripts { <script src="~/js/production-supply-queue.js" asp-append-version="true"></script> }

@section Styles { <link rel="stylesheet" href="~/css/production-workspace.css" asp-append-version="true"/> }
