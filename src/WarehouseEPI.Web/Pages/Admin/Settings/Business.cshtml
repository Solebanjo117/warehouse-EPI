@page
@model WarehouseEPI.Web.Pages.Admin.Settings.BusinessModel
@{ ViewData["Title"] = "Datos del negocio"; var logoUrl = ViewData["LogoUrl"] as string; }
<div class="row justify-content-center"><div class="col-12 col-xl-8"><h1 class="h2 mb-2">Datos del negocio</h1><p class="text-muted mb-4">Estos datos identifican el almacén y definen la fecha usada por lotes automáticos futuros.</p>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<form method="post" enctype="multipart/form-data" class="card shadow-sm"><div class="card-body p-4"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.BusinessName" class="form-label">Nombre del negocio</label><input asp-for="Input.BusinessName" class="form-control form-control-lg" /><span asp-validation-for="Input.BusinessName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Input.WarehouseName" class="form-label">Nombre del almacén</label><input asp-for="Input.WarehouseName" class="form-control form-control-lg" /><span asp-validation-for="Input.WarehouseName" class="text-danger"></span></div></div>
<div class="row"><div class="col-md-5 mb-3"><label asp-for="Input.WarehouseCode" class="form-label">Código del almacén</label><input asp-for="Input.WarehouseCode" class="form-control form-control-lg text-uppercase" /><span asp-validation-for="Input.WarehouseCode" class="text-danger"></span></div><div class="col-md-7 mb-3"><label asp-for="Input.TimeZoneId" class="form-label">Zona horaria IANA</label><input asp-for="Input.TimeZoneId" class="form-control form-control-lg" list="timezones" /><datalist id="timezones"><option value="America/Matamoros"></option><option value="America/Mexico_City"></option><option value="America/Tijuana"></option><option value="UTC"></option></datalist><span asp-validation-for="Input.TimeZoneId" class="text-danger"></span></div></div>
<fieldset class="border rounded-3 p-3 mt-2"><legend class="float-none w-auto px-2 h6">Logo</legend>@if (logoUrl is not null) { <img src="@logoUrl" class="business-logo-preview mb-3" alt="Logo actual del negocio" /> }<div class="mb-2"><label asp-for="Input.Logo" class="form-label">Imagen PNG, JPEG o WebP (máximo 1 MB)</label><input asp-for="Input.Logo" class="form-control" accept="image/png,image/jpeg,image/webp" /><span asp-validation-for="Input.Logo" class="text-danger"></span></div>@if (logoUrl is not null) { <div class="form-check"><input asp-for="Input.RemoveLogo" class="form-check-input" /><label asp-for="Input.RemoveLogo" class="form-check-label">Eliminar logo actual</label></div> }</fieldset>
<button class="btn btn-primary btn-lg mt-4">Guardar datos</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
