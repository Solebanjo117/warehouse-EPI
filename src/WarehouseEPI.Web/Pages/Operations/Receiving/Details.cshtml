@page "/Operations/Receiving/{id:guid}"
@using WarehouseEPI.Core.Entities
@using WarehouseEPI.Infrastructure.Inventory
@model WarehouseEPI.Web.Pages.Operations.Receiving.DetailsModel
@{ ViewData["Title"]=$"Recepción {Model.Document.Number}"; }
<div class="container-fluid py-3 receiving-shell"><header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><a asp-page="Index" class="small text-decoration-none">← Recepciones</a><h1 class="h2 mt-2 mb-1">@ReceivingQueryService.FormatType(Model.Document.Type) @Model.Document.Number</h1><p class="text-muted mb-0">@Model.Document.Origin · abierto por @Model.Document.OpenedBy el @Model.LocalOpenedAt.ToString("dd/MM/yyyy HH:mm")</p></div><div class="d-flex gap-2 align-items-start"><span class="badge fs-6 text-bg-primary">@StatusText(Model.Document.Status)</span>@if(Model.Document.CanReceive){<a class="btn btn-primary" asp-page="Receive" asp-route-id="@Model.Document.Id">Registrar recepción</a>}</div></header>
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<section class="operation-card mb-3"><div class="row g-3"><div class="col-sm-4"><span class="text-muted d-block">Fecha documental</span><strong>@(Model.Document.DocumentDate?.ToString("dd/MM/yyyy")??"Sin fecha")</strong></div><div class="col-sm-8"><span class="text-muted d-block">Notas</span><strong>@(Model.Document.Notes??"Sin notas")</strong></div></div></section>
<section class="operation-card mb-3"><h2 class="h5">Cumplimiento vigente</h2><div class="table-responsive receiving-table"><table class="table align-middle mb-0"><thead><tr><th>Producto</th><th>Esperado</th><th>Recibido efectivo</th><th>Diferencia</th></tr></thead><tbody>@foreach(var line in Model.Document.Lines){<tr><td data-label="Producto"><strong>@line.Sku</strong><div class="small text-muted">@line.Description</div></td><td data-label="Esperado">@line.Expected.ToString("0.####") @line.Unit</td><td data-label="Recibido">@line.Received.ToString("0.####") @line.Unit</td><td data-label="Diferencia" class="@(line.Difference==0?"text-success":"text-warning")"><strong>@line.Difference.ToString("+0.####;-0.####;0") @line.Unit</strong></td></tr>}</tbody></table></div></section>
<section class="operation-card mb-3"><h2 class="h5">Recepciones confirmadas</h2>@if(Model.Document.Confirmations.Count==0){<p class="text-muted mb-0">Todavía no hay Entradas vinculadas.</p>}@foreach(var confirmation in Model.Document.Confirmations){<article class="border rounded p-3 mb-2"><div class="d-flex justify-content-between gap-2 flex-wrap"><strong>@Model.ConfirmationDates[confirmation.Id].ToString("dd/MM/yyyy HH:mm") · @confirmation.Responsible</strong><a asp-page="/Operations/Receipt" asp-route-id="@confirmation.MovementId">Ver movimiento</a></div>@foreach(var line in confirmation.Lines){<div class="small mt-2"><strong>@line.Sku</strong> · @line.Quantity.ToString("0.####") @line.Unit → @line.Destination @if(line.ExternalLotReference is not null){<span> · Lote/rollo: @line.ExternalLotReference</span>} @if(line.Unexpected){<span class="badge text-bg-warning">Inesperado</span>}</div>}@if(confirmation.DifferenceNotes is not null){<p class="small text-warning mb-0 mt-2">@confirmation.DifferenceNotes</p>}</article>}</section>
<section class="operation-card mb-3"><h2 class="h5">Historial</h2><ol class="receiving-timeline">@foreach(var item in Model.LocalEvents){<li><strong>@EventText(item.Event.Type)</strong><span>@item.Local.ToString("dd/MM/yyyy HH:mm") · @item.Event.Actor</span>@if(item.Event.Notes is not null){<p>@item.Event.Notes</p>}</li>}</ol></section>
@if(Model.Document.CanCancel||Model.Document.CanCloseWithDifferences){<section class="operation-card border-warning"><h2 class="h5">Finalizar seguimiento</h2><form method="post"><input asp-for="Input.OperationId" type="hidden"/><div class="row g-3"><div class="col-lg-7"><label asp-for="Input.Reason" class="form-label">Motivo</label><textarea asp-for="Input.Reason" class="form-control" rows="2" maxlength="500" required></textarea></div><div class="col-lg-3"><label asp-for="Input.Pin" class="form-label">NIP</label><input asp-for="Input.Pin" value="" class="form-control pin-input" type="password" inputmode="numeric" maxlength="8" required/></div><div class="col-lg-2 d-flex align-items-end">@if(Model.Document.CanCancel){<button class="btn btn-outline-danger w-100" asp-page-handler="Cancel">Cancelar documento</button>}else if(Model.Document.CanCloseWithDifferences){<button class="btn btn-warning w-100" asp-page-handler="Close">Cerrar diferencias</button>}</div></div></form></section>}
</div>
@functions{static string StatusText(ReceivingDocumentStatus s)=>s switch{ReceivingDocumentStatus.Open=>"Abierto",ReceivingDocumentStatus.PartiallyReceived=>"Parcial",ReceivingDocumentStatus.Completed=>"Completado",ReceivingDocumentStatus.ClosedWithDifferences=>"Cerrado con diferencias",_=>"Cancelado"};static string EventText(ReceivingDocumentEventType t)=>t switch{ReceivingDocumentEventType.Opened=>"Documento abierto",ReceivingDocumentEventType.ReceiptConfirmed=>"Recepción confirmada",ReceivingDocumentEventType.AutomaticallyCompleted=>"Completado automáticamente",ReceivingDocumentEventType.ClosedWithDifferences=>"Cerrado con diferencias",ReceivingDocumentEventType.Cancelled=>"Cancelado",ReceivingDocumentEventType.ReceiptCorrected=>"Recepción corregida",_=>"Reabierto tras corrección"};}
