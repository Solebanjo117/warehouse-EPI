@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.ImportModel
@{ ViewData["Title"] = "Importar productos"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1 class="h2 mb-1">Importar productos</h1>
        <p class="text-muted mb-0">Compara el Excel con el catálogo y confirma las altas y actualizaciones.</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary">Volver a productos</a>
</div>

@if (Model.ImportMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.ImportMessage</div>
}
@if (Model.ImportError is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ImportError</div>
}

<div class="card card-body mb-4">
    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <label asp-for="Upload" class="form-label fw-semibold">Archivo de productos</label>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-8">
                <input asp-for="Upload" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="form-control form-control-lg" />
                <span asp-validation-for="Upload" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-4">
                <button type="submit" class="btn btn-primary btn-lg w-100">Analizar archivo</button>
            </div>
        </div>
        <div class="mt-3">
            <label asp-for="UpdateExisting" class="form-label fw-semibold">Acción sobre el catálogo</label>
            <select asp-for="UpdateExisting" class="form-select form-select-lg">
                <option value="true">Agregar nuevos y actualizar existentes</option>
                <option value="false">Solo agregar nuevos (omitir SKU existentes)</option>
            </select>
        </div>
        <div class="form-text mt-2">Solo .xlsx, máximo 10 MB y 10,000 filas. Hojas admitidas: ITEMS o ITEM LISTING, con sus columnas originales. Si hay ambas, se utiliza ITEMS.</div>
        <p class="small mt-2 mb-0">Al actualizar, las celdas vacías conservan el valor actual. En productos nuevos, U/M vacía usa “Sin asignar”. Las clases nuevas se crean al confirmar, con el código como nombre. Solo se modifican descripción, referencia, clase y unidad; la unidad no puede cambiar si hay movimientos. Los productos ausentes del Excel se conservan.</p>
    </form>
</div>

@if (Model.Preview is { } preview)
{
    @if (preview.Source is { Conflicts.Count: > 0 } source)
    {
        <section class="card card-body mb-3" aria-labelledby="resolve-duplicates-heading">
            <h2 id="resolve-duplicates-heading" class="h4">Resolver productos repetidos</h2>
            <p>Elige qué valor conservar en cada campo diferente. Los campos vacíos se completan con los disponibles. Esta selección recalcula la vista previa; no modifica el Excel ni guarda productos.</p>
            @{ var fieldNumber = 0; }
            @foreach (var conflict in source.Conflicts)
            {
                <form method="post" asp-page-handler="ResolveDuplicate" class="border rounded p-3 mb-3">
                    <input type="hidden" name="token" value="@preview.Token" />
                    <input type="hidden" name="sku" value="@conflict.Sku" />
                    <h3 class="h5 text-break">@conflict.Sku</h3>
                    <p class="text-body-secondary">Filas: @string.Join(", ", conflict.Rows.SelectMany(x => x.SourceRows))</p>
                    @foreach (var field in conflict.Fields)
                    {
                        if (field.Value.Length > 1)
                        {
                            var controlId = $"duplicate-field-{fieldNumber++}";
                            <div class="mb-3">
                                <label for="@controlId" class="form-label fw-semibold">@field.Key que se conservará</label>
                                <select id="@controlId" name="choices[@field.Key]" class="form-select form-select-lg" required>
                                    <option value="">Selecciona un valor</option>
                                    @foreach (var value in field.Value)
                                    {
                                        <option value="@value">@value</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <p class="text-break mb-2"><strong>@field.Key:</strong> @(field.Value.SingleOrDefault() ?? "Vacío")</p>
                        }
                    }
                    <button type="submit" class="btn btn-outline-primary btn-lg mt-2">Consolidar y volver a comparar</button>
                </form>
            }
        </section>
    }
    @if (preview.UnresolvedUnits.Count > 0)
    {
        <section class="card card-body mb-3" aria-labelledby="resolve-unit-heading">
            <h2 id="resolve-unit-heading" class="h4">Resolver unidades del Excel</h2>
            <p>Selecciona la unidad del catálogo que corresponde a cada valor. Se recalculará la comparación para todas sus filas, sin guardar productos todavía.</p>
            @for (var i = 0; i < preview.UnresolvedUnits.Count; i++)
            {
                var sourceUnit = preview.UnresolvedUnits[i];
                <form method="post" asp-page-handler="ResolveUnit" class="row g-2 align-items-end mb-3">
                    <input type="hidden" name="token" value="@preview.Token" />
                    <input type="hidden" name="sourceUnit" value="@sourceUnit" />
                    <div class="col-12 col-md-8">
                        <label class="form-label fw-semibold" for="resolve-unit-@i">Unidad para “@sourceUnit”</label>
                        <select id="resolve-unit-@i" name="targetUnit" class="form-select form-select-lg" required>
                            <option value="">Selecciona una unidad</option>
                            @foreach (var unit in preview.UnitOptions)
                            {
                                <option value="@unit.Code">@unit.Code — @unit.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4"><button class="btn btn-outline-primary btn-lg" type="submit">Usar unidad y comparar</button></div>
                </form>
            }
        </section>
    }
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 class="h4 mb-1">Vista previa</h2>
            <div class="text-muted text-break">@preview.FileName · vence a las @preview.ExpiresAt.ToLocalTime().ToString("HH:mm")</div>
        </div>
        @if (preview.CanConfirm)
        {
            <form method="post" asp-page-handler="Confirm">
                <input type="hidden" name="token" value="@preview.Token" />
                <button type="submit" class="btn btn-success btn-lg">Confirmar importación: @preview.NewCount altas y @preview.UpdatedCount actualizaciones</button>
            </form>
        }
        else
        {
            <span class="text-body-secondary">No hay cambios válidos para aplicar o el archivo contiene errores bloqueantes.</span>
        }
    </div>

    @if (preview.UpdateExisting)
    {
        <div class="alert alert-info" role="status">
            <strong>@preview.UpdatedCount por actualizar · @preview.UnchangedCount sin cambios.</strong>
            Se aplicarán únicamente los productos válidos. Incidencias de error: @preview.ErrorCount.
            Las filas indicadas con error se omiten; revisa las incidencias antes de confirmar.
        </div>
    }
    <div class="row row-cols-2 row-cols-lg-4 g-2 mb-3">
        <div class="col"><div class="card card-body h-100"><span class="text-muted">Filas fuente</span><strong class="fs-4">@preview.SourceRowCount.ToString("N0")</strong></div></div>
        <div class="col"><div class="card card-body h-100"><span class="text-muted">Productos nuevos</span><strong class="fs-4 text-success">@preview.NewCount.ToString("N0")</strong></div></div>
        <div class="col"><div class="card card-body h-100"><span class="text-muted">SKU existentes</span><strong class="fs-4">@preview.ExistingCount.ToString("N0")</strong></div></div>
        <div class="col"><div class="card card-body h-100"><span class="text-muted">Consolidados</span><strong class="fs-4">@preview.ConsolidatedCount.ToString("N0")</strong></div></div>
        <div class="col"><div class="card card-body h-100"><span class="text-muted">Referencias vacías</span><strong class="fs-4">@preview.MissingExternalReferenceCount.ToString("N0")</strong></div></div>
        <div class="col"><div class="card card-body h-100"><span class="text-muted">Advertencias</span><strong class="fs-4 text-warning">@preview.WarningCount.ToString("N0")</strong></div></div>
        <div class="col"><div class="card card-body h-100"><span class="text-muted">Errores</span><strong class="fs-4 text-danger">@preview.ErrorCount.ToString("N0")</strong></div></div>
        <div class="col"><div class="card card-body h-100"><span class="text-muted">Tipo</span><strong class="fs-5">Sin asignar</strong></div></div>
    </div>

    @if (preview.Issues.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header fw-semibold">Incidencias del archivo</div>
            <ul class="list-group list-group-flush">
                @foreach (var issue in preview.Issues.Take(100))
                {
                    <li class="list-group-item @(issue.IsError ? "list-group-item-danger" : "list-group-item-warning")">
                        @if (issue.RowNumber is not null) { <strong>Fila @issue.RowNumber:</strong> }
                        @issue.Message
                    </li>
                }
            </ul>
            @if (preview.Issues.Count > 100)
            {
                <div class="card-footer text-muted">Se muestran las primeras 100 incidencias de @preview.Issues.Count.ToString("N0").</div>
            }
        </div>
    }

    <nav class="nav nav-pills flex-wrap gap-1 mb-3" aria-label="Filtros de la vista previa">
        @foreach (var option in new[] { ("all", "Todos"), ("new", "Nuevos"), ("existing", "Existentes"), ("updated", "Por actualizar"), ("unchanged", "Sin cambios"), ("consolidated", "Consolidados"), ("warnings", "Advertencias"), ("errors", "Errores") })
        {
            <a class="nav-link @(Model.Filter == option.Item1 ? "active" : "")" asp-route-token="@preview.Token" asp-route-filter="@option.Item1">@option.Item2</a>
        }
    </nav>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Fila(s)</th><th>SKU / descripción propuesta</th><th>Unidad propuesta</th><th>Clase propuesta</th><th>Referencia propuesta</th><th>Resultado / comparación</th></tr></thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No hay filas para este filtro.</td></tr>
            }
            else
            {
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@string.Join(", ", row.SourceRows)</td>
                        <td><strong>@row.Sku</strong>@if (row.Description is not null) { <div class="text-break">@row.Description</div> }</td>
                        <td>@row.UnitDisplay</td>
                        <td>@(row.ClassCode ?? "—")</td>
                        <td class="text-break">@(row.ExternalReference ?? "—")</td>
                        <td>
                            @if (row.HasError) { <span class="badge text-bg-danger">Error</span> }
                            else if (row.IsUpdate) { <span class="badge text-bg-primary">Actualizar</span> }
                            else if (row.IsExisting) { <span class="badge text-bg-secondary">@(preview.UpdateExisting ? "Sin cambios" : "Omitir")</span> }
                            else if (row.IsConsolidated) { <span class="badge text-bg-info">Consolidado</span> }
                            else { <span class="badge text-bg-success">Nuevo</span> }
                            @if (row.HasWarning) { <span class="badge text-bg-warning">Advertencia</span> }
                            @if (row.Message is not null) { <div class="small mt-1">@row.Message</div> }
                            @if (preview.UpdateExisting && row.Changes.Count > 0)
                            {
                                <dl class="small text-break mt-2 mb-0">
                                @foreach (var change in row.Changes)
                                {
                                    <dt>@change.Field</dt>
                                    <dd>Actual: @(change.Before ?? "—")<br />Propuesto: @(change.After ?? "—")</dd>
                                }
                                </dl>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Paginación de la vista previa"><ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")"><a class="page-link" asp-route-token="@preview.Token" asp-route-filter="@Model.Filter" asp-route-pageNumber="@(Model.CurrentPage - 1)">Anterior</a></li>
            <li class="page-item disabled"><span class="page-link">@Model.CurrentPage de @Model.TotalPages</span></li>
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-route-token="@preview.Token" asp-route-filter="@Model.Filter" asp-route-pageNumber="@(Model.CurrentPage + 1)">Siguiente</a></li>
        </ul></nav>
    }
}
