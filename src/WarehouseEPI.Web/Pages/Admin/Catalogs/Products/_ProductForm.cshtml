@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.IProductFormPage
@{
    var isEditing = Model.Input.Id != Guid.Empty;
    var selectedEntryLocation = Model.SelectedEntryLocation;
    var hasWipInput = Model.Wip.Rules.Any(x => x.StageId.HasValue || !string.IsNullOrWhiteSpace(x.TargetKey));
    var hasWipErrors = ViewData.ModelState.Keys.Any(x => x.StartsWith("Wip", StringComparison.Ordinal)) ||
        (hasWipInput && !ViewData.ModelState.IsValid);
}

<form id="product-general-form" method="post" class="product-editor-form" data-cycle-plan data-product-dirty-form="Datos generales"
      data-lookup-url="@Url.Page("/Operations/Lookup")">
    <div asp-validation-summary="All" class="alert alert-danger product-editor-validation" role="alert" tabindex="-1"></div>
    <input asp-for="Input.Id" type="hidden" />

    <section class="card product-editor-card" aria-labelledby="product-information-heading">
        <div class="card-body p-3 p-md-4">
            <div class="product-editor-section-heading">
                <div><span class="product-editor-step">Datos generales</span><h2 id="product-information-heading" class="h4 mb-1">Identificación</h2><p class="text-body-secondary mb-0">Los campos marcados con * son obligatorios.</p></div>
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Input.Sku" class="form-label fw-semibold">SKU <span class="text-danger" aria-hidden="true">*</span></label>
                    <input asp-for="Input.Sku" class="form-control form-control-lg text-uppercase" autocomplete="off" aria-required="true" autofocus />
                    <span asp-validation-for="Input.Sku" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.ExternalReference" class="form-label fw-semibold">Referencia externa <span class="text-body-secondary fw-normal">(opcional)</span></label>
                    <input asp-for="Input.ExternalReference" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Input.ExternalReference" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Input.Description" class="form-label fw-semibold">Descripción <span class="text-body-secondary fw-normal">(opcional)</span></label>
                    <textarea asp-for="Input.Description" class="form-control product-editor-description" rows="2" data-product-autogrow placeholder="Describe el producto para reconocerlo con facilidad"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="card product-editor-card" aria-labelledby="product-classification-heading">
        <div class="card-body p-3 p-md-4">
            <div class="product-editor-section-heading">
                <h2 id="product-classification-heading" class="h4 mb-0">Clasificación y existencia mínima</h2>
            </div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Input.BaseUnitId" class="form-label fw-semibold">Unidad base <span class="text-danger" aria-hidden="true">*</span></label>
                    <select asp-for="Input.BaseUnitId" asp-items="Model.Units" class="form-select product-editor-control" aria-required="true"><option value="">Seleccione una unidad</option></select>
                    <span asp-validation-for="Input.BaseUnitId" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.MinimumStock" class="form-label fw-semibold">Stock mínimo</label>
                    <div class="input-group"><input asp-for="Input.MinimumStock" class="form-control product-editor-control" type="number" min="0" step="0.0001" /><span class="input-group-text">mínimo</span></div>
                    <span asp-validation-for="Input.MinimumStock" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.ProductTypeId" class="form-label fw-semibold">Tipo <span class="text-body-secondary fw-normal">(opcional)</span></label>
                    <select asp-for="Input.ProductTypeId" asp-items="Model.Types" class="form-select product-editor-control"><option value="">Sin tipo</option></select>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Input.ProductClassId" class="form-label fw-semibold">Clase <span class="text-body-secondary fw-normal">(opcional)</span></label>
                    <select asp-for="Input.ProductClassId" asp-items="Model.Classes" class="form-select product-editor-control"><option value="">Sin clase</option></select>
                </div>
            </div>
        </div>
    </section>

    <section class="card product-editor-card" aria-labelledby="product-operational-heading">
        <div class="card-body p-3 p-md-4">
            <div class="product-editor-section-heading">
                <h2 id="product-operational-heading" class="h4 mb-0">Configuración operativa</h2>
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label for="default-entry-location-search" class="form-label fw-semibold">Ubicación principal de entrada <span class="text-body-secondary fw-normal">(opcional)</span></label>
                    <div class="lookup-field" data-cycle-plan-field="location" data-cycle-plan-key="default-entry-location" data-cycle-plan-label="Ubicación principal" data-cycle-plan-optional>
                        <input asp-for="Input.DefaultEntryLocationId" type="hidden" data-cycle-plan-id />
                        <div class="input-group">
                            <input id="default-entry-location-search" class="form-control product-editor-control" type="search" value="@selectedEntryLocation?.Code" autocomplete="off" autocapitalize="characters" placeholder="Busca por código o descripción" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="default-entry-location-results" aria-describedby="default-entry-location-feedback" data-cycle-plan-search />
                            <button type="button" class="btn btn-outline-secondary" data-cycle-plan-camera aria-label="Escanear ubicación principal con cámara"><svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg></button>
                            <button type="button" class="btn btn-outline-secondary" data-cycle-plan-clear disabled="@(selectedEntryLocation is null)" aria-label="Quitar ubicación principal de entrada">Quitar</button>
                        </div>
                        <div id="default-entry-location-results" class="lookup-results list-group" role="listbox" data-cycle-plan-results></div>
                        <div class="selected-record @(selectedEntryLocation is null ? "d-none" : null) mt-2" data-cycle-plan-selected>
                            <strong data-cycle-plan-selected-title>@selectedEntryLocation?.Code</strong><span data-cycle-plan-selected-detail>@selectedEntryLocation?.Description</span><small data-cycle-plan-selected-meta>@(selectedEntryLocation?.IsAvailable == false ? "No disponible" : "Ubicación")</small>
                        </div>
                        <p id="default-entry-location-feedback" class="form-text mb-0" role="status" aria-live="polite" data-cycle-plan-feedback>Escribe para buscar o usa un lector HID.</p>
                    </div>
                    <span asp-validation-for="Input.DefaultEntryLocationId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="product-editor-status-control"><div><span class="fw-semibold d-block">Estado del producto</span><small class="text-body-secondary">Los productos inactivos permanecen en el historial.</small></div><div class="form-check form-switch mb-0"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Activo</label></div></div>
                </div>
            </div>
        </div>
    </section>

    @if (!isEditing)
    {
        <details class="card product-editor-module product-editor-disclosure" open="@(hasWipInput || hasWipErrors)">
            <summary class="card-body product-editor-disclosure-summary"><span><strong>Destinos WIP opcionales</strong><small class="d-block text-body-secondary">Configura destinos habituales solo si este producto se usa como material.</small></span><span class="badge text-bg-secondary">Opcional</span></summary>
            <div class="px-3 px-md-4 pb-3 pb-md-4"><partial name="_ProductionWipDefaults" model="Model" /></div>
        </details>
        <p class="product-editor-production-note mb-0"><strong>¿Este producto se fabrica?</strong> Guarda el producto y continúa para configurar su receta y procesos.</p>
    }

    <div class="product-editor-actions" data-product-actions>
        @if (isEditing) { <a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-outline-secondary btn-lg">Cancelar</a> }
        else { <a asp-page="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a> }
        @if (isEditing) { <button type="submit" class="btn btn-primary btn-lg">Guardar cambios</button> }
        else
        {
            <button type="submit" name="nextStep" value="details" class="btn btn-outline-primary btn-lg">Guardar producto</button>
            <button type="submit" name="nextStep" value="production" class="btn btn-primary btn-lg">Guardar y configurar receta</button>
        }
    </div>
</form>
