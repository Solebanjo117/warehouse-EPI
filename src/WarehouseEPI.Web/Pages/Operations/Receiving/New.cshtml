@page "/Operations/Receiving/New"
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Operations.Receiving.NewModel
@{ ViewData["Title"]="Preparar recepción"; }
<div class="container-fluid py-3 receiving-shell" data-receiving-builder data-lookup-url="@Url.Page("/Operations/Lookup")">
<header class="mb-4"><a asp-page="Index" class="small text-decoration-none">← Recepciones</a><h1 class="h2 mt-2 mb-1">Preparar documento</h1><p class="text-muted">El borrador permanece en este formulario. Solo se guarda al abrirlo con NIP.</p></header>
<form method="post" data-receiving-form><input asp-for="Input.OperationId" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div>
<section class="operation-card mb-3"><div class="row g-3"><div class="col-md-4"><label asp-for="Input.Type" class="form-label">Tipo</label><select asp-for="Input.Type" class="form-select"><option value="PurchaseOrder">Orden de compra</option><option value="DeliveryNote">Remisión</option><option value="PackingList">Packing list</option><option value="ProductionOrder">Orden de producción</option><option value="Other">Otro</option></select></div><div class="col-md-4"><label asp-for="Input.Number" class="form-label">Número</label><input asp-for="Input.Number" class="form-control" maxlength="120" required/><span asp-validation-for="Input.Number" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.DocumentDate" class="form-label">Fecha documental</label><input asp-for="Input.DocumentDate" class="form-control" type="date"/></div><div class="col-md-6"><label asp-for="Input.Origin" class="form-label">Origen</label><input asp-for="Input.Origin" class="form-control" maxlength="160" required/></div><div class="col-md-6"><label asp-for="Input.Notes" class="form-label">Notas</label><input asp-for="Input.Notes" class="form-control" maxlength="500"/></div></div></section>
<section class="operation-card"><div class="d-flex justify-content-between gap-2 align-items-center"><div><h2 class="h5 mb-1">Productos esperados</h2><p class="small text-muted mb-0">Un renglón por producto.</p></div><button type="button" class="btn btn-outline-primary" data-add-receiving-line>Agregar producto</button></div><div class="mt-3" data-receiving-lines>@for(var i=0;i<Model.Input.Lines.Count;i++){<div class="receiving-capture-line" data-receiving-line><input asp-for="Input.Lines[i].ProductId" type="hidden" data-product-id/><div><label class="form-label" for="product-@i">SKU o código</label><input id="product-@i" class="form-control" type="search" data-product-lookup autocomplete="off" placeholder="Escanea o escribe"/><div class="list-group lookup-results" data-product-results></div><small class="text-muted" data-product-description></small></div><div><label asp-for="Input.Lines[i].ExpectedQuantity" class="form-label">Cantidad esperada</label><input asp-for="Input.Lines[i].ExpectedQuantity" class="form-control" type="number" min="0.0001" step="0.0001" inputmode="decimal" required/></div><button type="button" class="btn btn-outline-danger align-self-end" data-remove-receiving-line aria-label="Quitar producto">Quitar</button></div>}</div></section>
<aside class="operation-card mt-3"><h2 class="h5">Abrir documento</h2><p class="text-muted">Al confirmar, encabezado y cantidades quedarán congelados.</p><label asp-for="Input.Pin" class="form-label">NIP del responsable</label><input asp-for="Input.Pin" value="" class="form-control pin-input" type="password" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" autocomplete="off" required/><div class="d-flex gap-2 mt-3"><a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a><button class="btn btn-primary flex-grow-1">Abrir documento</button></div></aside></form></div>
<template data-receiving-line-template><div class="receiving-capture-line" data-receiving-line><input name="Input.Lines[__index__].ProductId" type="hidden" data-product-id/><div><label class="form-label">SKU o código</label><input class="form-control" type="search" data-product-lookup autocomplete="off" placeholder="Escanea o escribe"/><div class="list-group lookup-results" data-product-results></div><small class="text-muted" data-product-description></small></div><div><label class="form-label">Cantidad esperada</label><input name="Input.Lines[__index__].ExpectedQuantity" class="form-control" type="number" min="0.0001" step="0.0001" inputmode="decimal" required/></div><button type="button" class="btn btn-outline-danger align-self-end" data-remove-receiving-line>Quitar</button></div></template>
@section Scripts{<script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script><script src="~/js/receiving.js" asp-append-version="true"></script>}
