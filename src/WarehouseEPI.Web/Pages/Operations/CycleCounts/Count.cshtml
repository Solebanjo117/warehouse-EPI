@page
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.CountModel
@{ ViewData["Title"]="Conteo ciego"; var attempt=Model.Attempt!; }
<div class="inventory-analytics"><header class="inventory-page-header"><div><a asp-page="Details" asp-route-id="@Model.CampaignId" class="small text-decoration-none">← Campaña</a><h1 class="h2 mt-2">Conteo ciego · intento @attempt.AttemptNumber</h1><p class="text-muted mb-0">Captura cantidades físicas. El sistema no muestra existencias esperadas.</p></div></header>@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}<form method="post" class="analytics-filter-card"><input asp-for="Input.AttemptId" type="hidden" value="@attempt.Id"/><input asp-for="Input.OperationId" type="hidden" value="@Guid.NewGuid()"/><input type="hidden" name="id" value="@Model.CampaignId"/><input type="hidden" name="locationId" value="@Model.LocationId"/><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Producto</th><th>Unidad</th><th>Conteo físico</th></tr></thead><tbody>@for(var index=0;index<attempt.Entries.Count;index++){var entry=attempt.Entries[index];<tr><td><strong>@entry.Sku</strong><small class="d-block text-body-secondary">@(entry.Description ?? "Sin descripción")</small><input name="Input.Entries[@index].ProductId" type="hidden" value="@entry.ProductId"/></td><td>@entry.UnitCode</td><td><input name="Input.Entries[@index].Quantity" class="form-control" inputmode="decimal" min="0" required autocomplete="off" placeholder="Cantidad física" /></td></tr>}</tbody></table></div><fieldset class="border rounded p-3 mb-3"><legend class="h6 px-2">Productos inesperados</legend><p class="small text-body-secondary">Escanea o escribe un SKU/código de barras y su cantidad. Deja en blanco las filas que no uses.</p>@for(var index=0;index<3;index++){<div class="row g-2 mb-2"><div class="col-sm-8"><label class="visually-hidden" for="unexpected-code-@index">SKU o código inesperado @(index + 1)</label><input id="unexpected-code-@index" name="Input.UnexpectedEntries[@index].Code" class="form-control" autocomplete="off" autocapitalize="characters" placeholder="SKU o código de barras inesperado" /></div><div class="col-sm-4"><label class="visually-hidden" for="unexpected-quantity-@index">Cantidad inesperada @(index + 1)</label><input id="unexpected-quantity-@index" name="Input.UnexpectedEntries[@index].Quantity" class="form-control" inputmode="decimal" min="0" placeholder="Cantidad" /></div></div>}</fieldset><div class="form-check mb-3"><input asp-for="Input.IsLocationEmpty" class="form-check-input"/><label asp-for="Input.IsLocationEmpty" class="form-check-label">La ubicación está vacía: registrar cero para todas las líneas.</label></div><div class="row g-2 align-items-end"><div class="col-sm-4"><label asp-for="Input.Pin" class="form-label">NIP responsable</label><input asp-for="Input.Pin" class="form-control" type="password" inputmode="numeric" maxlength="8" autocomplete="off"/></div><div class="col-sm-8"><button class="btn btn-primary">Enviar conteo para revisión</button> <a asp-page="Print" asp-route-id="@Model.CampaignId" asp-route-locationId="@Model.LocationId" asp-route-attemptId="@attempt.Id" class="btn btn-outline-secondary">Hoja imprimible</a></div></div></form></div>
@section Scripts { <script src="~/js/cycle-count.js" asp-append-version="true"></script> }
