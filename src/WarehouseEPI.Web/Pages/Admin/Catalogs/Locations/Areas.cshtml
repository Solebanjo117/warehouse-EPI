@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.AreasModel
@using WarehouseEPI.Core.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@{ ViewData["Title"] = CatTexts["Áreas"].Value; }
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div><h1 class="h2">@CatTexts["Áreas"]</h1><p class="text-body-secondary">@CatTexts["Selecciona un área para corregir sus datos, procesos o disponibilidad."]</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-page="Index" class="btn btn-outline-secondary btn-lg">@CatTexts["Ubicaciones"]</a><a asp-page="Area" class="btn btn-primary btn-lg">@CatTexts["Crear área"]</a></div>
</div>
@if (Model.Message is not null) { <div class="alert alert-success" role="status">@Model.Message</div> }
<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6"><label for="search" class="form-label">@CatTexts["Buscar área"]</label><input id="search" name="search" value="@Model.Search" type="search" class="form-control form-control-lg" autocomplete="off" /></div>
        <div class="col-12 col-md-3"><label for="status" class="form-label">@CatTexts["Estado"]</label><select id="status" name="status" class="form-select form-select-lg">
            <option value="all" selected="@(Model.Status == "all")">@CatTexts["Todas"]</option>
            <option value="active" selected="@(Model.Status == "active")">@CatTexts["Disponible"]</option>
            <option value="blocked" selected="@(Model.Status == "blocked")">@CatTexts["Bloqueada"]</option>
            <option value="inactive" selected="@(Model.Status == "inactive")">@CatTexts["Inactiva"]</option>
        </select></div>
        <div class="col-12 col-md-3 d-flex gap-2"><button class="btn btn-primary btn-lg">@CatTexts["Buscar"]</button><a asp-page="Areas" class="btn btn-outline-secondary btn-lg">@CatTexts["Limpiar"]</a></div>
    </div>
</form>
@if (Model.Areas.Count == 0)
{
    <div class="card card-body text-center py-4"><h2 class="h5">@CatTexts["No hay áreas con estos filtros."]</h2><p>@CatTexts["Busca otro código o limpia los filtros para ver todas las áreas."]</p><div><a asp-page="Areas" class="btn btn-outline-primary btn-lg">@CatTexts["Ver todas las áreas"]</a></div></div>
}
else
{
    <div class="row g-3">
    @foreach (var area in Model.Areas)
    {
        <div class="col-12 col-lg-6"><article class="card h-100"><div class="card-body d-flex flex-column gap-2">
            <div class="d-flex flex-wrap justify-content-between gap-2"><h2 class="h4 mb-0 text-break"><a asp-page="Details" asp-route-id="@area.Id">@area.Code</a></h2><span class="badge align-self-start @(!area.IsActive ? "text-bg-secondary" : area.IsBlocked ? "text-bg-warning" : "text-bg-success")">@(!area.IsPhysicallyPresent ? CatTexts["Retirada"] : !area.IsActive ? CatTexts["Inactiva"] : area.IsBlocked ? CatTexts["Bloqueada"] : CatTexts["Disponible"])</span></div>
            <p class="mb-0 text-break">@(string.IsNullOrWhiteSpace(area.Description) ? CatTexts["Sin descripción"].Value : area.Description)</p>
            <p class="text-body-secondary mb-0">@(area.OperationalRole == LocationOperationalRole.Wip ? CatTexts["WIP · Sin control de existencias"] : area.OperationalRole == LocationOperationalRole.Storage ? CatTexts["Área con inventario"] : CatTexts["Área general"])</p>
            @if (area.IsBlocked) { <p class="mb-0 text-break"><strong>@CatTexts["Motivo de bloqueo"]:</strong> @area.BlockReason</p> }
            <div class="d-flex flex-wrap gap-2 mt-auto pt-2"><a asp-page="Area" asp-route-locationId="@area.Id" class="btn btn-primary btn-lg" aria-label="@CatTexts["Editar área {0}", area.Code]">@CatTexts["Editar área"]</a><a asp-page="Details" asp-route-id="@area.Id" class="btn btn-outline-secondary btn-lg">@CatTexts["Ver ficha"]</a></div>
        </div></article></div>
    }
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="@CatTexts["Paginación"]"><ul class="pagination flex-wrap">
    @if (Model.CurrentPage > 1) { <li class="page-item"><a class="page-link px-3 py-3" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@(Model.CurrentPage - 1)">@CatTexts["Anterior"]</a></li> }
    @foreach (var number in Model.VisiblePages) { <li class="page-item @(number == Model.CurrentPage ? "active" : "")"><a class="page-link px-3 py-3" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@number" aria-current="@(number == Model.CurrentPage ? "page" : null)">@number</a></li> }
    @if (Model.CurrentPage < Model.TotalPages) { <li class="page-item"><a class="page-link px-3 py-3" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-pageNumber="@(Model.CurrentPage + 1)">@CatTexts["Siguiente"]</a></li> }
    </ul></nav>
}
