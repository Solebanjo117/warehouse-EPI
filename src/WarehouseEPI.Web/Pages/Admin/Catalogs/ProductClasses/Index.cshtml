@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.ProductClasses.IndexModel
@{ ViewData["Title"] = "Clases de producto"; }

<div class="catalog-admin-workspace">
    <header class="catalog-admin-header">
        <div>
            <span class="catalog-admin-eyebrow">Catálogo de productos</span>
            <h1 class="h2 mb-1">Clases de producto</h1>
            <p class="text-body-secondary mb-0">Familias normalizadas usadas para organizar el catálogo.</p>
        </div>
        <span class="catalog-admin-count">@Model.Items.Count clase(s)</span>
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert" aria-live="polite">@error</div>
    }

    <section class="card catalog-admin-card mb-4" aria-labelledby="class-editor-title">
        <div class="card-body">
            <h2 id="class-editor-title" class="h5 mb-1">@(Model.Input.Id == 0 ? "Agregar clase" : "Editar clase")</h2>
            <p class="text-body-secondary small mb-3">El código identifica esta familia en productos e importaciones.</p>
            <form method="post" asp-page-handler="Save">
                <input asp-for="Input.Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger catalog-admin-validation" role="alert"></div>
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label asp-for="Input.Code" class="form-label">Código</label>
                        <input asp-for="Input.Code" class="form-control text-uppercase catalog-admin-control" autocomplete="off" />
                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-5">
                        <label asp-for="Input.Name" class="form-label">Nombre</label>
                        <input asp-for="Input.Name" class="form-control catalog-admin-control" autocomplete="off" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-3 catalog-admin-form-actions">
                        <button type="submit" class="btn btn-primary">@(Model.Input.Id == 0 ? "Agregar clase" : "Guardar cambios")</button>
                        @if (Model.Input.Id != 0)
                        {
                            <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section aria-labelledby="classes-list-title">
        <div class="catalog-admin-section-heading">
            <div>
                <h2 id="classes-list-title" class="h4 mb-1">Clases registradas</h2>
                <p class="text-body-secondary mb-0">Las clases inactivas se conservan para mantener el historial.</p>
            </div>
        </div>
        @if (Model.Items.Count == 0)
        {
            <div class="catalog-admin-empty"><strong>No hay clases registradas.</strong><span>Agrega la primera clase con el formulario anterior.</span></div>
        }
        else
        {
            <div class="table-responsive d-none d-md-block">
                <table class="table table-striped align-middle catalog-admin-table">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.Name</td>
                            <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span></td>
                            <td class="text-end catalog-admin-row-actions">
                                <a asp-route-editId="@item.Id" class="btn btn-outline-primary">Editar</a>
                                <form method="post" asp-page-handler="Toggle">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-outline-secondary" aria-label="@(item.IsActive ? $"Desactivar clase {item.Code}" : $"Activar clase {item.Code}")">@(item.IsActive ? "Desactivar" : "Activar")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="catalog-admin-mobile-list d-md-none">
                @foreach (var item in Model.Items)
                {
                    <article class="card catalog-admin-item">
                        <div class="card-body">
                            <div class="catalog-admin-item-heading"><div><strong>@item.Code</strong><span>@item.Name</span></div><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span></div>
                            <div class="catalog-admin-row-actions">
                                <a asp-route-editId="@item.Id" class="btn btn-outline-primary">Editar</a>
                                <form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@item.Id" /><button type="submit" class="btn btn-outline-secondary">@(item.IsActive ? "Desactivar" : "Activar")</button></form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
