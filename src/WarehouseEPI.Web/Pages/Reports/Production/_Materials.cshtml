@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionMaterialReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>@CatTexts["Orden / proceso"]</th><th>Material</th><th class="text-end">@CatTexts["Plan autorizado"]</th><th class="text-end">@CatTexts["Surtido"]</th><th class="text-end">@CatTexts["Consumido"]</th><th class="text-end">@CatTexts["Devuelto"]</th><th class="text-end">@CatTexts["Desperdicio"]</th><th class="text-end">@CatTexts["Pendiente"]</th><th class="text-end">@CatTexts["Desviaciones"]</th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr><td data-label="@CatTexts["Orden / proceso"]"><a asp-page="/Admin/Production/Details" asp-route-id="@row.OrderId"><strong>@row.OrderNumber</strong></a><small>@row.Stage</small></td><td data-label="Material"><span class="font-monospace">@row.Sku</span><small>@row.Description · @row.Unit</small></td><td data-label="@CatTexts["Plan autorizado"]" class="text-end">@row.AuthorizedPlan.ToString("0.####")</td><td data-label="@CatTexts["Surtido"]" class="text-end">@row.Issued.ToString("0.####")</td><td data-label="@CatTexts["Consumido"]" class="text-end">@row.Consumed.ToString("0.####")<small>Primera pasada @(row.FirstPassConsumption?.ToString("0.####") ?? CatTexts["Sin base"].Value)</small></td><td data-label="@CatTexts["Devuelto"]" class="text-end">@row.Returned.ToString("0.####")</td><td data-label="@CatTexts["Desperdicio"]" class="text-end">@row.Scrapped.ToString("0.####")</td><td data-label="@CatTexts["Pendiente"]" class="text-end">@row.PendingSupply.ToString("0.####")</td><td data-label="@CatTexts["Desviaciones"]" class="text-end"><span>Plan @Signed(row.PlanVariance)</span><small>Técnica @(row.TechnicalVariance is null ? CatTexts["Sin base"].Value : Signed(row.TechnicalVariance.Value))</small></td></tr> }</tbody>
</table>
@functions { static string Signed(decimal value) => value > 0 ? $"+{value:0.####}" : value.ToString("0.####"); }
