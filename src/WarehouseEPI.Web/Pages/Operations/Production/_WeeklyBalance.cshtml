@model WarehouseEPI.Web.Pages.Operations.Production.IndexModel
@using WarehouseEPI.Core.Entities
@using WarehouseEPI.Infrastructure.Production
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> T
@{
    string AreaName(ProductionDailyArea area) => T[area switch { ProductionDailyArea.Cutting => "Corte", ProductionDailyArea.Sewing => "Costura", _ => "Ready to Pack" }];
    var weekly = Model.Daily;
}
<section class="production-balance" aria-labelledby="weekly-heading" data-balance-root>
    <h2 id="weekly-heading" class="visually-hidden">@T["Balance diario"]</h2>
    <div class="balance-context" data-balance-context>
        <div class="balance-context__week">
            <label asp-for="WeekId" class="form-label">@T["Semana"]</label>
            <select asp-for="WeekId" form="balance-filters" class="form-select production-daily__week" data-balance-week>
                <option value="">@T["Selecciona una semana"]</option>
                @foreach(var week in Model.Weeks)
                { <option value="@week.Id" data-start="@week.WeekStart.ToString("yyyy-MM-dd")">@week.WeekStart.ToString("dd/MM/yyyy")–@week.WeekEnd.ToString("dd/MM/yyyy")</option> }
            </select>
        </div>
        @if (weekly is not null)
        {
            <div class="balance-context__date"><span class="small text-body-secondary">@T["Fecha"]</span><strong>@weekly.Through.ToString("ddd dd MMM yyyy")</strong></div>
            <span class="badge @(weekly.Status == ProductionScheduleWeekStatus.Open ? "text-bg-success" : "text-bg-secondary")">@WarehouseEPI.Web.Production.ProductionDailyText.WeekStatus(T, weekly.Status)</span>
            <a asp-page-handler="Export" asp-route-weekId="@weekly.WeekId" asp-route-Through="@weekly.Through.ToString("yyyy-MM-dd")" asp-route-Sku="@Model.Sku" asp-route-Reference="@Model.Reference" asp-route-Area="@Model.Area" class="btn btn-outline-primary balance-context__export">@T["Exportar XLSX"]</a>
        }
    </div>
    <form id="balance-filters" method="get" class="balance-filters production-daily__filters">
        <input name="Tab" value="balance" type="hidden"/>
        <input name="Through" value="@(weekly?.Through.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" type="hidden"/>
        <input asp-for="PendingPage" type="hidden"/><input asp-for="CompletionPage" type="hidden"/><input asp-for="SummaryPage" type="hidden"/>
        <div class="balance-filters__product"><label asp-for="Sku" class="form-label">@T["Filtrar productos"]</label><input asp-for="Sku" type="search" class="form-control"/></div>
        <button class="btn btn-outline-primary">@T["Filtrar"]</button>
        <details class="balance-filters__more"><summary>@T["Más filtros"]</summary><div class="balance-filters__fields">
            <div><label asp-for="Area" class="form-label">@T["Área"]</label><select asp-for="Area" class="form-select"><option value="">@T["Todas"]</option>@foreach(var area in Enum.GetValues<ProductionDailyArea>()){<option value="@area">@AreaName(area)</option>}</select></div>
            <div><label asp-for="Reference" class="form-label">@T["Referencia"]</label><input asp-for="Reference" class="form-control"/></div>
        </div></details>
        @if (weekly is not null)
        {
            <nav class="balance-filters__days d-flex gap-2 overflow-auto" aria-label="@T["Días de la semana"]">
                @foreach (var day in ProductionWeekCalendar.Days(weekly.WeekStart))
                {
                    <button type="button" class="btn @(weekly.Through == day ? "btn-primary" : "btn-outline-primary") flex-shrink-0" aria-current="@(weekly.Through == day ? "date" : null)" data-balance-day="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@day.ToString("ddd dd/MM", CultureInfo.CurrentUICulture)</button>
                }
            </nav>
        }
    </form>
    @if (weekly is null) { <p class="alert alert-info">@T["Todavía no hay una semana de producción para consultar."]</p> }
    else
    {
        @if (!Model.ConfigurationReady) { <p class="alert alert-warning">@T["Configura las tres áreas y los dos turnos activos para capturar."]</p> }
        @if (!Model.ConfigurationReady && User.IsInRole("ADMIN")) { <a class="btn btn-outline-primary mb-2" asp-page="/Admin/Production/Schedule" asp-fragment="daily-configuration">@T["Configurar áreas y turnos"]</a> }
        @if (weekly.Status == ProductionScheduleWeekStatus.Closed) { <p class="alert alert-warning">@T["Semana cerrada. Puedes consultar el balance; tus cambios pendientes se conservarán."]</p> }
        @if (weekly.Through > Model.Today) { <p class="alert alert-info">@T["La programación futura es una proyección. Las piezas registradas provienen de capturas confirmadas."]</p> }
        @if (weekly.Status == ProductionScheduleWeekStatus.Draft) { <p class="alert alert-info">@T["Proyección del borrador. La semana todavía no está abierta para capturar."]</p> }
        @if (weekly.Products.Count == 0) { <p class="alert alert-info">@T["No hay productos para los filtros seleccionados."]</p> }
        <partial name="_BalanceEditor" model="Model"/>
    }
</section>
@if (Model.WeekClose is not null) { <partial name="_WeekClose" model="Model" /> }
