@page "{id:guid}"
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Admin.Inventory.Alerts.DetailsModel
@{ ViewData["Title"] = "Seguimiento de excepción"; var item = Model.Exception!.Case; }

<div class="inventory-analytics"><header class="inventory-page-header"><div><a asp-page="/Admin/Inventory/Alerts" class="small text-decoration-none">← Centro de excepciones</a><h1 class="h2 mt-2">@item.PrimaryText</h1><p class="text-muted mb-0">@item.SecondaryText · @CategoryLabel(item.Category) · @SeverityLabel(item.Severity)</p></div><a href="@item.TargetUrl" class="btn btn-primary">Actuar sobre condición</a></header>
@if(Model.Error is not null){<div class="alert alert-danger mt-3" role="alert">@Model.Error</div>}
<section class="analytics-filter-card mt-3"><div class="row g-3"><div class="col-md-3"><span class="inventory-card-label">Estado</span><strong class="d-block">@StatusLabel(item.Status)</strong></div><div class="col-md-3"><span class="inventory-card-label">Valor actual</span><strong class="d-block">@(item.ValueText ?? "Requiere atención")</strong></div><div class="col-md-3"><span class="inventory-card-label">Detectada</span><strong class="d-block">@item.FirstDetectedAt.ToString("dd/MM/yyyy HH:mm")</strong></div><div class="col-md-3"><span class="inventory-card-label">Última detección</span><strong class="d-block">@item.LastDetectedAt.ToString("dd/MM/yyyy HH:mm")</strong></div></div></section>
@if(item.Status==OperationalExceptionStatus.Resolved){<div class="alert alert-success mt-3"><strong>Resuelta automáticamente.</strong> La condición dejó de estar presente el @item.ResolvedAt?.ToString("dd/MM/yyyy HH:mm").</div>}
else{<form method="post" asp-page-handler="Update" class="analytics-filter-card mt-3"><input asp-for="Input.OperationId" type="hidden"/><input asp-for="Input.Version" type="hidden"/><div class="row g-3"><div class="col-md-4"><label asp-for="Input.AssignedUserId" class="form-label">Responsable</label><select asp-for="Input.AssignedUserId" class="form-select"><option value="">Sin responsable</option>@foreach(var user in Model.Assignees){<option value="@user.Id">@user.FullName · @user.RoleCode</option>}</select></div><div class="col-md-4"><label asp-for="Input.Status" class="form-label">Estado</label><select asp-for="Input.Status" class="form-select"><option value="@OperationalExceptionStatus.New">Nueva</option><option value="@OperationalExceptionStatus.InProgress">En atención</option><option value="@OperationalExceptionStatus.Waiting">En espera</option></select></div><div class="col-md-4"><label asp-for="Input.Notes" class="form-label">Nota</label><input asp-for="Input.Notes" class="form-control" maxlength="500"/><div class="form-text">Obligatoria al dejar el caso en espera.</div></div></div><button class="btn btn-primary mt-3">Guardar seguimiento</button></form>}
<section class="mt-4"><h2 class="h4">Historial</h2><ol class="list-group list-group-numbered">@foreach(var history in Model.Exception.Events){<li class="list-group-item"><div class="d-flex flex-wrap justify-content-between gap-2"><strong>@EventLabel(history.Type)</strong><small>@history.RecordedAt.ToString("dd/MM/yyyy HH:mm")</small></div><div class="small text-muted">@if(history.ActorUserName is not null){<span>Por @history.ActorUserName. </span>}@if(history.CurrentAssignedUserName is not null){<span>Responsable: @history.CurrentAssignedUserName. </span>}@if(history.CurrentStatus is not null){<span>Estado: @StatusLabel(history.CurrentStatus.Value).</span>}</div>@if(history.Notes is not null){<p class="mb-0 mt-2">@history.Notes</p>}</li>}</ol></section></div>

@functions { static string StatusLabel(OperationalExceptionStatus value) => value switch { OperationalExceptionStatus.New => "Nueva", OperationalExceptionStatus.InProgress => "En atención", OperationalExceptionStatus.Waiting => "En espera", _ => "Resuelta" }; static string SeverityLabel(OperationalExceptionSeverity value) => value switch { OperationalExceptionSeverity.Critical => "Crítica", OperationalExceptionSeverity.Warning => "Advertencia", _ => "Informativa" }; static string CategoryLabel(OperationalExceptionCategory value) => value switch { OperationalExceptionCategory.NegativeInventory => "Saldo negativo", OperationalExceptionCategory.BelowMinimum => "Bajo mínimo", OperationalExceptionCategory.UnassignedBalance => "Sin asignación", OperationalExceptionCategory.RestrictedInventory => "Restringido", OperationalExceptionCategory.StagnantInventory => "Estancado", OperationalExceptionCategory.CycleCountStale => "Conteo obsoleto", OperationalExceptionCategory.CycleCountPending => "Conteo pendiente", _ => "WIP estancado" }; static string EventLabel(OperationalExceptionEventType value) => value switch { OperationalExceptionEventType.Detected => "Condición detectada", OperationalExceptionEventType.AutoResolved => "Condición resuelta automáticamente", _ => "Seguimiento actualizado" }; }
