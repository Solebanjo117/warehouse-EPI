@page
@model WarehouseEPI.Web.Pages.Admin.Production.ScheduleModel
@using WarehouseEPI.Core.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@using global::System.Globalization
@using WarehouseEPI.Web.Production
@{
    ViewData["Title"] = ProdTexts["Programa semanal"];
}
<div class="container-fluid py-3 production-daily" data-production-daily data-no-description="@ProdTexts["Sin descripción"]" data-product-url="@Url.Page("/Operations/Lookup", "Products")">
    <header class="production-daily__header mb-4"><div><span class="eyebrow">@ProdTexts["Producción"]</span><h1 class="h2 mb-1">@ProdTexts["Programa semanal"]</h1><p class="text-body-secondary mb-0">@ProdTexts["Agrega productos por día y abre la semana para registrar producción."]</p></div><div class="d-flex gap-2"><a asp-page="/Operations/Production/Index" asp-route-WeekId="@Model.WeekId" class="btn btn-primary">@ProdTexts["Capturar"]</a><a asp-page="ScheduleImport" class="btn btn-outline-primary">@ProdTexts["Importar Excel"]</a></div></header>
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-12">
            <section class="card mb-4"><div class="card-body d-flex flex-wrap gap-3 justify-content-between align-items-end">
                <form method="get" class="d-flex flex-wrap gap-2 align-items-end"><div><label asp-for="WeekId" class="form-label">@ProdTexts["Semana"]</label><select asp-for="WeekId" class="form-select form-select-lg production-daily__week" disabled="@(Model.Weeks.Count == 0)"><option value="">@ProdTexts[Model.Weeks.Count == 0 ? "Todavía no hay semanas programadas" : "Selecciona una semana"]</option>@foreach(var item in Model.Weeks){<option value="@item.Id">@item.WeekStart.ToString("dd/MM")–@item.WeekEnd.ToString("dd/MM") · @ProductionDailyText.WeekStatus(ProdTexts, item.Status)</option>}</select></div><button class="btn btn-outline-primary btn-lg" disabled="@(Model.Weeks.Count == 0)">@ProdTexts["Abrir"]</button></form>
                <form method="post" asp-page-handler="CreateWeek" class="d-flex flex-wrap gap-2 align-items-end"><input asp-for="NewWeek.OperationId" type="hidden"/><div><label asp-for="NewWeek.WeekStart" class="form-label">@ProdTexts["Nueva semana (lunes)"]</label><input asp-for="NewWeek.WeekStart" type="date" class="form-control form-control-lg"/><span asp-validation-for="NewWeek.WeekStart" class="text-danger"></span></div><button class="btn btn-primary btn-lg">@ProdTexts["Crear borrador"]</button></form>
            </div></section>

            @if (Model.Week is not null)
            {
                <section class="card mb-4"><div class="card-body"><div class="d-flex flex-wrap justify-content-between gap-3"><div><span class="badge text-bg-secondary">@ProductionDailyText.WeekStatus(ProdTexts, Model.Week.Status)</span><h2 class="h4 mt-2">@Model.Week.WeekStart.ToString("dd/MM/yyyy") – @Model.Week.WeekEnd.ToString("dd/MM/yyyy")</h2></div><div class="d-flex flex-wrap gap-2">
                    @if(Model.Week.Status==ProductionScheduleWeekStatus.Open){<form method="post" asp-page-handler="Close"><input name="weekId" value="@Model.Week.Id" type="hidden"/><input name="version" value="@Model.Week.Version" type="hidden"/><button class="btn btn-outline-secondary">@ProdTexts["Cerrar semana"]</button></form>}
                    @if(Model.Week.Status==ProductionScheduleWeekStatus.Closed){<form method="post" asp-page-handler="Reopen"><input name="weekId" value="@Model.Week.Id" type="hidden"/><input name="version" value="@Model.Week.Version" type="hidden"/><button class="btn btn-outline-warning">@ProdTexts["Reabrir con auditoría"]</button></form>}
                </div></div>
                @if(Model.Week.Status!=ProductionScheduleWeekStatus.Closed)
                {
                    <hr/><form method="post" asp-page-handler="SaveLine" class="row g-3"><input asp-for="Line.OperationId" type="hidden"/><input asp-for="Line.WeekId" type="hidden"/><input asp-for="Line.LineId" type="hidden"/><input asp-for="Line.ExpectedWeekVersion" type="hidden"/><input asp-for="Line.ExpectedLineVersion" type="hidden"/><input asp-for="Line.ProductId" type="hidden" data-product-id/>
                        <div class="col-6 col-lg-2"><label asp-for="Line.PlannedDate" class="form-label">@ProdTexts["Día"]</label><input asp-for="Line.PlannedDate" type="date" min="@Model.Week.WeekStart.ToString("yyyy-MM-dd")" max="@Model.Week.WeekEnd.ToString("yyyy-MM-dd")" class="form-control form-control-lg"/></div>
                        <div class="col-12 col-lg-4 position-relative" data-product-field><label asp-for="Line.ProductLabel" class="form-label">@ProdTexts["SKU o descripción"]</label><input asp-for="Line.ProductLabel" class="form-control form-control-lg" data-product-input type="search" placeholder="@ProdTexts["Escribe y selecciona"]"/><div class="production-daily__suggestions list-group" data-product-results></div><span asp-validation-for="Line.ProductId" class="text-danger"></span></div>
                        <div class="col-6 col-lg-2"><label asp-for="Line.Quantity" class="form-label">@ProdTexts["Cantidad"]</label><input asp-for="Line.Quantity" class="form-control form-control-lg" inputmode="decimal"/></div>
                        <details class="col-12"><summary class="py-2">@ProdTexts["Más detalles"]</summary><div class="row g-3">
                        <div class="col-6 col-lg-2"><label asp-for="Line.OrderReference1" class="form-label">@ProdTexts["Orden 1"]</label><input asp-for="Line.OrderReference1" class="form-control"/></div><div class="col-6 col-lg-2"><label asp-for="Line.OrderReference2" class="form-label">@ProdTexts["Orden 2"]</label><input asp-for="Line.OrderReference2" class="form-control"/></div><div class="col-6 col-lg-2"><label asp-for="Line.OrderReference3" class="form-label">@ProdTexts["Orden 3"]</label><input asp-for="Line.OrderReference3" class="form-control"/></div>
                        <div class="col-12 col-lg-8"><label asp-for="Line.Notes" class="form-label">@ProdTexts["Notas"]</label><input asp-for="Line.Notes" class="form-control"/></div></div></details>
@if(Model.Week.Status==ProductionScheduleWeekStatus.Open && !Model.EditLineId.HasValue){<div class="col-md-4"><label asp-for="Line.Pin" class="form-label">@ProdTexts["NIP ADMIN de la sesión"]</label><input asp-for="Line.Pin" type="password" inputmode="numeric" class="form-control form-control-lg"/></div>}
<div class="col-12 col-lg-2 d-grid"><label class="form-label d-none d-lg-block">&nbsp;</label><button class="btn btn-primary">@(Model.EditLineId.HasValue?ProdTexts["Guardar cambio"]:ProdTexts["Agregar línea"])</button></div>
                    </form>
                }
                </div></section>
                <section class="card mb-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>#</th><th>@ProdTexts["Día"]</th><th>SKU</th><th class="text-end">@ProdTexts["Cantidad"]</th><th>@ProdTexts["Referencias"]</th><th>@ProdTexts["Origen"]</th><th></th></tr></thead><tbody>
                @foreach(var day in Enumerable.Range(0,6).Select(Model.Week.WeekStart.AddDays)){<tr class="table-light"><th colspan="7">@day.ToString("dddd dd/MM",CultureInfo.CurrentUICulture)</th></tr>@foreach(var line in Model.Week.Lines.Where(x=>x.PlannedDate==day)){<tr><td>@line.Sequence</td><td>@line.PlannedDate.ToString("ddd dd/MM", CultureInfo.CurrentUICulture)</td><td><strong>@line.Sku</strong><small class="d-block text-body-secondary">@line.Description</small></td><td class="text-end">@line.Quantity.ToString("0.####")</td><td>@string.Join(" · ",new[]{line.OrderReference1,line.OrderReference2,line.OrderReference3}.Where(x=>!string.IsNullOrWhiteSpace(x)))</td><td>@(line.IsCarryover?ProdTexts["Arrastre"]:line.WorkOrderId.HasValue?ProdTexts["Orden vinculada"]:ProdTexts["Plan"])</td><td>@if(Model.Week.Status!=ProductionScheduleWeekStatus.Closed){<a asp-route-WeekId="@Model.Week.Id" asp-route-EditLineId="@line.Id" class="btn btn-sm btn-outline-primary">@ProdTexts["Editar"]</a>}</td></tr>}}
                </tbody></table></div></section>
                <partial name="_ScheduleWorkflow" model="Model"/>
                @if(Model.Week.Status==ProductionScheduleWeekStatus.Draft)
                {
                    <section class="card border-primary"><div class="card-body"><h2 class="h5">@ProdTexts["Abrir semana para capturar"]</h2><p>@ProdTexts["Líneas"]: @Model.Week.Lines.Count · @ProdTexts["Piezas"]: @Model.Week.Lines.Sum(x=>x.Quantity).ToString("0.####",CultureInfo.InvariantCulture)</p><p class="small">@ProdTexts["Los pendientes de órdenes anteriores también estarán disponibles para capturar."]</p><p class="text-body-secondary">@ProdTexts["Si los procesos o turnos de Producción diaria no están listos, no se creará ninguna orden."]</p><form method="post" asp-page-handler="Publish" class="row g-2 align-items-end"><input asp-for="Publish.OperationId" type="hidden"/><input asp-for="Publish.WeekId" type="hidden"/><input asp-for="Publish.ExpectedVersion" type="hidden"/><div class="col-12 col-md-4"><label asp-for="Publish.Pin" class="form-label">@ProdTexts["NIP ADMIN de la sesión"]</label><input asp-for="Publish.Pin" class="form-control form-control-lg" type="password" inputmode="numeric"/></div><div class="col-12 col-md-4"><button class="btn btn-success btn-lg w-100">@ProdTexts["Abrir semana para capturar"]</button></div></form></div></section>
                }
            }
        </div>
        <aside class="col-12" id="daily-configuration"><details class="card" open="@(!Model.ConfigurationReady)"><summary class="card-header py-3">@ProdTexts["Configuración diaria"]</summary><div class="card-body"><h2 class="h5">@ProdTexts["Configuración diaria"]</h2><p class="small text-body-secondary">@ProdTexts["Reutiliza procesos y turnos existentes; no crea catálogos duplicados."]</p>@if (!Model.ConfigurationReady) { <p class="alert alert-warning" role="status">@ProdTexts["Las coincidencias únicas se proponen aquí. Revisa y guarda la configuración para habilitar la captura."]</p> }<form method="post" asp-page-handler="Configure" class="d-grid gap-3"><input asp-for="Configuration.OperationId" type="hidden"/><input asp-for="Configuration.ExpectedVersion" type="hidden"/>
            <div><label asp-for="Configuration.CuttingStageId" class="form-label">@ProdTexts["Corte"]</label><select asp-for="Configuration.CuttingStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.SewingStageId" class="form-label">@ProdTexts["Costura"]</label><select asp-for="Configuration.SewingStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.ReadyToPackStageId" class="form-label">@ProdTexts["Ready to Pack"]</label><select asp-for="Configuration.ReadyToPackStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.Shift1Id" class="form-label">T1</label><select asp-for="Configuration.Shift1Id" class="form-select"><option value="">@ProdTexts[Model.Shifts.Count == 0 ? "No hay turnos activos" : "Selecciona un turno"]</option>@foreach(var shift in Model.Shifts){<option value="@shift.Id">@shift.Name</option>}</select></div><div><label asp-for="Configuration.Shift2Id" class="form-label">T2</label><select asp-for="Configuration.Shift2Id" class="form-select"><option value="">@ProdTexts[Model.Shifts.Count == 0 ? "No hay turnos activos" : "Selecciona un turno"]</option>@foreach(var shift in Model.Shifts){<option value="@shift.Id">@shift.Name</option>}</select></div><button class="btn btn-outline-primary">@ProdTexts["Guardar configuración"]</button>
        </form>
        <a asp-page="/Admin/Production/Routes" class="btn btn-outline-secondary w-100 mt-3">@ProdTexts["Agregar turno"]</a>
        </div></details></aside>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/production-daily.js" asp-append-version="true"></script> }
@section Styles { <link rel="stylesheet" href="~/css/production-daily.css" asp-append-version="true"/> }


