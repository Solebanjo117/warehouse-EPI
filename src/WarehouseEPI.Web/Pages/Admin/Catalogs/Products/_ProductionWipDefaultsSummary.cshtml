@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.DetailsModel
<section class="card mb-4" aria-labelledby="product-wip-summary-heading">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div><span class="eyebrow">@CatTexts["Producción"]</span><h2 id="product-wip-summary-heading" class="h4 mb-1">@CatTexts["Destinos WIP habituales"]</h2><p class="text-body-secondary mb-0">@CatTexts["Preferencias por proceso; no representan existencias."]</p></div>
            <a asp-page="Edit" asp-route-id="@Model.Product.Id" asp-fragment="product-wip-defaults" class="btn btn-outline-primary">@CatTexts["Editar destinos WIP"]</a>
        </div>
        @if (Model.WipConfiguration.Rules.Count == 0)
        {
            <div class="product-editor-empty mt-3">@CatTexts["Configura un destino habitual cuando este producto se utilice como material."]</div>
        }
        else
        {
            <div class="table-responsive mt-3"><table class="table align-middle mb-0">
                <thead><tr><th>@CatTexts["Proceso"]</th><th>@CatTexts["Destino habitual"]</th><th>@CatTexts["Tipo"]</th><th>@CatTexts["Estado"]</th></tr></thead>
                <tbody>
                @foreach (var rule in Model.WipConfiguration.Rules)
                {
                    <tr><td>@rule.Process</td><td><strong>@rule.Target</strong></td><td>@rule.Type</td><td>
                        @if (rule.IsAvailable) { <span class="badge text-bg-success">@CatTexts["Disponible"]</span> }
                        else { <span class="badge text-bg-warning">@CatTexts["Requiere atención"]</span><small class="d-block text-body-secondary">@rule.Warning</small> }
                    </td></tr>
                }
                </tbody>
            </table></div>
        }
        @if (Model.WipConfiguration.Revisions.Count > 0)
        {
            <details class="mt-3">
                <summary class="fw-semibold">@CatTexts["Historial de cambios"]</summary>
                <ul class="list-group list-group-flush mt-2">
                @foreach (var revision in Model.WipConfiguration.Revisions)
                {
                    <li class="list-group-item px-0"><strong>@revision.RecordedAt.ToString("yyyy-MM-dd HH:mm") UTC</strong> · @revision.AuthorizedByUser.FullName<span class="d-block text-body-secondary">@revision.Reason</span></li>
                }
                </ul>
            </details>
        }
    </div>
</section>
