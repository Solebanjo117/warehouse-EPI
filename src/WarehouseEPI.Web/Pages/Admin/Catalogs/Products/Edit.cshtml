@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.EditModel
@{
    ViewData["Title"] = "Editar producto";
    var activeLocationCount = Model.LocationAssignments.Count(item => item.IsActive);
    var activeBarcodeCount = Model.Barcodes.Count(item => item.IsActive);
}

<div class="product-editor-workspace">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <header class="product-editor-header">
        <div>
            <span class="product-editor-eyebrow">Catálogo de productos</span>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="h2 mb-0">Editar producto</h1>
                <span class="badge @(Model.Input.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.Input.IsActive ? "Activo" : "Inactivo")</span>
            </div>
            <p class="product-editor-product-code mb-0">@Model.Input.Sku</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Details" asp-route-id="@Model.Input.Id" class="btn btn-outline-primary">Ver ficha</a>
            <a asp-page="Index" class="btn btn-outline-secondary">Volver a productos</a>
        </div>
    </header>

    <partial name="_ProductForm" model="Model" />

    <section class="card product-editor-module" aria-labelledby="product-locations-heading">
        <div class="card-body p-3 p-md-4">
            <div class="product-editor-module-header">
                <div>
                    <span class="product-editor-step">Distribución</span>
                    <h2 id="product-locations-heading" class="h4 mb-1">Ubicaciones asignadas</h2>
                    <p class="text-body-secondary mb-0">Relaciones fijas para encontrar y operar este producto; no representan el saldo actual.</p>
                </div>
                <span class="product-editor-count">@activeLocationCount @(activeLocationCount == 1 ? "activa" : "activas")</span>
            </div>

            <form method="get" asp-page="Edit" asp-route-id="@Model.Input.Id" class="product-editor-search">
                <div class="flex-grow-1">
                    <label for="locationSearch" class="form-label fw-semibold">Buscar otra ubicación</label>
                    <input id="locationSearch" name="locationSearch" value="@Model.LocationSearch" class="form-control form-control-lg" placeholder="Código o descripción" autocomplete="off" />
                </div>
                <button type="submit" class="btn btn-outline-primary btn-lg">Buscar ubicación</button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.LocationSearch))
            {
                <div class="product-editor-search-results" aria-live="polite">
                    <h3 class="h6 mb-2">Resultados para “@Model.LocationSearch”</h3>
                    @if (Model.LocationResults.Count == 0)
                    {
                        <div class="product-editor-empty">No se encontraron ubicaciones disponibles. Prueba con parte del código o descripción.</div>
                    }
                    else
                    {
                        <ul class="product-editor-list" aria-label="Resultados de ubicaciones">
                            @foreach (var location in Model.LocationResults)
                            {
                                <li class="product-editor-list-row">
                                    <div class="product-editor-list-main">
                                        <strong>@location.Code</strong>
                                        <span class="text-body-secondary">@(location.Description ?? "Sin descripción")</span>
                                    </div>
                                    @if (location.IsAssigned)
                                    {
                                        <span class="badge text-bg-success">Ya asignada</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="AssignLocation" asp-route-id="@Model.Input.Id">
                                            <input type="hidden" name="locationId" value="@location.Id" />
                                            <button type="submit" class="btn btn-primary" disabled="@(!Model.Input.IsActive)">Asignar</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            <div class="product-editor-subsection">
                <h3 class="h6 mb-2">Asignaciones registradas</h3>
                @if (Model.LocationAssignments.Count == 0)
                {
                    <div class="product-editor-empty">Este producto todavía no tiene ubicaciones asignadas.</div>
                }
                else
                {
                    <ul class="product-editor-list" aria-label="Ubicaciones asignadas">
                        @foreach (var item in Model.LocationAssignments)
                        {
                            <li class="product-editor-list-row @(!item.IsActive ? "is-inactive" : null)">
                                <div class="product-editor-list-main">
                                    <a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@item.LocationId" class="fw-semibold">@item.Code</a>
                                    <span class="text-body-secondary">@(item.Description ?? "Sin descripción")</span>
                                </div>
                                <div class="product-editor-list-status">
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge text-bg-secondary">Asignación inactiva</span>
                                    }
                                    else if (!item.LocationIsActive)
                                    {
                                        <span class="badge text-bg-secondary">Ubicación inactiva</span>
                                    }
                                    else if (item.LocationIsBlocked)
                                    {
                                        <span class="badge text-bg-warning">Ubicación bloqueada</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">Asignada</span>
                                    }
                                </div>
                                <div class="product-editor-list-actions">
                                    @if (item.IsActive)
                                    {
                                        <form method="post" asp-page-handler="DeactivateLocation" asp-route-id="@Model.Input.Id">
                                            <input type="hidden" name="locationId" value="@item.LocationId" />
                                            <button type="submit" class="btn btn-outline-secondary">Desasignar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="AssignLocation" asp-route-id="@Model.Input.Id">
                                            <input type="hidden" name="locationId" value="@item.LocationId" />
                                            <button type="submit" class="btn btn-outline-primary" disabled="@(!item.LocationIsActive || item.LocationIsBlocked || !Model.Input.IsActive)">Reactivar</button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>

    <section class="card product-editor-module" aria-labelledby="product-barcodes-heading">
        <div class="card-body p-3 p-md-4">
            <div class="product-editor-module-header">
                <div>
                    <span class="product-editor-step">Identificación</span>
                    <h2 id="product-barcodes-heading" class="h4 mb-1">Códigos de barras</h2>
                    <p class="text-body-secondary mb-0">Administra los códigos que identifican este producto durante la operación.</p>
                </div>
                <span class="product-editor-count">@activeBarcodeCount @(activeBarcodeCount == 1 ? "activo" : "activos")</span>
            </div>

            <form method="post" asp-page-handler="AddBarcode" asp-route-id="@Model.Input.Id" class="product-editor-inline-form">
                <div class="product-editor-inline-form-heading">
                    <h3 class="h6 mb-1">Agregar código</h3>
                    <p class="text-body-secondary mb-0">El código principal será la referencia preferida del producto.</p>
                </div>
                <div>
                    <label asp-for="BarcodeInput.Barcode" class="form-label fw-semibold">Código</label>
                    <input asp-for="BarcodeInput.Barcode" class="form-control form-control-lg" autocomplete="off" />
                </div>
                <div>
                    <label asp-for="BarcodeInput.Format" class="form-label fw-semibold">Formato</label>
                    <select asp-for="BarcodeInput.Format" asp-items="Model.BarcodeFormats" class="form-select form-select-lg"></select>
                </div>
                <div class="product-editor-primary-check">
                    <div class="form-check">
                        <input asp-for="BarcodeInput.IsPrimary" class="form-check-input" />
                        <label asp-for="BarcodeInput.IsPrimary" class="form-check-label">Marcar como principal</label>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-lg">Agregar código</button>
            </form>

            <div class="product-editor-subsection">
                <h3 class="h6 mb-2">Códigos registrados</h3>
                @if (Model.Barcodes.Count == 0)
                {
                    <div class="product-editor-empty">Este producto todavía no tiene códigos de barras.</div>
                }
                else
                {
                    <ul class="product-editor-list" aria-label="Códigos de barras registrados">
                        @foreach (var item in Model.Barcodes)
                        {
                            <li class="product-editor-list-row @(!item.IsActive ? "is-inactive" : null)">
                                <div class="product-editor-list-main product-editor-barcode-value">
                                    <strong>@item.Barcode</strong>
                                    <span class="text-body-secondary">@item.Format</span>
                                </div>
                                <div class="product-editor-list-status">
                                    @if (item.IsPrimary)
                                    {
                                        <span class="badge text-bg-primary">Principal</span>
                                    }
                                    <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span>
                                </div>
                                <div class="product-editor-list-actions">
                                    @if (item.IsActive && !item.IsPrimary)
                                    {
                                        <form method="post" asp-page-handler="SetPrimary" asp-route-id="@Model.Input.Id">
                                            <input type="hidden" name="barcodeId" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-primary">Hacer principal</button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="ToggleBarcode" asp-route-id="@Model.Input.Id">
                                        <input type="hidden" name="barcodeId" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-secondary">@(item.IsActive ? "Desactivar" : "Reactivar")</button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
