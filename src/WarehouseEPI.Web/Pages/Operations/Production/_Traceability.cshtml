@using WarehouseEPI.Web.Pages.Operations.Production
@model WarehouseEPI.Web.Pages.Operations.Production.WorkModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@{ var o=Model.Order; var active=o.Status is WarehouseEPI.Core.Entities.ProductionWorkOrderStatus.Released or WarehouseEPI.Core.Entities.ProductionWorkOrderStatus.InProgress or WarehouseEPI.Core.Entities.ProductionWorkOrderStatus.PrincipalClosed; var selected=Model.Batches.FirstOrDefault(x=>x.Id==Model.BatchId); }
@if(!o.UsesBatchTraceability){<div class="alert alert-warning" role="status"><strong>@ProdTexts["Seguimiento anterior sin trazabilidad por lote."]</strong> @ProdTexts["Conserva el flujo con el que fue creada."]</div>}
else
{
<section class="production-trace mb-4" aria-labelledby="trace-title">
 <div class="d-flex flex-wrap justify-content-between gap-3 mb-3"><div><h2 id="trace-title" class="h4 mb-1">@ProdTexts["Transformación por lotes"]</h2><p class="text-body-secondary mb-0">@ProdTexts["Receta v{0} · cantidades separadas por unidad.", o.RecipeVersion?.ToString() ?? string.Empty]</p></div><form method="get" class="d-flex gap-2" data-batch-filter-form><input type="hidden" name="id" value="@o.Id"/><label class="visually-hidden" for="batch-filter">@ProdTexts["Lote"]</label><select id="batch-filter" name="BatchId" class="form-select" data-batch-filter><option value="">@ProdTexts["Vista acumulada"]</option>@foreach(var b in Model.Batches){<option value="@b.Id" selected="@(Model.BatchId==b.Id)">@b.Number</option>}</select></form></div>
 <div class="production-flow">
  <article class="production-flow-column"><h3 class="h6">@ProdTexts["Materiales"]</h3>@foreach(var m in Model.MaterialPlan){var materialState=m.Pending>0?ProdTexts["Faltan {0}", m.Pending.ToString("0.####")].Value:m.Consumed==0&&m.Issued>0?ProdTexts["Material listo en WIP"].Value:ProdTexts["Surtimiento completo"].Value;<div class="production-flow-card @(m.Pending>0?"is-warning":"is-ready")"><strong>@m.Sku</strong><small>@m.Description</small><dl><dt>@ProdTexts["Previsto"]</dt><dd>@m.Planned.ToString("0.####") @m.Unit</dd><dt>@ProdTexts["Surtido"]</dt><dd>@m.Issued.ToString("0.####")</dd><dt>@ProdTexts["Consumido"]</dt><dd>@m.Consumed.ToString("0.####")</dd><dt>@ProdTexts["Devuelto"]</dt><dd>@m.Returned.ToString("0.####")</dd></dl><span class="badge @(m.Pending>0?"text-bg-warning":"text-bg-success")">@materialState</span><a asp-page="/Operations/ProductionSupply/Index" asp-route-Search="@o.Number" class="btn btn-sm btn-outline-primary mt-2">@ProdTexts["Ver surtimientos"]</a>@if(WarehouseEPI.Infrastructure.Production.ProductionActionPolicy.Allows(o.Status,"capture")){<a asp-page="Execution" asp-route-id="@o.Id" class="btn btn-sm btn-outline-warning mt-2">@ProdTexts["Ajustar orden y materiales"]</a>}</div>}</article>
  <span class="production-flow-arrow" aria-hidden="true">→</span>
  <article class="production-flow-column production-flow-processes"><h3 class="h6">@ProdTexts["Procesos"]</h3>@foreach(var s in o.Stages){<div class="production-flow-card"><strong>@s.Sequence. @s.Name</strong><small>@s.Code</small><dl><dt>@ProdTexts["Bueno"]</dt><dd>@s.Good.ToString("0.####") @o.Unit</dd><dt>@ProdTexts["Retrabajo"]</dt><dd>@s.Rework.ToString("0.####")</dd><dt>@ProdTexts["Merma"]</dt><dd>@s.Scrap.ToString("0.####")</dd><dt>@ProdTexts["Por recibir"]</dt><dd>@s.PendingReceipt.ToString("0.####")</dd></dl></div>}</article>
  <span class="production-flow-arrow" aria-hidden="true">→</span>
  <article class="production-flow-column"><h3 class="h6">@ProdTexts["Producto terminado"]</h3>@if(selected is null){<div class="production-flow-card"><strong>@o.Sku</strong><small>@ProdTexts["Selecciona un lote."]</small></div>}else{<div class="production-flow-card is-ready"><strong>@selected.Number</strong><small>@ProdTexts["{0} {1} asignados", selected.Assigned.ToString("0.####"), o.Unit]</small><dl><dt>@ProdTexts["Bueno final"]</dt><dd>@selected.Good.ToString("0.####")</dd><dt>@ProdTexts["Recibido en bodega"]</dt><dd>@selected.WarehouseReceived.ToString("0.####")</dd><dt>@ProdTexts["Merma"]</dt><dd>@selected.Scrap.ToString("0.####")</dd><dt>@ProdTexts["Proceso"]</dt><dd>@selected.CurrentStage</dd></dl><a asp-page="BatchLabel" asp-route-id="@selected.Id" class="btn btn-outline-primary btn-sm">@ProdTexts["Imprimir etiqueta"]</a></div>}</article>
  <span class="production-flow-arrow" aria-hidden="true">→</span>
  <article class="production-flow-column"><h3 class="h6">@ProdTexts["Bodega"]</h3><div class="production-flow-card"><strong>@ProdTexts["{0} de {1} {2}", o.WarehouseReceived.ToString("0.####"), o.TargetQuantity.ToString("0.####"), o.Unit]</strong><div class="progress mt-2" role="progressbar" aria-label="@ProdTexts["Recibido en bodega"]"><div class="progress-bar" style="width:@(o.TargetQuantity>0?Math.Min(100,o.WarehouseReceived*100/o.TargetQuantity):0)%"></div></div>@if(o.WarehouseReceived>o.TargetQuantity){<span class="badge text-bg-warning mt-2">@ProdTexts["Excedente {0}", o.WarehouseReceived - o.TargetQuantity]</span>}</div></article>
 </div>
</section>
@if(selected is not null){<details class="card mb-4"><summary class="card-header fw-semibold">@ProdTexts["Procedencia del lote {0}", selected.Number]</summary><div class="card-body">@if(Model.TraceLinks.Count==0){<p class="text-body-secondary mb-0">@ProdTexts["Todavía no hay materiales consumidos vinculados a este lote."]</p>}else{<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>@ProdTexts["Material"]</th><th>@ProdTexts["Lote"]</th><th>@ProdTexts["Consumo"]</th><th>@ProdTexts["Proceso"]</th><th>@ProdTexts["Responsable"]</th></tr></thead><tbody>@foreach(var x in Model.TraceLinks){<tr><td>@x.MaterialSku</td><td>@x.MaterialLot</td><td>@x.Quantity.ToString("0.####") @x.Unit</td><td>@x.Stage</td><td>@x.Responsible<small class="d-block text-body-secondary">@x.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td></tr>}</tbody></table></div>}</div></details>}
@if(selected is not null&&Model.BatchResults.Count>0){<details class="card mb-4"><summary class="card-header fw-semibold">@ProdTexts["Resultados parciales de {0}", selected.Number]</summary><div class="card-body table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>@ProdTexts["Fecha"]</th><th>@ProdTexts["Proceso"]</th><th>@ProdTexts["Resultado"]</th><th>@ProdTexts["Responsable"]</th><th>@ProdTexts["Corrección"]</th></tr></thead><tbody>@foreach(var r in Model.BatchResults){<tr><td>@r.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@r.Stage<small class="d-block text-body-secondary">@r.Shift</small></td><td>@ProdTexts["{0} procesadas", r.Input.ToString("0.####")]<small class="d-block">@ProdTexts["Buena {0} · Retrabajo {1} · Merma {2}", r.Good.ToString("0.####"), r.Rework.ToString("0.####"), r.Scrap.ToString("0.####")]</small></td><td>@r.Responsible</td><td>@if(!r.CanReverse){<span class="badge text-bg-secondary">@ProdTexts["Revertido"]</span>}else if(WarehouseEPI.Infrastructure.Production.ProductionActionPolicy.Allows(o.Status,"capture")){<details><summary class="btn btn-sm btn-outline-danger">@ProdTexts["Revertir"]</summary><form method="post" asp-page-handler="ReverseResult" class="mt-2"><input asp-for="ResultReverse.OperationId" type="hidden" value="@Guid.NewGuid()"/><input asp-for="ResultReverse.ResultId" type="hidden" value="@r.Id"/><input asp-for="ResultReverse.ExpectedVersion" type="hidden" /><label class="form-label">@ProdTexts["Motivo"]</label><input asp-for="ResultReverse.Reason" class="form-control mb-2" required/><label class="form-label">@ProdTexts["NIP ADMIN"]</label><input asp-for="ResultReverse.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control mb-2" required/><button class="btn btn-danger btn-sm" type="submit">@ProdTexts["Confirmar reverso"]</button></form></details>}</td></tr>}</tbody></table></div></details>}
@if(active||Model.FailedHandler is "BatchResult" or "Handoff" or "Warehouse" or "Batch")
{
<section class="card mb-4"><div class="card-body"><h2 class="h5">@ProdTexts["Lotes de producción"]</h2><div class="d-flex flex-wrap gap-2 mb-3">@foreach(var b in Model.Batches){<a asp-route-id="@o.Id" asp-route-BatchId="@b.Id" class="btn @(b.Id==Model.BatchId?"btn-primary":"btn-outline-primary")">@b.Number · @b.Assigned.ToString("0.####")</a>}</div>@if(Model.Batches.Count==0){<details><summary class="btn btn-outline-primary">@ProdTexts["Crear lote único de la orden"]</summary><form method="post" asp-page-handler="Batch" class="row g-3 mt-2"><input asp-for="Batch.OperationId" type="hidden"/><input asp-for="Batch.ExpectedVersion" type="hidden"/><div class="col-6"><label asp-for="Batch.Quantity" class="form-label">@ProdTexts["Cantidad asignada"]</label><input asp-for="Batch.Quantity" data-decimals="@(o.AllowsDecimals?"true":"false")" value="@o.AuthorizedQuantity" readonly class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6"><label asp-for="Batch.Pin" class="form-label">@ProdTexts["NIP"]</label><input asp-for="Batch.Pin" type="password" value="" class="form-control form-control-lg" inputmode="numeric" autocomplete="off"/></div><div class="col-12"><button class="btn btn-primary" type="submit">@ProdTexts["Crear e identificar lote"]</button></div></form></details>}</div></section>
@if(selected is not null)
{
<div class="accordion mb-4" id="trace-actions">
 <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#batch-result-panel">@ProdTexts["Registrar resultado y consumo"]</button></h2><div id="batch-result-panel" class="accordion-collapse collapse show"><div class="accordion-body"><form method="post" asp-page-handler="BatchResult" class="row g-3" data-batch-result-form><div class="col-12"><label asp-for="BatchResult.IsRework" class="form-label">@ProdTexts["Operación"]</label><select asp-for="BatchResult.IsRework" class="form-select" data-result-mode><option value="false">@ProdTexts["Registrar avance"]</option><option value="true">@ProdTexts["Atender retrabajo"]</option></select><p class="form-text">@ProdTexts["En retrabajo captura solamente el material adicional utilizado."]</p></div><input asp-for="BatchResult.OperationId" type="hidden"/><input asp-for="BatchResult.ExpectedVersion" type="hidden"/><input asp-for="BatchResult.BatchId" type="hidden" value="@selected.Id"/><div class="col-6"><label asp-for="BatchResult.StageId" class="form-label">@ProdTexts["Proceso"]</label><select asp-for="BatchResult.StageId" class="form-select form-select-lg" data-result-stage><option value="">@ProdTexts["Selecciona…"]</option>@foreach(var s in o.Stages){<option value="@s.Id">@s.Sequence. @s.Name</option>}</select></div><div class="col-6"><label asp-for="BatchResult.ShiftId" class="form-label">@ProdTexts["Turno"]</label><select asp-for="BatchResult.ShiftId" class="form-select form-select-lg"><option value="">@ProdTexts["Selecciona…"]</option>@foreach(var s in Model.Shifts.Where(x=>x.IsActive)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-12"><h3 class="h6">@ProdTexts["Material consumido realmente"]</h3><p class="small text-body-secondary">@ProdTexts["El plan autorizado orienta la propuesta. Revisa el consumo real por origen; la receta histórica se conserva como referencia."]</p><button type="button" class="btn btn-outline-primary mb-3" data-propose-consumption>@ProdTexts["Proponer consumo"]</button><div data-consumption-summary role="status" aria-live="polite"></div>@for(var i=0;i<Model.MaterialIssues.Count;i++){var m=Model.MaterialIssues[i];var enteredIndex=Model.BatchResult.Materials.FindIndex(x=>x.IssueLinkId==m.IssueLinkId);var entered=enteredIndex<0?null:Model.BatchResult.Materials[enteredIndex];var captured=ProductionCapture.Value(Model,$"BatchResult.Materials[{enteredIndex}].Quantity",entered?.Quantity??0);var plan=Model.MaterialPlan.FirstOrDefault(x=>x.StageId==m.StageId&&x.Sku==m.ProductSku);var ratio=plan is null||o.AuthorizedQuantity<=0?0:plan.Planned/o.AuthorizedQuantity;<div class="row g-2 align-items-center mb-2" data-result-material data-stage-id="@m.StageId" data-product-id="@m.ProductId" data-issue-id="@m.IssueLinkId" data-created="@m.CreatedAt.ToString("O")" data-sku="@m.ProductSku" data-unit="@m.Unit" data-decimals="@(m.AllowsDecimals?"true":"false")"><input name="BatchResult.Materials[@i].IssueLinkId" value="@m.IssueLinkId" type="hidden"/><input name="BatchResult.Materials[@i].WipCode" value="@m.WipCode" type="hidden"/><div class="col-12"></div><div class="col-auto"><input name="BatchResult.Materials[@i].Selected" value="true" type="checkbox" checked="@(entered?.Selected==true)" class="form-check-input" aria-label="Consumir @m.ProductSku"/></div><div class="col"><strong>@m.ProductSku</strong><small class="d-block text-body-secondary">@m.WipCode · @m.Pending.ToString("0.####") @m.Unit</small>@if(!string.IsNullOrWhiteSpace(m.Lots)){<small class="d-block">@ProdTexts["Lotes: {0}", m.Lots]</small>}</div><div class="col-4"><label class="visually-hidden" for="batch-material-@i">@ProdTexts["Cantidad de {0}", m.ProductSku]</label><input id="batch-material-@i" name="BatchResult.Materials[@i].Quantity" class="form-control" inputmode="decimal" max="@m.Pending" value="@captured" data-result-material-quantity data-ratio="@ratio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-pending="@m.Pending.ToString(System.Globalization.CultureInfo.InvariantCulture)"/></div></div>}</div><div class="col-6 col-lg-3"><label asp-for="BatchResult.InputQuantity" class="form-label">@ProdTexts["Procesada"]</label><input asp-for="BatchResult.InputQuantity" data-decimals="@(o.AllowsDecimals?"true":"false")" class="form-control form-control-lg" inputmode="decimal" data-result-input/></div><div class="col-6 col-lg-3"><label asp-for="BatchResult.GoodQuantity" class="form-label">@ProdTexts["Buena"]</label><input asp-for="BatchResult.GoodQuantity" data-decimals="@(o.AllowsDecimals?"true":"false")" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="BatchResult.ReworkQuantity" class="form-label">@ProdTexts["Retrabajo"]</label><input asp-for="BatchResult.ReworkQuantity" data-decimals="@(o.AllowsDecimals?"true":"false")" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="BatchResult.ScrapQuantity" class="form-label">@ProdTexts["Merma"]</label><input asp-for="BatchResult.ScrapQuantity" data-decimals="@(o.AllowsDecimals?"true":"false")" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-md-6"><label asp-for="BatchResult.ReworkCaseId" class="form-label">@ProdTexts["Pendiente de retrabajo (al atender retrabajo)"]</label><select asp-for="BatchResult.ReworkCaseId" class="form-select" data-rework-case><option value="">@ProdTexts["Selecciona…"]</option>@foreach(var item in Model.Rework.Where(x=>x.BatchId==selected.Id && x.Pending>0)){<option value="@item.Id" data-stage-id="@item.StageId">@ProdTexts["{0} · {1} pendientes", item.Stage, item.Pending.ToString("0.####")]</option>}</select></div>
<div class="col-12"><p role="status" data-result-balance>@ProdTexts["Procesada = buena + retrabajo + merma."]</p></div><div class="col-md-6"><label asp-for="BatchResult.ReasonId" class="form-label">@ProdTexts["Motivo de resultado"]</label><select asp-for="BatchResult.ReasonId" class="form-select"><option value="">@ProdTexts["Sin diferencia, merma ni retrabajo"]</option>@foreach(var reason in Model.Reasons.Where(x=>x.Category!=WarehouseEPI.Core.Entities.ProductionReasonCategory.Adjustment)){<option value="@reason.Id">@(reason.Category==WarehouseEPI.Core.Entities.ProductionReasonCategory.Rework?ProdTexts["Retrabajo"].Value:reason.Category==WarehouseEPI.Core.Entities.ProductionReasonCategory.Scrap?ProdTexts["Merma"].Value:ProdTexts["Diferencia"].Value) · @reason.Description</option>}</select></div>
<div class="col-md-6"><label asp-for="BatchResult.AdminPin" class="form-label">@ProdTexts["NIP ADMIN para descartar retrabajo"]</label><input asp-for="BatchResult.AdminPin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control"/></div><div class="col-8"><label asp-for="BatchResult.DifferenceReason" class="form-label">@ProdTexts["Motivo si difiere de receta"]</label><input asp-for="BatchResult.DifferenceReason" class="form-control"/></div><div class="col-4"><label asp-for="BatchResult.Pin" class="form-label">@ProdTexts["NIP"]</label><input asp-for="BatchResult.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control"/></div><div class="col-12"><button class="btn btn-primary btn-lg" type="submit">@ProdTexts["Confirmar resultado y consumo"]</button></div></form></div></div></div>
 <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#batch-handoff-panel">@ProdTexts["Entregar, recibir o conciliar"]</button></h2><div id="batch-handoff-panel" class="accordion-collapse collapse"><div class="accordion-body"><form method="post" asp-page-handler="Handoff" class="row g-3"><input asp-for="Handoff.OperationId" type="hidden"/><input asp-for="Handoff.ExpectedVersion" type="hidden" value="@o.Version"/><input asp-for="Handoff.BatchId" type="hidden" value="@selected.Id"/><div class="col-4"><label asp-for="Handoff.Mode" class="form-label">@ProdTexts["Acción"]</label><select asp-for="Handoff.Mode" class="form-select"><option value="deliver">@ProdTexts["Entregar"]</option><option value="receive">@ProdTexts["Recibir"]</option><option value="return">@ProdTexts["Devolver diferencia"]</option><option value="lost">@ProdTexts["Registrar pérdida"]</option></select></div><div class="col-4"><label asp-for="Handoff.SourceStageId" class="form-label">@ProdTexts["Origen"]</label><select asp-for="Handoff.SourceStageId" class="form-select">@foreach(var s in o.Stages.Take(Math.Max(0,o.Stages.Count-1))){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-4"><label asp-for="Handoff.TargetStageId" class="form-label">@ProdTexts["Destino"]</label><select asp-for="Handoff.TargetStageId" class="form-select">@foreach(var s in o.Stages.Skip(1)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-12"><label asp-for="Handoff.DeliveryEventId" class="form-label">@ProdTexts["Entrega pendiente"]</label><select asp-for="Handoff.DeliveryEventId" class="form-select"><option value="">@ProdTexts["No aplica al entregar"]</option>@foreach(var d in Model.PendingDeliveries.Where(x=>x.BatchId==selected.Id)){<option value="@d.Id">@ProdTexts["{0} · {1} pendientes", d.BatchNumber, d.Pending.ToString("0.####")]</option>}</select></div><div class="col-4"><label asp-for="Handoff.Quantity" class="form-label">@ProdTexts["Cantidad"]</label><input asp-for="Handoff.Quantity" data-decimals="@(o.AllowsDecimals?"true":"false")" class="form-control" inputmode="decimal"/></div><div class="col-5"><label asp-for="Handoff.Reason" class="form-label">@ProdTexts["Motivo de diferencia"]</label><input asp-for="Handoff.Reason" class="form-control"/></div><div class="col-3"><label asp-for="Handoff.Pin" class="form-label">@ProdTexts["NIP"]</label><input asp-for="Handoff.Pin" value="" type="password" inputmode="numeric" class="form-control"/></div><div class="col-12"><button class="btn btn-primary" type="submit">@ProdTexts["Registrar movimiento"]</button></div></form></div></div></div>
 <div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#batch-warehouse-panel">@ProdTexts["Recibir en bodega"]</button></h2><div id="batch-warehouse-panel" class="accordion-collapse collapse"><div class="accordion-body"><form method="post" asp-page-handler="Warehouse" class="row g-3"><input asp-for="Warehouse.OperationId" type="hidden"/><input asp-for="Warehouse.ExpectedVersion" type="hidden" value="@o.Version"/><input asp-for="Warehouse.FinalStageId" type="hidden" value="@o.Stages.Last().Id"/><input asp-for="Warehouse.BatchId" type="hidden" value="@selected.Id"/><div class="col-4"><label asp-for="Warehouse.Quantity" class="form-label">@ProdTexts["Cantidad"]</label><input asp-for="Warehouse.Quantity" data-decimals="@(o.AllowsDecimals?"true":"false")" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-5"><label asp-for="Warehouse.DestinationLocationId" class="form-label">@ProdTexts["Ubicación"]</label><select asp-for="Warehouse.DestinationLocationId" class="form-select form-select-lg"><option value="">@ProdTexts["Selecciona…"]</option>@foreach(var x in Model.Destinations){<option value="@x.Id">@x.Code</option>}</select></div><div class="col-3"><label asp-for="Warehouse.Pin" class="form-label">@ProdTexts["NIP"]</label><input asp-for="Warehouse.Pin" value="" type="password" inputmode="numeric" class="form-control form-control-lg"/></div><partial name="_WarehouseSharing" model="Model"/><div class="col-12"><button class="btn btn-success btn-lg" type="submit">@ProdTexts["Registrar recepción y entrada (acción)"]</button></div></form></div></div></div>
</div>
}
}
}
