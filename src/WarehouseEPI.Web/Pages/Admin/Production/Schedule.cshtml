@page
@model WarehouseEPI.Web.Pages.Admin.Production.ScheduleModel
@using WarehouseEPI.Core.Entities
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@using global::System.Globalization
@using WarehouseEPI.Web.Production
@{
    ViewData["Title"] = ProdTexts["Programa semanal"];
}
<div class="container-fluid py-3 production-daily production-schedule" data-schedule-context data-week-id="@Model.Week?.Id" data-user-id="@Model.User.FindFirst(global::System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" data-week-status="@Model.Week?.Status" data-review-url="@Url.Page("Schedule", new { Model.WeekId, SelectedDay = Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), View = "review" })" data-program-url="@Url.Page("Schedule", new { Model.WeekId, SelectedDay = Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), View = "program" })"
                    data-state-saved="@ProdTexts["Programa guardado"]" data-state-changed="@ProdTexts["Cambios sin guardar"]" data-state-prepared="@ProdTexts["Preparación sin incorporar"]" data-state-saving="@ProdTexts["Guardando…"]" data-state-uncertain="@ProdTexts["Guardado por comprobar"]" data-state-recovery="@ProdTexts["Preparación pendiente de recuperar"]" data-production-daily data-product-url="@Url.Page("/Operations/Lookup", "Products")" data-product-resolve-url="@Url.Page("/Operations/Lookup", "ResolveProduct")">
    <partial name="_ScheduleHeader" model="Model"/>
    @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-12">
            @if(Model.ActionPanel=="new" || Model.Weeks.Count==0){
            <partial name="_NewWeekPicker" model="Model"/>
            <partial name="_ScheduleWorkspace" model="Model"/>
            }

            @if (!Model.IsPreparingNew && Model.Week is not null)
            {
                @if(Model.View=="program"){<partial name="_ScheduleWorkspace" model="Model"/>}
                @if(Model.Week.ExplicitCarryover && Model.View!="program"){<partial name="_InitialCarryover" model="Model"/>}
                @if(Model.View=="week"){
                <section class="card mt-3 mb-4"><div class="card-body"><h3 class="h5 mb-1">@ProdTexts["Sección Productos"]</h3><p class="text-body-secondary mb-3">@Model.WeekLineCount @(Model.WeekLineCount==1?"renglón programado":"renglones programados") · @Model.WeekSkuCount @(Model.WeekSkuCount==1?"SKU distinto":"SKU distintos"). Cada renglón conserva su día, cantidad y pedidos; un SKU puede aparecer varias veces.</p>
                <div class="table-responsive"><table class="table table-hover align-middle mb-0 production-schedule-table production-schedule-products"><thead><tr><th scope="col">SKU</th><th scope="col">@ProdTexts["Día"]</th><th scope="col" class="text-end">@ProdTexts["Cantidad"]</th><th scope="col">@ProdTexts["Destino"]</th><th scope="col">@ProdTexts["Detalles"]</th><th scope="col">@ProdTexts["Acción"]</th></tr></thead><tbody>
                @foreach(var line in Model.WeekLines){<tr>
                    <td data-label="SKU" class="production-schedule-cell--sku"><strong>@line.Sku</strong></td>
                    <td data-label="@ProdTexts["Día"]">@line.PlannedDate.ToString("ddd dd/MM", CultureInfo.CurrentUICulture)</td>
                    <td class="text-end" data-label="@ProdTexts["Cantidad"]">@line.Quantity.ToString("0.####") @line.Unit</td>
                    <td data-label="@ProdTexts["Destino"]">@ProdTexts[new[]{line.OrderReference1,line.OrderReference2,line.OrderReference3}.Any(x=>!string.IsNullOrWhiteSpace(x))?"Cliente":"Inventario"]</td>
                    <td data-label="@ProdTexts["Detalles"]" class="production-schedule-cell--details"><details><summary>@ProdTexts["Ver detalles"]</summary><dl>
                        <dt>@ProdTexts["Pedidos"]</dt><dd>@(new[]{line.OrderReference1,line.OrderReference2,line.OrderReference3}.Any(x=>!string.IsNullOrWhiteSpace(x)) ? string.Join(" · ",new[]{line.OrderReference1,line.OrderReference2,line.OrderReference3}.Where(x=>!string.IsNullOrWhiteSpace(x))) : ProdTexts["Sin pedidos"].Value)</dd>
                        <dt>@ProdTexts["Tipo original"]</dt><dd>@(string.IsNullOrWhiteSpace(line.OriginalType)?ProdTexts["Sin especificar en origen"].Value:line.OriginalType)</dd>
                        <dt>@ProdTexts["Notas"]</dt><dd>@(string.IsNullOrWhiteSpace(line.Notes)?ProdTexts["Sin notas"].Value:line.Notes)</dd>
                        <dt>@ProdTexts["Anotación 1"]</dt><dd>@(string.IsNullOrWhiteSpace(line.OriginalAnnotation1)?ProdTexts["Sin anotación"].Value:line.OriginalAnnotation1)</dd>
                        <dt>@ProdTexts["Anotación 2"]</dt><dd>@(string.IsNullOrWhiteSpace(line.OriginalAnnotation2)?ProdTexts["Sin anotación"].Value:line.OriginalAnnotation2)</dd>
                    </dl></details></td>
                    <td class="production-schedule-cell--actions"><a class="btn btn-outline-primary" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@line.PlannedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" asp-route-View="program">@ProdTexts["Ver semana"]</a></td>
                </tr>}
                </tbody></table></div>@if(Model.WeekLineCount==0){<p class="pt-3 mb-0">Todavía no hay productos programados para esta semana.</p>}
                @if(Model.WeekPageCount>1){<nav class="d-flex flex-wrap gap-2 mt-3" aria-label="Páginas de productos de la semana">@for(var pg=1;pg<=Model.WeekPageCount;pg++){<a class="btn @(pg==Model.PageNumber?"btn-primary":"btn-outline-primary")" asp-route-WeekId="@Model.Week.Id" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" asp-route-View="week" asp-route-PageNumber="@pg">@pg</a>}</nav>}
                </div></section>
                }
                @if(Model.View is "summary" or "review"){
                <section class="card mb-4"><div class="card-body"><h3 class="h5">@ProdTexts[Model.View=="review"?"Revisión de la semana":"Resumen del plan"]</h3>
                @if(Model.View=="review" && Model.PublicationIssues.Count>0){<div role="alert" class="alert alert-warning">@foreach(var issue in Model.PublicationIssues){<p>@issue</p>}</div>}
                <partial name="_ScheduleSummary" model="Model"/>
                @if(Model.View=="review" && Model.Week.Status==ProductionScheduleWeekStatus.Draft)
                {
                    <h2 class="h5 mt-4">@ProdTexts["Revisar apertura de la semana"]</h2>
                        <p>@ProdTexts["Al confirmar la apertura se habilitará la captura de esta semana."]</p>
                        <p>@ProdTexts["Líneas"]: @Model.Week.Lines.Count</p>
                        @foreach(var group in Model.Week.Lines.GroupBy(x=>x.Unit)){<p>@group.Sum(x=>x.Quantity).ToString("0.####",CultureInfo.InvariantCulture) @group.Key</p>}
                        <p class="small">@(Model.Week.ExplicitCarryover ? ProdTexts["Solo se incorporará el arrastre seleccionado en la preparación."] : ProdTexts["Los pendientes de órdenes anteriores también estarán disponibles para capturar."])</p>
                        <div class="alert alert-warning" role="alert" data-schedule-pending-warning hidden>@ProdTexts["Hay preparación pendiente en este dispositivo. Vuelve a editar para recuperarla, guardarla o descartarla antes de abrir."]</div>
                        @if(Model.PublicationIssues.Count>0){<p class="alert alert-warning">@ProdTexts["Resuelve los bloqueos de la revisión antes de confirmar la apertura."]</p>}
                        @if(!Model.ConfigurationReady){<a class="btn btn-outline-primary mb-3" asp-route-WeekId="@Model.WeekId" asp-route-SelectedDay="@(Model.SelectedDay?.ToString("yyyy-MM-dd",CultureInfo.InvariantCulture))" asp-route-View="review" asp-route-ActionPanel="config" asp-fragment="daily-configuration">@ProdTexts["Configurar áreas y turnos"]</a>}
                        <form method="post" asp-page-handler="Publish" class="row g-2 align-items-end" data-schedule-publish data-server-blocked="@(Model.PublicationIssues.Count>0?"true":"false")">
                            <input asp-for="Publish.OperationId" type="hidden"/><input asp-for="Publish.WeekId" type="hidden"/><input asp-for="Publish.ExpectedVersion" type="hidden"/><input asp-for="SelectedDay" type="hidden"/>
                            <div class="col-12 col-md-4"><label asp-for="Publish.Pin" class="form-label">@ProdTexts["NIP ADMIN de la sesión"]</label><input asp-for="Publish.Pin" class="form-control form-control-lg" type="password" inputmode="numeric" autocomplete="off" value="" disabled="@(Model.PublicationIssues.Count>0)"/></div>
                            <div class="col-12 col-md-4"><button class="btn btn-success btn-lg w-100" data-schedule-publish-confirm disabled="@(Model.PublicationIssues.Count>0)">@ProdTexts["Confirmar apertura"]</button></div>
                        </form>
                }
                </div></section>
                }
                @if(Model.View!="program" && ((Model.ActionPanel=="copy" && Model.Week.Status!=ProductionScheduleWeekStatus.Draft) || Model.ActionPanel=="carry" || Model.CarryProduct.HasValue || Model.CarryPlanId.HasValue)){<partial name="_ScheduleWorkflow" model="Model"/>}
            }
        </div>
        @if(Model.ActionPanel=="config" || !Model.ConfigurationReady){<aside class="col-12" id="daily-configuration"><details class="card" open><summary class="card-header py-3">@ProdTexts["Configuración diaria"]</summary><div class="card-body"><h2 class="h5">@ProdTexts["Configuración diaria"]</h2><p class="small text-body-secondary">@ProdTexts["Reutiliza procesos y turnos existentes; no crea catálogos duplicados."]</p>@if (!Model.ConfigurationReady) { <p class="alert alert-warning" role="status">@ProdTexts["Las coincidencias únicas se proponen aquí. Revisa y guarda la configuración para habilitar la captura."]</p> }<form method="post" asp-page-handler="Configure" class="d-grid gap-3"><input name="WeekId" type="hidden" value="@Model.WeekId"/><input name="SelectedDay" type="hidden" value="@(Model.SelectedDay?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"/><input name="View" type="hidden" value="@Model.View"/><input asp-for="Configuration.OperationId" type="hidden"/><input asp-for="Configuration.ExpectedVersion" type="hidden"/>
            <div><label asp-for="Configuration.CuttingStageId" class="form-label">@ProdTexts["Corte"]</label><select asp-for="Configuration.CuttingStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.SewingStageId" class="form-label">@ProdTexts["Costura"]</label><select asp-for="Configuration.SewingStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.ReadyToPackStageId" class="form-label">@ProdTexts["Ready to Pack"]</label><select asp-for="Configuration.ReadyToPackStageId" class="form-select"><option value="">@ProdTexts[Model.Stages.Count == 0 ? "No hay procesos activos" : "Selecciona un proceso"]</option>@foreach(var stage in Model.Stages){<option value="@stage.Id">@stage.Name</option>}</select></div><div><label asp-for="Configuration.Shift1Id" class="form-label">T1</label><select asp-for="Configuration.Shift1Id" class="form-select"><option value="">@ProdTexts[Model.Shifts.Count == 0 ? "No hay turnos activos" : "Selecciona un turno"]</option>@foreach(var shift in Model.Shifts){<option value="@shift.Id">@shift.Name</option>}</select></div><div><label asp-for="Configuration.Shift2Id" class="form-label">T2</label><select asp-for="Configuration.Shift2Id" class="form-select"><option value="">@ProdTexts[Model.Shifts.Count == 0 ? "No hay turnos activos" : "Selecciona un turno"]</option>@foreach(var shift in Model.Shifts){<option value="@shift.Id">@shift.Name</option>}</select></div><button class="btn btn-outline-primary">@ProdTexts["Guardar configuración"]</button>
        </form>
        <a asp-page="/Admin/Production/Routes" class="btn btn-outline-secondary w-100 mt-3">@ProdTexts["Agregar turno"]</a>
        </div></details></aside>}
    </div>
</div>
@if(!Model.IsPreparingNew){<partial name="_ScheduleStatusConfirmation" model="Model"/>}
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/production-daily.js" asp-append-version="true"></script><script src="~/js/production-schedule.js" asp-append-version="true"></script><script src="~/js/production-week-openings.js" asp-append-version="true"></script><script src="~/js/production-initial-balances.js" asp-append-version="true"></script><script src="~/js/production-schedule-progress.js" asp-append-version="true"></script><script src="~/js/production-week-workspace.js" asp-append-version="true"></script><script src="~/js/production-week-picker.js" asp-append-version="true"></script> }
@section Styles { <link rel="stylesheet" href="~/css/production-daily.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/production-week-workspace.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/production-week-picker.css" asp-append-version="true"/> }
