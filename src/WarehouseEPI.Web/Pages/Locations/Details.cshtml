@page "/Locations/{id:guid}"
@model WarehouseEPI.Web.Pages.Locations.DetailsModel
@{
    ViewData["Title"] = $"Ubicación {Model.Location.Code}";
    var available = Model.Location.IsPhysicallyPresent && Model.Location.IsActive && !Model.Location.IsBlocked;
    var balanceEmptyMessage = Model.ActiveAssignmentCount == 0
        ? "Sin saldo actual."
        : $"Sin saldo actual · {Model.ActiveAssignmentCount} producto(s) asignado(s).";
}

@if (Model.Location.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip)
{
    <div class="alert alert-warning"><strong>Ubicación WIP con existencias reales.</strong> Admite movimientos normales, asignaciones opcionales y conteos cíclicos.</div>
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <span class="text-body-secondary">Ubicación física</span>
        <h1 class="h2 mb-1">@Model.Location.Code</h1>
        <p class="text-body-secondary mb-0">
        @if (Model.Location.Kind == WarehouseEPI.Core.Entities.LocationKind.Rack)
        {
            <text>Fila @Model.Location.RowCode · Rack @Model.Location.RackNumber · Pallet @Model.Location.PalletNumber</text>
        }
        else
        {
            <text>@(Model.Location.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip ? "Área WIP" : "Área especial")</text>
        }
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="/Locations/Index" asp-route-viewMode="map" asp-route-highlightLocationId="@Model.Location.Id" class="btn btn-primary">Ver en croquis</a>
        <a asp-page="/Locations/Index" asp-route-viewMode="table" class="btn btn-outline-secondary">Ubicaciones</a>
    </div>
</div>

<section class="card card-body location-operational-summary mb-3" aria-label="Resumen operativo">
    <div class="location-summary-metric"><span>Estado</span><strong>@(!Model.Location.IsPhysicallyPresent ? "Retirada" : !Model.Location.IsActive ? "Inactiva" : Model.Location.IsBlocked ? "Bloqueada" : "Disponible")</strong>@if(Model.Location.IsBlocked && !string.IsNullOrWhiteSpace(Model.Location.BlockReason)){<small>@Model.Location.BlockReason</small>}</div>
    <div class="location-summary-metric"><span>Croquis</span><strong>@(Model.IsMapped ? "Colocada" : "Sin colocar")</strong></div>
    <div class="location-summary-metric"><span>Productos con saldo</span><strong>@Model.BalanceProductCount</strong></div>
    <div class="location-summary-metric"><span>Asignaciones activas</span><strong>@Model.ActiveAssignmentCount</strong></div>
    @if (!string.IsNullOrWhiteSpace(Model.Location.Description)){<div class="location-summary-description"><span>Descripción</span><strong>@Model.Location.Description</strong></div>}
</section>

@if (available)
{
    <section class="card card-body mb-4" aria-label="Acciones operativas">
        <h2 class="h4">Acciones operativas</h2>
        <p class="text-body-secondary">La ubicación se precarga; cantidades, destino, motivo y NIP se confirman dentro de cada operación.</p>
        <div class="d-flex flex-wrap gap-2">
        @if (Model.Location.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip)
        {
            <a asp-page="/Operations/Exit" asp-route-mode="wip" asp-route-destinationLocationId="@Model.Location.Id" class="btn btn-primary">Surtir a este WIP</a>
            <a asp-page="/Operations/WipProcess" asp-route-wipCode="@Model.Location.Code" class="btn btn-outline-primary">Procesar WIP</a>
            <a asp-page="/Reports/Wip/Index" asp-route-wipAreaId="@Model.Location.Id" class="btn btn-outline-secondary">Reporte WIP</a>
        }
        else
        {
            <a asp-page="/Operations/Entry" asp-route-destinationLocationId="@Model.Location.Id" class="btn btn-primary">Entrada</a>
            <a asp-page="/Operations/Exit" asp-route-mode="general" asp-route-sourceLocationId="@Model.Location.Id" class="btn btn-outline-primary">Salida</a>
            <a asp-page="/Operations/Transfer" asp-route-sourceLocationId="@Model.Location.Id" class="btn btn-outline-primary">Transferencia</a>
            <a asp-page="/Operations/Adjustment" asp-route-locationId="@Model.Location.Id" class="btn btn-outline-secondary">Ajuste</a>
        }
        </div>
    </section>
}
else
{
    <div class="alert alert-warning"><strong>No disponible para nuevas operaciones.</strong> El saldo se conserva visible para consulta.</div>
}

<div class="row g-3 mb-4">
    <section class="col-xl-7"><div class="card h-100"><div class="card-body">
        <h2 class="h4">Existencias actuales</h2>
        <p class="text-body-secondary">Cantidades agrupadas por producto y unidad; los lotes internos permanecen transparentes.</p>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Producto</th><th>Relación</th><th class="text-end">Saldo</th></tr></thead><tbody>
        @foreach (var item in Model.Balances)
        {
            <tr><td><a asp-page="/Inventory/Index" asp-route-productId="@item.ProductId" class="fw-semibold">@item.Sku</a><div class="small text-body-secondary">@item.Description</div></td><td>@(item.IsAssigned ? "Asignación activa" : "Saldo sin asignación")</td><td class="text-end @(item.Quantity < 0 ? "text-danger" : "")">@item.Quantity.ToString("0.####") @item.Unit</td></tr>
        }
        @if(Model.Balances.Count == 0){<tr><td colspan="3" class="text-center text-body-secondary py-4">@balanceEmptyMessage</td></tr>}
        </tbody></table></div>
        <a asp-page="/Inventory/Index" asp-route-locationId="@Model.Location.Id" class="btn btn-outline-primary">Consultar existencias</a>
    </div></div></section>

    <section class="col-xl-5"><div class="card h-100 location-rack-card"><div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2"><div><h2 class="h4 mb-1">Posiciones del rack</h2><p class="text-body-secondary mb-0">Consulta saldo y asignación sin abrir cada pallet.</p></div>@if(Model.Location.Kind == WarehouseEPI.Core.Entities.LocationKind.Rack){<span class="badge text-bg-light border">Fila @Model.Location.RowCode · Rack @Model.Location.RackNumber</span>}</div>
        @if(Model.Location.Kind != WarehouseEPI.Core.Entities.LocationKind.Rack){<p class="text-body-secondary mt-3">Esta ubicación no pertenece a un rack con pallets.</p>}
        else
        {
            <div class="location-rack-legend" aria-label="Leyenda de estados de inventario"><span class="occupied">Con saldo</span><span class="assigned-empty">Asignado sin saldo</span><span class="empty">Sin producto</span><span class="unassigned">Saldo sin asignación</span><span class="negative">Saldo negativo</span></div>
            <div class="location-neighbor-grid">
            @foreach (var pallet in new short[] { 7, 8, 9, 4, 5, 6, 1, 2, 3 })
            {
                var item = Model.Neighbors.FirstOrDefault(value => value.PalletNumber == pallet);
                if(item is null){<div class="location-neighbor-position missing" aria-label="Pallet @pallet, posición inexistente"><strong>@pallet</strong><span class="rack-slot-state">No existe</span></div>}
                else
                {
                    var classes = $"location-neighbor-position {item.InventoryClass} {(item.IsCurrent ? "is-current" : "")} {(!item.IsActive ? "is-inactive" : "")} {(item.IsBlocked ? "is-blocked" : "")}";
                    var productSummary = item.PrimaryBalance is not null ? $", {item.PrimaryBalance.Sku}, {item.PrimaryBalance.Quantity:0.####} {item.PrimaryBalance.Unit}" : item.PrimaryAssignedSku is not null ? $", {item.PrimaryAssignedSku}" : string.Empty;
                    var accessibleSummary = $"{item.Code}, pallet {pallet}, {item.OperationalState}, {item.InventoryState}{productSummary}";
                    if(item.IsCurrent){<div class="@classes" aria-label="Ubicación actual: @accessibleSummary" aria-current="location"><partial name="_LocationRackPositionContent" model="item" /></div>}
                    else{<a asp-page="/Locations/Details" asp-route-id="@item.Id" class="@classes" aria-label="Abrir @accessibleSummary"><partial name="_LocationRackPositionContent" model="item" /></a>}
                }
            }
            </div>
            <p class="small text-body-secondary mb-0">Bloqueada o inactiva describe la operación; el saldo se sigue mostrando.</p>
        }
    </div></div></section>
</div>

<section class="card mb-4"><div class="card-body">
    <h2 class="h4">Productos asignados</h2>
    <p class="text-body-secondary">Referencia operativa de asignaciones activas; una asignación sin saldo no confirma existencia física.</p>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Producto</th><th>Relación</th><th class="text-end">Consulta</th></tr></thead><tbody>
    @foreach(var item in Model.Assignments){<tr><td><a asp-page="/Inventory/Index" asp-route-productId="@item.ProductId" class="fw-semibold">@item.Sku</a><div class="small text-body-secondary">@item.Description</div></td><td>Asignación activa</td><td class="text-end"><a asp-page="/Inventory/Index" asp-route-productId="@item.ProductId" asp-route-locationId="@Model.Location.Id" class="btn btn-outline-primary btn-sm">Existencias</a></td></tr>}
    @if(Model.Assignments.Count == 0){<tr><td colspan="3" class="text-center text-body-secondary py-4">No hay productos asignados activamente.</td></tr>}
    </tbody></table></div>
</div></section>
