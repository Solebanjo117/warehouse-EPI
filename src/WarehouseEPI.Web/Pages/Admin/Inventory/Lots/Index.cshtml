@page
@model WarehouseEPI.Web.Pages.Admin.Inventory.Lots.IndexModel
@{ ViewData["Title"] = "Lotes internos"; }
<section class="inventory-shell">
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Lotes internos</h1><p class="text-body-secondary mb-0">Trazabilidad de lotes automáticos; no se crean ni seleccionan manualmente.</p></div></div>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-5"><label class="visually-hidden" for="lot-search">Buscar</label><input id="lot-search" name="search" value="@Model.Search" class="form-control form-control-lg" placeholder="Lote, SKU, descripción, referencia o código" autofocus /></div><div class="col-sm-4 col-md-2"><select name="balance" class="form-select"><option value="All">Todos los saldos</option><option value="WithBalance">Con saldo</option><option value="Positive">Positivos</option><option value="Negative">Negativos</option><option value="Exhausted">Agotados</option></select></div><div class="col-sm-4 col-md-2"><select name="date" class="form-select"><option value="All">Toda fecha</option><option value="WithDate">Con fecha</option><option value="WithoutDate">Sin fecha</option></select></div><div class="col-sm-4 col-md-2"><button class="btn btn-primary w-100">Buscar</button></div></div></form>
@if (Model.Results.Items.Count == 0) { <div class="empty-state"><h2 class="h5">No hay lotes con esos filtros</h2><p class="mb-0">Prueba con otra búsqueda o limpia los filtros.</p></div> } else { <div class="table-responsive"><table class="table align-middle inventory-list"><thead><tr><th>Producto</th><th>Lote</th><th>Fecha interna</th><th>Ubicaciones</th><th class="text-end">Saldo total</th><th></th></tr></thead><tbody>@foreach (var item in Model.Results.Items) { <tr><td><a asp-page="/Admin/Catalogs/Products/Details" asp-route-id="@item.ProductId">@item.Sku</a><div class="small text-body-secondary">@item.Description</div></td><td><a asp-page="Details" asp-route-id="@item.Id">@item.Number</a></td><td>@(item.LotDate?.ToString("yyyy-MM-dd") ?? "Sin fecha")</td><td>@item.Locations</td><td class="text-end @(item.Quantity < 0 ? "text-danger" : "")">@item.Quantity @item.Unit</td><td class="text-end"><a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver ficha</a></td></tr> }</tbody></table></div> }
@if (Model.TotalPages > 1) { <nav aria-label="Paginación de lotes" class="d-flex gap-2 align-items-center"><a class="btn btn-outline-secondary @(Model.PageNumber == 1 ? "disabled" : "")" asp-route-search="@Model.Search" asp-route-balance="@Model.Balance" asp-route-date="@Model.Date" asp-route-pageNumber="@(Model.PageNumber-1)">Anterior</a><span>Página @Model.PageNumber de @Model.TotalPages</span><a class="btn btn-outline-secondary @(Model.PageNumber == Model.TotalPages ? "disabled" : "")" asp-route-search="@Model.Search" asp-route-balance="@Model.Balance" asp-route-date="@Model.Date" asp-route-pageNumber="@(Model.PageNumber+1)">Siguiente</a></nav> }
</section>
