@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.AreaModel
@{ ViewData["Title"] = Model.IsEdit ? CatTexts["Editar área"].Value : CatTexts["Crear área"].Value; }
<div class="d-flex flex-wrap justify-content-between gap-3 mb-3"><h1 class="h2">@ViewData["Title"]</h1><a asp-page="Areas" class="btn btn-outline-secondary btn-lg">@CatTexts["Áreas"]</a></div><p class="text-muted">@CatTexts["Las áreas especiales no utilizan fila, rack ni pallet."]</p>
<form method="post" class="card card-body"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.OriginalUpdatedAt" type="hidden"/><input asp-for="Input.ProcessConfigurationVersion" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div><div class="row g-3"><div class="col-12"><h2 class="h4">@CatTexts["Datos generales"]</h2></div>
<div class="col-12 col-md-5"><label asp-for="Input.Code" class="form-label">@CatTexts["Código"]</label><input asp-for="Input.Code" class="form-control form-control-lg text-uppercase" maxlength="40" autocomplete="off" autocapitalize="characters"/><span asp-validation-for="Input.Code" class="text-danger"></span></div>
<div class="col-12 col-md-7"><label asp-for="Input.Description" class="form-label">@CatTexts["Descripción"]</label><input asp-for="Input.Description" class="form-control form-control-lg" maxlength="200"/><span asp-validation-for="Input.Description" class="text-danger"></span></div>
<div class="col-12 col-lg-7"><label asp-for="Input.OperationalRole" class="form-label">@CatTexts["Función operativa"]</label><select asp-for="Input.OperationalRole" class="form-select form-select-lg"><option value="Other">@CatTexts["Área general"]</option><option value="Storage">@CatTexts["Área con inventario"]</option><option value="Wip">@CatTexts["WIP · Sin control de existencias"]</option></select><span asp-validation-for="Input.OperationalRole" class="text-danger"></span><div class="form-text">@CatTexts["WIP da seguimiento documental al material recibido; no controla existencias de almacén."]</div></div>
<fieldset class="col-12" aria-describedby="area-sharing-help">
    <legend class="h5">@CatTexts["Aviso al compartir el área"]</legend>
    <div class="form-check">
        <input asp-for="Input.WarnOnMixedProducts" class="form-check-input mt-3" aria-describedby="area-sharing-help" />
        <label asp-for="Input.WarnOnMixedProducts" class="form-check-label py-3">@CatTexts["Avisar al agregar un producto cuando el área contiene otros"]</label>
    </div>
    <p id="area-sharing-help" class="form-text mb-0">@CatTexts["Desactiva esta opción en áreas como STAGING que reciben varios productos pendientes de acomodo. No se pedirá confirmación para compartir el área; se conservan las existencias, el historial y el NIP. En WIP esta opción no aplica."]</p>
    <p class="form-text mb-0">@CatTexts["El aviso solo considera otros productos con saldo positivo. Cero o negativo no lo activan."]</p>
</fieldset>
<fieldset class="col-12"><legend class="h5">@CatTexts["Procesos del área WIP"]</legend><p class="form-text">@CatTexts["Se guardan cuando la función operativa es WIP. La asociación no mueve ni consume inventario."]</p>@if (Model.Processes.Count == 0) { <p class="text-body-secondary">@CatTexts["No hay procesos disponibles para asociar."]</p> }<div class="row">@foreach (var process in Model.Processes) { <div class="col-12 col-md-6"><div class="form-check"><input class="form-check-input mt-3" type="checkbox" name="Input.ProcessIds" value="@process.Id" id="area-process-@process.Id" checked="@(Model.Input.ProcessIds.Contains(process.Id) ? "checked" : null)"/><label class="form-check-label py-3" for="area-process-@process.Id">@process.Code · @process.Name @if (!process.IsActive) { <span class="text-body-secondary">@CatTexts["(inactivo)"]</span> }</label></div></div> }</div></fieldset>
@if (Model.IsEdit && Model.Input.OperationalRole == WarehouseEPI.Core.Entities.LocationOperationalRole.Wip) { <div class="col-12"><div class="alert alert-info mb-0">@CatTexts["Si cambias la función a un tipo distinto de WIP, se retirarán estas asociaciones al guardar."]</div></div> }
<fieldset class="col-12"><legend class="h4">@CatTexts["Estado"]</legend>
<div class="form-check"><input asp-for="Input.IsActive" class="form-check-input mt-3"/><label asp-for="Input.IsActive" class="form-check-label py-3">@CatTexts["Área activa"]</label></div>
<div class="form-check"><input asp-for="Input.IsBlocked" class="form-check-input mt-3"/><label asp-for="Input.IsBlocked" class="form-check-label py-3">@CatTexts["Área bloqueada"]</label></div>
<label asp-for="Input.BlockReason" class="form-label">@CatTexts["Motivo de bloqueo"]</label><textarea asp-for="Input.BlockReason" class="form-control" rows="2" maxlength="200" aria-describedby="area-state-help"></textarea><span asp-validation-for="Input.BlockReason" class="text-danger"></span>
<p id="area-state-help" class="form-text">@CatTexts["El bloqueo requiere un motivo. Al desactivar el área se limpia el bloqueo; no se eliminan sus registros."]</p>
</fieldset>
<div class="col-12"><button class="btn btn-primary btn-lg">@CatTexts["Guardar área"]</button> <a asp-page="Areas" class="btn btn-outline-secondary btn-lg">@CatTexts["Cancelar"]</a></div></div></form>
@if (Model.IsEdit && Model.Deletion is not null)
{
    <section class="card border-danger mt-4" aria-labelledby="delete-area-title">
        <div class="card-body">
            <h2 id="delete-area-title" class="h4 text-danger">@CatTexts["Eliminar área definitivamente"]</h2>
            @if (Model.Deletion.CanDelete)
            {
                <p>@CatTexts["Esta área nunca ha sido utilizada por inventario, productos u operaciones. La eliminación también la quitará del croquis."]</p>
                <details open="@(Model.DeleteErrors.Count > 0 ? "open" : null)">
                    <summary class="btn btn-outline-danger">@CatTexts["Preparar eliminación definitiva"]</summary>
                    <form method="post" asp-page-handler="Delete" class="mt-3" data-area-delete-form>
                        <input asp-for="DeleteInput.OperationId" type="hidden" />
                        <input asp-for="DeleteInput.LocationId" type="hidden" />
                        @if (Model.DeleteErrors.Count > 0)
                        {
                            <div class="alert alert-danger" role="alert"><strong>@CatTexts["No se puede continuar."]</strong><ul class="mb-0 mt-2">@foreach (var error in Model.DeleteErrors) { <li>@error</li> }</ul></div>
                        }
                        <div class="alert alert-danger" role="alert"><strong>@CatTexts["Esta acción no se puede deshacer."]</strong> @CatTexts["Los registros operativos nunca se eliminan."]</div>
                        <label asp-for="DeleteInput.Reason" class="form-label">@CatTexts["Motivo de la eliminación"]</label>
                        <textarea asp-for="DeleteInput.Reason" class="form-control mb-3" rows="3" maxlength="500" required></textarea>
                        <label asp-for="DeleteInput.ConfirmationCode" class="form-label">@CatTexts["Escribe {0} para confirmar", Model.Input.Code]</label>
                        <input asp-for="DeleteInput.ConfirmationCode" class="form-control mb-3 text-uppercase" required autocomplete="off" />
                        <label asp-for="DeleteInput.Pin" class="form-label">@CatTexts["NIP ADMIN"]</label>
                        <input asp-for="DeleteInput.Pin" value="" class="form-control" type="password" inputmode="numeric" autocomplete="off" required />
                        <button type="submit" class="btn btn-danger mt-3">@CatTexts["Eliminar área definitivamente"]</button>
                    </form>
                </details>
            }
            else
            {
                <p class="mb-2">@CatTexts["Esta área no puede eliminarse porque conserva registros relacionados:"]</p>
                <ul class="mb-0">@foreach (var blocker in Model.Deletion.Blockers) { <li>@CatTexts[blocker]</li> }</ul>
            }
        </div>
    </section>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
