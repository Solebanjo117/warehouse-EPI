@model WarehouseEPI.Web.Pages.Admin.Catalogs.Locations.DetailsModel.NeighborRow

<div class="location-neighbor-header">
    <strong>@Model.PalletNumber</strong>
    @if (Model.IsCurrent)
    {
        <span class="badge text-bg-primary">Actual</span>
    }
</div>
<small class="location-neighbor-code">@Model.Code</small>
<span class="rack-slot-state">@Model.InventoryState</span>
@if (Model.PrimaryBalance is not null)
{
    <span class="sku-chip" title="@Model.PrimaryBalance.Sku">@Model.PrimaryBalance.Sku</span>
    <span class="location-neighbor-balance @(Model.PrimaryBalance.Quantity < 0 ? "text-danger" : "")">@Model.PrimaryBalance.Quantity.ToString("0.####") @Model.PrimaryBalance.Unit</span>
    @if (Model.AdditionalProductCount > 0)
    {
        <span class="sku-more">+@Model.AdditionalProductCount producto(s)</span>
    }
}
else if (Model.PrimaryAssignedSku is not null)
{
    <span class="sku-chip" title="@Model.PrimaryAssignedSku">@Model.PrimaryAssignedSku</span>
    @if (Model.AdditionalAssignmentCount > 0)
    {
        <span class="sku-more">+@Model.AdditionalAssignmentCount asignado(s)</span>
    }
}
<div class="location-neighbor-flags">
    @if (!Model.IsActive)
    {
        <span class="badge text-bg-secondary">Inactiva</span>
    }
    @if (Model.IsBlocked)
    {
        <span class="badge text-bg-warning" title="@Model.BlockReason">Bloqueada</span>
    }
</div>
