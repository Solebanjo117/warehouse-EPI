@page
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.PrintModel
@{ ViewData["Title"]="Hoja de conteo"; }
<div class="cycle-count-print"><header><h1>Hoja ciega de conteo</h1><p><strong>Folio:</strong> @Model.Campaign?.Folio · <strong>Ubicación:</strong> @Model.Location?.LocationCode · <strong>Intento:</strong> @Model.Attempt?.AttemptNumber</p><p class="no-print"><button class="btn btn-primary" onclick="window.print()">Imprimir</button> <a asp-page="Details" asp-route-id="@Model.Campaign?.Id" class="btn btn-outline-secondary">Volver</a></p></header><table class="table table-bordered"><thead><tr><th>SKU</th><th>Descripción</th><th>Unidad</th><th>Cantidad física</th><th>Iniciales</th></tr></thead><tbody>@foreach(var item in Model.Attempt?.Entries ?? []){<tr><td>@item.Sku</td><td>@item.Description</td><td>@item.UnitCode</td><td class="cycle-count-blank"></td><td></td></tr>}</tbody></table><footer><p>Responsable: ________________________________ Firma: ________________________________ Fecha: __________________</p></footer></div>
@section Scripts { <style>@@media print{.app-topbar,.app-sidebar,.app-backdrop,.app-footer,.no-print{display:none!important}.app-content{margin:0!important}.app-main{padding:0!important}.cycle-count-print{font-size:12pt}.cycle-count-print h1{font-size:20pt}.cycle-count-print table{width:100%;border-collapse:collapse}.cycle-count-print th,.cycle-count-print td{padding:.5rem;border:1px solid #222}.cycle-count-blank{height:3rem;width:20%}}</style> }
