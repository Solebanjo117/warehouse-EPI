@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.EditModel
@{ ViewData["Title"]="Editar producto"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h2 mb-0">Editar producto</h1><a asp-page="Index" class="btn btn-outline-secondary">Volver</a></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<partial name="_ProductForm" model="Model" />
<section class="card shadow-sm mt-4"><div class="card-body"><h2 class="h4">Ubicaciones asignadas</h2><p class="text-muted">Asignación fija; las cantidades se mostrarán cuando exista el núcleo de inventario.</p>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Ubicación</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>@if(Model.LocationAssignments.Count==0){<tr><td colspan="3" class="text-center text-muted">Sin ubicaciones asignadas.</td></tr>}else{@foreach(var item in Model.LocationAssignments){<tr class="@(!item.IsActive?"table-secondary":"")"><td><a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@item.LocationId" class="fw-bold">@item.Code</a>@if(item.Description is not null){<div class="small">@item.Description</div>}</td><td>@if(!item.IsActive){<span class="badge text-bg-secondary">Asignación inactiva</span>}else if(!item.LocationIsActive){<span class="badge text-bg-secondary">Ubicación inactiva</span>}else if(item.LocationIsBlocked){<span class="badge text-bg-warning">Ubicación bloqueada</span>}else{<span class="badge text-bg-success">Asignado</span>}</td><td class="text-end">@if(item.IsActive){<form method="post" asp-page-handler="DeactivateLocation" asp-route-id="@Model.Input.Id"><input type="hidden" name="locationId" value="@item.LocationId"/><button class="btn btn-outline-secondary">Desasignar</button></form>}else{<form method="post" asp-page-handler="AssignLocation" asp-route-id="@Model.Input.Id"><input type="hidden" name="locationId" value="@item.LocationId"/><button class="btn btn-outline-primary" disabled="@(!item.LocationIsActive||item.LocationIsBlocked||!Model.Input.IsActive)">Reactivar</button></form>}</td></tr>}}</tbody></table></div>
<form method="get" asp-page="Edit" asp-route-id="@Model.Input.Id" class="row g-2 mt-2"><div class="col-12 col-md-9"><label for="locationSearch" class="form-label">Buscar otra ubicación</label><input id="locationSearch" name="locationSearch" value="@Model.LocationSearch" class="form-control form-control-lg" placeholder="Código o descripción"/></div><div class="col-12 col-md-3 d-flex align-items-end"><button class="btn btn-outline-primary btn-lg w-100">Buscar</button></div></form>
@if(!string.IsNullOrWhiteSpace(Model.LocationSearch)){<div class="list-group mt-3">@if(Model.LocationResults.Count==0){<div class="list-group-item text-muted">No se encontraron ubicaciones disponibles.</div>}@foreach(var location in Model.LocationResults){<div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2"><div><strong>@location.Code</strong>@if(location.Description is not null){<div class="small">@location.Description</div>}</div>@if(location.IsAssigned){<span class="badge text-bg-success">Ya asignada</span>}else{<form method="post" asp-page-handler="AssignLocation" asp-route-id="@Model.Input.Id"><input type="hidden" name="locationId" value="@location.Id"/><button class="btn btn-primary" disabled="@(!Model.Input.IsActive)">Asignar</button></form>}</div>}</div>}
</div></section>
<section class="card shadow-sm mt-4"><div class="card-body"><h2 class="h4">Códigos de barras</h2><form method="post" asp-page-handler="AddBarcode" asp-route-id="@Model.Input.Id" class="row g-3 align-items-end mb-4"><div class="col-12 col-md-5"><label asp-for="BarcodeInput.Barcode" class="form-label">Código</label><input asp-for="BarcodeInput.Barcode" class="form-control form-control-lg" autocomplete="off"/></div><div class="col-8 col-md-3"><label asp-for="BarcodeInput.Format" class="form-label">Formato</label><select asp-for="BarcodeInput.Format" asp-items="Model.BarcodeFormats" class="form-select form-select-lg"></select></div><div class="col-4 col-md-2"><div class="form-check"><input asp-for="BarcodeInput.IsPrimary" class="form-check-input"/><label asp-for="BarcodeInput.IsPrimary" class="form-check-label">Principal</label></div></div><div class="col-12 col-md-2"><button class="btn btn-primary btn-lg w-100">Agregar</button></div></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Código</th><th>Formato</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>@if(Model.Barcodes.Count==0){<tr><td colspan="4" class="text-muted text-center">Sin códigos.</td></tr>}else{@foreach(var item in Model.Barcodes){<tr><td><strong>@item.Barcode</strong> @if(item.IsPrimary){<span class="badge text-bg-primary">Principal</span>}</td><td>@item.Format</td><td>@(item.IsActive?"Activo":"Inactivo")</td><td class="text-end">@if(item.IsActive&&!item.IsPrimary){<form method="post" asp-page-handler="SetPrimary" asp-route-id="@Model.Input.Id" class="d-inline"><input type="hidden" name="barcodeId" value="@item.Id"/><button class="btn btn-outline-primary btn-sm">Hacer principal</button></form>} <form method="post" asp-page-handler="ToggleBarcode" asp-route-id="@Model.Input.Id" class="d-inline"><input type="hidden" name="barcodeId" value="@item.Id"/><button class="btn btn-outline-secondary btn-sm">@(item.IsActive?"Desactivar":"Reactivar")</button></form></td></tr>}}</tbody></table></div></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
