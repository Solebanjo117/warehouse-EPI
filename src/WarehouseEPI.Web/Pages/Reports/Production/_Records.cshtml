@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionRecordReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>@CatTexts["Fecha"]</th><th>@CatTexts["Orden"]</th><th>@CatTexts["Registro"]</th><th>@CatTexts["Proceso / turno"]</th><th>@CatTexts["Responsable"]</th><th class="text-end">@CatTexts["Cantidades"]</th><th>@CatTexts["Motivo"]</th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr class="@(!row.IsEffective ? "production-row-reversed" : null)"><td data-label="@CatTexts["Fecha"]">@row.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td data-label="@CatTexts["Orden"]"><a asp-page="/Admin/Production/Details" asp-route-id="@row.OrderId"><strong>@row.OrderNumber</strong></a></td><td data-label="@CatTexts["Registro"]"><span class="badge @(!row.IsEffective ? "text-bg-secondary" : "text-bg-primary")">@row.Type</span>@if (!row.IsEffective) { <small>@CatTexts["Revertido o reverso"]</small> }</td><td data-label="@CatTexts["Proceso / turno"]">@(row.Stage ?? CatTexts["General"].Value)<small>@(row.Shift ?? CatTexts["Sin turno registrado"].Value)</small></td><td data-label="@CatTexts["Responsable"]">@row.Responsible</td><td data-label="@CatTexts["Cantidades"]" class="text-end">@row.Quantity.ToString("0.####")<small>Bueno @row.Good.ToString("0.####") · Retrabajo @row.Rework.ToString("0.####") · Merma @row.Scrap.ToString("0.####")</small></td><td data-label="@CatTexts["Motivo"]">@(row.Reason ?? "—")</td></tr> }</tbody>
</table>
