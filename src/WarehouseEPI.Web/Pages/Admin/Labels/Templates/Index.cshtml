@page
@model WarehouseEPI.Web.Pages.Admin.Labels.Templates.IndexModel
@using WarehouseEPI.Core.Entities
@{
    ViewData["Title"] = "Diseñar formatos";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h3 mb-1">Formatos de etiquetas</h1><p class="text-body-secondary mb-0">Versiones controladas para diseñar, validar y publicar.</p></div>
        <a class="btn btn-outline-secondary" asp-page="../Assets/Index">Biblioteca de imágenes</a>
    </div>
    @if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <section class="card shadow-sm mb-4">
        <div class="card-header"><strong>Nueva plantilla</strong></div>
        <form method="post" asp-page-handler="Create" class="card-body row g-3 align-items-end">
            <div class="col-sm-4"><label asp-for="Create.Code" class="form-label">Código estable</label><input asp-for="Create.Code" class="form-control text-uppercase" placeholder="LBL-NUEVA" /></div>
            <div class="col-sm-4"><label asp-for="Create.Name" class="form-label">Nombre del formato</label><input asp-for="Create.Name" class="form-control" /></div>
            <div class="col-sm-3"><label asp-for="Create.Size" class="form-label">Tamaño</label><select asp-for="Create.Size" class="form-select">@foreach (var size in Model.Sizes) { <option value="@size.Preset">@size.Name</option> }</select></div>
            <div class="col-sm-1 d-grid"><button class="btn btn-primary" type="submit">Crear</button></div>
        </form>
    </section>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Plantilla</th><th>Tipo</th><th>Versión</th><th>Estado</th><th>Actualizada</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><strong>@row.Code</strong><div class="small text-body-secondary">@row.Name</div></td><td>@(row.Kind == LabelTemplateKind.PalletLicensePlate ? "Placa de pallet" : "Etiqueta de producto")</td>
                        <td>v@row.Version @if (row.IsCurrent) { <span class="badge text-bg-success">Vigente</span> }</td>
                        <td><span class="badge text-bg-secondary">@row.Status</span></td>
                        <td>@row.UpdatedAt.ToLocalTime().ToString("g")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@row.VersionId">@(row.Status is LabelTemplateStatus.Draft or LabelTemplateStatus.InValidation ? "Editar" : "Ver")</a>
                            @if (row.Status == LabelTemplateStatus.Published)
                            {
                                <form method="post" asp-page-handler="Duplicate" asp-route-id="@row.VersionId" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Nueva versión</button></form>
                            }
                        </td>
                    </tr>
                    @if (row.IsCurrent)
                    {
                        <tr><td colspan="6" class="bg-body-tertiary">
                            <details><summary class="small fw-semibold">Retirar versión vigente</summary>
                                <form method="post" asp-page-handler="Retire" asp-route-id="@row.VersionId" class="row g-2 mt-1">
                                    <div class="col-md-7"><label class="form-label small">Motivo</label><input asp-for="RetireReason" class="form-control" maxlength="500" required /></div>
                                    <div class="col-md-3"><label class="form-label small">NIP ADMIN</label><input asp-for="RetirePin" class="form-control" type="password" autocomplete="off" required /></div>
                                    <div class="col-md-2 d-grid align-self-end"><button class="btn btn-danger">Retirar</button></div>
                                </form>
                            </details>
                        </td></tr>
                    }
                }
                @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="text-center text-body-secondary py-5">Aún no hay plantillas. La migración precarga LBL-6X4-ZEBRA.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
