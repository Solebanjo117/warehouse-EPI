@page
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Admin.Reports.Movements.IndexModel
@{
    ViewData["Title"] = "Reporte analítico de movimientos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Reporte Analítico de Movimientos</h1>
        <p class="text-muted mb-0">Auditoría y conciliación de movimientos efectivos vigentes; excluye originales corregidos y reversos.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-success d-inline-flex align-items-center gap-1"
           asp-page-handler="Export"
           asp-route-format="xlsx"
           asp-route-search="@Model.Search"
           asp-route-sku="@Model.Sku"
           asp-route-locationCode="@Model.LocationCode"
           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
           asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
           asp-route-period="@Model.Period"
           asp-route-movementType="@Model.MovementType"
           asp-route-purpose="@Model.Purpose"
           asp-route-responsibleUserId="@Model.ResponsibleUserId">
            <svg class="app-icon" aria-hidden="true"><use href="#icon-system" /></svg>
            <span>Excel (.xlsx)</span>
        </a>
        <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-1"
           asp-page-handler="Export"
           asp-route-format="csv"
           asp-route-search="@Model.Search"
           asp-route-sku="@Model.Sku"
           asp-route-locationCode="@Model.LocationCode"
           asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
           asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
           asp-route-period="@Model.Period"
           asp-route-movementType="@Model.MovementType"
           asp-route-purpose="@Model.Purpose"
           asp-route-responsibleUserId="@Model.ResponsibleUserId">
            <svg class="app-icon" aria-hidden="true"><use href="#icon-movements" /></svg>
            <span>CSV</span>
        </a>
    </div>
</div>

<div class="alert alert-light border small" role="note">
    <strong>Población:</strong> una fila por operación efectiva, con sus líneas de detalle.
    <strong class="ms-2">Período local:</strong> @(Model.From?.ToString("dd/MM/yyyy") ?? "inicio")–@(Model.To?.ToString("dd/MM/yyyy") ?? "actualidad").
    <strong class="ms-2">Zona:</strong> @Model.TimeZoneId.
</div>

<div class="card mb-3 shadow-sm border-0">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-12 d-flex flex-wrap gap-2 align-items-center mb-1">
                <span class="text-muted small fw-bold">Período rápido:</span>
                <a asp-route-period="today" class="btn btn-sm @(Model.Period == "today" ? "btn-primary" : "btn-outline-secondary")">Hoy</a>
                <a asp-route-period="7" class="btn btn-sm @(Model.Period == "7" ? "btn-primary" : "btn-outline-secondary")">Últimos 7 días</a>
                <a asp-route-period="30" class="btn btn-sm @(Model.Period == "30" ? "btn-primary" : "btn-outline-secondary")">Últimos 30 días</a>
                <a asp-route-period="all" class="btn btn-sm @(Model.Period == "all" ? "btn-primary" : "btn-outline-secondary")">Todo el historial</a>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted">Desde</label>
                <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Hasta</label>
                <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Tipo de Movimiento</label>
                <select name="movementType" class="form-select form-select-sm">
                    <option value="">Todos los tipos</option>
                    @foreach (var type in Enum.GetValues<InventoryMovementType>())
                    {
                        <option value="@type" selected="@(Model.MovementType == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Propósito</label>
                <select name="purpose" class="form-select form-select-sm">
                    <option value="">Todos los propósitos</option>
                    @foreach (var p in Enum.GetValues<InventoryMovementPurpose>())
                    {
                        <option value="@p" selected="@(Model.Purpose == p)">@p</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted">Producto</label>
                <input name="sku" value="@Model.Sku" class="form-control form-control-sm" placeholder="SKU, descripción, referencia o código" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Ubicación / Área</label>
                <input name="locationCode" value="@Model.LocationCode" class="form-control form-control-sm" placeholder="Parte del código o descripción" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Responsable</label>
                <select name="responsibleUserId" class="form-select form-select-sm" asp-items="Model.UserOptions">
                    <option value="">Todos los usuarios</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Búsqueda libre</label>
                <input name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Folio, referencia, notas..." />
            </div>

            <div class="col-12 d-flex justify-content-between align-items-center pt-2">
                <span class="text-muted small">
                    Mostrando <strong>@Model.Results.Items.Count</strong> de <strong>@Model.Results.TotalCount</strong> operaciones efectivas encontradas.
                </span>
                <div class="d-flex gap-2">
                    <a asp-page="/Admin/Reports/Movements/Index" class="btn btn-sm btn-outline-secondary">Limpiar filtros</a>
                    <button type="submit" class="btn btn-sm btn-primary px-4">Aplicar Filtros</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive bg-body rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 140px;">Fecha / Hora</th>
                <th style="width: 110px;">Tipo</th>
                <th style="width: 130px;">Propósito</th>
                <th>Responsable</th>
                <th>Detalle de Líneas (SKU, Cantidad, Origen / Destino)</th>
                <th>Referencia / Notas</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted text-center py-5">
                        <div class="mb-2">No se encontraron movimientos efectivos con los filtros seleccionados.</div>
                        <small>Intenta ampliar el rango de fechas o eliminar criterios de búsqueda.</small>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@Model.LocalOccurredAt[item.Id].ToString("dd/MM/yyyy")</div>
                            <small class="text-muted">@Model.LocalOccurredAt[item.Id].ToString("HH:mm:ss")</small>
                        </td>
                        <td>
                            @switch (item.MovementType)
                            {
                                case InventoryMovementType.Entry:
                                    <span class="badge bg-success">ENTRADA</span>
                                    break;
                                case InventoryMovementType.Exit:
                                    <span class="badge bg-danger">SALIDA</span>
                                    break;
                                case InventoryMovementType.Transfer:
                                    <span class="badge bg-info text-dark">TRANSFERENCIA</span>
                                    break;
                                case InventoryMovementType.Adjustment:
                                    <span class="badge bg-warning text-dark">AJUSTE</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.MovementType</span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@item.Purpose</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@item.ResponsibleName</div>
                            <small class="text-muted font-monospace">@item.Id.ToString()[..8]...</small>
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1">
                                @foreach (var line in item.Lines)
                                {
                                    <div class="p-1 rounded bg-light border-start border-3 border-primary small">
                                        <strong>@line.Sku</strong>:
                                        @if (item.MovementType == InventoryMovementType.Adjustment && line.AdjustmentDelta is not null)
                                        {
                                            <span class="text-primary fw-bold">
                                                @(line.PreviousQuantity?.ToString("0.####") ?? "—") → @line.Quantity.ToString("0.####") @line.UnitCode
                                                (Δ @line.AdjustmentDelta.Value.ToString("+0.####;-0.####;0"))
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-primary fw-bold">@line.Quantity.ToString("0.####") @line.UnitCode</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(line.SourceLocationCode) || !string.IsNullOrWhiteSpace(line.DestinationLocationCode) || !string.IsNullOrWhiteSpace(item.OperationalAreaCode))
                                        {
                                            <span class="text-muted">
                                                (@(line.SourceLocationCode ?? "—") &rarr; @(line.DestinationLocationCode ?? item.OperationalAreaCode ?? "—"))
                                            </span>
                                        }
                                        @foreach (var lot in line.BalanceChanges
                                            .Where(change => !string.IsNullOrWhiteSpace(change.LotNumber))
                                            .Select(change => change.LotNumber)
                                            .Distinct(StringComparer.Ordinal))
                                        {
                                            <span class="badge bg-secondary text-white ms-1">Lote: @lot</span>
                                        }
                                    </div>
                                }
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Reference))
                            {
                                <div><strong>Ref:</strong> @item.Reference</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <small class="text-muted">@item.Notes</small>
                            }
                            @if (string.IsNullOrWhiteSpace(item.Reference) && string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.Results.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Paginación de resultados">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-search="@Model.Search"
                   asp-route-sku="@Model.Sku"
                   asp-route-locationCode="@Model.LocationCode"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-period="@Model.Period"
                   asp-route-movementType="@Model.MovementType"
                   asp-route-purpose="@Model.Purpose"
                   asp-route-responsibleUserId="@Model.ResponsibleUserId">
                    Anterior
                </a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página @Model.PageNumber de @Model.Results.TotalPages</span>
            </li>
            <li class="page-item @(Model.PageNumber >= Model.Results.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-search="@Model.Search"
                   asp-route-sku="@Model.Sku"
                   asp-route-locationCode="@Model.LocationCode"
                   asp-route-from="@Model.From?.ToString("yyyy-MM-dd")"
                   asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                   asp-route-period="@Model.Period"
                   asp-route-movementType="@Model.MovementType"
                   asp-route-purpose="@Model.Purpose"
                   asp-route-responsibleUserId="@Model.ResponsibleUserId">
                    Siguiente
                </a>
            </li>
        </ul>
    </nav>
}
