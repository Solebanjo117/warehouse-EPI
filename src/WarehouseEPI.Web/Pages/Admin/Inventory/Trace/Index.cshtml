@page
@model WarehouseEPI.Web.Pages.Admin.Inventory.Trace.IndexModel
@{ViewData["Title"]="Trazabilidad unificada";var pages=Math.Max(1,(int)Math.Ceiling(Model.Results.TotalCount/(double)IndexModel.PageSize));}
<div class="container-fluid py-3"><header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="text-uppercase small text-primary fw-semibold">Auditoría ADMIN</span><h1 class="h2 mb-1">Trazabilidad unificada</h1><p class="text-muted mb-0">Historial completo y marca de efecto vigente. Zona: @Model.TimeZoneId.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-page-handler="Export" asp-route-format="csv" asp-route-search="@Model.Search" asp-route-kind="@Model.Kind" asp-route-from="@Model.From" asp-route-to="@Model.To">CSV</a><a class="btn btn-outline-success" asp-page-handler="Export" asp-route-format="xlsx" asp-route-search="@Model.Search" asp-route-kind="@Model.Kind" asp-route-from="@Model.From" asp-route-to="@Model.To">Excel</a></div></header>
<form method="get" class="operation-card mb-3"><div class="row g-3 align-items-end"><div class="col-lg-4"><label for="trace-search" class="form-label">Buscar</label><input id="trace-search" name="search" value="@Model.Search" class="form-control" placeholder="Documento, SKU, lote, ubicación o folio"/></div><div class="col-md-4 col-lg-2"><label for="trace-kind" class="form-label">Categoría</label><select id="trace-kind" name="kind" class="form-select"><option value="">Todas</option><option value="movement" selected="@(Model.Kind=="movement")">Movimientos</option><option value="document" selected="@(Model.Kind=="document")">Documentos</option><option value="wip" selected="@(Model.Kind=="wip")">WIP</option><option value="count" selected="@(Model.Kind=="count")">Conteos</option></select></div><div class="col-md-3 col-lg-2"><label for="trace-from" class="form-label">Desde</label><input id="trace-from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div><div class="col-md-3 col-lg-2"><label for="trace-to" class="form-label">Hasta</label><input id="trace-to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">Consultar</button></div></div></form>
@if(Model.Results.Items.Count==0){<section class="operation-card text-center py-5"><h2 class="h5">Sin eventos para estos filtros.</h2><p class="text-muted mb-0">Amplía el periodo o cambia la búsqueda.</p></section>}else{<section class="operation-card"><div class="table-responsive receiving-table"><table class="table align-middle mb-0"><thead><tr><th>Fecha</th><th>Categoría</th><th>Evento</th><th>Sujeto</th><th>Estado</th><th>Responsable</th><th></th></tr></thead><tbody>@foreach(var item in Model.Results.Items){<tr><td data-label="Fecha">@Model.LocalDates[item.Id].ToString("dd/MM/yyyy HH:mm")</td><td data-label="Categoría"><span class="badge text-bg-secondary">@item.Kind</span></td><td data-label="Evento"><strong>@item.Title</strong><div class="small text-muted">@item.Summary</div></td><td data-label="Sujeto">@if(item.ProductSku is not null){<strong>@item.ProductSku</strong>}@if(item.Location is not null){<div class="small">@item.Location</div>}@if(item.ExternalLot is not null){<div class="small">Ext: @item.ExternalLot</div>}@if(item.InternalLot is not null){<div class="small">Lote: @item.InternalLot</div>}</td><td data-label="Estado"><span>@item.Status</span>@if(item.IsEffective is not null){<div class="small @(item.IsEffective.Value?"text-success":"text-warning")">@(item.IsEffective.Value?"Efectivo":"Histórico")</div>}</td><td data-label="Responsable">@item.Responsible</td><td><a class="btn btn-sm btn-outline-primary" href="@item.DetailsUrl">Detalle</a></td></tr>}</tbody></table></div></section>}
@if(pages>1){<nav class="mt-3" aria-label="Páginas de trazabilidad"><ul class="pagination">@for(var p=1;p<=pages;p++){<li class="page-item @(p==Model.PageNumber?"active":null)"><a class="page-link" asp-route-search="@Model.Search" asp-route-kind="@Model.Kind" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-pageNumber="@p">@p</a></li>}</ul></nav>}
</div>
