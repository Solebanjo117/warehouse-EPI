@model WarehouseEPI.Web.Pages.Admin.Production.ScheduleModel
@using global::System.Text.Json
@using global::System.Globalization
@using WarehouseEPI.Core.Entities
@if (Model.Week is { Status: ProductionScheduleWeekStatus.Draft } week)
{
    <section class="card mt-3 production-week-workspace" data-week-workspace
             data-week-id="@week.Id" data-week-version="@week.Version"
             data-week-start="@week.WeekStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
             data-user-id="@Model.User.FindFirst(global::System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"
             data-search-url="@Url.Page("Schedule", "WorkspaceProducts")"
             data-resolve-url="@Url.Page("/Operations/Lookup", "ResolveProduct")"
             data-paste-url="@Url.Page("Schedule", "WorkspaceResolveProducts")"
             data-copy-url="@Url.Page("Schedule", "WorkspaceCopy")"
             data-operation-url="@Url.Page("Schedule", "WorkspaceOperation")">
        <div class="card-body">
            <div class="production-week-workspace__context d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div><h3 class="h5 mb-1">Preparar la semana</h3><p class="text-body-secondary mb-0">Escribe cantidades por día. Revisa y guarda el grupo cuando esté listo.</p></div>
                <div class="d-flex flex-wrap gap-2"><span class="badge text-bg-secondary">Borrador · @week.WeekStart.ToString("dd/MM/yyyy")–@week.WeekEnd.ToString("dd/MM/yyyy")</span><span class="badge text-bg-primary" data-workspace-count>0 cambios</span></div>
            </div>
            <partial name="_InitialCarryover" model="Model" />
            <div hidden data-workspace-existing>
                @foreach (var line in week.Lines.Where(x => !x.IsCarryover))
                {
                    <span data-line="@JsonSerializer.Serialize(new {
                        line.Id, line.Version, line.ProductId, line.Sku, line.Unit,
                        Day = line.PlannedDate.DayNumber - week.WeekStart.DayNumber,
                        line.Quantity, line.OrderReference1, line.OrderReference2, line.OrderReference3,
                        line.Notes, line.OriginalType, line.OriginalAnnotation1, line.OriginalAnnotation2,
                        line.OriginalAnnotation1Kind, line.OriginalAnnotation2Kind
                    })"></span>
                }
            </div>
            <div class="row g-3 mt-1">
                <div class="col-12 col-lg-5 position-relative">
                    <label for="week-workspace-search" class="form-label">Buscar o escanear SKU</label>
                    <input id="week-workspace-search" type="search" class="form-control form-control-lg" data-workspace-search autocomplete="off" autocapitalize="characters" aria-expanded="false" aria-controls="week-workspace-results" />
                    <div id="week-workspace-results" class="list-group production-daily__suggestions" data-workspace-results role="listbox"></div>
                </div>
                <div class="col-12 col-lg-4">
                    <label for="week-workspace-source" class="form-label">Copiar de otra semana</label>
                    <select id="week-workspace-source" class="form-select form-select-lg" data-workspace-source>
                        @foreach (var source in Model.Weeks.Where(x => x.WeekStart < week.WeekStart).OrderByDescending(x => x.WeekStart))
                        { <option value="@source.Id">@source.WeekStart.ToString("dd/MM/yyyy")–@source.WeekEnd.ToString("dd/MM/yyyy")</option> }
                    </select>
                </div>
                <div class="col-12 col-lg-3 d-flex flex-column justify-content-end gap-1 production-week-workspace__copy-controls">
                    <label><input type="checkbox" data-workspace-copy-products checked /> Copiar productos</label>
                    <label><input type="checkbox" data-workspace-copy-openings /> Traer arrastre</label>
                    <label><input type="checkbox" data-workspace-copy-quantities /> Incluir cantidades anteriores de productos</label>
                    <button type="button" class="btn btn-outline-primary" data-workspace-copy>Preparar copia</button>
                </div>
            </div>
            <details class="mt-3" data-workspace-paste-panel><summary class="py-2">Pegar desde Excel</summary>
                <p class="small text-body-secondary">Usa encabezados «SKU | Lunes | Martes | … | Domingo» o «Día | SKU | Cantidad». Pedido 1, Pedido 2, Pedido 3 y Notas son opcionales.</p>
                <div class="row g-2"><div class="col-12 col-lg-6"><strong class="small">Plantilla semanal</strong><pre class="small border rounded p-2 overflow-auto">SKU	Lunes	Martes	Miércoles	Jueves	Viernes	Sábado	Domingo	Pedido 1	Notas
SKU-123	10	20						PO-1	</pre></div><div class="col-12 col-lg-6"><strong class="small">Plantilla por día</strong><pre class="small border rounded p-2 overflow-auto">Día	SKU	Cantidad	Pedido 1	Notas
Lunes	SKU-123	10	PO-1	</pre></div></div>
                <label for="week-workspace-paste" class="form-label">Datos copiados de Excel</label>
                <textarea id="week-workspace-paste" class="form-control" rows="5" data-workspace-paste></textarea>
                <button type="button" class="btn btn-outline-primary mt-2" data-workspace-preview-paste>Revisar pegado</button>
            </details>
            <section data-workspace-paste-preview class="mt-3" aria-label="Productos y arrastre preparados para incorporar" tabindex="-1" hidden></section>
            <div class="d-flex flex-wrap gap-2 mt-3" role="group" aria-label="Vista de la preparación">
                <button type="button" class="btn btn-outline-primary active" data-workspace-view="week">Semana</button>
                <button type="button" class="btn btn-outline-primary" data-workspace-view="day">Por día</button>
                <select class="form-select production-week-workspace__day" data-workspace-day aria-label="Día visible"></select>
            </div>
            <p class="small text-body-secondary mt-2 mb-0" data-workspace-day-summary></p>
            <div class="table-responsive mt-3"><table class="table table-bordered align-middle production-week-workspace__table">
                <thead><tr><th scope="col">SKU</th><th scope="col" data-workspace-day-head="0">Lunes</th><th scope="col" data-workspace-day-head="1">Martes</th><th scope="col" data-workspace-day-head="2">Miércoles</th><th scope="col" data-workspace-day-head="3">Jueves</th><th scope="col" data-workspace-day-head="4">Viernes</th><th scope="col" data-workspace-day-head="5">Sábado</th><th scope="col" data-workspace-day-head="6">Domingo</th><th scope="col">Total</th><th scope="col">Acciones</th></tr></thead>
                <tbody data-workspace-rows></tbody>
            </table></div>
            <p data-workspace-empty class="text-body-secondary">Busca un SKU, pega una lista o copia una semana para empezar.</p>
            <div data-workspace-message role="status" aria-live="polite"></div>
            <form method="post" asp-page-handler="WorkspaceSave" data-workspace-form autocomplete="off">
                <input name="payload" type="hidden" data-workspace-payload />
                <div class="production-week-workspace__actions border rounded p-2 mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span data-workspace-summary>Sin cambios pendientes</span>
                    <button type="button" class="btn btn-primary" data-workspace-review>Revisar cambios</button>
                </div>
                <div data-workspace-review-panel hidden class="border rounded p-3 mt-3">
                    <h4 class="h6">Cambios por confirmar</h4><div data-workspace-review-list></div>
                    <div class="d-flex flex-wrap gap-2 mt-3"><button type="submit" class="btn btn-success" data-workspace-save>Guardar cambios</button><button type="button" class="btn btn-outline-secondary" data-workspace-back>Seguir editando</button></div>
                </div>
            </form>
            <div class="alert alert-info mt-3" data-workspace-recovery hidden></div>
        </div>
    </section>
}
