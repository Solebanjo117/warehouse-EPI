@page
@model WarehouseEPI.Web.Pages.Operations.Production.WorkModel
@{ViewData["Title"]=$"Producción {Model.Order.Number}";var o=Model.Order;var active=o.Status is WarehouseEPI.Core.Entities.ProductionWorkOrderStatus.Released or WarehouseEPI.Core.Entities.ProductionWorkOrderStatus.InProgress;}
<div class="container-fluid py-3 production-page"><header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><a asp-page="Index" class="text-decoration-none">← Producción</a><span class="eyebrow d-block mt-2">Orden de trabajo</span><h1 class="h2 mb-1">@o.Number</h1><p class="mb-0"><strong>@o.Sku</strong> · @o.Description</p></div><div class="text-end"><span class="badge text-bg-primary fs-6">@o.Status</span><div class="mt-2"><strong>@o.WarehouseReceived.ToString("0.####") de @o.TargetQuantity.ToString("0.####") @o.Unit</strong> recibidos en bodega</div></div></header>
@if(TempData["Success"] is string ok){<div class="alert alert-success" role="status">@ok</div>}<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div>
<section class="card mb-4"><div class="card-body"><div class="row g-3"><div class="col-6 col-lg-3"><small class="text-muted d-block">Meta original</small><strong>@o.TargetQuantity.ToString("0.####") @o.Unit</strong></div><div class="col-6 col-lg-3"><small class="text-muted d-block">Autorizado</small><strong>@o.AuthorizedQuantity.ToString("0.####") @o.Unit</strong></div><div class="col-6 col-lg-3"><small class="text-muted d-block">Referencia externa</small><strong>@(o.ExternalReference??"Sin referencia")</strong></div><div class="col-6 col-lg-3"><small class="text-muted d-block">Fecha prevista</small><strong>@(o.DueDate?.ToString("dd/MM/yyyy")??"Sin fecha")</strong></div></div>@if(!string.IsNullOrWhiteSpace(o.Notes)){<p class="mt-3 mb-0">@o.Notes</p>}</div></section>
<section class="mb-4" aria-labelledby="route-title"><h2 id="route-title" class="h4">Avance por etapa</h2><div class="row g-3">@foreach(var s in o.Stages){<div class="col-12 col-xl-6"><article class="card h-100"><div class="card-header"><strong>@s.Sequence. @s.Name</strong> <span class="text-muted">@s.Code</span></div><div class="card-body"><dl class="row mb-0"><dt class="col-7">Disponible para procesar</dt><dd class="col-5 text-end fw-bold">@s.AvailableInput.ToString("0.####")</dd><dt class="col-7">Procesado</dt><dd class="col-5 text-end">@s.Processed.ToString("0.####")</dd><dt class="col-7">Bueno</dt><dd class="col-5 text-end">@s.Good.ToString("0.####")</dd><dt class="col-7">Retrabajo pendiente</dt><dd class="col-5 text-end">@s.Rework.ToString("0.####")</dd><dt class="col-7">Merma</dt><dd class="col-5 text-end">@s.Scrap.ToString("0.####")</dd><dt class="col-7">Disponible para entregar</dt><dd class="col-5 text-end fw-bold">@s.AvailableToDeliver.ToString("0.####")</dd><dt class="col-7">Pendiente de recepción</dt><dd class="col-5 text-end @(s.PendingReceipt>0?"text-warning fw-bold":null)">@s.PendingReceipt.ToString("0.####")</dd></dl></div></article></div>}</div></section>
@if(active){<div class="accordion mb-4" id="production-actions"><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#process-panel">Registrar producción</button></h2><div id="process-panel" class="accordion-collapse collapse show"><div class="accordion-body"><form method="post" asp-page-handler="Process" class="row g-3"><input asp-for="Process.OperationId" type="hidden"/><div class="col-12 col-md-4"><label asp-for="Process.StageId" class="form-label">Etapa</label><select asp-for="Process.StageId" class="form-select form-select-lg"><option value="">Selecciona…</option>@foreach(var s in o.Stages){<option value="@s.Id">@s.Sequence. @s.Name</option>}</select></div><div class="col-12 col-md-4"><label asp-for="Process.ShiftId" class="form-label">Turno</label><select asp-for="Process.ShiftId" class="form-select form-select-lg"><option value="">Selecciona…</option>@foreach(var s in Model.Shifts.Where(x=>x.IsActive)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-12 col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="Process.IsRework" class="form-check-input"/><label asp-for="Process.IsRework" class="form-check-label">Procesar retrabajo pendiente</label></div></div><div class="col-6 col-lg-3"><label asp-for="Process.InputQuantity" class="form-label">Cantidad procesada</label><input asp-for="Process.InputQuantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="Process.GoodQuantity" class="form-label">Cantidad buena</label><input asp-for="Process.GoodQuantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="Process.ReworkQuantity" class="form-label">A retrabajo</label><input asp-for="Process.ReworkQuantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-6 col-lg-3"><label asp-for="Process.ScrapQuantity" class="form-label">Merma</label><input asp-for="Process.ScrapQuantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-12 col-md-8"><label asp-for="Process.Reason" class="form-label">Motivo u observaciones</label><input asp-for="Process.Reason" class="form-control"/></div><div class="col-12 col-md-4"><label asp-for="Process.Pin" class="form-label">NIP</label><input asp-for="Process.Pin" type="password" inputmode="numeric" autocomplete="off" class="form-control"/></div><div class="col-12"><button class="btn btn-primary btn-lg" type="submit">Registrar avance</button></div></form></div></div></div>
<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#handoff-panel">Entregar, recibir o conciliar</button></h2><div id="handoff-panel" class="accordion-collapse collapse"><div class="accordion-body"><form method="post" asp-page-handler="Handoff" class="row g-3"><input asp-for="Handoff.OperationId" type="hidden"/><div class="col-12 col-md-4"><label asp-for="Handoff.Mode" class="form-label">Acción</label><select asp-for="Handoff.Mode" class="form-select"><option value="deliver">Entregar a siguiente etapa</option><option value="receive">Recibir de etapa anterior</option><option value="return">Devolver diferencia al emisor</option><option value="lost">Registrar pérdida conciliada</option></select></div><div class="col-6 col-md-4"><label asp-for="Handoff.SourceStageId" class="form-label">Etapa que entrega</label><select asp-for="Handoff.SourceStageId" class="form-select">@foreach(var s in o.Stages.Take(Math.Max(0,o.Stages.Count-1))){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-6 col-md-4"><label asp-for="Handoff.TargetStageId" class="form-label">Etapa que recibe</label><select asp-for="Handoff.TargetStageId" class="form-select">@foreach(var s in o.Stages.Skip(1)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-6 col-md-3"><label asp-for="Handoff.Quantity" class="form-label">Cantidad</label><input asp-for="Handoff.Quantity" class="form-control" inputmode="decimal"/></div><div class="col-12 col-md-5"><label asp-for="Handoff.Reason" class="form-label">Motivo de conciliación</label><input asp-for="Handoff.Reason" class="form-control"/></div><div class="col-6 col-md-4"><label asp-for="Handoff.Pin" class="form-label">NIP</label><input asp-for="Handoff.Pin" type="password" inputmode="numeric" autocomplete="off" class="form-control"/></div><div class="col-12"><button class="btn btn-primary" type="submit">Registrar movimiento</button></div></form></div></div></div>
<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#warehouse-panel">Recibir producto terminado en bodega</button></h2><div id="warehouse-panel" class="accordion-collapse collapse"><div class="accordion-body"><form method="post" asp-page-handler="Warehouse" class="row g-3"><input asp-for="Warehouse.OperationId" type="hidden"/><input asp-for="Warehouse.FinalStageId" type="hidden" value="@o.Stages.Last().Id"/><div class="col-6 col-md-3"><label asp-for="Warehouse.Quantity" class="form-label">Cantidad</label><input asp-for="Warehouse.Quantity" class="form-control form-control-lg" inputmode="decimal"/></div><div class="col-12 col-md-5"><label asp-for="Warehouse.DestinationLocationId" class="form-label">Ubicación destino</label><select asp-for="Warehouse.DestinationLocationId" class="form-select form-select-lg"><option value="">Selecciona…</option>@foreach(var x in Model.Destinations){<option value="@x.Id">@x.Code</option>}</select></div><div class="col-6 col-md-4"><label asp-for="Warehouse.Pin" class="form-label">NIP</label><input asp-for="Warehouse.Pin" type="password" inputmode="numeric" autocomplete="off" class="form-control form-control-lg"/></div><div class="col-12"><button class="btn btn-success btn-lg" type="submit">Registrar recepción y Entrada</button></div></form></div></div></div></div>}
@if(User.Identity?.IsAuthenticated==true){<section class="card mb-4 border-warning"><div class="card-body"><h2 class="h5">Control ADMIN</h2><form method="post" asp-page-handler="Action" class="row g-3"><input asp-for="Action.OperationId" type="hidden"/><input asp-for="Action.ExpectedVersion" type="hidden"/><div class="col-12 col-md-3"><label asp-for="Action.Mode" class="form-label">Acción</label><select asp-for="Action.Mode" class="form-select"><option value="release">Liberar orden</option><option value="pause">Pausar</option><option value="resume">Reanudar</option><option value="authorize">Autorizar cantidad adicional</option><option value="close">Cerrar orden</option></select></div><div class="col-6 col-md-2"><label asp-for="Action.Quantity" class="form-label">Cantidad adicional</label><input asp-for="Action.Quantity" class="form-control" inputmode="decimal"/></div><div class="col-12 col-md-4"><label asp-for="Action.Reason" class="form-label">Motivo</label><input asp-for="Action.Reason" class="form-control"/></div><div class="col-6 col-md-3"><label asp-for="Action.Pin" class="form-label">NIP ADMIN</label><input asp-for="Action.Pin" type="password" inputmode="numeric" autocomplete="off" class="form-control"/></div><div class="col-12"><button class="btn btn-warning" type="submit">Aplicar acción administrativa</button></div></form></div></section>}
<section aria-labelledby="history-title"><h2 id="history-title" class="h4">Historial</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Fecha</th><th>Evento</th><th>Etapa</th><th>Cantidades</th><th>Responsable</th><th>Motivo</th></tr></thead><tbody>@foreach(var e in o.Events){<tr><td>@e.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@e.Type</td><td>@e.Stage@if(e.RelatedStage is not null){<span> → @e.RelatedStage</span>}</td><td>@if(e.Quantity!=0){<span>@e.Quantity.ToString("0.####")</span>}@if(e.Good+e.Rework+e.Scrap!=0){<small class="d-block">Buena @e.Good.ToString("0.####") · Retrabajo @e.Rework.ToString("0.####") · Merma @e.Scrap.ToString("0.####")</small>}</td><td>@e.Responsible@if(e.Shift is not null){<small class="d-block">@e.Shift</small>}</td><td>@e.Reason @if(e.MovementId is Guid m){<a asp-page="/Operations/Receipt" asp-route-id="@m">Ver Entrada</a>}</td></tr>}</tbody></table></div></section></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
