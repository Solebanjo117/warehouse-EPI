@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionMaterialReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>Orden / proceso</th><th>Material</th><th class="text-end">Plan autorizado</th><th class="text-end">Surtido</th><th class="text-end">Consumido</th><th class="text-end">Devuelto</th><th class="text-end">Desperdicio</th><th class="text-end">Pendiente</th><th class="text-end">Desviaciones</th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr><td data-label="Orden / proceso"><a asp-page="/Admin/Production/Details" asp-route-id="@row.OrderId"><strong>@row.OrderNumber</strong></a><small>@row.Stage</small></td><td data-label="Material"><span class="font-monospace">@row.Sku</span><small>@row.Description · @row.Unit</small></td><td data-label="Plan autorizado" class="text-end">@row.AuthorizedPlan.ToString("0.####")</td><td data-label="Surtido" class="text-end">@row.Issued.ToString("0.####")</td><td data-label="Consumido" class="text-end">@row.Consumed.ToString("0.####")<small>Primera pasada @(row.FirstPassConsumption?.ToString("0.####") ?? "Sin base")</small></td><td data-label="Devuelto" class="text-end">@row.Returned.ToString("0.####")</td><td data-label="Desperdicio" class="text-end">@row.Scrapped.ToString("0.####")</td><td data-label="Pendiente" class="text-end">@row.PendingSupply.ToString("0.####")</td><td data-label="Desviaciones" class="text-end"><span>Plan @Signed(row.PlanVariance)</span><small>Técnica @(row.TechnicalVariance is null ? "Sin base" : Signed(row.TechnicalVariance.Value))</small></td></tr> }</tbody>
</table>
@functions { static string Signed(decimal value) => value > 0 ? $"+{value:0.####}" : value.ToString("0.####"); }
