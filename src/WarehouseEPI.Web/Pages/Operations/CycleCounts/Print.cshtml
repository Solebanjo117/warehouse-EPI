@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.PrintModel
@{ ViewData["Title"] = OpTexts["Hoja de conteo"].Value; }
<div class="cycle-count-print"><header><h1>@OpTexts["Hoja ciega de conteo"]</h1><p><strong>@OpTexts["Folio:"]</strong> @Model.Campaign?.Folio · <strong>@OpTexts["Ubicación:"]</strong> @Model.Location?.LocationCode · <strong>@OpTexts["Intento:"]</strong> @Model.Attempt?.AttemptNumber</p><p class="no-print"><button type="button" class="btn btn-primary" data-cycle-print>@OpTexts["Imprimir"]</button> <a asp-page="Details" asp-route-id="@Model.Campaign?.Id" class="btn btn-outline-secondary">@OpTexts["Volver"]</a></p></header><table class="table table-bordered"><thead><tr><th>@OpTexts["SKU"]</th><th>@OpTexts["Descripción"]</th><th>@OpTexts["Unidad"]</th><th>@OpTexts["Cantidad física"]</th><th>@OpTexts["Iniciales"]</th></tr></thead><tbody>@foreach(var item in Model.Attempt?.Entries ?? []){<tr><td>@item.Sku</td><td>@item.Description</td><td>@item.UnitCode</td><td class="cycle-count-blank"></td><td></td></tr>}</tbody></table><footer><p>@OpTexts["Responsable: ________________________________ Firma: ________________________________ Fecha: __________________"]</p></footer></div>
@section Scripts { <style>@@media print{.app-topbar,.app-sidebar,.app-backdrop,.app-footer,.no-print{display:none!important}.app-content{margin:0!important}.app-main{padding:0!important}.cycle-count-print{font-size:12pt}.cycle-count-print h1{font-size:20pt}.cycle-count-print table{width:100%;border-collapse:collapse}.cycle-count-print th,.cycle-count-print td{padding:.5rem;border:1px solid #222}.cycle-count-blank{height:3rem;width:20%}}</style> <script src="~/js/cycle-count.js" asp-append-version="true"></script> }
