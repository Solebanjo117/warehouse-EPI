@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Settings.BusinessModel
@{ ViewData["Title"] = CatTexts["Datos del negocio"].Value; var logoUrl = ViewData["LogoUrl"] as string; }
<div class="row justify-content-center admin-form-workspace"><div class="col-12 col-xl-8"><h1 class="h2 mb-2">@CatTexts["Datos del negocio"]</h1><p class="text-muted mb-4">@CatTexts["Estos datos identifican el almacén y definen la fecha usada por lotes automáticos futuros."]</p>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<form method="post" enctype="multipart/form-data" class="card admin-form-card"><div class="card-body p-4"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<fieldset class="admin-form-section"><legend>@CatTexts["Identidad"]</legend><div class="row"><div class="col-md-6 mb-3"><label asp-for="Input.BusinessName" class="form-label">@CatTexts["Nombre del negocio"]</label><input asp-for="Input.BusinessName" class="form-control form-control-lg" /><span asp-validation-for="Input.BusinessName" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Input.WarehouseName" class="form-label">@CatTexts["Nombre del almacén"]</label><input asp-for="Input.WarehouseName" class="form-control form-control-lg" /><span asp-validation-for="Input.WarehouseName" class="text-danger"></span></div></div>
<div class="row"><div class="col-md-5 mb-3"><label asp-for="Input.WarehouseCode" class="form-label">@CatTexts["Código del almacén"]</label><input asp-for="Input.WarehouseCode" class="form-control form-control-lg text-uppercase" /><span asp-validation-for="Input.WarehouseCode" class="text-danger"></span></div></div></fieldset><fieldset class="admin-form-section"><legend>@CatTexts["Configuración horaria"]</legend><div class="row"><div class="col-12 mb-3"><label asp-for="Input.TimeZoneId" class="form-label">@CatTexts["Zona horaria IANA"]</label><input asp-for="Input.TimeZoneId" class="form-control form-control-lg" list="timezones" /><datalist id="timezones"><option value="America/Matamoros"></option><option value="America/Mexico_City"></option><option value="America/Tijuana"></option><option value="UTC"></option></datalist><span asp-validation-for="Input.TimeZoneId" class="text-danger"></span></div></div>
</fieldset><fieldset class="admin-form-section"><legend>@CatTexts["Alertas operativas"]</legend><label asp-for="Input.WipReminderDays" class="form-label">@CatTexts["Alertar saldo WIP estancado después de"]</label><div class="input-group"><input asp-for="Input.WipReminderDays" class="form-control" min="1" max="365" /><span class="input-group-text">@CatTexts["días.lower"]</span></div><span asp-validation-for="Input.WipReminderDays" class="text-danger"></span><div class="form-text">@CatTexts["La antigüedad se basa en el lote positivo más antiguo de cada posición producto–WIP."]</div></fieldset>
<fieldset class="admin-form-section"><legend>@CatTexts["Logo"]</legend>@if (logoUrl is not null) { <img src="@logoUrl" class="business-logo-preview mb-3" alt='@CatTexts["Logo actual del negocio"]' /> }<div class="mb-2"><label asp-for="Input.Logo" class="form-label">@CatTexts["Imagen PNG, JPEG o WebP (máximo 1 MB)"]</label><input asp-for="Input.Logo" class="form-control" accept="image/png,image/jpeg,image/webp" /><span asp-validation-for="Input.Logo" class="text-danger"></span></div>@if (logoUrl is not null) { <div class="form-check"><input asp-for="Input.RemoveLogo" class="form-check-input" /><label asp-for="Input.RemoveLogo" class="form-check-label">@CatTexts["Eliminar logo actual"]</label></div> }</fieldset>
<div class="admin-form-actions"><button class="btn btn-primary btn-lg">@CatTexts["Guardar datos"]</button></div></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@section Styles { <link rel="stylesheet" href="~/css/admin-forms.css" asp-append-version="true" /> }
