# Mantener un formato de texto consistente sin renormalizar archivos historicos.
* text=auto

.editorconfig text eol=lf
.gitattributes text eol=lf

*.cs text eol=lf
*.cshtml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.xlsm binary
*.dump binary
