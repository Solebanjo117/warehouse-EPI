@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@using WarehouseEPI.Core.Entities
@using WarehouseEPI.Infrastructure.Inventory
@model WarehouseEPI.Web.Pages.Admin.Inventory.Movements.IndexModel
@{
    ViewData["Title"] = CatTexts["Movimientos"].Value;
    var request = ViewContext.HttpContext.Request;
    var returnUrl = $"{request.Path}{request.QueryString}";
    var itemCount = Model.IsAudit ? Model.AuditResults.Items.Count : Model.EffectiveResults.Items.Count;
    var effectiveValues = Model.RouteValues(("view", "effective"), ("state", null), ("pageNumber", null));
    var auditValues = Model.RouteValues(("view", "audit"), ("pageNumber", null));
    var xlsxValues = Model.RouteValues(("format", "xlsx"), ("pageNumber", null));
    var csvValues = Model.RouteValues(("format", "csv"), ("pageNumber", null));
    var todayValues = Model.RouteValues(("period", "today"), ("from", null), ("to", null), ("pageNumber", null));
    var yesterdayValues = Model.RouteValues(("period", "yesterday"), ("from", null), ("to", null), ("pageNumber", null));
    var thisWeekValues = Model.RouteValues(("period", "this-week"), ("from", null), ("to", null), ("pageNumber", null));
    var lastWeekValues = Model.RouteValues(("period", "last-week"), ("from", null), ("to", null), ("pageNumber", null));
    var sevenValues = Model.RouteValues(("period", "7"), ("from", null), ("to", null), ("pageNumber", null));
    var thisMonthValues = Model.RouteValues(("period", "this-month"), ("from", null), ("to", null), ("pageNumber", null));
    var lastMonthValues = Model.RouteValues(("period", "last-month"), ("from", null), ("to", null), ("pageNumber", null));
    var thirtyValues = Model.RouteValues(("period", "30"), ("from", null), ("to", null), ("pageNumber", null));
    var allValues = Model.RouteValues(("period", "all"), ("from", null), ("to", null), ("pageNumber", null));
    var clearPeriodValues = Model.RouteValues(("period", "30"), ("from", null), ("to", null), ("pageNumber", null));
    var clearTypeValues = Model.RouteValues(("movementType", null), ("pageNumber", null));
    var clearPurposeValues = Model.RouteValues(("purpose", null), ("pageNumber", null));
    var clearSkuValues = Model.RouteValues(("sku", null), ("pageNumber", null));
    var clearLocationValues = Model.RouteValues(("locationCode", null), ("pageNumber", null));
    var clearResponsibleValues = Model.RouteValues(("responsibleUserId", null), ("pageNumber", null));
    var clearSearchValues = Model.RouteValues(("search", null), ("pageNumber", null));
    var clearStateValues = Model.RouteValues(("state", null), ("pageNumber", null));
    var previousValues = Model.RouteValues(("pageNumber", (Model.PageNumber - 1).ToString()));
    var nextValues = Model.RouteValues(("pageNumber", (Model.PageNumber + 1).ToString()));
}

@section Styles {
    <link rel="stylesheet" href="~/css/movements-index.css" asp-append-version="true" />
}
<div class="inventory-analytics movements-page">
  <header class="inventory-page-header analytics-header"><div><span class="inventory-eyebrow">@CatTexts["Consulta ADMIN"]</span><h1 class="h2 mb-1">@CatTexts["Movimientos"]</h1><p class="text-muted mb-0">@CatTexts["Consulta movimientos vigentes y su historial de auditoría."]</p></div><div class="analytics-exports"><a class="btn btn-outline-secondary" asp-page-handler="Export" asp-all-route-data="@xlsxValues">Excel (.xlsx)</a><a class="btn btn-outline-secondary" asp-page-handler="Export" asp-all-route-data="@csvValues">CSV</a></div></header>
  <nav class="inventory-filter-tabs analytics-tabs" aria-label="@CatTexts["Población de movimientos"]"><a class="@(Model.IsAudit ? null : "active")" aria-current="@(!Model.IsAudit ? "page" : null)" asp-all-route-data="@effectiveValues" data-movement-tab="effective">@CatTexts["Vigentes"]</a><a class="@(Model.IsAudit ? "active" : null)" aria-current="@(Model.IsAudit ? "page" : null)" asp-all-route-data="@auditValues" data-movement-tab="audit">@CatTexts["Auditoría completa"]</a></nav>
  <dl class="movements-meta">
    <div><dt>@CatTexts["Población"]</dt><dd>@(Model.IsAudit ? CatTexts["Todas las operaciones confirmadas, incluidos originales corregidos, reversos y reemplazos."].Value : CatTexts["Operaciones efectivas vigentes; excluye originales corregidos y reversos."].Value)</dd></div>
    <div><dt>@CatTexts["Período local"]</dt><dd class="is-range">@(Model.From?.ToString("dd/MM/yyyy") ?? "inicio") a @(Model.To?.ToString("dd/MM/yyyy") ?? CatTexts["actualidad"].Value)</dd></div>
    <div><dt>@CatTexts["Zona horaria"]</dt><dd>@Model.TimeZoneId</dd></div>
  </dl>
  <form method="get" class="analytics-filter-card"><input type="hidden" name="view" value="@Model.View" /><input type="hidden" name="period" value="@Model.Period" />
    <div class="d-flex flex-wrap gap-2 align-items-center"><span class="text-muted small fw-bold">@CatTexts["Período rápido:"]</span><a asp-all-route-data="@todayValues" class="btn btn-sm @(Model.Period == "today" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="today">@CatTexts["Hoy"]</a><a asp-all-route-data="@yesterdayValues" class="btn btn-sm @(Model.Period == "yesterday" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="yesterday">@CatTexts["Ayer"]</a><a asp-all-route-data="@thisWeekValues" class="btn btn-sm @(Model.Period == "this-week" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="this-week">@CatTexts["Esta semana"]</a><a asp-all-route-data="@lastWeekValues" class="btn btn-sm @(Model.Period == "last-week" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="last-week">@CatTexts["Semana pasada"]</a><a asp-all-route-data="@sevenValues" class="btn btn-sm @(Model.Period == "7" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="7">@CatTexts["Últimos 7 días"]</a><a asp-all-route-data="@thisMonthValues" class="btn btn-sm @(Model.Period == "this-month" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="this-month">@CatTexts["Mes actual"]</a><a asp-all-route-data="@lastMonthValues" class="btn btn-sm @(Model.Period == "last-month" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="last-month">@CatTexts["Mes anterior"]</a><a asp-all-route-data="@thirtyValues" class="btn btn-sm @(Model.Period == "30" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="30">@CatTexts["Últimos 30 días"]</a><a asp-all-route-data="@allValues" class="btn btn-sm @(Model.Period == "all" ? "btn-primary" : "btn-outline-secondary")" data-movement-period="all">@CatTexts["Todo el historial"]</a></div>
    <details class="analytics-filter-details mt-3" open="@(Model.HasAdvancedFilters ? "open" : null)"><summary>@CatTexts["Filtros avanzados"]</summary><div class="row g-3 pt-3"><div class="col-sm-6 col-lg-3"><label for="movement-from" class="form-label">@CatTexts["Desde"]</label><input id="movement-from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-to" class="form-label">@CatTexts["Hasta"]</label><input id="movement-to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-type" class="form-label">@CatTexts["Tipo"]</label><select id="movement-type" name="movementType" class="form-select"><option value="">@CatTexts["Todos"]</option>@foreach (var type in Enum.GetValues<InventoryMovementType>()) { <option value="@type" selected="@(Model.MovementType == type)">@TypeLabel(type)</option> }</select></div><div class="col-sm-6 col-lg-3"><label for="movement-purpose" class="form-label">@CatTexts["Propósito"]</label><select id="movement-purpose" name="purpose" class="form-select"><option value="">@CatTexts["Todos"]</option>@foreach (var purpose in Enum.GetValues<InventoryMovementPurpose>()) { <option value="@purpose" selected="@(Model.Purpose == purpose)">@PurposeLabel(purpose)</option> }</select></div><div class="col-sm-6 col-lg-3"><label for="movement-product" class="form-label">@CatTexts["Producto"]</label><input id="movement-product" name="sku" value="@Model.Sku" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-location" class="form-label">@CatTexts["Ubicación / área"]</label><input id="movement-location" name="locationCode" value="@Model.LocationCode" class="form-control" /></div><div class="col-sm-6 col-lg-3"><label for="movement-user" class="form-label">@CatTexts["Responsable"]</label><select id="movement-user" name="responsibleUserId" class="form-select" asp-items="Model.UserOptions"><option value="">@CatTexts["Todos"]</option></select></div>@if (Model.IsAudit) { <div class="col-sm-6 col-lg-3"><label for="movement-state" class="form-label">@CatTexts["Estado de auditoría"]</label><select id="movement-state" name="state" class="form-select"><option value="All">@CatTexts["Todos"]</option><option value="Current" selected="@(Model.State == InventoryHistoryCorrectionState.Current)">@CatTexts["Sin relación con corrección"]</option><option value="CorrectedOriginal" selected="@(Model.State == InventoryHistoryCorrectionState.CorrectedOriginal)">@CatTexts["Original corregido"]</option><option value="Reversal" selected="@(Model.State == InventoryHistoryCorrectionState.Reversal)">@CatTexts["Reverso"]</option><option value="Replacement" selected="@(Model.State == InventoryHistoryCorrectionState.Replacement)">@CatTexts["Reemplazo"]</option></select></div> }<div class="col-12"><label for="movement-search" class="form-label">@CatTexts["Búsqueda libre"]</label><input id="movement-search" name="search" value="@Model.Search" class="form-control" /></div><div class="col-12 d-flex justify-content-between"><span class="text-muted small">@CatTexts["Mostrando"] <strong>@itemCount</strong> @CatTexts["de"] <strong>@Model.TotalCount</strong> @CatTexts["operaciones."]</span><div><a asp-page="Index" asp-route-view="@Model.View" class="btn btn-outline-secondary">@CatTexts["Limpiar"]</a><button type="submit" class="btn btn-primary">@CatTexts["Aplicar filtros"]</button></div></div></div></details>
  </form>
  @if (Model.HasAdvancedFilters) { <nav class="analytics-filter-chips" aria-label="@CatTexts["Filtros activos"]">@if (Model.Period == "custom") { <a asp-all-route-data="@clearPeriodValues" data-filter-chip="period" aria-label="@CatTexts["Quitar el filtro de período"]">Período: @(Model.From?.ToString("dd/MM/yyyy") ?? "inicio") a @(Model.To?.ToString("dd/MM/yyyy") ?? CatTexts["actualidad"].Value)<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.MovementType is not null) { <a asp-all-route-data="@clearTypeValues" data-filter-chip="movementType" aria-label="@CatTexts["Quitar el filtro de tipo"]">Tipo: @TypeLabel(Model.MovementType.Value)<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.Purpose is not null) { <a asp-all-route-data="@clearPurposeValues" data-filter-chip="purpose" aria-label="@CatTexts["Quitar el filtro de propósito"]">@CatTexts["Propósito: {0}", PurposeLabel(Model.Purpose.Value)]<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (!string.IsNullOrWhiteSpace(Model.Sku)) { <a asp-all-route-data="@clearSkuValues" data-filter-chip="sku" aria-label="@CatTexts["Quitar el filtro de producto"]">Producto: @Model.Sku<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (!string.IsNullOrWhiteSpace(Model.LocationCode)) { <a asp-all-route-data="@clearLocationValues" data-filter-chip="locationCode" aria-label="@CatTexts["Quitar el filtro de ubicación"]">@CatTexts["Ubicación: {0}", Model.LocationCode ?? string.Empty]<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.ResponsibleUserId is not null) { <a asp-all-route-data="@clearResponsibleValues" data-filter-chip="responsibleUserId" aria-label="@CatTexts["Quitar el filtro de responsable"]">@CatTexts["Responsable"]<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (!string.IsNullOrWhiteSpace(Model.Search)) { <a asp-all-route-data="@clearSearchValues" data-filter-chip="search" aria-label="@CatTexts["Quitar la búsqueda libre"]">@CatTexts["Búsqueda: {0}", Model.Search ?? string.Empty]<span class="movement-chip-remove" aria-hidden="true"></span></a> }@if (Model.IsAudit && Model.State != InventoryHistoryCorrectionState.All) { <a asp-all-route-data="@clearStateValues" data-filter-chip="state" aria-label="@CatTexts["Quitar el filtro de estado"]">Estado: @Model.State<span class="movement-chip-remove" aria-hidden="true"></span></a> }</nav> }
  @if (Model.IsAudit) { <div class="table-responsive analytics-table-card"><table class="table table-hover align-middle report-cards"><thead><tr><th scope="col">@CatTexts["Fecha / folio"]</th><th scope="col">@CatTexts["Tipo / propósito"]</th><th scope="col">@CatTexts["Producto"]</th><th scope="col">@CatTexts["Trayecto"]</th><th scope="col">@CatTexts["Responsable"]</th><th scope="col">@CatTexts["Referencia"]</th><th scope="col">@CatTexts["Estado"]</th><th scope="col"><span class="visually-hidden">@CatTexts["Acciones"]</span></th></tr></thead><tbody>@if (Model.AuditResults.Items.Count == 0) { <tr class="report-empty-row"><td colspan="8">@CatTexts["No hay movimientos de auditoría con los filtros seleccionados."]</td></tr> } else { @foreach (var item in Model.AuditResults.Items) { <tr><td data-label="@CatTexts["Fecha / folio"]"><span class="movement-when">@Model.LocalOccurredAt[item.Id].ToString("dd/MM/yyyy HH:mm")</span><br /><a class="movement-folio" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@item.Id.ToString()[..8]</a></td><td data-label="@CatTexts["Tipo / propósito"]"><span class="movement-type @TypeModifier(item.Type)">@TypeLabel(item.Type)</span><span class="movement-purpose">@PurposeLabel(item.Purpose)</span></td><td data-label="@CatTexts["Producto"]">@item.ProductSummary</td><td data-label="@CatTexts["Trayecto"]">@item.Route</td><td data-label="@CatTexts["Responsable"]">@item.ResponsibleName</td><td data-label="@CatTexts["Referencia"]">@if (item.Reference is null) { <span class="movement-muted">@CatTexts["Sin referencia"]</span> } else { @item.Reference }</td><td data-label="@CatTexts["Estado"]">@item.Status</td><td data-label=""><a class="btn btn-outline-primary btn-sm" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@CatTexts["Ver detalle"]</a></td></tr> } }</tbody></table></div> }
  else { <div class="table-responsive analytics-table-card"><table class="table table-hover align-middle report-cards"><thead><tr><th scope="col">@CatTexts["Fecha / folio"]</th><th scope="col">@CatTexts["Tipo"]</th><th scope="col">@CatTexts["Propósito"]</th><th scope="col">@CatTexts["Responsable"]</th><th scope="col">@CatTexts["Detalle de líneas"]</th><th scope="col">@CatTexts["Referencia / notas"]</th><th scope="col"><span class="visually-hidden">@CatTexts["Acciones"]</span></th></tr></thead><tbody>@if (Model.EffectiveResults.Items.Count == 0) { <tr class="report-empty-row"><td colspan="7">@CatTexts["No hay movimientos vigentes con los filtros seleccionados."]</td></tr> } else { @foreach (var item in Model.EffectiveResults.Items) { <tr><td data-label="@CatTexts["Fecha / folio"]"><span class="movement-when">@Model.LocalOccurredAt[item.Id].ToString("dd/MM/yyyy HH:mm")</span><br /><a class="movement-folio" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@item.Id.ToString()[..8]</a></td><td data-label="@CatTexts["Tipo"]"><span class="movement-type @TypeModifier(item.MovementType)">@TypeLabel(item.MovementType)</span></td><td data-label="@CatTexts["Propósito"]">@PurposeLabel(item.Purpose)</td><td data-label="@CatTexts["Responsable"]">@item.ResponsibleName</td><td data-label="@CatTexts["Detalle de líneas"]"><div class="report-lines-full">@foreach (var line in item.Lines) { <div><span class="movement-line-sku">@line.Sku</span><span class="movement-line-quantity">@line.Quantity.ToString("0.####") @line.UnitCode</span><span class="movement-line-route">@(line.SourceLocationCode ?? CatTexts["Sin origen"].Value)<svg class="movement-route-arrow" aria-hidden="true"><use href="#icon-chevron" /></svg>@(line.DestinationLocationCode ?? item.OperationalAreaCode ?? CatTexts["Sin destino"].Value)</span></div> }</div><span class="report-lines-compact">@CatTexts["{0} línea(s)", item.LineCount] · <a asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@CatTexts["Ver detalle"]</a></span></td><td data-label="@CatTexts["Referencia / notas"]">@if (item.Reference is null && item.Notes is null) { <span class="movement-muted">@CatTexts["Sin referencia"]</span> } else { @(item.Reference ?? item.Notes) }</td><td data-label=""><div class="d-flex flex-wrap gap-2">@if (Model.CanGeneratePalletPlate(item)) { <a class="btn btn-outline-success btn-sm" asp-page="/Operations/PalletLabels/Index" asp-route-id="@item.Id">@CatTexts["Generar placa"]</a> }<a class="btn btn-outline-primary btn-sm" asp-page="Details" asp-route-id="@item.Id" asp-route-returnUrl="@returnUrl">@CatTexts["Ver detalle"]</a></div></td></tr> } }</tbody></table></div> }
  @if (Model.TotalPages > 1) { <nav aria-label="@CatTexts["Paginación de movimientos"]"><ul class="pagination justify-content-center"><li class="page-item">@if (Model.PageNumber <= 1) { <span class="page-link">@CatTexts["Anterior"]</span> } else { <a class="page-link" asp-all-route-data="@previousValues" data-movement-page-link="previous">@CatTexts["Anterior"]</a> }</li><li class="page-item disabled"><span class="page-link">@CatTexts["{0} de {1}", Model.PageNumber, Model.TotalPages]</span></li><li class="page-item">@if (Model.PageNumber >= Model.TotalPages) { <span class="page-link">@CatTexts["Siguiente"]</span> } else { <a class="page-link" asp-all-route-data="@nextValues" data-movement-page-link="next">@CatTexts["Siguiente"]</a> }</li></ul></nav> }
</div>

@functions {
    string TypeLabel(InventoryMovementType type) => type switch
    {
        InventoryMovementType.Entry => CatTexts["Entrada"].Value,
        InventoryMovementType.Exit => CatTexts["Salida"].Value,
        InventoryMovementType.Transfer => CatTexts["Transferencia"].Value,
        InventoryMovementType.Adjustment => CatTexts["Ajuste"].Value,
        _ => CatTexts["Movimiento"].Value
    };

    static string TypeModifier(InventoryMovementType type) => type switch
    {
        InventoryMovementType.Entry => "is-entry",
        InventoryMovementType.Exit => "is-exit",
        InventoryMovementType.Transfer => "is-transfer",
        InventoryMovementType.Adjustment => "is-adjustment",
        _ => null
    } ?? string.Empty;

    string PurposeLabel(InventoryMovementPurpose purpose) => purpose switch
    {
        InventoryMovementPurpose.ProductionIssue => CatTexts["Surtimiento WIP"].Value,
        InventoryMovementPurpose.WipWarehouseReturn => CatTexts["Devolución WIP a bodega"].Value,
        InventoryMovementPurpose.WipConsumption => CatTexts["Consumo WIP"].Value,
        InventoryMovementPurpose.WipSupplierReturn => CatTexts["Devolución WIP a proveedor"].Value,
        InventoryMovementPurpose.GeneralExit => CatTexts["Salida general"].Value,
        InventoryMovementPurpose.CycleCountAdjustment => CatTexts["Ajuste por conteo cíclico"].Value,
        InventoryMovementPurpose.DocumentReceipt => CatTexts["Recepción por documento"].Value,
        _ => CatTexts["Estándar"].Value
    };
}
