@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionOrderReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>@CatTexts["Orden"]</th><th>@CatTexts["Producto"]</th><th class="text-end">@CatTexts["Meta"]</th><th class="text-end">@CatTexts["Recibido"]</th><th>@CatTexts["Estado"]</th><th>@CatTexts["Fecha requerida"]</th><th class="text-end">@CatTexts["Alertas"]</th><th></th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr class="@(row.IsOverdue ? "production-row-alert" : null)"><td data-label="@CatTexts["Orden"]"><strong>@row.Number</strong></td><td data-label="@CatTexts["Producto"]"><span class="font-monospace">@row.Sku</span><small>@row.Description</small></td><td data-label="@CatTexts["Meta"]" class="text-end">@row.Target.ToString("0.####") @row.Unit@if (row.OriginalTarget != row.Target) { <small>Original @row.OriginalTarget.ToString("0.####")</small> }</td><td data-label="@CatTexts["Recibido"]" class="text-end"><strong>@row.Received.ToString("0.####") @row.Unit</strong></td><td data-label="@CatTexts["Estado"]"><span class="badge text-bg-secondary">@row.Status</span>@if (row.IsOverdue) { <span class="badge text-bg-danger">@CatTexts["Vencida"]</span> }</td><td data-label="@CatTexts["Fecha requerida"]">@(row.DueDate?.ToString("dd/MM/yyyy") ?? CatTexts["Sin fecha"].Value)</td><td data-label="@CatTexts["Alertas"]" class="text-end">@row.AlertCount</td><td><a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Production/Details" asp-route-id="@row.Id">@CatTexts["Ver orden"]</a></td></tr> }</tbody>
</table>
