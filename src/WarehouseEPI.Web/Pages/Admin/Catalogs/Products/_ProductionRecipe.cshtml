@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.EditModel
@{
    var configuration = Model.Production;
    var recipe = configuration?.ActiveRecipe;
}

<section id="product-production" class="card product-editor-module" aria-labelledby="product-production-heading">
    <div class="card-body p-3 p-md-4">
        <div class="product-editor-module-header">
            <div>
                <span class="product-editor-step">Producción</span>
                <h2 id="product-production-heading" class="h4 mb-1">Ruta y receta</h2>
                <p class="text-body-secondary mb-0">Define los materiales que se transforman en este producto.</p>
            </div>
            @if (recipe is not null)
            {
                <span class="badge text-bg-primary">Receta v@recipe.Version</span>
            }
        </div>

        @if (configuration is null)
        {
            <div class="alert alert-danger" role="alert">No fue posible consultar la configuración de producción.</div>
        }
        else if (!configuration.ProductIsActive)
        {
            <div class="alert alert-warning mb-0" role="status">Activa el producto antes de crear una receta de producción.</div>
        }
        else if (configuration.RouteId is null)
        {
            <div class="product-editor-empty d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div><strong class="d-block">Este producto necesita una ruta de producción.</strong><span>Asigna sus procesos antes de definir materiales.</span></div>
                <a asp-page="/Admin/Production/Routes" asp-route-productId="@Model.Input.Id" class="btn btn-outline-primary">Configurar ruta</a>
            </div>
        }
        else
        {
            <div class="production-product-route mb-3">
                <div><small class="text-body-secondary d-block">Ruta activa</small><strong>@configuration.RouteName</strong></div>
                <ol class="production-product-stages mb-0" aria-label="Etapas de la ruta activa">
                    @foreach (var stage in configuration.Stages)
                    {
                        <li><span>@stage.Sequence</span>@stage.Name</li>
                    }
                </ol>
            </div>

            @if (recipe is not null)
            {
                <div class="alert alert-info" role="status">Los valores actuales están cargados como base. Al guardar se conservará la versión @recipe.Version y se creará la versión @(recipe.Version + 1).</div>
            }

            <form method="post" asp-page-handler="Recipe" asp-route-id="@Model.Input.Id"
                  class="row g-3" data-cycle-plan data-production-recipe data-lookup-url="@Url.Page("/Operations/Lookup")">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger col-12" role="alert" tabindex="-1"></div>
                <div class="col-12 col-lg-4">
                    <label asp-for="Recipe.BaseQuantity" class="form-label fw-semibold">Cantidad base producida</label>
                    <input asp-for="Recipe.BaseQuantity" class="form-control form-control-lg" inputmode="decimal" />
                    <span asp-validation-for="Recipe.BaseQuantity" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <fieldset>
                        <legend class="h6">Materiales y proceso de incorporación</legend>
                        <div class="table-responsive recipe-material-table">
                            <table class="table align-middle mb-0">
                                <thead><tr><th>Material</th><th>Proceso</th><th>Cantidad</th></tr></thead>
                                <tbody>
                                @for (var i = 0; i < Model.Recipe.Lines.Count; i++)
                                {
                                    var selectedMaterial = Model.RecipeMaterials.FirstOrDefault(product => product.Id == Model.Recipe.Lines[i].MaterialProductId);
                                    var resultsId = $"recipe-material-results-{i}";
                                    var feedbackId = $"recipe-material-feedback-{i}";
                                    <tr data-production-recipe-line>
                                        <td class="recipe-material-cell">
                                            <div class="lookup-field" data-cycle-plan-field="product" data-cycle-plan-key="material-@i" data-cycle-plan-label="Material" data-cycle-plan-optional>
                                                <input asp-for="Recipe.Lines[i].MaterialProductId" type="hidden" data-cycle-plan-id />
                                                <div class="input-group input-group-lg">
                                                    <input asp-for="Recipe.Lines[i].MaterialSearch" id="recipe-material-search-@i"
                                                           class="form-control" type="search" autocomplete="off" autocapitalize="characters"
                                                           placeholder="SKU, descripción o código" aria-label="Material @(i + 1)"
                                                           role="combobox" aria-autocomplete="list" aria-expanded="false"
                                                           aria-controls="@resultsId" aria-describedby="@feedbackId" data-cycle-plan-search />
                                                    <button type="button" class="btn btn-outline-secondary" data-cycle-plan-camera
                                                            aria-label="Escanear material @(i + 1) con cámara">
                                                        <svg class="app-icon" aria-hidden="true"><use href="#icon-camera" /></svg>
                                                    </button>
                                                </div>
                                                <div id="@resultsId" class="lookup-results list-group" role="listbox" data-cycle-plan-results></div>
                                                <div class="selected-record @(selectedMaterial is null ? "d-none" : null)" data-cycle-plan-selected>
                                                    <strong data-cycle-plan-selected-title>@selectedMaterial?.Sku</strong>
                                                    <span data-cycle-plan-selected-detail>@selectedMaterial?.Description</span>
                                                    <small data-cycle-plan-selected-meta>@selectedMaterial?.BaseUnit.Code</small>
                                                </div>
                                                @if (selectedMaterial?.IsActive == false)
                                                {
                                                    <div class="small text-danger">Este material está inactivo; reemplázalo antes de guardar.</div>
                                                }
                                                <p id="@feedbackId" class="form-text mb-0" role="status" aria-live="polite" data-cycle-plan-feedback>Escribe para buscar o usa un lector HID.</p>
                                            </div>
                                        </td>
                                        <td>
                                            <select asp-for="Recipe.Lines[i].StageId" class="form-select form-select-lg" data-production-recipe-stage>
                                                <option value="">Selecciona…</option>
                                                @foreach (var stage in configuration.Stages)
                                                {
                                                    <option value="@stage.Id">@stage.Sequence. @stage.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input asp-for="Recipe.Lines[i].Quantity" class="form-control form-control-lg" inputmode="decimal" data-production-recipe-quantity /></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </fieldset>
                </div>
                <div class="col-12 col-lg-8">
                    <label asp-for="Recipe.Reason" class="form-label fw-semibold">Motivo de la nueva versión</label>
                    <input asp-for="Recipe.Reason" class="form-control form-control-lg" autocomplete="off" />
                    <span asp-validation-for="Recipe.Reason" class="text-danger"></span>
                </div>
                <div class="col-12 col-lg-4">
                    <label asp-for="Recipe.Pin" class="form-label fw-semibold">NIP ADMIN</label>
                    <input asp-for="Recipe.Pin" value="" type="password" inputmode="numeric" autocomplete="off" class="form-control form-control-lg" />
                    <span asp-validation-for="Recipe.Pin" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary btn-lg" type="submit">@(recipe is null ? "Crear receta" : "Guardar nueva versión")</button>
                </div>
            </form>
        }
    </div>
</section>
