        @if(unplacedHeat.Length > 0)
        {
            <details class="card card-body mt-3"><summary><strong>@CatTexts["Racks sin colocar en el croquis ({0})", unplacedHeat.Length]</strong></summary><div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Rack</th><th class="text-end">@CatTexts["Operaciones"]</th><th class="text-end">@CatTexts["Ocupación"]</th><th class="text-end">Incidencias</th></tr></thead><tbody>@foreach(var rack in unplacedHeat){<tr data-heatmap-rack-row="@rack.ElementId"><td>@rack.Label</td><td class="text-end" data-heatmap-access>@rack.AccessCount</td><td class="text-end" data-heatmap-occupancy>@rack.OccupiedPositions/@rack.TotalPositions (@rack.OccupancyPercent.ToString("0.##")%)</td><td class="text-end" data-heatmap-incidents>@rack.NegativePositions negativas · @rack.BlockedPositions bloqueadas</td></tr>}</tbody></table></div></details>
        }
