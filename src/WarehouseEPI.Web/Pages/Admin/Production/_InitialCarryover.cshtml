@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> T
@model WarehouseEPI.Web.Pages.Admin.Production.ScheduleModel
@using WarehouseEPI.Core.Entities
@if (Model.Workspace is { } week)
{
    <section data-opening-editor data-totals="true" data-integrated="true" hidden
             data-url="@Url.Page("Schedule", "WorkspaceInitialBalances", new { weekId = week.Id })"
             data-legacy-url="@Url.Page("Schedule", "WorkspaceOpenings", new { weekId = week.Id, weekStart = Model.IsPreparingNew ? week.WeekStart.ToString("yyyy-MM-dd") : null })"
             data-readonly="@(week.Status == ProductionScheduleWeekStatus.Closed ? "true" : "false")">
        <span data-opening-status role="status" aria-live="polite"></span>
    </section>
}
