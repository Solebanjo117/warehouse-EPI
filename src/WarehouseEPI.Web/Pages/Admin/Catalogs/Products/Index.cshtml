@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.IndexModel
@{ ViewData["Title"] = "Productos"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><h1 class="h2 mb-1">Productos</h1><p class="text-body-secondary mb-0">Consulta el catálogo; la edición permanece como una acción administrativa.</p></div><div class="d-flex gap-2"><a asp-page="Import" class="btn btn-outline-primary">Importar Excel</a><a asp-page="Create" class="btn btn-primary">Crear producto</a></div></div>
<div class="row row-cols-2 row-cols-lg-6 g-2 mb-3">@foreach (var metric in new[] { ("Activos", Model.Summary.Active, "text-success"), ("Inactivos", Model.Summary.Inactive, ""), ("Con existencia", Model.Summary.WithBalance, ""), ("Negativos", Model.Summary.Negative, "text-danger"), ("Bajo mínimo", Model.Summary.BelowMinimum, "text-warning"), ("Sin ubicación", Model.Summary.WithoutAssignment, "text-warning") }) { <div class="col"><div class="card card-body h-100 py-2"><small class="text-body-secondary">@metric.Item1</small><strong class="@metric.Item3">@metric.Item2</strong></div></div> }</div>
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-12 col-lg-4"><label for="search" class="form-label">Buscar</label><input id="search" name="search" value="@Model.Search" class="form-control form-control-lg" autofocus placeholder="SKU, descripción, referencia, código o ubicación" /></div><div class="col-6 col-lg-2"><label class="form-label">Estado</label><select name="status" class="form-select"><option value="active">Activos</option><option value="inactive" selected="@(Model.Status == "inactive")">Inactivos</option><option value="all" selected="@(Model.Status == "all")">Todos</option></select></div><div class="col-6 col-lg-2"><label class="form-label">Existencia</label><select name="stock" class="form-select"><option value="all">Todos</option><option value="balance" selected="@(Model.Stock == "balance")">Con saldo</option><option value="empty" selected="@(Model.Stock == "empty")">Sin saldo</option><option value="negative" selected="@(Model.Stock == "negative")">Negativos</option><option value="minimum" selected="@(Model.Stock == "minimum")">Bajo mínimo</option></select></div><div class="col-6 col-lg-2"><label class="form-label">Asignación</label><select name="assignment" class="form-select"><option value="all">Todas</option><option value="assigned" selected="@(Model.Assignment == "assigned")">Asignados</option><option value="unassigned" selected="@(Model.Assignment == "unassigned")">Sin ubicación</option></select></div><div class="col-6 col-lg-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Buscar</button></div></div></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>SKU / producto</th><th>Clasificación</th><th>Existencia</th><th>Ubicaciones</th><th>Estado</th><th></th></tr></thead><tbody>@if (Model.Products.Count == 0) { <tr><td colspan="6" class="text-center text-body-secondary py-4">No hay productos que coincidan.</td></tr> } @foreach (var item in Model.Products) { <tr><td><a asp-page="Details" asp-route-id="@item.Id" class="fw-bold">@item.Sku</a><div>@item.Description</div><small class="text-body-secondary">@(item.ExternalReference ?? "Sin referencia") · @item.Unit · @item.BarcodeCount código(s)</small></td><td>@(item.Type ?? "—") / @(item.Class ?? "—")</td><td class="@(item.IsNegative ? "text-danger" : "")">@item.Quantity.ToString("0.####") @item.Unit<br /><small>Mín. @item.Minimum.ToString("0.####")</small></td><td>@item.LocationCount @if(!item.HasAssignment){<span class="badge text-bg-warning">Sin asignación</span>}</td><td>@if(!item.IsActive){<span class="badge text-bg-secondary">Inactivo</span>} @if(item.IsNegative){<span class="badge text-bg-danger">Negativo</span>} @if(item.IsBelowMinimum){<span class="badge text-bg-warning">Bajo mínimo</span>}</td><td class="text-end"><a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Ficha</a> <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Editar</a></td></tr> }</tbody></table></div>
@if(Model.TotalPages > 1) { <nav class="d-flex justify-content-center gap-2"><a class="btn btn-outline-secondary @(Model.CurrentPage == 1 ? "disabled" : "")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-stock="@Model.Stock" asp-route-assignment="@Model.Assignment" asp-route-pageNumber="@(Model.CurrentPage - 1)">Anterior</a><span class="align-self-center">@Model.CurrentPage de @Model.TotalPages</span><a class="btn btn-outline-secondary @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-stock="@Model.Stock" asp-route-assignment="@Model.Assignment" asp-route-pageNumber="@(Model.CurrentPage + 1)">Siguiente</a></nav> }
