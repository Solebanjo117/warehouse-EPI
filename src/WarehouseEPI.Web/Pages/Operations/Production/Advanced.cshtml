@page
@model WarehouseEPI.Web.Pages.Operations.Production.AdvancedModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.ProductionTexts> ProdTexts
@{ViewData["Title"]=ProdTexts["Producción avanzada"].Value;}
<div class="container-fluid py-3 production-page" data-supply-queue data-signature="@Model.Snapshot.Signature" data-checked-at="@Model.Snapshot.CheckedAt.ToString("O")" data-snapshot-url="@Url.Page(null,"Snapshot",new{Model.Search,Model.Status,Model.ActiveStageId,Model.From,Model.To,Model.AlertsOnly,Model.View})"><header class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><span class="eyebrow">@ProdTexts["Operación"]</span><h1 class="h2 mb-1">@ProdTexts["Producción avanzada"]</h1><p class="text-muted mb-0">@ProdTexts["Escanea o busca una orden, lote de producción o lote terminado."]</p></div><a asp-page="Trace" class="btn btn-outline-primary align-self-start">@ProdTexts["Consultar procedencia"]</a></header>
<button class="btn btn-outline-primary" type="button" data-queue-refresh>@ProdTexts["Actualizar"]</button><p data-supply-live role="status" aria-live="polite"></p><nav class="d-flex flex-wrap gap-2 mb-3" aria-label="@ProdTexts["Órdenes por estado"]">@foreach(var tab in new[]{("active",ProdTexts["Activas"].Value),("drafts",ProdTexts["Borradores"].Value),("closed",ProdTexts["Cerradas"].Value),("cancelled",ProdTexts["Canceladas"].Value)}){<a class="btn btn-outline-primary" asp-route-View="@tab.Item1" aria-current="@(Model.View==tab.Item1?"page":null)">@ProdTexts[tab.Item2]</a>}</nav><form method="get" class="row g-2 mb-4"><input type="hidden" asp-for="View"/><div class="col-12 col-lg-4"><label for="production-search" class="form-label">@ProdTexts["Folio, lote, referencia o SKU"]</label><input id="production-search" name="Search" value="@Model.Search" class="form-control form-control-lg" type="search" autocomplete="off" autocapitalize="characters" autofocus/></div><div class="col-6 col-lg-2"><label asp-for="Status" class="form-label">@ProdTexts["Estado"]</label><select asp-for="Status" class="form-select form-select-lg"><option value="">@ProdTexts["Todos"]</option>@foreach(var s in Enum.GetValues<WarehouseEPI.Core.Entities.ProductionWorkOrderStatus>()){<option value="@s">@ProdTexts[WarehouseEPI.Infrastructure.Production.ProductionStateLabels.Label(s)]</option>}</select></div><div class="col-6 col-lg-2"><label asp-for="ActiveStageId" class="form-label">@ProdTexts["Proceso con pendientes"]</label><select asp-for="ActiveStageId" class="form-select form-select-lg"><option value="">@ProdTexts["Todos"]</option>@foreach(var s in Model.Stages.Where(x=>x.IsActive)){<option value="@s.Id">@s.Name</option>}</select></div><div class="col-6 col-lg-2"><label asp-for="From" class="form-label">@ProdTexts["Desde"]</label><input asp-for="From" class="form-control" type="date"/></div><div class="col-6 col-lg-2"><label asp-for="To" class="form-label">@ProdTexts["Hasta"]</label><input asp-for="To" class="form-control" type="date"/></div><div class="col-8 col-lg-3 d-flex align-items-center"><div class="form-check"><input asp-for="AlertsOnly" class="form-check-input"/><label asp-for="AlertsOnly" class="form-check-label">@ProdTexts["Solo con alertas"]</label></div></div><div class="col-4 col-lg-2"><button class="btn btn-primary btn-lg w-100">@ProdTexts["Buscar"]</button></div></form>
@if(Model.Result.Items.Count==0){<div class="alert alert-info">@ProdTexts["No hay órdenes con esos filtros. Revisa el folio o solicita que ADMIN libere la orden."]</div>}else{<div class="row g-3">@foreach(var x in Model.Result.Items){var pct=x.Target>0?Math.Min(100,x.Received*100/x.Target):0;<div class="col-12 col-lg-6"><article class="card h-100"><div class="card-body d-flex justify-content-between gap-3"><div class="flex-grow-1"><span class="badge text-bg-secondary">@ProdTexts[WarehouseEPI.Infrastructure.Production.ProductionStateLabels.Label(x.Status)]</span><span class="badge text-bg-secondary ms-1">@(x.Priority==WarehouseEPI.Core.Entities.ProductionSupplyPriority.Urgent?ProdTexts["Urgente"].Value:ProdTexts["Normal"].Value)</span>@if(x.AlertCount>0){<span class="badge text-bg-warning">@ProdTexts["{0} alertas", x.AlertCount]</span>}<p class="small mt-2 mb-0">@ProdTexts["Fecha requerida {0}", x.DueDate?.ToString("dd/MM/yyyy") ?? ProdTexts["Sin fecha"].Value]</p><p class="small">@x.Attention</p><h2 class="h5 mt-2 mb-1">@x.Number</h2><strong>@x.Sku</strong> <span>@x.Description</span>@if(x.UsesBatchTraceability){<small class="d-block text-body-secondary">@ProdTexts["Seguimiento por lote · {0}", x.ActiveProcess ?? ProdTexts["Sin iniciar"].Value]</small>}<div class="progress mt-3" role="progressbar" aria-label="@ProdTexts["Recibido en bodega"]"><div class="progress-bar" style="width:@pct%"></div></div><p class="mb-0 mt-1">@ProdTexts["Recibido:"] <strong>@ProdTexts["{0} de {1} {2}", x.Received.ToString("0.####"), x.Target.ToString("0.####"), x.Unit]</strong></p></div><div><a asp-page="Work" asp-route-id="@x.Id" class="btn btn-primary">@x.NextAction</a></div></div></article></div>}</div><nav class="d-flex justify-content-between align-items-center mt-4" aria-label="@ProdTexts["Paginación"]"><a class="btn btn-outline-primary @(Model.Result.Page<=1?"disabled":null)" asp-route-View="@Model.View" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-ActiveStageId="@Model.ActiveStageId" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-AlertsOnly="@Model.AlertsOnly" asp-route-PageNumber="@(Model.Result.Page-1)">@ProdTexts["Anterior"]</a><span>@ProdTexts["Página {0} de {1} · {2} órdenes", Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount]</span><a class="btn btn-outline-primary @(Model.Result.Page>=Model.Result.TotalPages?"disabled":null)" asp-route-View="@Model.View" asp-route-Search="@Model.Search" asp-route-Status="@Model.Status" asp-route-ActiveStageId="@Model.ActiveStageId" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-AlertsOnly="@Model.AlertsOnly" asp-route-PageNumber="@(Model.Result.Page+1)">@ProdTexts["Siguiente"]</a></nav>}</div>

@section Scripts { <script src="~/js/production-supply-queue.js" asp-append-version="true"></script> }

@section Styles { <link rel="stylesheet" href="~/css/production-workspace.css" asp-append-version="true"/> }
