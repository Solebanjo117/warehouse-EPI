@page
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.ReviewModel
@{ ViewData["Title"]="Revisión de conteo"; var attempt=Model.Attempt; }
<div class="inventory-analytics"><header class="inventory-page-header"><div><a asp-page="Details" asp-route-id="@Model.Campaign!.Id" class="small text-decoration-none">← Campaña</a><h1 class="h2 mt-2">Revisión · @Model.Location!.LocationCode</h1><p class="text-muted mb-0">El saldo esperado solo aparece después de enviar el conteo.</p></div></header>@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}@if(attempt is null){<div class="alert alert-secondary">Aún no hay un intento para revisar.</div>}else{<div class="table-responsive analytics-table"><table class="table align-middle"><thead><tr><th>Producto</th><th>Esperado</th><th>Contado</th><th>Diferencia</th></tr></thead><tbody>@foreach(var entry in attempt.Entries){<tr><td><strong>@entry.Sku</strong><small class="d-block text-body-secondary">@entry.UnitCode</small></td><td>@entry.ExpectedQuantity?.ToString("0.####")</td><td>@entry.CountedQuantity?.ToString("0.####")</td><td class="@(entry.Difference != 0 ? "text-danger fw-semibold" : null)">@entry.Difference?.ToString("+0.####;-0.####;0")</td></tr>}</tbody></table></div><div class="row g-3 mt-2"><div class="col-md-6"><form method="post" asp-page-handler="Recount" class="analytics-filter-card"><input type="hidden" name="id" value="@Model.Campaign.Id"/><input type="hidden" name="locationId" value="@Model.Location.Id"/><label asp-for="Pin" class="form-label">NIP</label><input asp-for="Pin" class="form-control" type="password" inputmode="numeric" autocomplete="off" required/><label asp-for="Notes" class="form-label mt-2">Motivo del reconteo</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea><button class="btn btn-outline-warning mt-3">Solicitar reconteo</button></form></div><div class="col-md-6"><form method="post" asp-page-handler="Approve" class="analytics-filter-card"><input type="hidden" name="id" value="@Model.Campaign.Id"/><input type="hidden" name="locationId" value="@Model.Location.Id"/><input asp-for="OperationId" type="hidden" value="@Guid.NewGuid()"/>@if(Model.SharingConflicts.Count != 0){<fieldset class="alert alert-warning"><legend class="h6">Confirmar pallet compartido</legend>@foreach(var conflict in Model.SharingConflicts){<label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="SharedApprovals" value="@conflict.ProductId|@conflict.LocationId" required/><span class="form-check-label"><strong>@conflict.ProductSku</strong> compartirá @conflict.LocationCode con @string.Join(", ", conflict.ExistingProductSkus)</span></label>}</fieldset>}<label asp-for="Pin" class="form-label">NIP de autorización</label><input asp-for="Pin" value="" class="form-control" type="password" inputmode="numeric" autocomplete="off" required/><label asp-for="Notes" class="form-label mt-2">Motivo</label><textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ajuste autorizado por conteo cíclico"></textarea><button class="btn btn-primary mt-3">Autorizar ajuste</button></form></div></div>}</div>
