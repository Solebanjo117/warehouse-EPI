@page
@model WarehouseEPI.Web.Pages.Admin.System.IndexModel
@{
    ViewData["Title"] = "Estado del sistema";
    var maxActivity = Model.Status.Activity.Count == 0 ? 0 : Model.Status.Activity.Max(item => item.Count);
    var totalActivity = Model.Status.Activity.Sum(item => item.Count);
    var buildSeparator = Model.Status.Version.IndexOf('+');
    var versionNumber = buildSeparator > 0 ? Model.Status.Version[..buildSeparator] : Model.Status.Version;
    var buildIdentifier = buildSeparator > 0 ? Model.Status.Version : null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/system-status.css" asp-append-version="true" />
}

<div class="sys-board">
    <header class="sys-header">
        <div>
            <span class="eyebrow">Diagnóstico local</span>
            <h1 class="h2 mb-1">Estado del sistema</h1>
            <p>Resumen local de salud y actividad. No contiene datos operativos ni credenciales.</p>
        </div>
        <p class="sys-checked mb-0">
            <span>Última comprobación</span>
            <time datetime="@Model.Status.CheckedAt.ToString("o")">@Model.Status.CheckedAt.LocalDateTime.ToString("g")</time>
        </p>
    </header>

    <ul class="sys-vitals" aria-label="Signos vitales del servidor">
        <li class="sys-vital @(Model.Status.DatabaseHealthy ? "is-up" : "is-down")">
            <span class="sys-vital-label">Base de datos</span>
            <span class="sys-readout">
                <span class="sys-dot" aria-hidden="true"></span>
                @(Model.Status.DatabaseHealthy ? "Disponible" : "No disponible")
            </span>
            <span class="sys-vital-note">
                @if (Model.Status.DatabaseLatencyMilliseconds is long latency)
                {
                    @($"Respuesta en {latency} ms")
                }
                else if (Model.Status.DatabaseHealthy)
                {
                    @:Sin medición de latencia en esta comprobación
                }
                else
                {
                    @:Revisa PostgreSQL en la laptop servidor antes de operar
                }
            </span>
        </li>
        <li class="sys-vital is-steady">
            <span class="sys-vital-label">Aplicación</span>
            <span class="sys-readout">
                <time datetime="@Model.Status.StartedAt.ToString("o")">@Model.Status.StartedAt.LocalDateTime.ToString("g")</time>
            </span>
            <span class="sys-vital-note">Activa sin reinicios desde esa hora</span>
        </li>
        <li class="sys-vital is-steady">
            <span class="sys-vital-label">Versión</span>
            <span class="sys-readout">@versionNumber</span>
            <span class="sys-vital-note">Compilación en ejecución</span>
            @if (buildIdentifier is not null)
            {
                <span class="sys-build">@buildIdentifier</span>
            }
        </li>
    </ul>

    <section aria-labelledby="sys-activity-title">
        <div class="sys-section-head">
            <h2 class="h4" id="sys-activity-title">Movimientos de las últimas 24 horas</h2>
            @if (Model.Status.Activity.Count > 0)
            {
                <span class="sys-tally">@totalActivity en total</span>
            }
        </div>
        @if (Model.Status.Activity.Count == 0)
        {
            <div class="sys-empty">
                <strong>Sin movimientos en las últimas 24 horas.</strong>
                <span>Cuando se registre actividad, aparecerá aquí.</span>
            </div>
        }
        else
        {
            <ul class="sys-activity">
                @foreach (var item in Model.Status.Activity)
                {
                    var share = maxActivity == 0 ? 0 : (int)Math.Round(item.Count * 100d / maxActivity);
                    <li class="sys-activity-row">
                        <span class="sys-activity-type">@item.Type</span>
                        <span class="sys-bar" aria-hidden="true"><span style="@($"--sys-share: {share}%")"></span></span>
                        <span class="sys-count">@item.Count</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section aria-labelledby="sys-failures-title">
        <div class="sys-section-head">
            <h2 class="h4" id="sys-failures-title">Fallos recientes sanitizados</h2>
            @if (Model.Status.RecentFailures.Count > 0)
            {
                <span class="sys-tally">@Model.Status.RecentFailures.Count registrados</span>
            }
        </div>
        @if (Model.Status.RecentFailures.Count == 0)
        {
            <div class="sys-empty">
                <strong>Sin fallos de servidor recientes.</strong>
                <span>Aquí aparecerá la fecha, la categoría y la correlación de cada fallo, nunca su contenido.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm sys-table">
                    <thead>
                        <tr>
                            <th scope="col">Fecha</th>
                            <th scope="col">Categoría</th>
                            <th scope="col">HTTP</th>
                            <th scope="col">Correlación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var failure in Model.Status.RecentFailures)
                        {
                            <tr>
                                <td><time datetime="@failure.OccurredAt.ToString("o")">@failure.OccurredAt.LocalDateTime.ToString("g")</time></td>
                                <td>@failure.Category</td>
                                <td><span class="sys-status-code">@failure.StatusCode</span></td>
                                <td><code>@failure.CorrelationId</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
