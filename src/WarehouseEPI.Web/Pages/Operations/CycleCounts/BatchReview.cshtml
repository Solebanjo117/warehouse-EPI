@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.BatchReviewModel
@using WarehouseEPI.Core.Entities
@{ ViewData["Title"]="Revisión final"; }
<div class="inventory-analytics"><header class="inventory-page-header"><div><a asp-page="Details" asp-route-id="@Model.Campaign!.Id" class="small text-decoration-none">← Campaña</a><h1 class="h2 mt-2">Revisión final de diferencias</h1><p class="text-muted mb-0">Autoriza los ajustes vigentes o solicita reconteo. El NIP se pide una sola vez.</p></div></header>@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}<form method="post" class="analytics-filter-card"><input asp-for="Input.OperationId" type="hidden" value="@(Model.Input.OperationId == Guid.Empty ? Guid.NewGuid() : Model.Input.OperationId)"/>@for(var index=0;index<Model.Decisions.Count;index++){var item=Model.Decisions[index];<section class="border rounded p-3 mb-3"><input name="Input.Decisions[@index].LocationId" type="hidden" value="@item.LocationId"/><input name="Input.Decisions[@index].OperationId" type="hidden" value="@Model.DecisionOperationId(index)"/><h2 class="h5">@item.LocationCode</h2><ul class="mb-3">@foreach(var entry in item.Entries){<li><strong>@entry.Sku</strong>: @entry.ExpectedQuantity?.ToString("0.####") → @entry.CountedQuantity?.ToString("0.####") (@entry.Difference?.ToString("+0.####;-0.####;0"))</li>}</ul><div class="row g-2"><div class="col-md-4"><label class="form-label">Decisión</label><select name="Input.Decisions[@index].Decision" class="form-select"><option value="Approve">Aprobar ajuste</option><option value="Recount">Solicitar reconteo</option></select></div><div class="col-md-4"><label class="form-label">Causa</label><select name="Input.Decisions[@index].Reason" class="form-select"><option value="UnrecordedEntry">Entrada no registrada</option><option value="UnrecordedExit">Salida no registrada</option><option value="WrongLocation">Producto en ubicación incorrecta</option><option value="UnrecordedDamageOrScrap">Daño o merma no registrada</option><option value="CaptureOrUnitError">Error de captura o unidad</option><option value="Unknown">Causa desconocida</option><option value="Other">Otro</option></select></div><div class="col-md-4"><label class="form-label">Observación</label><input name="Input.Decisions[@index].Notes" class="form-control" maxlength="500"/></div></div></section>}<label asp-for="Input.Pin" class="form-label">NIP de autorización</label><input asp-for="Input.Pin" class="form-control" type="password" inputmode="numeric" autocomplete="off" required/><button class="btn btn-primary mt-3">Aplicar revisión final</button></form></div>
