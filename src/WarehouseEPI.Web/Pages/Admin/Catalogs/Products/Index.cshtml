@page
@model WarehouseEPI.Web.Pages.Admin.Catalogs.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<header class="product-catalog-header mb-3">
    <div>
        <span class="product-catalog-eyebrow">Catálogo</span>
        <h1 class="h2 mb-1">Productos</h1>
        <p class="text-body-secondary mb-0">Consulta el catálogo; la edición permanece como una acción administrativa.</p>
    </div>
    <div class="product-catalog-header-actions">
        <a asp-page="Import" class="btn btn-outline-primary">Importar Excel</a>
        <a asp-page="Create" class="btn btn-primary">Crear producto</a>
    </div>
</header>

<nav class="product-catalog-metrics mb-3" aria-label="Filtros rápidos del catálogo">
    <a asp-route-search="@Model.Search" asp-route-unitId="@Model.UnitId" asp-route-typeId="@Model.TypeId" asp-route-classId="@Model.ClassId" asp-route-status="active" asp-route-stock="all" asp-route-assignment="all" asp-route-pageNumber="1"
       class="product-catalog-metric metric-success @(Model.QuickFilter == "active" ? "is-active" : null)"
       aria-current="@(Model.QuickFilter == "active" ? "true" : null)">
        <span>Activos</span><strong>@Model.Summary.Active</strong><small>Disponibles en catálogo</small>
    </a>
    <a asp-route-search="@Model.Search" asp-route-unitId="@Model.UnitId" asp-route-typeId="@Model.TypeId" asp-route-classId="@Model.ClassId" asp-route-status="inactive" asp-route-stock="all" asp-route-assignment="all" asp-route-pageNumber="1"
       class="product-catalog-metric metric-secondary @(Model.QuickFilter == "inactive" ? "is-active" : null)"
       aria-current="@(Model.QuickFilter == "inactive" ? "true" : null)">
        <span>Inactivos</span><strong>@Model.Summary.Inactive</strong><small>Fuera de operación</small>
    </a>
    <a asp-route-search="@Model.Search" asp-route-unitId="@Model.UnitId" asp-route-typeId="@Model.TypeId" asp-route-classId="@Model.ClassId" asp-route-status="active" asp-route-stock="balance" asp-route-assignment="all" asp-route-pageNumber="1"
       class="product-catalog-metric metric-primary @(Model.QuickFilter == "balance" ? "is-active" : null)"
       aria-current="@(Model.QuickFilter == "balance" ? "true" : null)">
        <span>Con existencia</span><strong>@Model.Summary.WithBalance</strong><small>Saldo distinto de cero</small>
    </a>
    <a asp-route-search="@Model.Search" asp-route-unitId="@Model.UnitId" asp-route-typeId="@Model.TypeId" asp-route-classId="@Model.ClassId" asp-route-status="active" asp-route-stock="negative" asp-route-assignment="all" asp-route-pageNumber="1"
       class="product-catalog-metric metric-danger @(Model.QuickFilter == "negative" ? "is-active" : null)"
       aria-current="@(Model.QuickFilter == "negative" ? "true" : null)">
        <span>Negativos</span><strong>@Model.Summary.Negative</strong><small>Requieren revisión</small>
    </a>
    <a asp-route-search="@Model.Search" asp-route-unitId="@Model.UnitId" asp-route-typeId="@Model.TypeId" asp-route-classId="@Model.ClassId" asp-route-status="active" asp-route-stock="minimum" asp-route-assignment="all" asp-route-pageNumber="1"
       class="product-catalog-metric metric-warning @(Model.QuickFilter == "minimum" ? "is-active" : null)"
       aria-current="@(Model.QuickFilter == "minimum" ? "true" : null)">
        <span>Bajo mínimo</span><strong>@Model.Summary.BelowMinimum</strong><small>Saldo menor al mínimo</small>
    </a>
    <a asp-route-search="@Model.Search" asp-route-unitId="@Model.UnitId" asp-route-typeId="@Model.TypeId" asp-route-classId="@Model.ClassId" asp-route-status="active" asp-route-stock="all" asp-route-assignment="unassigned" asp-route-pageNumber="1"
       class="product-catalog-metric metric-warning @(Model.QuickFilter == "unassigned" ? "is-active" : null)"
       aria-current="@(Model.QuickFilter == "unassigned" ? "true" : null)">
        <span>Sin ubicación</span><strong>@Model.Summary.WithoutAssignment</strong><small>Sin asignación activa</small>
    </a>
</nav>

<form method="get" class="product-catalog-filters mb-3" role="search">
    <div class="product-catalog-filter-grid">
        <div class="product-catalog-search">
            <label for="search" class="form-label">Buscar producto</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" autofocus
                   placeholder="SKU, descripción, referencia o ubicación" />
        </div>
        <div>
            <label for="status" class="form-label">Estado</label>
            <select id="status" name="status" class="form-select">
                <option value="active">Activos</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactivos</option>
                <option value="all" selected="@(Model.Status == "all")">Todos</option>
            </select>
        </div>
        <div>
            <label for="stock" class="form-label">Existencia</label>
            <select id="stock" name="stock" class="form-select">
                <option value="all">Todos</option>
                <option value="balance" selected="@(Model.Stock == "balance")">Con saldo</option>
                <option value="empty" selected="@(Model.Stock == "empty")">Sin saldo</option>
                <option value="negative" selected="@(Model.Stock == "negative")">Negativos</option>
                <option value="minimum" selected="@(Model.Stock == "minimum")">Bajo mínimo</option>
            </select>
        </div>
        <div>
            <label for="assignment" class="form-label">Asignación</label>
            <select id="assignment" name="assignment" class="form-select">
                <option value="all">Todas</option>
                <option value="assigned" selected="@(Model.Assignment == "assigned")">Asignados</option>
                <option value="unassigned" selected="@(Model.Assignment == "unassigned")">Sin ubicación</option>
            </select>
        </div>
    </div>

    <details class="product-catalog-advanced" open="@Model.HasCatalogFilters">
        <summary class="product-catalog-advanced-toggle">
            Filtros de catálogo
            @if (Model.CatalogFilterCount > 0)
            {
                <span class="badge text-bg-primary">@Model.CatalogFilterCount</span>
            }
        </summary>
        <div class="product-catalog-filter-grid product-catalog-filter-grid-advanced">
            <div>
                <label for="unitId" class="form-label">Unidad base</label>
                <select id="unitId" name="unitId" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var option in Model.UnitOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.UnitId?.ToString())">@option.Text</option>
                    }
                </select>
            </div>
            <div>
                <label for="typeId" class="form-label">Tipo</label>
                <select id="typeId" name="typeId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var option in Model.TypeOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.TypeId?.ToString())">@option.Text</option>
                    }
                </select>
            </div>
            <div>
                <label for="classId" class="form-label">Clase</label>
                <select id="classId" name="classId" class="form-select">
                    <option value="">Todas</option>
                    @foreach (var option in Model.ClassOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.ClassId?.ToString())">@option.Text</option>
                    }
                </select>
            </div>
        </div>
    </details>

    <div class="product-catalog-filter-actions">
        <button class="btn btn-primary" type="submit">Buscar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Limpiar filtros</a>
    </div>
</form>

<div class="product-catalog-results-bar mb-3" role="status">
    <div>
        <strong>@Model.TotalResults @(Model.TotalResults == 1 ? "producto" : "productos")</strong>
        @if (Model.TotalResults > 0)
        {
            <span class="text-body-secondary">Mostrando @Model.FirstResult–@Model.LastResult</span>
        }
    </div>
    <div class="product-catalog-active-filters" aria-label="Filtros activos">
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="product-catalog-filter-chip" asp-all-route-data="@RouteValues(("search", null))">
                <span class="product-catalog-chip-label">Búsqueda: “@Model.Search”</span>
                <span class="product-catalog-chip-remove" aria-hidden="true">&times;</span>
                <span class="visually-hidden">Quitar el filtro de búsqueda</span>
            </a>
        }
        @if (Model.Status == "active")
        {
            <span class="product-catalog-filter-chip is-static">Activos</span>
        }
        else
        {
            <a class="product-catalog-filter-chip" asp-all-route-data="@RouteValues(("status", "active"))">
                <span class="product-catalog-chip-label">@(Model.Status == "inactive" ? "Inactivos" : "Todos los estados")</span>
                <span class="product-catalog-chip-remove" aria-hidden="true">&times;</span>
                <span class="visually-hidden">Volver a productos activos</span>
            </a>
        }
        @if (Model.Stock != "all")
        {
            <a class="product-catalog-filter-chip" asp-all-route-data="@RouteValues(("stock", "all"))">
                <span class="product-catalog-chip-label">@(Model.Stock switch { "balance" => "Con saldo", "empty" => "Sin saldo", "negative" => "Negativos", _ => "Bajo mínimo" })</span>
                <span class="product-catalog-chip-remove" aria-hidden="true">&times;</span>
                <span class="visually-hidden">Quitar el filtro de existencia</span>
            </a>
        }
        @if (Model.Assignment != "all")
        {
            <a class="product-catalog-filter-chip" asp-all-route-data="@RouteValues(("assignment", "all"))">
                <span class="product-catalog-chip-label">@(Model.Assignment == "assigned" ? "Asignados" : "Sin ubicación")</span>
                <span class="product-catalog-chip-remove" aria-hidden="true">&times;</span>
                <span class="visually-hidden">Quitar el filtro de asignación</span>
            </a>
        }
        @if (Model.UnitLabel is not null)
        {
            <a class="product-catalog-filter-chip" asp-all-route-data="@RouteValues(("unitId", null))">
                <span class="product-catalog-chip-label">Unidad: @Model.UnitLabel</span>
                <span class="product-catalog-chip-remove" aria-hidden="true">&times;</span>
                <span class="visually-hidden">Quitar el filtro de unidad</span>
            </a>
        }
        @if (Model.TypeLabel is not null)
        {
            <a class="product-catalog-filter-chip" asp-all-route-data="@RouteValues(("typeId", null))">
                <span class="product-catalog-chip-label">Tipo: @Model.TypeLabel</span>
                <span class="product-catalog-chip-remove" aria-hidden="true">&times;</span>
                <span class="visually-hidden">Quitar el filtro de tipo</span>
            </a>
        }
        @if (Model.ClassLabel is not null)
        {
            <a class="product-catalog-filter-chip" asp-all-route-data="@RouteValues(("classId", null))">
                <span class="product-catalog-chip-label">Clase: @Model.ClassLabel</span>
                <span class="product-catalog-chip-remove" aria-hidden="true">&times;</span>
                <span class="visually-hidden">Quitar el filtro de clase</span>
            </a>
        }
        @if (Model.HasActiveFilters)
        {
            <a class="product-catalog-filter-chip is-clear" asp-page="Index">Limpiar todo</a>
        }
    </div>
</div>

@if (Model.Products.Count == 0)
{
    <section class="product-catalog-empty" aria-labelledby="empty-products-title">
        @if (Model.HasActiveFilters)
        {
            <h2 id="empty-products-title" class="h5 mb-0">No hay productos que coincidan</h2>
            <p class="mb-0">Ningún producto cumple los filtros aplicados. Quita alguno o amplía la búsqueda al catálogo completo.</p>
            <div class="product-catalog-empty-actions">
                <a asp-page="Index" class="btn btn-outline-primary">Limpiar filtros</a>
                <a class="btn btn-outline-secondary" asp-all-route-data="@RouteValues(("status", "all"), ("stock", "all"), ("assignment", "all"))">Buscar en todos los estados</a>
            </div>
        }
        else
        {
            <h2 id="empty-products-title" class="h5 mb-0">El catálogo está vacío</h2>
            <p class="mb-0">Importa el archivo de productos o crea el primer SKU para comenzar.</p>
            <div class="product-catalog-empty-actions">
                <a asp-page="Import" class="btn btn-outline-primary">Importar Excel</a>
                <a asp-page="Create" class="btn btn-primary">Crear producto</a>
            </div>
        }
    </section>
}
else
{
    <div class="product-catalog-table d-none d-lg-block">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Catálogo de productos filtrado</caption>
            <thead><tr><th scope="col">Producto</th><th scope="col" class="text-end">Existencia</th><th scope="col" class="text-end">Ubicaciones</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr></thead>
            <tbody>
                @foreach (var item in Model.Products)
                {
                    <tr>
                        <td class="product-catalog-product-cell">
                            <a asp-page="Details" asp-route-id="@item.Id" class="product-catalog-sku">@item.Sku</a>
                            <p class="product-catalog-description mb-1">@(item.Description ?? "Sin descripción")</p>
                            <div class="product-catalog-meta"><span>@(item.ExternalReference ?? "Sin referencia")</span><span>@item.Unit</span><span>@(item.Type ?? "Sin tipo") / @(item.Class ?? "Sin clase")</span></div>
                        </td>
                        <td class="product-catalog-stock text-end @(item.IsNegative ? "text-danger" : null)"><strong>@item.Quantity.ToString("0.####") @item.Unit</strong><small>Mínimo @item.Minimum.ToString("0.####")</small></td>
                        <td class="product-catalog-count text-end">
                            <strong>@item.LocationCount</strong><small class="d-block text-body-secondary">con saldo</small>
                            @if (!item.HasAssignment) { <span class="badge text-bg-warning mt-1">Sin asignación</span> }
                        </td>
                        <td>
                            <div class="product-catalog-statuses">
                                @foreach (var badge in StatusBadges(item)) { <span class="badge @badge.Css">@badge.Text</span> }
                            </div>
                        </td>
                        <td><div class="product-catalog-row-actions"><a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Ficha</a><a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Editar</a></div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="product-catalog-card-list d-lg-none">
        @foreach (var item in Model.Products)
        {
            <article class="product-catalog-card @RowState(item)">
                <header>
                    <div><a asp-page="Details" asp-route-id="@item.Id" class="product-catalog-sku product-catalog-card-link">@item.Sku</a><p class="product-catalog-description mb-0">@(item.Description ?? "Sin descripción")</p></div>
                    <div class="product-catalog-statuses">
                        @foreach (var badge in StatusBadges(item)) { <span class="badge @badge.Css">@badge.Text</span> }
                    </div>
                </header>
                <div class="product-catalog-meta"><span>@(item.ExternalReference ?? "Sin referencia")</span><span>@item.Unit</span><span>@(item.Type ?? "Sin tipo") / @(item.Class ?? "Sin clase")</span></div>
                <dl class="product-catalog-card-facts">
                    <div><dt>Existencia</dt><dd class="@(item.IsNegative ? "text-danger" : null)">@item.Quantity.ToString("0.####") @item.Unit</dd><small>Mínimo @item.Minimum.ToString("0.####")</small></div>
                    <div><dt>Ubicaciones</dt><dd>@item.LocationCount con saldo</dd>@if (!item.HasAssignment) { <small class="text-warning-emphasis">Sin asignación activa</small> }</div>
                </dl>
                <footer><a asp-page="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Ficha</a><a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Editar</a></footer>
            </article>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="product-catalog-pagination mt-4" aria-label="Paginación de productos">
        <ul class="pagination mb-0 flex-wrap justify-content-center">
            <li class="page-item page-nav @(Model.CurrentPage <= 1 ? "disabled" : null)"><a class="page-link" asp-all-route-data="@RouteValues(("pageNumber", "1"))">Primera</a></li>
            <li class="page-item page-nav @(Model.CurrentPage <= 1 ? "disabled" : null)"><a class="page-link" asp-all-route-data="@RouteValues(("pageNumber", (Model.CurrentPage - 1).ToString()))">Anterior</a></li>
            @foreach (var pageNumber in Model.VisiblePages)
            {
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : null)"><a class="page-link" asp-all-route-data="@RouteValues(("pageNumber", pageNumber.ToString()))" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a></li>
            }
            <li class="page-item page-nav @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-all-route-data="@RouteValues(("pageNumber", (Model.CurrentPage + 1).ToString()))">Siguiente</a></li>
            <li class="page-item page-nav @(Model.CurrentPage >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-all-route-data="@RouteValues(("pageNumber", Model.TotalPages.ToString()))">Última</a></li>
        </ul>
        <p class="product-catalog-pagination-hint mb-0">Página @Model.CurrentPage de @Model.TotalPages · @Model.TotalResults @(Model.TotalResults == 1 ? "producto" : "productos")</p>
    </nav>
}

@functions {
    private Dictionary<string, string?> RouteValues(params (string Key, string? Value)[] overrides)
    {
        var values = new Dictionary<string, string?>(StringComparer.Ordinal)
        {
            ["search"] = Model.Search,
            ["status"] = Model.Status,
            ["stock"] = Model.Stock,
            ["assignment"] = Model.Assignment,
            ["unitId"] = Model.UnitId?.ToString(),
            ["typeId"] = Model.TypeId?.ToString(),
            ["classId"] = Model.ClassId?.ToString(),
            ["pageNumber"] = "1"
        };

        foreach (var (key, value) in overrides)
        {
            values[key] = value;
        }

        return values.Where(entry => !string.IsNullOrEmpty(entry.Value)).ToDictionary(entry => entry.Key, entry => entry.Value, StringComparer.Ordinal);
    }

    private static IReadOnlyList<(string Css, string Text)> StatusBadges(IndexModel.ProductRow item)
    {
        var badges = new List<(string Css, string Text)>();
        if (!item.IsActive) { badges.Add(("text-bg-secondary", "Inactivo")); }
        if (item.IsNegative) { badges.Add(("text-bg-danger", "Negativo")); }
        else if (item.IsBelowMinimum) { badges.Add(("text-bg-warning", "Bajo mínimo")); }
        if (badges.Count == 0) { badges.Add(("text-bg-success", "Activo")); }
        return badges;
    }

    private static string? RowState(IndexModel.ProductRow item) =>
        !item.IsActive ? "is-inactive" : item.IsNegative ? "is-negative" : item.IsBelowMinimum ? "is-warning" : null;
}
