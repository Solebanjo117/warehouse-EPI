@model WarehouseEPI.Web.Pages.Locations.Rack.RackPrintPageModel
@{
    ViewData["Title"] = $"Hoja del rack {Model.RackCode}";
}

<div class="rack-sheet-actions no-print">
    <button type="button" class="btn btn-primary btn-lg" data-print-page>Imprimir hoja</button>
    <a asp-page="@(Model.IsAdministrativeView ? "/Admin/Catalogs/Locations/Index" : "/Locations/Index")" asp-route-viewMode="map" class="btn btn-outline-secondary btn-lg">Volver al croquis</a>
</div>

<div class="rack-sheet-desk">
    <main class="rack-sheet">
        <header class="rack-sheet-header">
            <div class="rack-sheet-identity">
                <span class="rack-sheet-brand">Warehouse EPI</span>
                <span class="rack-sheet-eyebrow">Hoja de verificación de rack</span>
            </div>
            <h1 class="rack-sheet-code"><span>Rack</span>@Model.RackCode</h1>
            <p class="rack-sheet-meta">@Model.PositionCount posiciones · @Model.OccupiedCount con saldo · @Model.ProductCount productos · generada el <time datetime="@Model.GeneratedAt.ToString("O")">@Model.GeneratedAt.ToString("dd/MM/yyyy HH:mm")</time></p>
        </header>

        @* El bastidor repite el alzado del rack visto desde el pasillo: 7-8-9 arriba,
           1-2-3 al ras del suelo. Papel, pantalla y acero se leen igual. *@
        <section class="rack-sheet-frame" aria-label="Posiciones del rack @Model.RackCode">
            @foreach (var palletNumber in RackPrintPageModel.KeypadOrder)
            {
                var position = Model.Positions.FirstOrDefault(item => item.PalletNumber == palletNumber);
                if (position is null)
                {
                    <article class="sheet-cell is-missing" aria-label="Pallet @palletNumber, posición inexistente">
                        <span class="sheet-pallet">@palletNumber</span>
                        <span class="sheet-cell-note">Sin posición</span>
                    </article>
                }
                else
                {
                    <article class="sheet-cell @(position.HasIssue ? "is-flagged" : "")">
                        <header class="sheet-cell-head">
                            <span class="sheet-pallet">@position.PalletNumber</span>
                            <div class="sheet-cell-id">
                                <h2>@position.Code</h2>
                                <span class="sheet-cell-state">@position.OperationalState</span>
                            </div>
                            <span class="sheet-check" aria-hidden="true"></span>
                        </header>
                        @if (!string.IsNullOrWhiteSpace(position.Description))
                        {
                            <p class="sheet-cell-description">@position.Description</p>
                        }
                        @if (position.Products.Count == 0)
                        {
                            <p class="sheet-cell-note">Sin productos ni saldo.</p>
                        }
                        else
                        {
                            var printedProducts = position.Products.Take(3).ToArray();
                            var additionalProducts = position.Products.Count - printedProducts.Length;
                            <ul class="sheet-products">
                                @foreach (var product in printedProducts)
                                {
                                    <li>
                                        <span class="sheet-sku">@product.Sku</span>
                                        @if (product.Quantity is decimal quantity)
                                        {
                                            <span class="sheet-qty @(quantity < 0 ? "is-negative" : "")">@quantity.ToString("0.####") @product.Unit</span>
                                        }
                                        else
                                        {
                                            <span class="sheet-qty is-none">Sin saldo</span>
                                        }
                                        <span class="sheet-product-desc">@(string.IsNullOrWhiteSpace(product.Description) ? "Sin descripción" : product.Description)</span>
                                        <span class="sheet-product-rel">@product.RelationshipState</span>
                                    </li>
                                }
                            </ul>
                            @if (additionalProducts > 0)
                            {
                                <p class="sheet-cell-more">+@additionalProducts producto(s) más en esta posición. Imprime la ficha para verlos.</p>
                            }
                        }
                    </article>
                }
            }
        </section>

        <footer class="rack-sheet-footer">
            <p class="rack-sheet-sign"><span>Verificado por</span><span class="rack-sheet-blank"></span></p>
            <p class="rack-sheet-sign"><span>Fecha</span><span class="rack-sheet-blank"></span></p>
            <p class="rack-sheet-fineprint">Rack @Model.RackCode · Warehouse EPI · El saldo corresponde al momento de generación. Una asignación sin saldo no confirma existencia física.</p>
        </footer>
    </main>
</div>

