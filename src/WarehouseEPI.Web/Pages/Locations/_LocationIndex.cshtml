            <aside class="rack-detail-panel" aria-live="polite"><div class="rack-detail-placeholder"><h2 class="h5">@CatTexts["Selecciona una posición"]</h2><p>@CatTexts["Consulta saldos, asignaciones y movimientos sin salir de la fila."]</p></div>
            @foreach(var position in Model.Locations.Where(location=>location.Kind==WarehouseEPI.Core.Entities.LocationKind.Rack))
            {
                <section id="rack-detail-@position.Id" class="rack-position-detail" data-rack-detail="@position.Id" hidden><div class="d-flex justify-content-between gap-2"><div><span class="text-body-secondary">@CatTexts["Ubicación"]</span><h2 class="h4 mb-1">@position.Code</h2><span class="badge text-bg-light border">@RackStateLabel(position.RackState)</span>@if(position.IsWip){<span class="badge text-bg-warning ms-1">WIP</span>}</div><button type="button" class="btn-close" data-rack-close aria-label="@CatTexts["Cerrar detalle"]"></button></div>
                @if(position.IsBlocked){<p class="alert alert-warning py-2 mt-3 mb-2"><strong>@CatTexts["Bloqueada."]</strong> @position.BlockReason</p>}else if(!position.IsActive){<p class="alert alert-secondary py-2 mt-3 mb-2"><strong>@CatTexts["Inactiva."]</strong> @CatTexts["No está disponible para nuevas operaciones."]</p>}
                <h3 class="h6 mt-3">@CatTexts["Saldos actuales"]</h3>@if(position.Balances.Count==0){<p class="text-body-secondary">@CatTexts["Sin saldo registrado. Registra una entrada para empezar a usar la posición."]</p>}else{<div class="rack-balance-list">@foreach(var balance in position.Balances){<div><div><strong>@balance.Sku</strong><small>@(balance.Description??CatTexts["Sin descripción"].Value) · @(balance.IsAssigned?CatTexts["Asignado"].Value:CatTexts["Sin asignación activa"].Value)</small></div><span class="@(balance.Quantity<0?"text-danger":"")">@balance.Quantity.ToString("0.####") @balance.Unit</span></div>}</div>}
                <div class="d-flex flex-wrap gap-2 mt-3"><a asp-page="@detailsPage" asp-route-id="@position.Id" class="btn btn-primary">@CatTexts["Ficha"]</a><a asp-page="/Inventory/Index" asp-route-locationId="@position.Id" class="btn btn-outline-secondary">@CatTexts["Existencias"]</a>@if(Model.IsAdministrativeView){<a asp-page="/Admin/Inventory/Movements/Index" asp-route-search="@position.Code" class="btn btn-outline-secondary">@CatTexts["Movimientos"]</a>}</div></section>
