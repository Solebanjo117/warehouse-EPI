@model IReadOnlyList<WarehouseEPI.Infrastructure.Reporting.ProductionReworkReportRow>
<table class="table align-middle mb-0">
    <thead><tr><th>Orden / proceso</th><th class="text-end">Inicial</th><th class="text-end">Recuperado</th><th class="text-end">Descartado</th><th class="text-end">Pendiente</th><th class="text-end">Intentos</th><th>Antigüedad</th><th>Estado</th></tr></thead>
    <tbody>@foreach (var row in Model) { <tr class="@(row.IsLate ? "production-row-alert" : null)"><td data-label="Orden / proceso"><a asp-page="/Admin/Production/Details" asp-route-id="@row.OrderId"><strong>@row.OrderNumber</strong></a><small>@row.Stage</small></td><td data-label="Inicial" class="text-end">@row.Initial.ToString("0.####") @row.Unit</td><td data-label="Recuperado" class="text-end">@row.Recovered.ToString("0.####")</td><td data-label="Descartado" class="text-end">@row.Discarded.ToString("0.####")</td><td data-label="Pendiente" class="text-end"><strong>@row.Pending.ToString("0.####")</strong></td><td data-label="Intentos" class="text-end">@row.Attempts</td><td data-label="Antigüedad">@row.AgeHours h<small>Desde @row.OriginAt.ToString("dd/MM/yyyy HH:mm")</small></td><td data-label="Estado">@if (row.IsLate) { <span class="badge text-bg-warning">Requiere atención</span> } else if (row.AlertHours is null) { <span class="badge text-bg-secondary">Sin umbral</span> } else { <span class="badge text-bg-success">Dentro del umbral</span> }</td></tr> }</tbody>
</table>
