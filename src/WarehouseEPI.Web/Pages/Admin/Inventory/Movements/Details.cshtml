@page "{id:guid}"
@model WarehouseEPI.Web.Pages.Admin.Inventory.Movements.DetailsModel
@{ ViewData["Title"]="Detalle de movimiento"; var correction = Model.Movement.OriginalCorrection ?? Model.Movement.ReversalCorrection ?? Model.Movement.ReplacementCorrection; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h2 mb-1">@Model.Movement.Type</h1><p class="text-muted mb-0">@Model.Movement.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @Model.Movement.ResponsibleName</p></div><a asp-page="Index" class="btn btn-outline-secondary">Historial</a></div>
<section class="card card-body mb-3"><div class="row g-3"><div class="col-md-6"><strong>Folio</strong><div class="text-break">@Model.Movement.Id</div></div><div class="col-md-6"><strong>Operación</strong><div class="text-break">@Model.Movement.OperationId</div></div><div class="col-md-6"><strong>Referencia</strong><div>@(Model.Movement.Reference??"—")</div></div><div class="col-md-6"><strong>Registrado</strong><div>@Model.Movement.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div></div></section>
@if(correction is not null){<div class="alert alert-warning"><strong>Movimiento relacionado con una corrección.</strong><div>Motivo: @correction.Reason</div><div>Solicitó: @correction.RequestedBy · Autorizó: @correction.AuthorizedBy</div><div class="mt-2"><a asp-page="Details" asp-route-id="@correction.OriginalMovementId">Original</a> · <a asp-page="Details" asp-route-id="@correction.ReversalMovementId">Reverso</a>@if(correction.ReplacementMovementId is Guid replacement){<text> · <a asp-page="Details" asp-route-id="@replacement">Reemplazo</a></text>}</div></div>}
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Producto</th><th>Cantidad</th><th>Origen / destino</th><th>Cambios de saldo</th></tr></thead><tbody>@foreach(var line in Model.Movement.Lines){<tr><td><strong>@line.Sku</strong><div class="text-muted">@line.Description</div></td><td>@line.Quantity.ToString("0.####") @line.Unit</td><td>@(line.Source??"—") → @(line.Destination??"—")</td><td>@foreach(var change in line.Changes){<div class="@(change.ResultingQuantity<0?"text-danger":"")">@change.LocationCode: @change.PreviousQuantity.ToString("0.####") → @change.ResultingQuantity.ToString("0.####") (@(change.DeltaQuantity>0?"+":"")@change.DeltaQuantity.ToString("0.####"))</div>}</td></tr>}</tbody></table></div>
@if(Model.Movement.Notes is not null){<section class="card card-body mb-3"><strong>Observaciones / motivo</strong><div>@Model.Movement.Notes</div></section>}
@if(Model.Movement.OriginalCorrection is null && Model.Movement.ReversalCorrection is null){<a class="btn btn-danger" asp-page="Correct" asp-route-id="@Model.Movement.Id">Corregir movimiento</a>}
