@using WarehouseEPI.Infrastructure.Settings
@inject WarehouseSettingsService WarehouseSettings
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isAdmin = User.IsInRole("ADMIN");
    var business = await WarehouseSettings.GetAsync();
    var logoUrl = business.LogoFileName is null ? null : $"/branding/logo?v={business.LogoHash}";
    bool IsCurrent(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase);
    bool IsSection(string page) => currentPage.StartsWith(page, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warehouse EPI</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <svg class="app-icon-sprite" aria-hidden="true">
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5v8a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></symbol>
        <symbol id="icon-entry" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 20h16" /></symbol>
        <symbol id="icon-exit" viewBox="0 0 24 24"><path d="M12 16V4m-5 5 5-5 5 5M4 20h16" /></symbol>
        <symbol id="icon-transfer" viewBox="0 0 24 24"><path d="m7 7-3 3 3 3m-3-3h13m0 1 3 3-3 3m3-3H7" /></symbol>
        <symbol id="icon-adjust" viewBox="0 0 24 24"><path d="M4 7h10m4 0h2M4 17h2m4 0h10M14 4v6M6 14v6" /></symbol>
        <symbol id="icon-inventory" viewBox="0 0 24 24"><path d="m4 7 8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10" /></symbol>
        <symbol id="icon-alert" viewBox="0 0 24 24"><path d="M12 3 2.5 20h19zM12 9v5m0 3v.1" /></symbol>
        <symbol id="icon-movements" viewBox="0 0 24 24"><path d="M5 7h14M5 12h14M5 17h14M8 4 5 7l3 3m8-1 3 3-3 3m-8-1-3 3 3 3" /></symbol>
        <symbol id="icon-lots" viewBox="0 0 24 24"><path d="M4 6h16v14H4zM8 3h8v3M8 11h8m-8 4h5" /></symbol>
        <symbol id="icon-products" viewBox="0 0 24 24"><path d="m3 9 9-6 9 6-9 6zM3 9v8l9 4 9-4V9" /></symbol>
        <symbol id="icon-location" viewBox="0 0 24 24"><path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6" /></symbol>
        <symbol id="icon-units" viewBox="0 0 24 24"><path d="M4 6h16v12H4zM8 6v4m4-4v2m4-2v4" /></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><path d="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8m7-1a3 3 0 1 0 0-6M2 21v-3a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v3m0-8h1a5 5 0 0 1 5 5v3" /></symbol>
        <symbol id="icon-system" viewBox="0 0 24 24"><path d="M4 5h16v12H4zM8 21h8m-4-4v4M7 9h2l2 4 2-7 2 5h2" /></symbol>
        <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></symbol>
        <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></symbol>
        <symbol id="icon-logout" viewBox="0 0 24 24"><path d="M10 4H5v16h5m3-4 4-4-4-4m4 4H9" /></symbol>
    </svg>

    <header class="app-topbar">
        <button class="app-menu-button" type="button" data-nav-toggle aria-controls="app-sidebar" aria-expanded="false">
            <svg class="app-icon" aria-hidden="true"><use href="#icon-menu" /></svg>
            <span class="visually-hidden">Abrir menú</span>
        </button>
        <a class="app-topbar-brand" asp-page="/Index">
            @if (logoUrl is not null) { <img class="app-brand-logo" src="@logoUrl" alt="" /> } else { <span class="app-brand-mark" aria-hidden="true">WE</span> }
            <span>@business.BusinessName</span>
        </a>
        <span class="app-topbar-page">@ViewData["Title"]</span>
    </header>

    <div class="app-backdrop" data-nav-dismiss aria-hidden="true"></div>
    <aside class="app-sidebar" id="app-sidebar" aria-label="Navegación principal">
        <div class="app-sidebar-header">
            <a class="app-brand" asp-page="/Index" aria-label="Warehouse EPI, inicio">
                @if (logoUrl is not null) { <img class="app-brand-logo" src="@logoUrl" alt="" /> } else { <span class="app-brand-mark" aria-hidden="true">WE</span> }
                <span class="app-brand-text"><strong>Warehouse EPI</strong><small>@business.WarehouseName</small></span>
            </a>
            <button class="app-collapse-button" type="button" data-nav-collapse aria-expanded="true" title="Contraer menú">
                <svg class="app-icon" aria-hidden="true"><use href="#icon-chevron" /></svg>
                <span class="visually-hidden">Contraer menú</span>
            </button>
        </div>

        <nav class="app-nav">
            <a class="app-nav-link @(IsCurrent("/Index") ? "active" : null)" asp-page="/Index" aria-current="@(IsCurrent("/Index") ? "page" : null)" title="Inicio">
                <svg class="app-icon" aria-hidden="true"><use href="#icon-home" /></svg><span>Inicio</span>
            </a>

            <div class="app-nav-group">
                <div class="app-nav-heading">Operación</div>
                <a class="app-nav-link @(IsCurrent("/Operations/Entry") ? "active" : null)" asp-page="/Operations/Entry" aria-current="@(IsCurrent("/Operations/Entry") ? "page" : null)" title="Entrada">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-entry" /></svg><span>Entrada</span>
                </a>
                <a class="app-nav-link @(IsCurrent("/Operations/Exit") ? "active" : null)" asp-page="/Operations/Exit" aria-current="@(IsCurrent("/Operations/Exit") ? "page" : null)" title="Salida">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-exit" /></svg><span>Salida</span>
                </a>
                <a class="app-nav-link @(IsCurrent("/Operations/Transfer") ? "active" : null)" asp-page="/Operations/Transfer" aria-current="@(IsCurrent("/Operations/Transfer") ? "page" : null)" title="Transferencia">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-transfer" /></svg><span>Transferencia</span>
                </a>
                <a class="app-nav-link @(IsCurrent("/Operations/WipReturn") ? "active" : null)" asp-page="/Operations/WipReturn" title="Devolución desde WIP">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-transfer" /></svg><span>Devolución WIP</span>
                </a>
                <a class="app-nav-link @(IsCurrent("/Operations/Adjustment") ? "active" : null)" asp-page="/Operations/Adjustment" aria-current="@(IsCurrent("/Operations/Adjustment") ? "page" : null)" title="Ajuste">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-adjust" /></svg><span>Ajuste</span>
                </a>
            </div>

            <div class="app-nav-group">
                <div class="app-nav-heading">Inventario</div>
                <a class="app-nav-link @(IsSection("/Inventory") ? "active" : null)" asp-page="/Inventory/Index" aria-current="@(IsSection("/Inventory") ? "page" : null)" title="Existencias">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-inventory" /></svg><span>Existencias</span>
                </a>
                <a class="app-nav-link @(IsSection("/Reports/Wip") ? "active" : null)" asp-page="/Reports/Wip/Index" title="Reporte WIP">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-movements" /></svg><span>Reporte WIP</span>
                </a>
                @if (isAdmin)
                {
                    <a class="app-nav-link @(IsCurrent("/Admin/Inventory/Alerts") ? "active" : null)" asp-page="/Admin/Inventory/Alerts" aria-current="@(IsCurrent("/Admin/Inventory/Alerts") ? "page" : null)" title="Alertas">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-alert" /></svg><span>Alertas</span>
                    </a>
                    <a class="app-nav-link @(IsSection("/Admin/Inventory/Movements") ? "active" : null)" asp-page="/Admin/Inventory/Movements/Index" aria-current="@(IsSection("/Admin/Inventory/Movements") ? "page" : null)" title="Movimientos">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-movements" /></svg><span>Movimientos</span>
                    </a>
                    <a class="app-nav-link @(IsSection("/Admin/Inventory/Lots") ? "active" : null)" asp-page="/Admin/Inventory/Lots/Index" aria-current="@(IsSection("/Admin/Inventory/Lots") ? "page" : null)" title="Lotes">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-lots" /></svg><span>Lotes</span>
                    </a>
                }
            </div>

            @if (isAdmin)
            {
                <div class="app-nav-group">
                    <div class="app-nav-heading">Catálogos</div>
                    <a class="app-nav-link @(IsSection("/Admin/Catalogs/Products") ? "active" : null)" asp-page="/Admin/Catalogs/Products/Index" aria-current="@(IsSection("/Admin/Catalogs/Products") ? "page" : null)" title="Productos">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-products" /></svg><span>Productos</span>
                    </a>
                    <a class="app-nav-link @(IsSection("/Admin/Catalogs/Locations") ? "active" : null)" asp-page="/Admin/Catalogs/Locations/Index" aria-current="@(IsSection("/Admin/Catalogs/Locations") ? "page" : null)" title="Ubicaciones">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-location" /></svg><span>Ubicaciones</span>
                    </a>
                    <a class="app-nav-link @(IsSection("/Admin/Catalogs/Units") ? "active" : null)" asp-page="/Admin/Catalogs/Units/Index" aria-current="@(IsSection("/Admin/Catalogs/Units") ? "page" : null)" title="Unidades de medida">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-units" /></svg><span>Unidades de medida</span>
                    </a>
                </div>

                <div class="app-nav-group">
                    <div class="app-nav-heading">Administración</div>
                    <a class="app-nav-link @(IsSection("/Admin/Users") ? "active" : null)" asp-page="/Admin/Users/Index" aria-current="@(IsSection("/Admin/Users") ? "page" : null)" title="Usuarios">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-users" /></svg><span>Usuarios</span>
                    </a>
                    <a class="app-nav-link @(IsSection("/Admin/System") ? "active" : null)" asp-page="/Admin/System/Index" aria-current="@(IsSection("/Admin/System") ? "page" : null)" title="Estado del sistema">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-system" /></svg><span>Estado del sistema</span>
                    </a>
                </div>

                <div class="app-nav-group">
                    <div class="app-nav-heading">Configuración</div>
                    <a class="app-nav-link @(IsSection("/Admin/Settings") ? "active" : null)" asp-page="/Admin/Settings/Business" aria-current="@(IsSection("/Admin/Settings") ? "page" : null)" title="Datos del negocio">
                        <svg class="app-icon" aria-hidden="true"><use href="#icon-system" /></svg><span>Datos del negocio</span>
                    </a>
                </div>
            }
        </nav>

        <div class="app-sidebar-footer">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <details class="app-account-menu">
                    <summary class="app-user" title="@User.Identity.Name"><span class="app-user-avatar" aria-hidden="true">@User.Identity.Name?.Substring(0, 1).ToUpperInvariant()</span><span class="app-user-name"><strong>@User.Identity.Name</strong><small>Administrador</small></span></summary>
                    <a class="app-nav-link" asp-page="/Admin/Account/Index"><svg class="app-icon" aria-hidden="true"><use href="#icon-users" /></svg><span>Mi cuenta</span></a>
                    <partial name="_ThemeControl" />
                </details>
                <form method="post" asp-page="/Admin/Logout"><button type="submit" class="app-nav-link app-logout" title="Cerrar sesión"><svg class="app-icon" aria-hidden="true"><use href="#icon-logout" /></svg><span>Cerrar sesión</span></button></form>
            }
            else
            {
                <partial name="_ThemeControl" />
                <a asp-page="/Admin/Login" class="app-nav-link" title="Acceso administrativo">
                    <svg class="app-icon" aria-hidden="true"><use href="#icon-users" /></svg><span>Acceso administrativo</span>
                </a>
            }
        </div>
    </aside>

    <div class="app-content">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
        <footer class="app-footer">&copy; 2026 Warehouse EPI</footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/zxing/zxing-browser.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/operations.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
