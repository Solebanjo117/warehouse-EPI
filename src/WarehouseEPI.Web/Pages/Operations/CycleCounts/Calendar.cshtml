@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@model WarehouseEPI.Web.Pages.Operations.CycleCounts.CalendarModel
@using WarehouseEPI.Core.Entities
@using WarehouseEPI.Infrastructure.Inventory
@{
    ViewData["Title"] = OpTexts["Calendario de conteos"].Value;
    string State(CycleCountCalendarItem item) => item.IsHistorical
        ? item.LocationStatus switch { CycleCountLocationStatus.Completed => OpTexts["Completado"].Value, CycleCountLocationStatus.Cancelled => OpTexts["Cancelado"].Value, _ => OpTexts["En campaña"].Value }
        : !item.IsActive ? OpTexts["Pausado"].Value : item.IsBlocked ? OpTexts["Bloqueado"].Value : item.IsInCampaign ? OpTexts["En campaña"].Value : item.ScheduledFor < Model.Today ? OpTexts["Vencido"].Value : item.ScheduledFor == Model.Today ? OpTexts["Vence hoy"].Value : OpTexts["Programado"].Value;
    bool Available(CycleCountCalendarItem item) => !item.IsHistorical && item.IsActive && !item.IsBlocked && !item.IsInCampaign && item.ScheduledFor <= Model.Today;
    string Badge(CycleCountCalendarItem item) => item.LocationStatus == CycleCountLocationStatus.Completed ? "text-bg-success" : item.LocationStatus == CycleCountLocationStatus.Cancelled ? "text-bg-secondary" : Available(item) ? "text-bg-warning" : item.IsInCampaign ? "text-bg-info" : item.IsBlocked ? "text-bg-danger" : "text-bg-secondary";
}
<div class="inventory-analytics cycle-count-workspace">
    <header class="inventory-page-header analytics-header"><div><a asp-page="Index" class="small text-decoration-none">@OpTexts["← Conteos cíclicos"]</a><h1 class="h2 mt-2 mb-1">@OpTexts["Calendario de conteos"]</h1><p class="text-muted mb-0">@OpTexts["Cada despacho permanece en su fecha programada; solo se publica la cantidad final contada."]</p></div><a asp-page="/Admin/Inventory/CycleCountPlans/Index" class="btn btn-outline-primary">@OpTexts["Administrar planes"]</a></header>
    @if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
    <nav class="nav nav-tabs mb-3" aria-label="@OpTexts["Vistas del calendario"]"><a class="nav-link @(!Model.IsOverdue ? "active" : null)" asp-route-month="@Model.SelectedMonth" asp-route-view="month">@OpTexts["Mes"]</a><a class="nav-link @(Model.IsOverdue ? "active" : null)" asp-route-month="@Model.SelectedMonth" asp-route-view="overdue">@OpTexts["Vencidos"]</a></nav>
    @if (!Model.IsOverdue) { <form method="get" class="analytics-filter-card analytics-filter-form mb-3"><input type="hidden" name="view" value="month" /><div><label class="form-label" for="cycle-month">@OpTexts["Mes"]</label><input id="cycle-month" name="month" type="month" class="form-control" value="@Model.SelectedMonth" /></div><div class="analytics-filter-actions"><button class="btn btn-outline-primary">@OpTexts["Ver calendario"]</button></div></form> }
    else { <div class="analytics-filter-card mb-3"><strong>@OpTexts["Planes vencidos al {0}", Model.Today.ToString("dd/MM/yyyy")]</strong><p class="text-body-secondary mb-0">@OpTexts["Solo aparecen planes activos sin un despacho abierto. Los bloqueados permanecen visibles para diagnóstico."]</p></div> }
    <form method="post" asp-page-handler="Release"><input asp-for="OperationId" type="hidden" /><input type="hidden" name="month" value="@Model.SelectedMonth" /><input type="hidden" name="view" value="@Model.ViewMode" /><input type="hidden" name="pageNumber" value="@Model.Result.Page" />
        <div class="table-responsive analytics-table"><table class="table align-middle"><thead><tr><th><span class="visually-hidden">@OpTexts["Seleccionar"]</span></th><th>@OpTexts["Fecha programada"]</th><th>@OpTexts["SKU"]</th><th>@OpTexts["Ubicación"]</th><th>@OpTexts["Frecuencia"]</th><th>@OpTexts["Cantidad contada"]</th><th>@OpTexts["Estado"]</th></tr></thead><tbody>
        @foreach (var item in Model.Plans) { <tr><td>@if (Available(item)) { <input class="form-check-input" type="checkbox" name="PlanIds" value="@item.PlanId" aria-label="@OpTexts["Liberar {0} en {1}", item.Sku, item.LocationCode]" /> }</td><td><strong>@item.ScheduledFor.ToString("dd/MM/yyyy")</strong></td><td><strong>@item.Sku</strong><small class="d-block text-body-secondary">@(item.Description ?? OpTexts["Sin descripción"].Value)</small></td><td>@item.LocationCode</td><td>@OpTexts[CycleCountPlanPresentation.FrequencyLabel(item.Frequency)]</td><td>@(item.CompletedQuantity is null ? OpTexts["Por capturar"].Value : item.CompletedQuantity.Value.ToString("0.####") + " " + item.UnitCode)</td><td><span class="badge @Badge(item)">@OpTexts[State(item)]</span>@if (item.IsBlocked && !item.IsHistorical) { <small class="d-block text-danger mt-1">@OpTexts["Producto o ubicación no operativa."]</small> }</td></tr> }
        @if (Model.Plans.Count == 0) { <tr><td colspan="7" class="text-center text-body-secondary py-4">@(Model.IsOverdue ? OpTexts["No hay planes vencidos pendientes."].Value : OpTexts["No hay despachos ni vencimientos programados en este mes."].Value)</td></tr> }
        </tbody></table></div>
        @if (Model.Result.TotalPages > 1) { <nav aria-label="@OpTexts["Páginas del calendario"]"><ul class="pagination justify-content-center">@for (var p = 1; p <= Model.Result.TotalPages; p++) { <li class="page-item @(p == Model.Result.Page ? "active" : null)"><a class="page-link" asp-route-month="@Model.SelectedMonth" asp-route-view="@Model.ViewMode" asp-route-pageNumber="@p">@p</a></li> }</ul></nav> }
        <section class="analytics-filter-card mt-3"><h2 class="h5">@OpTexts["Liberar seleccionados de esta página"]</h2><p class="text-body-secondary">@OpTexts["Se crea una campaña lista para contar. Las ubicaciones con una campaña abierta no se liberan."]</p><label asp-for="Pin" class="form-label">@OpTexts["NIP responsable"]</label><input asp-for="Pin" class="form-control" type="password" inputmode="numeric" minlength="4" maxlength="8" autocomplete="off" /><button class="btn btn-primary mt-3">@OpTexts["Crear y liberar campaña"]</button></section>
    </form>
</div>
