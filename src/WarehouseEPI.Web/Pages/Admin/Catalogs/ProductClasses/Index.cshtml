@page
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.CatalogTexts> CatTexts
@model WarehouseEPI.Web.Pages.Admin.Catalogs.ProductClasses.IndexModel
@{
    ViewData["Title"] = CatTexts["Clases de producto"].Value;
    var isEditing = Model.Input.Id != 0;
    var totalCount = Model.Items.Count;
    var activeCount = Model.Items.Count(productClass => productClass.IsActive);
    var inactiveCount = totalCount - activeCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-classes-index.css" asp-append-version="true" />
}

<div class="product-classes-page">
    <header class="product-classes-header">
        <div>
            <span class="eyebrow">@CatTexts["Catálogo administrativo"]</span>
            <h1 class="h2 mb-1">@CatTexts["Clases de producto"]</h1>
            <p>@CatTexts["Las clases agrupan el catálogo por familia y son el valor que reconocen las importaciones. Un producto puede existir sin clase: sirven para ordenar, no para restringir."]</p>
        </div>
        @if (totalCount > 0)
        {
            <dl class="product-classes-summary">
                <div>
                    <dt>Total</dt>
                    <dd>@totalCount</dd>
                </div>
                <div>
                    <dt>@CatTexts["Activas"]</dt>
                    <dd>@activeCount</dd>
                </div>
                <div>
                    <dt>@CatTexts["Inactivas"]</dt>
                    <dd>@inactiveCount</dd>
                </div>
            </dl>
        }
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger mb-0" role="alert" tabindex="-1">@error</div>
    }

    <section class="product-classes-form-section @(isEditing ? "is-editing" : null)" aria-labelledby="product-classes-form-title">
        @if (isEditing)
        {
            <span class="product-classes-editing-flag">@CatTexts["Estás modificando una clase existente"]</span>
        }
        <h2 class="product-classes-form-title" id="product-classes-form-title" tabindex="-1">@(isEditing ? CatTexts["Editar clase"].Value : CatTexts["Agregar clase"].Value)</h2>
        <p class="product-classes-form-intro">
            @if (isEditing)
            {
                @:Cambiar el código o el nombre modifica cómo se presenta esta clase en los productos que ya la usan y en las importaciones que la nombran. Cancela si prefieres dejarla como está.
            }
            else
            {
                @:El código identifica la clase en productos e importaciones. El servidor lo normaliza al guardar y no admite duplicados.
            }
        </p>
        <form method="post" asp-page-handler="Save">
            <input asp-for="Input.Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="Input.Code" class="form-label">@CatTexts["Código"]</label>
                    <input asp-for="Input.Code" class="form-control text-uppercase product-classes-code-input" autocomplete="off" autocapitalize="characters" />
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-8">
                    <label asp-for="Input.Name" class="form-label">@CatTexts["Nombre"]</label>
                    <input asp-for="Input.Name" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
            </div>
            <div class="product-classes-form-actions">
                <button type="submit" class="btn btn-primary btn-lg">@(Model.Input.Id == 0 ? CatTexts["Agregar clase"].Value : CatTexts["Guardar cambios"].Value)</button>
                @if (isEditing)
                {
                    <a asp-page="Index" class="btn btn-outline-secondary">@CatTexts["Cancelar"]</a>
                }
            </div>
        </form>
    </section>

    <section aria-labelledby="product-classes-list-title">
        <h2 class="product-classes-list-title" id="product-classes-list-title">@CatTexts["Clases registradas"]</h2>
        @if (totalCount == 0)
        {
            <div class="product-classes-empty">
                <strong>@CatTexts["Todavía no hay clases registradas."]</strong>
                <p>@CatTexts["Las clases son opcionales: sirven para organizar el catálogo por familia y para que las importaciones reconozcan a qué grupo pertenece cada producto. Crea la primera con el formulario"] <a href="#product-classes-form-title">@CatTexts["Agregar clase"]</a>.</p>
            </div>
        }
        else
        {
            <table class="table product-classes-table align-middle">
                <caption class="product-classes-caption">@CatTexts["Clases disponibles para organizar el catálogo. Desactivar una clase la retira de las altas nuevas, pero conserva su historial en los productos que ya la usan; el servidor impide desactivar una clase mientras haya productos activos con ella."]</caption>
                <thead>
                    <tr>
                        <th scope="col">@CatTexts["Código"]</th>
                        <th scope="col">@CatTexts["Nombre"]</th>
                        <th scope="col">@CatTexts["Estado"]</th>
                        <th scope="col" class="text-end">@CatTexts["Acciones"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsActive ? null : "is-inactive")">
                            <td class="product-classes-cell-code">
                                <span class="product-classes-code">@item.Code</span>
                            </td>
                            <td class="product-classes-cell-name">
                                <span class="product-classes-name">@item.Name</span>
                            </td>
                            <td class="product-classes-cell-state">
                                <span class="product-classes-flag @(item.IsActive ? "is-active" : "is-inactive")">@(item.IsActive ? CatTexts["Activa"].Value : CatTexts["Inactiva"].Value)</span>
                            </td>
                            <td class="product-classes-cell-actions text-end">
                                <div class="product-classes-row-actions">
                                    <a asp-route-editId="@item.Id" class="btn btn-outline-secondary" aria-label="Editar la clase @item.Code">@CatTexts["Editar"]</a>
                                    <form method="post" asp-page-handler="Toggle">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")" aria-label="@(item.IsActive ? $"Desactivar la clase {item.Code}" : $"Activar la clase {item.Code}")">@(item.IsActive ? CatTexts["Desactivar"].Value : CatTexts["Activar"].Value)</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
