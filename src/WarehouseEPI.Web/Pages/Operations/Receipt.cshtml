@page "{id:guid}"
@inject Microsoft.Extensions.Localization.IStringLocalizer<WarehouseEPI.Web.Localization.OperationsTexts> OpTexts
@using WarehouseEPI.Core.Entities
@model WarehouseEPI.Web.Pages.Operations.ReceiptModel
<a asp-page="/Operations/PalletLabels/Tracking" asp-route-OriginId="@Model.Receipt.MovementId" class="btn btn-outline-primary btn-lg">@OpTexts["Ver placas de esta operación"]</a>
@{
    ViewData["Title"] = OpTexts["Operación confirmada"].Value;
    var typeName = Model.Receipt.Purpose switch
    {
        InventoryMovementPurpose.ProductionReceipt => OpTexts["Recepción de producción"].Value,
        InventoryMovementPurpose.ProductionIssue => OpTexts["Surtimiento WIP"].Value,
        InventoryMovementPurpose.WipWarehouseReturn => OpTexts["Devolución WIP a bodega"].Value,
        InventoryMovementPurpose.WipConsumption => OpTexts["Consumo WIP"].Value,
        InventoryMovementPurpose.WipSupplierReturn => OpTexts["Devolución WIP a proveedor"].Value,
        InventoryMovementPurpose.DocumentReceipt => OpTexts["Recepción documental"].Value,
        _ => Model.Receipt.Type switch
    {
        InventoryMovementType.Entry => OpTexts["Entrada"].Value,
        InventoryMovementType.Exit => OpTexts["Salida"].Value,
        InventoryMovementType.Transfer => OpTexts["Transferencia"].Value,
        InventoryMovementType.Adjustment => OpTexts["Ajuste"].Value,
        _ => OpTexts["Movimiento"].Value
    }};
    var newPage = Model.Receipt.Purpose switch
    {
        InventoryMovementPurpose.ProductionReceipt => "/Operations/Production/Index",
        InventoryMovementPurpose.ProductionIssue => "/Operations/Exit",
        InventoryMovementPurpose.WipWarehouseReturn => "/Operations/WipProcess",
        InventoryMovementPurpose.WipConsumption => "/Operations/WipProcess",
        InventoryMovementPurpose.WipSupplierReturn => "/Operations/WipProcess",
        InventoryMovementPurpose.DocumentReceipt => "/Operations/Receiving/Index",
        _ => Model.Receipt.Type switch
    {
        InventoryMovementType.Entry => "/Operations/Entry",
        InventoryMovementType.Exit => "/Operations/Exit",
        InventoryMovementType.Transfer => "/Operations/Transfer",
        InventoryMovementType.Adjustment => "/Operations/Adjustment",
        _ => "/Index"
    }};
    var superseded = Model.Receipt.Purpose == InventoryMovementPurpose.ProductionReceipt && Model.Receipt.Correction is not null && Model.Receipt.Correction.ReplacementMovementId != Model.Receipt.MovementId;
    var newMode = Model.Receipt.Purpose == InventoryMovementPurpose.ProductionIssue ? "wip" : null;
    var canGeneratePalletPlate = Model.Receipt.Type == InventoryMovementType.Entry &&
        (Model.Receipt.Correction is null || Model.Receipt.Correction.ReplacementMovementId == Model.Receipt.MovementId);
}

<div class="receipt-shell">
    <div class="receipt-status @(Model.Receipt.HasNegativeBalance ? "receipt-warning" : "receipt-success")">
        <span class="receipt-icon" aria-hidden="true">@(Model.Receipt.HasNegativeBalance ? "!" : "✓")</span>
        <div>
            <h1 class="h3 mb-1">@typeName @(superseded ? OpTexts["corregida · antecedente"].Value : OpTexts["confirmada"].Value)</h1>
            <p class="mb-0">
                @if (superseded) { <text>@OpTexts["Este movimiento no representa una recepción vigente. Consulta la corrección."]</text> }
                else if (Model.Receipt.HasNegativeBalance)
                {
                    <text>@OpTexts["La operación se guardó, pero existe un saldo negativo."]</text>
                }
                else
                {
                    <text>@OpTexts["El inventario se actualizó correctamente."]</text>
                }
            </p>
        </div>
    </div>

    <section class="operation-card mt-4">
        <div class="receipt-meta">
            <div><span>@OpTexts["Responsable"]</span><strong>@Model.Receipt.ResponsibleName</strong></div>
            <div><span>@OpTexts["Fecha"]</span><strong>@Model.OccurredAtWarehouseTime.ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div><span>@OpTexts["Folio"]</span><strong class="receipt-id">@Model.Receipt.MovementId</strong></div>
            @if (Model.Receipt.Reference is not null)
            {
                <div><span>@OpTexts["Referencia"]</span><strong>@Model.Receipt.Reference</strong></div>
            }
        </div>
    </section>
    @if(Model.Receipt.Purpose == InventoryMovementPurpose.ProductionReceipt) {
        <section class="operation-card border-primary" data-production-receipt>
        @if(Model.Production is { } production) {
            var productionUnit=Model.Receipt.Lines.FirstOrDefault()?.UnitCode;
            <h2 class="h5">@production.OrderNumber · @(production.BatchNumber ?? OpTexts["Seguimiento histórico sin lote"].Value)</h2>
            <p>@OpTexts["Cantidad de esta recepción: {0} {1}", production.Quantity.ToString("0.####"), productionUnit ?? ""]</p>
            <p>@OpTexts["Acumulado actual: {0} {1} · Disponible para otra recepción: {2} {1}", production.Received.ToString("0.####"), productionUnit ?? "", production.Pending.ToString("0.####")]</p>
            <p class="small text-body-secondary">@OpTexts["Acumulado y pendiente consultados al abrir este comprobante."]</p>
            <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary btn-lg" asp-page="/Operations/Production/Work" asp-route-id="@production.OrderId" asp-route-BatchId="@production.BatchId">@OpTexts["Volver a la orden"]</a>
            @if(!superseded && production.CanReceive && production.Pending>0) { <a class="btn btn-primary btn-lg" asp-page="/Operations/Production/Work" asp-route-id="@production.OrderId" asp-route-BatchId="@production.BatchId" asp-route-Task="warehouse">@OpTexts["Recibir otra parcialidad"]</a> }
            @if(production.BatchId.HasValue) { <a class="btn btn-outline-secondary btn-lg" asp-page="/Operations/Production/BatchLabel" asp-route-id="@production.BatchId">@OpTexts["Etiqueta del lote"]</a> }
            </div>
        } else { <p>@OpTexts["Este antecedente no conserva un vínculo completo con la orden y el lote."]</p><a class="btn btn-primary btn-lg" asp-page="/Operations/Production/Index" asp-route-View="all">@OpTexts["Buscar en producción"]</a> }
        </section>
    }
    @if (Model.Receipt.Purpose == InventoryMovementPurpose.ProductionIssue)
    {
        <section class="operation-card border-warning"><strong>Rack → @Model.Receipt.OperationalAreaCode</strong><p class="mb-0">@OpTexts["El surtimiento transfirió existencias al WIP y conservó los lotes del origen."]</p></section>
    }
    @if (Model.ReceivingDocument is not null)
    {
        <section class="operation-card border-primary">
            <h2 class="h5">@OpTexts["Documento relacionado"]</h2>
            <p class="mb-2"><strong>@Model.ReceivingDocument.DocumentLabel</strong> · @Model.ReceivingDocument.Status</p>
            @if (Model.ReceivingDocument.ExternalLotReferences.Count > 0) { <p class="small mb-2">@OpTexts["Lote/rollo externo: {0}", string.Join(", ", Model.ReceivingDocument.ExternalLotReferences)]</p> }
            @if (Model.ReceivingDocument.DifferenceNotes is not null) { <p class="small text-warning">@Model.ReceivingDocument.DifferenceNotes</p> }
            <a class="btn btn-outline-primary" asp-page="/Operations/Receiving/Details" asp-route-id="@Model.ReceivingDocument.DocumentId">@OpTexts["Ver recepción"]</a>
        </section>
    }

    @if (Model.Receipt.Correction is not null)
    {
        <section class="operation-card border-warning">
            <h2 class="h5">@OpTexts["Comprobante relacionado con una corrección"]</h2>
            <p class="mb-2">@Model.Receipt.Correction.Reason</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary" asp-page="/Operations/Receipt" asp-route-id="@Model.Receipt.Correction.OriginalMovementId">@OpTexts["Original"]</a>
                <a class="btn btn-outline-secondary" asp-page="/Operations/Receipt" asp-route-id="@Model.Receipt.Correction.ReversalMovementId">@OpTexts["Reverso"]</a>
                @if (Model.Receipt.Correction.ReplacementMovementId is Guid replacement)
                { <a class="btn btn-outline-secondary" asp-page="/Operations/Receipt" asp-route-id="@replacement">@OpTexts["Reemplazo"]</a> }
            </div>
        </section>
    }

    @foreach (var line in Model.Receipt.Lines)
    {
        <section class="operation-card">
            <h2 class="h5 mb-1">@line.ProductSku</h2>
            @if (line.ProductDescription is not null)
            {
                <p class="text-muted">@line.ProductDescription</p>
            }
            <p class="receipt-quantity"><strong>@line.Quantity.ToString("0.####") @line.UnitCode</strong></p>
            @if (line.SourceLocationCode is not null || line.DestinationLocationCode is not null)
            {
                <p class="receipt-route"><strong>@(line.SourceLocationCode ?? "—")</strong><span aria-hidden="true"> → </span><strong>@(line.DestinationLocationCode ?? Model.Receipt.OperationalAreaCode ?? "—")</strong></p>
            }
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>@OpTexts["Ubicación"]</th><th>@OpTexts["Anterior"]</th><th>@OpTexts["Cambio"]</th><th>@OpTexts["Final"]</th></tr></thead>
                    <tbody>
                    @foreach (var change in line.Changes)
                    {
                        <tr class="@(change.ResultingQuantity < 0 ? "table-warning" : null)">
                            <td><strong>@change.LocationCode</strong></td>
                            <td>@change.PreviousQuantity.ToString("0.####")</td>
                            <td>@(change.DeltaQuantity > 0 ? "+" : null)@change.DeltaQuantity.ToString("0.####")</td>
                            <td><strong>@change.ResultingQuantity.ToString("0.####")</strong></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.Receipt.Notes is not null)
    {
        <section class="operation-card"><strong>@OpTexts["Observaciones / motivo"]</strong><p class="mb-0 mt-1">@Model.Receipt.Notes</p></section>
    }
    @if (canGeneratePalletPlate)
    {
        <div class="operation-actions"><a class="btn btn-outline-primary btn-lg" asp-page="/Operations/PalletLabels/Index" asp-route-id="@Model.Receipt.MovementId">@OpTexts["Identificar pallet"]</a></div>
    }

    <div class="operation-actions">
        <a asp-page="/Index" class="btn btn-outline-secondary btn-lg">@OpTexts["Menú"]</a>
        @if(Model.Receipt.Purpose != InventoryMovementPurpose.ProductionReceipt) { <a asp-page="@newPage" asp-route-mode="@newMode" class="btn btn-primary btn-lg flex-grow-1">@OpTexts["Nueva operación"]</a> }
    </div>
</div>
