@page
@model WarehouseEPI.Web.Pages.Admin.Inventory.AlertsModel
@{ ViewData["Title"] = "Alertas de inventario"; }

<div class="alerts-workspace">
    <header class="inventory-page-header d-flex flex-wrap justify-content-between gap-3 align-items-start"><div><h1 class="h2 mb-1">Alertas de inventario</h1><p class="text-muted mb-0">Valores derivados de los saldos actuales.</p></div><div class="d-flex gap-2"><a asp-page="/Admin/Inventory/Movements/Index" class="btn btn-outline-secondary">Historial</a><a asp-route-view="@Model.View" asp-route-search="@Model.Search" class="btn btn-primary">Actualizar</a></div></header>
    <p class="alerts-updated">Actualizado: <time datetime="@Model.UpdatedAt.ToString("O")">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</time></p>

    <section class="alert-metrics" aria-label="Resumen de alertas"><article class="is-danger"><span aria-hidden="true">!</span><strong>@Model.Summary.NegativePositions</strong><small>Saldos producto-ubicación negativos</small></article><article><span aria-hidden="true">#</span><strong>@Model.Summary.NegativeProducts</strong><small>Productos afectados</small></article><article class="is-warning"><span aria-hidden="true">↓</span><strong>@Model.Summary.BelowMinimumProducts</strong><small>Productos bajo mínimo</small></article></section>

    <nav class="inventory-filter-tabs" aria-label="Tipo de alerta"><a class="@(Model.View == "negative" ? "active" : null)" aria-current="@(Model.View == "negative" ? "page" : null)" asp-route-view="negative">Saldos negativos <span>@Model.Summary.NegativePositions</span></a><a class="@(Model.View == "minimum" ? "active" : null)" aria-current="@(Model.View == "minimum" ? "page" : null)" asp-route-view="minimum">Bajo mínimo <span>@Model.Summary.BelowMinimumProducts</span></a></nav>
    <form method="get" class="alert-search-form"><input type="hidden" name="view" value="@Model.View" /><label class="visually-hidden" for="alert-search">Buscar alertas</label><div class="input-group"><input id="alert-search" name="search" value="@Model.Search" class="form-control" placeholder="SKU, descripción@(Model.View == "negative" ? " o ubicación" : string.Empty)" /><button class="btn btn-outline-primary">Filtrar</button></div></form>

    @if (Model.View == "negative")
    {
        @if (Model.NegativeAlerts.Items.Count == 0) { <div class="inventory-empty mt-3"><strong>No hay saldos negativos.</strong><span>Las posiciones actuales no requieren atención por negativo.</span></div> }
        else { <section class="alert-list mt-3" aria-label="Saldos negativos">@foreach (var item in Model.NegativeAlerts.Items) { <article class="alert-row is-negative"><div><span class="inventory-card-label">Producto</span><a asp-page="/Admin/Catalogs/Products/Edit" asp-route-id="@item.ProductId" class="fw-bold">@item.ProductSku</a><small>@(item.ProductDescription ?? "Sin descripción")</small></div><div><span class="inventory-card-label">Ubicación</span><a asp-page="/Admin/Catalogs/Locations/Details" asp-route-id="@item.LocationId" class="fw-bold">@item.LocationCode</a><small>@(item.LocationDescription ?? "Ubicación operativa")</small></div><div><span class="badge text-bg-danger">Saldo negativo</span><strong>@item.Quantity.ToString("0.####") @item.UnitCode</strong></div><a class="btn btn-outline-primary" asp-page="/Inventory/Index" asp-route-productId="@item.ProductId" asp-route-highlightLocationId="@item.LocationId">Ver existencias</a></article> }</section> }
    }
    else
    {
        @if (Model.MinimumAlerts.Items.Count == 0) { <div class="inventory-empty mt-3"><strong>No hay productos bajo mínimo.</strong><span>Los productos activos cumplen con su mínimo configurado.</span></div> }
        else { <section class="alert-list mt-3" aria-label="Productos bajo mínimo">@foreach (var item in Model.MinimumAlerts.Items) { <article class="alert-row is-minimum"><div><span class="inventory-card-label">Producto</span><a asp-page="/Admin/Catalogs/Products/Edit" asp-route-id="@item.ProductId" class="fw-bold">@item.Sku</a><small>@(item.Description ?? "Sin descripción")</small></div><div><span class="inventory-card-label">Existencia</span><strong>@item.TotalQuantity.ToString("0.####") / @item.MinimumStock.ToString("0.####") @item.UnitCode</strong><small>Faltan @item.Deficit.ToString("0.####") @item.UnitCode</small></div><div><span class="inventory-card-label">Cobertura</span><strong>@(item.CoveragePercent is decimal coverage ? $"{coverage:0.#}%" : "No aplica")</strong></div><a class="btn btn-outline-primary" asp-page="/Inventory/Index" asp-route-productId="@item.ProductId">Ver existencias</a></article> }</section> }
    }

    @if (Model.TotalPages > 1) { <nav class="mt-4" aria-label="Paginación de alertas"><ul class="pagination justify-content-center"><li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)"><a class="page-link" asp-route-view="@Model.View" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber - 1)">Anterior</a></li><li class="page-item disabled"><span class="page-link">@Model.PageNumber de @Model.TotalPages</span></li><li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : null)"><a class="page-link" asp-route-view="@Model.View" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber + 1)">Siguiente</a></li></ul></nav> }
</div>
